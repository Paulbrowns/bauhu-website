---
import { verifiedSupplierImage, supplierCatalogueUrl } from '../data/interiors-supplier-photography';
/**
 * Single approved Bauhu Interiors visual layout:
 * 1 interior hero, 2 overall mood board, 3 category-specific Finishes/Kitchens/Bathrooms cards.
 * Product detail / IDs belong outside the visual treatment.
 * Missing images use honest swatch previews, never another design's photography.
 */
interface Board {
 title:string;
 subtitle:string;
 image?:string|null;
 items?: {range?:string;finish?:string;slot?:string;supplier?:string}[];
}
interface Props {
 title:string;
 description:string;
 palette:readonly string[];
 hero?:string|null;
 overall?:string|null;
 boards:readonly Board[];
 preview?:boolean;
 useImageEmbeddedLabels?:boolean;
 schemeKey?:string;
 singleMoodboard?:string;
 moodboardFallback?:string;
}
const {title,description,palette,hero,overall,boards,preview=false,useImageEmbeddedLabels=false,schemeKey,singleMoodboard,moodboardFallback}=Astro.props;
---
<div class="space-y-10">
  <section class="relative min-h-[390px] overflow-hidden rounded-xl bg-ink md:min-h-[520px]">
    {hero ? <img src={hero} alt={title+' interior design atmosphere'} class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high"/> :
      <div class="absolute inset-0" style={'background:linear-gradient(120deg,'+palette[3]+','+palette[2]+','+palette[1]+')'}>
        <div class="absolute inset-0 opacity-20" style="background:repeating-linear-gradient(115deg,transparent 0 33px,#fff4 34px,transparent 36px 70px)"></div>
      </div>}
    <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-transparent to-transparent"></div>
    <div class="absolute bottom-9 left-7 max-w-3xl text-paper md:bottom-12 md:left-12">
      <p class="text-xs uppercase tracking-[.25em]">Bauhu Interiors / Curated design</p>
      <h1 class="mt-4 font-display text-6xl md:text-8xl">{title}</h1>
      <p class="mt-3 max-w-xl text-base leading-7 text-paper/85">{description}</p>
    </div>
    {!hero&&<span class="absolute right-4 top-4 rounded-full bg-paper/90 px-3 py-2 text-xs text-ink">Hero photography in preparation</span>}
  </section>

  {!singleMoodboard&&<section class="grid gap-8 md:grid-cols-[.75fr_1.25fr] md:items-stretch">
    <div>
      <p class="eyebrow text-clay">The mood / one complete look</p>
      <h2 class="mt-5 font-display text-5xl leading-tight">Everything in harmony.</h2>
      <p class="mt-5 text-lg leading-8 text-ink/65">A considered combination of materials, colours and architectural details.</p>
      <div class="mt-7 grid h-12 grid-cols-4 overflow-hidden rounded-md">{palette.map(p=><div style={'background-color:'+p}></div>)}</div>
    </div>
    <div class="mx-auto w-full max-w-[540px] overflow-hidden rounded-xl bg-mist md:h-[340px]">
      {overall?<img src={overall} alt={title+' overall editorial material mood board'} class="aspect-[6/4] w-full object-cover md:aspect-auto md:h-full" loading="lazy"/>:
        boards.some(b=>b.image)?
        <div class="grid aspect-[6/4] grid-cols-[1.2fr_.8fr] grid-rows-2 gap-2 bg-mist p-3">
          {boards.filter(b=>b.image).slice(0,3).map((b,i)=><div class={i===0?'row-span-2 overflow-hidden rounded-sm':'overflow-hidden rounded-sm'}>
            <img src={b.image!} alt={b.title+' material styling'} loading="lazy" class="h-full w-full object-cover"/>
          </div>)}
        </div>:
        <div class="relative grid aspect-[6/4] grid-cols-[1.1fr_.8fr_.7fr] gap-2 overflow-hidden p-5" style={'background:'+palette[0]}>
          <div class="rounded-sm shadow-lg" style={'background:linear-gradient(130deg,'+palette[1]+',#ffffff22)'}></div>
          <div class="grid grid-rows-2 gap-2"><div class="rounded-sm shadow-lg" style={'background:'+palette[2]}></div><div class="rounded-sm bg-paper shadow-lg"></div></div>
          <div class="rounded-sm shadow-lg" style={'background:'+palette[3]}></div>
          <p class="absolute bottom-6 left-7 rounded bg-paper/90 px-3 py-2 text-xs text-ink/70">Overall mood board imagery in preparation</p>
        </div>}
    </div>
  </section>}

  {singleMoodboard&&<section class="mx-auto max-w-[1500px]"><img src={singleMoodboard} onerror={moodboardFallback ? "this.onerror=null;this.src="+JSON.stringify(moodboardFallback) : undefined} alt={title+" curated interior mood board, illustrative product and material selection"} class="w-full rounded-xl object-contain shadow-sm" loading="lazy"/><p class="mt-4 text-xs leading-5 text-ink/60">Curated design illustration. Exact manufacturer ranges and finishes are listed in the specification below and require confirmation.</p></section>}
  {!singleMoodboard&&<section>
    <div class="mb-6"><p class="eyebrow text-clay">The details / three considered boards</p><h2 class="mt-3 font-display text-4xl">The look, up close.</h2></div>
    <div class="grid gap-6 lg:grid-cols-3">
      {boards.map((b,bi)=><figure class="min-w-0">
        <div class="overflow-hidden rounded-xl bg-mist">
          {b.image?<div class="relative aspect-[4/5]">
            <img src={b.image} alt={title+' '+b.title+' product-specific mood board'} loading="lazy" class="absolute inset-0 h-full w-full object-cover"/>
            {schemeKey&&b.title==='Finishes'&&b.items?.some(item=>verifiedSupplierImage(item,schemeKey))&&
              <div class="absolute inset-y-0 left-0 w-[49%] overflow-y-auto bg-[#fbfaf7] p-3 md:p-4">
                <h3 class="font-display text-xl md:text-2xl">Finishes</h3>
                <p class="mt-1 text-[9px] uppercase tracking-widest text-ink/50">Manufacturer selections</p>
                <div class="mt-3 grid grid-cols-2 gap-2">
                  {b.items.filter(item=>['Floor tile','Wall tile','Walls and ceilings','Interior doors','Window and exterior door frames','Exterior render'].includes(item.slot||'')).map(item=>{
                    const isWallPaint=item.slot==='Walls and ceilings';
                    const product=isWallPaint?undefined:verifiedSupplierImage(item,schemeKey);
                    return <div class="min-w-0">
                      {isWallPaint?<div class="aspect-square overflow-hidden rounded-sm border border-stone/20" aria-label="Proposed wall paint palette, not exact paint mixing codes"><div class="grid h-full grid-cols-2"><div style={'background-color:'+palette[1]}></div><div style={'background-color:'+palette[2]}></div></div></div>:product?<a href={product.source} target="_blank" rel="noopener noreferrer" aria-label={'View '+product.supplier+' '+product.variant+' on manufacturer website'} class="block">
                        <div class="aspect-square overflow-hidden bg-white"><img src={product.image} alt={product.supplier+' '+product.variant} loading="lazy" class={'h-full w-full '+('cropFromBoard' in product ? 'object-cover object-left' : 'object-contain')} style={'cropFromBoard' in product ? 'transform:scale(1.85);transform-origin:left center' : undefined}/></div>
                      </a>:<div class="flex aspect-square items-center justify-center bg-stone/15 px-2 text-center text-[10px] text-ink/50">
                          {supplierCatalogueUrl(item)?<a href={supplierCatalogueUrl(item)} target="_blank" rel="noopener noreferrer" class="flex h-full w-full flex-col items-center justify-center gap-1 text-ink/70 underline underline-offset-2">
                            <span>View Kitbanho</span><span>catalogue photo ↗</span>
                          </a>:<span>Photo pending</span>}
                        </div>}
                      <p class="mt-1 truncate text-[9px] uppercase text-ink/60">{isWallPaint?'Wall paint palette':item.slot}</p>
                      <p class="truncate text-[10px] font-medium">{isWallPaint?'Curated collection colours · indicative':product?product.supplier+' '+product.variant:item.range}</p>
                    </div>
                  })}
                </div>
                <p class="mt-4 text-[9px] leading-4 text-ink/55">Official model photographs; finish selection subject to approval.</p>
              </div>}
            {schemeKey&&b.title==='Kitchens'&&b.items?.some(item=>verifiedSupplierImage(item,schemeKey))&&
              <div class="absolute inset-y-0 left-0 w-[49%] overflow-y-auto bg-[#fbfaf7] p-3 md:p-4">
                <h3 class="font-display text-xl md:text-2xl">Kitchens</h3>
                <p class="mt-1 text-[9px] uppercase tracking-widest text-ink/50">Manufacturer photography</p>
                <div class="mt-3 grid grid-cols-2 gap-2">
                  {b.items.filter(item=>['Kitchen front','Kitchen handles','Countertop','Kitchen sink','Kitchen faucet'].includes(item.slot||'')).map(item=>{
                    const product=verifiedSupplierImage(item,schemeKey);
                    return <div class="min-w-0">
                      {product?<a href={product.source} target="_blank" rel="noopener noreferrer" class="block" aria-label={'View '+product.supplier+' '+product.variant+' on manufacturer website'}>
                        <div class="aspect-square overflow-hidden bg-white"><img src={product.image} alt={product.supplier+' '+product.variant} loading="lazy" class="h-full w-full object-contain"/></div>
                      </a>:<div class="flex aspect-square items-center justify-center bg-stone/15 px-2 text-center text-[10px] text-ink/50">Reference pending</div>}
                      <p class="mt-1 truncate text-[9px] uppercase text-ink/60">{item.slot}</p>
                      <p class="truncate text-[10px] font-medium">{product?product.supplier+' '+product.variant:item.range}</p>
                    </div>
                  })}
                </div>
                <p class="mt-4 text-[9px] leading-4 text-ink/55">Supplier photography · chosen variants pending final project approval</p>
              </div>}
            {schemeKey&&b.title==='Bathrooms'&&b.items?.some(item=>verifiedSupplierImage(item,schemeKey))&&
              <div class="absolute inset-y-0 left-0 w-[49%] overflow-y-auto bg-[#fbfaf7] p-3 md:p-4">
                <h3 class="font-display text-xl md:text-2xl">Bathrooms</h3>
                <p class="mt-1 text-[9px] uppercase tracking-widest text-ink/50">Manufacturer selections</p>
                <div class="mt-3 grid grid-cols-2 gap-2">
                  {b.items.filter(item=>['Vanity','Basin','Basin faucet','Shower faucet','Bathroom wall tile'].includes(item.slot||'')).map(item=>{
                    const product=verifiedSupplierImage(item,schemeKey);
                    return <div class="min-w-0">
                      {product?<a href={product.source} target="_blank" rel="noopener noreferrer" aria-label={'View '+product.supplier+' '+product.variant+' on manufacturer website'} class="block">
                        <div class="aspect-square overflow-hidden bg-white"><img src={product.image} alt={product.supplier+' '+product.variant} loading="lazy" class="h-full w-full object-contain"/></div>
                      </a>:<div class="flex aspect-square items-center justify-center bg-stone/15 px-2 text-center text-[10px] text-ink/50">
                          {supplierCatalogueUrl(item)?<a href={supplierCatalogueUrl(item)} target="_blank" rel="noopener noreferrer" class="flex h-full w-full flex-col items-center justify-center gap-1 text-ink/70 underline underline-offset-2"><span>View supplier</span><span>collection ↗</span></a>:<span>Photo pending</span>}
                        </div>}
                      <p class="mt-1 truncate text-[9px] uppercase text-ink/60">{item.slot}</p>
                      <p class="truncate text-[10px] font-medium">{product?product.supplier+' '+product.variant:item.range}</p>
                    </div>
                  })}
                </div>
                <p class="mt-4 text-[9px] leading-4 text-ink/55">Verified manufacturer images only. Exact selections subject to final approval.</p>
              </div>}
            {b.items?.length&&!useImageEmbeddedLabels&&<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 via-ink/70 to-transparent px-5 pb-5 pt-14 text-paper">
              <p class="text-[10px] uppercase tracking-[.2em] text-paper/75">{b.title} / supplier selections</p>
              <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2">
                {b.items.filter(item=>!['Exterior render','Shower faucet','Shower enclosure','Toilet'].includes(item.slot||'')).slice(0,4).map(item=><div class="min-w-0">
                  <p class="truncate text-[10px] uppercase tracking-wide text-paper/75">{item.slot}</p>
                  <p class="mt-0.5 truncate text-xs font-medium">{item.supplier} · {item.range}</p>
                </div>)}
              </div>
            </div>}
          </div>:
            <div class="grid aspect-[4/5] grid-cols-2 gap-2 p-4">
              {(b.items||[]).slice(0,4).map((i,index)=><div class="flex items-end overflow-hidden rounded-sm p-3 shadow-sm" style={'background-color:'+palette[(index+bi)%palette.length]}>
                <span class="rounded-sm bg-paper/80 px-2 py-2 text-[11px] leading-4 text-ink/80">{i.range||i.slot}</span>
              </div>)}
              <p class="col-span-2 text-xs text-ink/55">Photography in preparation</p>
            </div>}
        </div>
        {!useImageEmbeddedLabels&&<figcaption class="mt-5">
          <h3 class="font-display text-4xl">{b.title}</h3>
          <p class="mt-2 text-sm leading-6 text-ink/60">{b.subtitle}</p>
        </figcaption>}
      </figure>)}
    </div>
  </section>}
  {preview&&!singleMoodboard&&<p class="text-xs leading-6 text-ink/50">Design-stage material colour study. Illustrative colours and textures are not manufacturer samples. Final photographic hero and mood boards to follow.</p>}
</div>
