---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { eyebrow, title, text, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---
<section class="relative min-h-[88svh] overflow-hidden bg-ink text-paper">
  <div class="absolute inset-0 opacity-40">
    <div class="h-full w-full bg-[radial-gradient(circle_at_65%_25%,rgba(217,210,197,0.28),transparent_34%),linear-gradient(135deg,#171716_0%,#243A32_58%,#9A765E_100%)]"></div>
  </div>
  <div class="relative mx-auto flex min-h-[88svh] max-w-site items-end px-5 pb-16 pt-32 lg:px-10 lg:pb-24">
    <div class="max-w-4xl">
      <p class="eyebrow mb-6 text-stone">{eyebrow}</p>
      <h1 class="font-display text-5xl leading-[0.95] tracking-tight md:text-7xl lg:text-8xl">{title}</h1>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-paper/78 md:text-xl">{text}</p>
      {(primaryHref || secondaryHref) && (
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          {primaryHref && <a class="rounded-full bg-paper px-6 py-3 text-sm font-medium uppercase tracking-wide text-ink" href={primaryHref}>{primaryLabel}</a>}
          {secondaryHref && <a class="rounded-full border border-paper/40 px-6 py-3 text-sm font-medium uppercase tracking-wide text-paper" href={secondaryHref}>{secondaryLabel}</a>}
        </div>
      )}
    </div>
  </div>
</section>
