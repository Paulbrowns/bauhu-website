---
const year = new Date().getFullYear();
---
<footer class="bg-ink text-paper">
  <div class="mx-auto grid max-w-site gap-10 px-5 py-14 lg:grid-cols-[1.35fr_1fr_1fr_1fr] lg:px-10">
    <div>
      <p class="font-display text-3xl tracking-[0.18em]">BAUHU</p>
      <p class="mt-5 max-w-md text-sm leading-7 text-paper/70">Architect designed, precision engineered.</p>
      <a class="mt-7 inline-flex rounded-full border border-paper/35 px-5 py-3 text-xs uppercase tracking-wide text-paper transition hover:bg-paper hover:text-ink" href="/site-fit">Have a site in mind? Start your project →</a>
    </div>
    <nav class="text-sm text-paper/75" aria-label="Footer explore navigation">
      <p class="eyebrow mb-3 text-paper">Explore</p>
      <div class="grid gap-1 lg:gap-0 lg:leading-8">
        <a class="block py-2 hover:text-white lg:py-0" href="/residences">Custom Design</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/models">Home Models</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/remote-locations">Remote Locations</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/projects">Projects</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/engineering">Engineering</a>
      </div>
    </nav>
    <nav class="text-sm text-paper/75" aria-label="Footer begin navigation">
      <p class="eyebrow mb-3 text-paper">Begin</p>
      <div class="grid gap-1 lg:gap-0 lg:leading-8">
        <a class="block py-2 hover:text-white lg:py-0" href="/site-fit">Start your project</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/resources">Resources</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/how-it-works">How it works</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/privacy">Privacy Notice</a>
      </div>
    </nav>
    <div class="text-sm text-paper/75">
      <p class="eyebrow mb-3 text-paper">Contact</p>
      <div class="grid gap-1 lg:gap-0 lg:leading-8">
        <a class="block py-2 hover:text-white lg:py-0" href="mailto:contact@bauhu.com">contact@bauhu.com</a>
        <a class="block py-2 hover:text-white lg:py-0" href="tel:+447949345478">+44 7949 345 478</a>
      </div>
      <div class="mt-5 flex flex-wrap gap-3 text-xs uppercase tracking-wide text-paper/60">
        <a class="hover:text-white" href="https://www.instagram.com/bauhuhomes/" rel="noopener noreferrer" target="_blank">Instagram</a>
        <a class="hover:text-white" href="https://www.facebook.com/bauhu.co.uk/" rel="noopener noreferrer" target="_blank">Facebook</a>
        <a class="hover:text-white" href="https://www.linkedin.com/company/bauhu" rel="noopener noreferrer" target="_blank">LinkedIn</a>
      </div>
    </div>
  </div>
  <nav class="border-t border-paper/10 px-5 py-5 text-xs text-paper/45 lg:px-10" aria-label="Specialist Bauhu routes">
    <div class="mx-auto flex max-w-site flex-wrap gap-x-5 gap-y-2">
      <span class="uppercase tracking-wide text-paper/35">Specialist routes</span>
      <a class="hover:text-white" href="/off-the-shelf-modular-homes">Off-the-shelf modular homes</a>
      <a class="hover:text-white" href="/steel-frame-home-kits">Steel frame home kits</a>
      <a class="hover:text-white" href="/bespoke-modular-homes">Bespoke modular homes</a>
      <a class="hover:text-white" href="/modular-residential-projects">Modular residential projects</a>
    </div>
  </nav>
  <div class="border-t border-paper/10 px-5 py-5 text-xs text-paper/50 lg:px-10">© {year} Bauhu. All rights reserved.</div>
</footer>
