---
const year = new Date().getFullYear();
---
<footer class="bg-ink text-paper">
  <div class="mx-auto grid max-w-site gap-10 px-5 py-14 lg:grid-cols-[1.4fr_1fr_1fr] lg:px-10">
    <div>
      <p class="font-display text-3xl tracking-[0.18em]">BAUHU</p>
      <p class="mt-5 max-w-md text-sm leading-7 text-paper/70">Architect designed, precision engineered.</p>
    </div>
    <nav class="text-sm text-paper/75" aria-label="Footer explore navigation">
      <p class="eyebrow mb-3 text-paper">Explore</p>
      <div class="grid gap-1 lg:gap-0 lg:leading-8">
        <a class="block py-2 hover:text-white lg:py-0" href="/residences">Custom Design</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/models">Home Models</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/projects">Projects</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/engineering">Engineering</a>
      </div>
    </nav>
    <nav class="text-sm text-paper/75" aria-label="Footer begin navigation">
      <p class="eyebrow mb-3 text-paper">Begin</p>
      <div class="grid gap-1 lg:gap-0 lg:leading-8">
        <a class="block py-2 hover:text-white lg:py-0" href="/site-fit">Start your project</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/resources">Resources</a>
        <a class="block py-2 hover:text-white lg:py-0" href="/how-it-works">How it works</a>
      </div>
    </nav>
  </div>
  <div class="border-t border-paper/10 px-5 py-5 text-xs text-paper/50 lg:px-10">© {year} Bauhu. All rights reserved.</div>
</footer>
