---
const links = [
  ['/', 'Home'],
  ['/residences', 'Residences'],
  ['/models', 'Models'],
  ['/developments', 'Developments'],
  ['/how-it-works', 'How it works'],
  ['/projects', 'Projects'],
  ['/engineering', 'Engineering'],
  ['/resources', 'Resources'],
  ['/start-your-project', 'Start your project'],
];
---
<details class="relative xl:hidden">
  <summary class="flex h-10 w-10 cursor-pointer list-none flex-col items-center justify-center gap-1 rounded-full border border-paper/30 marker:hidden" aria-label="Open navigation menu">
    <span class="block h-px w-5 bg-paper"></span>
    <span class="block h-px w-5 bg-paper"></span>
    <span class="block h-px w-5 bg-paper"></span>
  </summary>
  <div class="absolute right-0 top-12 w-72 bg-ink p-5 shadow-xl">
    {links.map(([href, label]) => (
      <a href={href} class="block border-b border-paper/10 py-3 text-base">{label}</a>
    ))}
  </div>
</details>
