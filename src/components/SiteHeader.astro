---
import MobileMenu from './MobileMenu.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/residences', label: 'Residences' },
  { href: '/models', label: 'Models' },
  { href: '/remote-locations', label: 'Remote Locations' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/projects', label: 'Projects' },
  { href: '/engineering', label: 'Engineering' },
  { href: '/resources', label: 'Resources' },
];
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-ink/85 text-paper backdrop-blur-md">
  <div class="mx-auto flex max-w-site items-center justify-between px-5 py-4 lg:px-10">
    <a href="/" class="font-display text-2xl tracking-[0.22em]" aria-label="Bauhu home">BAUHU</a>
    <nav class="hidden items-center gap-5 text-xs uppercase tracking-wide xl:flex">
      {navItems.map((item) => <a class="transition hover:text-stone" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/site-fit" class="hidden rounded-full border border-paper/40 px-4 py-2 text-xs uppercase tracking-wide transition hover:bg-paper hover:text-ink sm:inline-flex">Start your project</a>
      <MobileMenu />
    </div>
  </div>
</header>
