---
import MobileMenu from './MobileMenu.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/residences', label: 'Custom Design' },
  { href: '/models', label: 'Home Models' },
  { href: '/remote-locations', label: 'Remote Locations' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/projects', label: 'Projects' },
  { href: '/engineering', label: 'Engineering' },
  { href: '/resources', label: 'Resources' },
];
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-navy/95 text-paper backdrop-blur-md">
  <div class="mx-auto flex max-w-site items-center justify-between px-5 py-4 lg:px-10">
    <a href="/" class="font-display text-2xl tracking-[0.22em]" aria-label="Bauhu home">BAUHU</a>
    <nav class="hidden items-center gap-5 text-xs uppercase tracking-wide xl:flex">
      {navItems.map((item) => <a class="transition hover:text-stone" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/site-fit" class="bauhu-magnetic-cta hidden rounded-full border px-5 py-3 text-xs uppercase tracking-wide sm:inline-flex" data-magnetic-cta>
        <span class="bauhu-magnetic-cta__glow" aria-hidden="true"></span>
        <span class="bauhu-magnetic-cta__label">Start your project</span>
        <span class="bauhu-magnetic-cta__arrow" aria-hidden="true">↗</span>
      </a>
      <MobileMenu />
    </div>
  </div>
</header>

<style>
  .bauhu-magnetic-cta {
    --mx: 0px;
    --my: 0px;
    --inner-x: 0px;
    --inner-y: 0px;
    --light-x: 50%;
    --light-y: 50%;
    position: relative;
    align-items: center;
    justify-content: center;
    gap: .85rem;
    min-height: 42px;
    isolation: isolate;
    overflow: hidden;
    border-color: rgba(246,243,236,.55);
    color: #f6f3ec;
    background: linear-gradient(120deg, #163e53, #205870 48%, #163e53);
    box-shadow: inset 0 1px rgba(255,255,255,.18), 0 2px 10px rgba(0,0,0,.09);
    transform: translate3d(var(--mx),var(--my),0);
    transition: transform 520ms cubic-bezier(.18,1.15,.32,1), box-shadow 320ms ease, border-color 320ms ease, background-color 320ms ease;
  }

  .bauhu-magnetic-cta::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at var(--light-x) var(--light-y), rgba(218,240,247,.52), rgba(137,196,218,.22) 32%, transparent 72%);
    transition: opacity 300ms ease;
  }
  .bauhu-magnetic-cta::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(110deg,transparent 21%,rgba(255,255,255,.26) 48%,transparent 77%);
    transform: translateX(-145%);
    transition: transform 850ms cubic-bezier(.16,.7,.2,1);
  }
  .bauhu-magnetic-cta__glow {
    position: absolute;
    inset: auto 12% -18px;
    height: 20px;
    background: #8dcbdf;
    filter: blur(17px);
    border-radius: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .bauhu-magnetic-cta__label,
  .bauhu-magnetic-cta__arrow {
    position: relative;
    display: inline-block;
    transform: translate3d(var(--inner-x),var(--inner-y),0);
    transition: transform 500ms cubic-bezier(.18,1.1,.32,1);
  }
  .bauhu-magnetic-cta__arrow {
    font-size: 1.3em;
    line-height: 1;
    transition: transform 500ms cubic-bezier(.18,1.1,.32,1);
  }
  .bauhu-magnetic-cta:hover {
    border-color: rgba(213,243,255,.98);
    box-shadow: inset 0 1px rgba(255,255,255,.3),0 6px 24px rgba(7,31,44,.3),0 0 0 3px rgba(129,205,232,.13);
  }
  .bauhu-magnetic-cta:hover::before,
  .bauhu-magnetic-cta:hover .bauhu-magnetic-cta__glow { opacity: 1; }
  .bauhu-magnetic-cta:hover::after { transform: translateX(145%); }
  .bauhu-magnetic-cta:hover .bauhu-magnetic-cta__arrow {
    transform: translate3d(calc(var(--inner-x) + 4px),calc(var(--inner-y) - 3px),0);
  }
  .bauhu-magnetic-cta:active { scale: .94; }
  .bauhu-magnetic-cta:focus-visible { outline: 2px solid #f6f3ec; outline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .bauhu-magnetic-cta,
    .bauhu-magnetic-cta__label,
    .bauhu-magnetic-cta__arrow { transform: none !important; transition: none !important; }
    .bauhu-magnetic-cta::after { display: none; }
  }
</style>

<script>
  const magneticCTA = document.querySelector<HTMLElement>('[data-magnetic-cta]');
  const pointerIsFine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const motionIsReduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (magneticCTA) {
    const reset = () => {
      magneticCTA.style.setProperty('--mx', '0px');
      magneticCTA.style.setProperty('--my', '0px');
      magneticCTA.style.setProperty('--inner-x', '0px');
      magneticCTA.style.setProperty('--inner-y', '0px');
      magneticCTA.style.setProperty('--light-x', '50%');
      magneticCTA.style.setProperty('--light-y', '50%');
    };
    const header = magneticCTA.closest('header');
    // Measure against its original position, avoiding feedback as the button moves.
    header?.addEventListener('pointermove', (event: PointerEvent) => {
      if (!pointerIsFine.matches || motionIsReduced.matches || event.pointerType !== 'mouse') {
        reset();
        return;
      }
      const rect = magneticCTA.getBoundingClientRect();
      const offsetX = parseFloat(magneticCTA.style.getPropertyValue('--mx')) || 0;
      const offsetY = parseFloat(magneticCTA.style.getPropertyValue('--my')) || 0;
      const cx = rect.left + rect.width / 2 - offsetX;
      const cy = rect.top + rect.height / 2 - offsetY;
      const dx = event.clientX - cx;
      const dy = event.clientY - cy;
      const distance = Math.hypot(dx,dy);
      const radius = 160;
      if (distance >= radius) { reset(); return; }
      const intensity = Math.pow(1 - distance / radius, 1.5);
      const moveX = Math.max(-17,Math.min(17,dx * intensity * .4));
      const moveY = Math.max(-12,Math.min(12,dy * intensity * .35));
      magneticCTA.style.setProperty('--mx', `${moveX.toFixed(2)}px`);
      magneticCTA.style.setProperty('--my', `${moveY.toFixed(2)}px`);
      magneticCTA.style.setProperty('--inner-x', `${(moveX*.42).toFixed(2)}px`);
      magneticCTA.style.setProperty('--inner-y', `${(moveY*.42).toFixed(2)}px`);
      magneticCTA.style.setProperty('--light-x', `${(50 + dx/rect.width*90).toFixed(1)}%`);
      magneticCTA.style.setProperty('--light-y', `${(50 + dy/rect.height*80).toFixed(1)}%`);
    });
    header?.addEventListener('pointerleave', reset);
    magneticCTA.addEventListener('blur', reset);
    pointerIsFine.addEventListener('change', reset);
    motionIsReduced.addEventListener('change', reset);

    // An architectural plan unfolds down and left from the top-right CTA.
    // The overlay sits beneath the fixed header, never obstructing clicks.
    let navigating = false;
    magneticCTA.addEventListener('click', (event: MouseEvent) => {
      if (
        event.defaultPrevented || navigating || event.button !== 0 ||
        event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
        motionIsReduced.matches
      ) return;
      const href = magneticCTA.getAttribute('href');
      if (!href) return;
      event.preventDefault();
      navigating = true;
      const canvas = document.createElement('canvas');
      canvas.setAttribute('aria-hidden', 'true');
      canvas.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;z-index:49;pointer-events:none;';
      document.body.appendChild(canvas);
      const ctx = canvas.getContext('2d');
      if (!ctx) { canvas.remove(); window.location.assign(href); return; }

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const width = window.innerWidth;
      const height = window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const buttonRect = magneticCTA.getBoundingClientRect();
      const originX = buttonRect.left + buttonRect.width * .45;
      const originY = buttonRect.bottom + 12;
      const planWidth = Math.min(540, width * .56, Math.max(185, originX - 35));
      const planHeight = Math.min(365, height * .57);
      const x = originX - planWidth;
      const y = originY + 28;
      const w = planWidth;
      const h = planHeight;
      const duration = 1950;
      const startTime = performance.now();
      const clamp = (v: number) => Math.max(0, Math.min(1, v));
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      // Segments have individual reveal windows, rather than drawing as one beam.
      const segments: Array<[number, number, number, number, number, number, number]> = [
        // outline: begins near the button and expands towards page centre
        [x+w,y,x,y,.04,.36,1.8],
        [x+w,y,x+w,y+h,.08,.39,1.8],
        [x,y,x,y+h,.26,.55,1.8],
        [x+w,y+h,x,y+h,.32,.62,1.8],
        // walls form rooms and a hallway
        [x+w*.61,y,x+w*.61,y+h*.59,.28,.53,1.5],
        [x+w*.61,y+h*.72,x+w*.61,y+h,.40,.62,1.5],
        [x,y+h*.53,x+w*.35,y+h*.53,.33,.56,1.5],
        [x+w*.47,y+h*.53,x+w*.61,y+h*.53,.40,.60,1.5],
        [x+w*.61,y+h*.38,x+w,y+h*.38,.42,.65,1.5],
        [x+w*.78,y+h*.38,x+w*.78,y+h*.75,.49,.70,1.3],
        // door openings / window lines
        [x+w*.61+8,y+h*.59,x+w*.61+35,y+h*.59,.57,.74,.85],
        [x+w*.35,y+h*.53-15,x+w*.35,y+h*.53+12,.52,.70,.85],
        [x+w*.10,y+8,x+w*.40,y+8,.45,.65,.8],
        [x+w*.10,y+14,x+w*.40,y+14,.48,.68,.8],
        // architectural guides extend beyond the plan
        [x-20,y,x+w+14,y,.12,.42,.65],
        [x,y-20,x,y+h+22,.25,.57,.65],
        [x+w+18,y,x+w+18,y+h+20,.38,.70,.65],
      ];

      const drawSegment = (seg: typeof segments[number], p: number, alpha: number) => {
        const [ax,ay,bx,by,begin,finish,weight] = seg;
        const t = ease(clamp((p-begin)/(finish-begin)));
        if (!t) return;
        ctx.strokeStyle = `rgba(193,231,245,${alpha})`;
        ctx.lineWidth = weight;
        ctx.beginPath();
        ctx.moveTo(ax,ay);
        ctx.lineTo(ax+(bx-ax)*t,ay+(by-ay)*t);
        ctx.stroke();
      };
      const dimension = (ax:number, ay:number, bx:number, by:number, label:string, vertical:boolean, a:number) => {
        ctx.strokeStyle = `rgba(230,244,248,${a*.92})`;
        ctx.fillStyle = `rgba(230,244,248,${a})`;
        ctx.lineWidth = .85;
        ctx.beginPath(); ctx.moveTo(ax,ay); ctx.lineTo(bx,by); ctx.stroke();
        const tick = 5;
        ctx.beginPath();
        if (vertical) {
          ctx.moveTo(ax-tick,ay-tick); ctx.lineTo(ax+tick,ay+tick);
          ctx.moveTo(bx-tick,by-tick); ctx.lineTo(bx+tick,by+tick);
        } else {
          ctx.moveTo(ax-tick,ay+tick); ctx.lineTo(ax+tick,ay-tick);
          ctx.moveTo(bx-tick,by+tick); ctx.lineTo(bx+tick,by-tick);
        }
        ctx.stroke();
        ctx.font = '10px ui-monospace, SFMono-Regular, monospace';
        ctx.textAlign = 'center';
        if (vertical) {
          ctx.save();
          ctx.translate(ax-10,(ay+by)/2);
          ctx.rotate(-Math.PI/2);
          ctx.fillText(label,0,0);
          ctx.restore();
        } else {
          ctx.fillText(label,(ax+bx)/2,ay-7);
        }
      };

      const draw = (now: number) => {
        const p = clamp((now-startTime)/duration);
        const opacity = clamp(p*9) * clamp((1-p)*8);
        ctx.clearRect(0,0,width,height);
        ctx.save();
        // Shadow makes the blueprint legible over light or photographic backgrounds.
        ctx.shadowColor = 'rgba(15,55,74,.85)';
        ctx.shadowBlur = 5;
        for (const segment of segments) drawSegment(segment,p,opacity*.97);
        ctx.restore();

        // Dimension strings arrive after the architectural geometry.
        const details = ease(clamp((p-.53)/.29)) * opacity;
        if (details > 0) {
          dimension(x,y-28,x+w,y-28,'12 400',false,details);
          dimension(x-28,y,x-28,y+h,'8 650',true,details);
          dimension(x+w+27,y+h*.38,x+w+27,y+h,'5 360',true,details*.8);
          dimension(x,y+h+23,x+w*.61,y+h+23,'7 600',false,details*.9);
          ctx.fillStyle = `rgba(223,244,248,${details*.95})`;
          ctx.font = '10px ui-monospace, SFMono-Regular, monospace';
          ctx.textAlign = 'left';
          ctx.fillText('01  /  CONCEPT PLAN',x+9,y+h*.96);
          ctx.fillText('LIVING',x+w*.16,y+h*.29);
          ctx.fillText('TERRACE',x+w*.69,y+h*.20);
          ctx.fillText('SUITE',x+w*.72,y+h*.61);
          // small architectural centre marks
          ctx.strokeStyle = `rgba(223,244,248,${details*.85})`;
          for (const [cx,cy] of [[x+w*.22,y+h*.25],[x+w*.82,y+h*.24]]) {
            ctx.beginPath();
            ctx.moveTo(cx-6,cy);ctx.lineTo(cx+6,cy);
            ctx.moveTo(cx,cy-6);ctx.lineTo(cx,cy+6);
            ctx.stroke();
          }
        }
        if (p < 1) requestAnimationFrame(draw);
        else canvas.remove();
      };
      requestAnimationFrame(draw);
      // Slightly longer pause lets visitors register the dimensioned drawing.
      window.setTimeout(() => window.location.assign(href), duration);
    });
  }
</script>
