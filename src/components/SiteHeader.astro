---
import MobileMenu from './MobileMenu.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/residences', label: 'Custom Design' },
  { href: '/models', label: 'Home Models' },
  { href: '/remote-locations', label: 'Remote Locations' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/projects', label: 'Projects' },
  { href: '/engineering', label: 'Engineering' },
  { href: '/resources', label: 'Resources' },
];
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-navy/95 text-paper backdrop-blur-md">
  <div class="mx-auto flex max-w-site items-center justify-between px-5 py-4 lg:px-10">
    <a href="/" class="font-display text-2xl tracking-[0.22em]" aria-label="Bauhu home">BAUHU</a>
    <nav class="hidden items-center gap-5 text-xs uppercase tracking-wide xl:flex">
      {navItems.map((item) => <a class="transition hover:text-stone" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/site-fit" class="bauhu-magnetic-cta hidden border px-5 py-3 text-xs uppercase tracking-wide sm:inline-flex" data-magnetic-cta>
        <span class="bauhu-magnetic-cta__frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="bauhu-magnetic-cta__label">Start your project</span>
        <span class="bauhu-magnetic-cta__arrow" aria-hidden="true">↗</span>
      </a>
      <MobileMenu />
    </div>
  </div>
</header>

<style>
  .bauhu-magnetic-cta {
    --magnetic-x: 0px;
    --magnetic-y: 0px;
    --content-x: 0px;
    --content-y: 0px;
    --spot-x: 50%;
    --spot-y: 50%;
    position: relative;
    isolation: isolate;
    align-items: center;
    justify-content: center;
    gap: .8rem;
    min-height: 44px;
    overflow: hidden;
    border-radius: 999px;
    border-color: rgba(246,243,236,.58);
    background: #173e54;
    color: #f6f3ec;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
    transform: translate3d(var(--magnetic-x),var(--magnetic-y),0);
    transition: transform 390ms cubic-bezier(.18,.95,.22,1.15),
      border-radius 480ms cubic-bezier(.18,.8,.25,1),
      background-color 260ms ease, border-color 260ms ease,
      box-shadow 260ms ease;
  }
  .bauhu-magnetic-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(circle at var(--spot-x) var(--spot-y),
      rgba(180,219,231,.31), transparent 65%);
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .bauhu-magnetic-cta__frame {
    position: absolute;
    inset: 5px;
    pointer-events: none;
    opacity: 0;
    transform: scale(.93);
    transition: opacity 290ms ease, transform 460ms cubic-bezier(.2,.8,.2,1);
  }
  .bauhu-magnetic-cta__frame i {
    position: absolute;
    width: 13px;
    height: 11px;
    border-color: rgba(231,245,250,.92);
    border-style: solid;
    border-width: 0;
  }
  .bauhu-magnetic-cta__frame i:nth-child(1) { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .bauhu-magnetic-cta__frame i:nth-child(2) { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
  .bauhu-magnetic-cta__frame i:nth-child(3) { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .bauhu-magnetic-cta__frame i:nth-child(4) { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }
  .bauhu-magnetic-cta__label,
  .bauhu-magnetic-cta__arrow {
    position: relative;
    display: inline-block;
    transform: translate3d(var(--content-x),var(--content-y),0);
    transition: transform 390ms cubic-bezier(.18,.95,.22,1.15);
  }
  .bauhu-magnetic-cta__arrow { font-size: 1.3em; line-height: 1; }
  .bauhu-magnetic-cta:hover,
  .bauhu-magnetic-cta:focus-visible {
    border-radius: 8px;
    border-color: rgba(235,249,253,.92);
    background-color: #20566d;
    box-shadow: 0 5px 20px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.14);
  }
  .bauhu-magnetic-cta:hover::before,
  .bauhu-magnetic-cta:focus-visible::before { opacity: 1; }
  .bauhu-magnetic-cta:hover .bauhu-magnetic-cta__frame,
  .bauhu-magnetic-cta:focus-visible .bauhu-magnetic-cta__frame {
    opacity: 1;
    transform: scale(1);
  }
  .bauhu-magnetic-cta:hover .bauhu-magnetic-cta__arrow {
    transform: translate3d(calc(var(--content-x) + 3px),calc(var(--content-y) - 3px),0);
  }
  .bauhu-magnetic-cta:active { scale: .96; }
  .bauhu-magnetic-cta:focus-visible { outline: 2px solid #f6f3ec; outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .bauhu-magnetic-cta,
    .bauhu-magnetic-cta__label,
    .bauhu-magnetic-cta__arrow,
    .bauhu-magnetic-cta__frame { transition: none !important; transform: none !important; }
  }
</style>

<script>
  const cta = document.querySelector<HTMLElement>('[data-magnetic-cta]');
  if (cta) {
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const reset = () => {
      cta.style.setProperty('--magnetic-x','0px');
      cta.style.setProperty('--magnetic-y','0px');
      cta.style.setProperty('--content-x','0px');
      cta.style.setProperty('--content-y','0px');
      cta.style.setProperty('--spot-x','50%');
      cta.style.setProperty('--spot-y','50%');
    };
    cta.closest('header')?.addEventListener('pointermove', (event: PointerEvent) => {
      if (!finePointer.matches || reducedMotion.matches || event.pointerType !== 'mouse') {
        reset();
        return;
      }
      const bounds = cta.getBoundingClientRect();
      const previousX = parseFloat(cta.style.getPropertyValue('--magnetic-x')) || 0;
      const previousY = parseFloat(cta.style.getPropertyValue('--magnetic-y')) || 0;
      const dx = event.clientX - (bounds.left + bounds.width / 2 - previousX);
      const dy = event.clientY - (bounds.top + bounds.height / 2 - previousY);
      const reach = 125;
      const distance = Math.hypot(dx,dy);
      if (distance >= reach) { reset(); return; }
      const influence = Math.pow(1 - distance / reach, 1.45);
      const x = Math.max(-11,Math.min(11,dx * .25 * influence));
      const y = Math.max(-8,Math.min(8,dy * .25 * influence));
      cta.style.setProperty('--magnetic-x', `${x.toFixed(2)}px`);
      cta.style.setProperty('--magnetic-y', `${y.toFixed(2)}px`);
      cta.style.setProperty('--content-x', `${(x*.38).toFixed(2)}px`);
      cta.style.setProperty('--content-y', `${(y*.38).toFixed(2)}px`);
      cta.style.setProperty('--spot-x', `${(50+dx/bounds.width*70).toFixed(1)}%`);
      cta.style.setProperty('--spot-y', `${(50+dy/bounds.height*65).toFixed(1)}%`);
    });
    cta.closest('header')?.addEventListener('pointerleave',reset);
    cta.addEventListener('blur',reset);
    finePointer.addEventListener('change',reset);
    reducedMotion.addEventListener('change',reset);
    // Native anchor navigation is intentionally left untouched.
  }
</script>
