---
import MobileMenu from './MobileMenu.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/residences', label: 'Custom Design' },
  { href: '/models', label: 'Home Models' },
  { href: '/remote-locations', label: 'Remote Locations' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/projects', label: 'Projects' },
  { href: '/engineering', label: 'Engineering' },
  { href: '/resources', label: 'Resources' },
];
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-navy/95 text-paper backdrop-blur-md">
  <div class="mx-auto flex max-w-site items-center justify-between px-5 py-4 lg:px-10">
    <a href="/" class="font-display text-2xl tracking-[0.22em]" aria-label="Bauhu home">BAUHU</a>
    <nav class="hidden items-center gap-5 text-xs uppercase tracking-wide xl:flex">
      {navItems.map((item) => <a class="transition hover:text-stone" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/site-fit" class="bauhu-magnetic-cta hidden rounded-full border px-5 py-3 text-xs uppercase tracking-wide sm:inline-flex" data-magnetic-cta>
        <span class="bauhu-magnetic-cta__glow" aria-hidden="true"></span>
        <span class="bauhu-magnetic-cta__label">Start your project</span>
        <span class="bauhu-magnetic-cta__arrow" aria-hidden="true">↗</span>
      </a>
      <MobileMenu />
    </div>
  </div>
</header>

<style>
  .bauhu-magnetic-cta {
    --mx: 0px;
    --my: 0px;
    --inner-x: 0px;
    --inner-y: 0px;
    --light-x: 50%;
    --light-y: 50%;
    position: relative;
    align-items: center;
    justify-content: center;
    gap: .85rem;
    min-height: 42px;
    isolation: isolate;
    overflow: hidden;
    border-color: rgba(246,243,236,.55);
    color: #f6f3ec;
    background: linear-gradient(120deg, #163e53, #205870 48%, #163e53);
    box-shadow: inset 0 1px rgba(255,255,255,.18), 0 2px 10px rgba(0,0,0,.09);
    transform: translate3d(var(--mx),var(--my),0);
    transition: transform 520ms cubic-bezier(.18,1.15,.32,1), box-shadow 320ms ease, border-color 320ms ease, background-color 320ms ease;
  }

  .bauhu-magnetic-cta::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at var(--light-x) var(--light-y), rgba(218,240,247,.52), rgba(137,196,218,.22) 32%, transparent 72%);
    transition: opacity 300ms ease;
  }
  .bauhu-magnetic-cta::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(110deg,transparent 21%,rgba(255,255,255,.26) 48%,transparent 77%);
    transform: translateX(-145%);
    transition: transform 850ms cubic-bezier(.16,.7,.2,1);
  }
  .bauhu-magnetic-cta__glow {
    position: absolute;
    inset: auto 12% -18px;
    height: 20px;
    background: #8dcbdf;
    filter: blur(17px);
    border-radius: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .bauhu-magnetic-cta__label,
  .bauhu-magnetic-cta__arrow {
    position: relative;
    display: inline-block;
    transform: translate3d(var(--inner-x),var(--inner-y),0);
    transition: transform 500ms cubic-bezier(.18,1.1,.32,1);
  }
  .bauhu-magnetic-cta__arrow {
    font-size: 1.3em;
    line-height: 1;
    transition: transform 500ms cubic-bezier(.18,1.1,.32,1);
  }
  .bauhu-magnetic-cta:hover {
    border-color: rgba(213,243,255,.98);
    box-shadow: inset 0 1px rgba(255,255,255,.3),0 6px 24px rgba(7,31,44,.3),0 0 0 3px rgba(129,205,232,.13);
  }
  .bauhu-magnetic-cta:hover::before,
  .bauhu-magnetic-cta:hover .bauhu-magnetic-cta__glow { opacity: 1; }
  .bauhu-magnetic-cta:hover::after { transform: translateX(145%); }
  .bauhu-magnetic-cta:hover .bauhu-magnetic-cta__arrow {
    transform: translate3d(calc(var(--inner-x) + 4px),calc(var(--inner-y) - 3px),0);
  }
  .bauhu-magnetic-cta:active { scale: .94; }
  .bauhu-magnetic-cta:focus-visible { outline: 2px solid #f6f3ec; outline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .bauhu-magnetic-cta,
    .bauhu-magnetic-cta__label,
    .bauhu-magnetic-cta__arrow { transform: none !important; transition: none !important; }
    .bauhu-magnetic-cta::after { display: none; }
  }
</style>

<script>
  const magneticCTA = document.querySelector<HTMLElement>('[data-magnetic-cta]');
  const pointerIsFine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const motionIsReduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (magneticCTA) {
    const reset = () => {
      magneticCTA.style.setProperty('--mx', '0px');
      magneticCTA.style.setProperty('--my', '0px');
      magneticCTA.style.setProperty('--inner-x', '0px');
      magneticCTA.style.setProperty('--inner-y', '0px');
      magneticCTA.style.setProperty('--light-x', '50%');
      magneticCTA.style.setProperty('--light-y', '50%');
    };
    const header = magneticCTA.closest('header');
    // Measure against its original position, avoiding feedback as the button moves.
    header?.addEventListener('pointermove', (event: PointerEvent) => {
      if (!pointerIsFine.matches || motionIsReduced.matches || event.pointerType !== 'mouse') {
        reset();
        return;
      }
      const rect = magneticCTA.getBoundingClientRect();
      const offsetX = parseFloat(magneticCTA.style.getPropertyValue('--mx')) || 0;
      const offsetY = parseFloat(magneticCTA.style.getPropertyValue('--my')) || 0;
      const cx = rect.left + rect.width / 2 - offsetX;
      const cy = rect.top + rect.height / 2 - offsetY;
      const dx = event.clientX - cx;
      const dy = event.clientY - cy;
      const distance = Math.hypot(dx,dy);
      const radius = 160;
      if (distance >= radius) { reset(); return; }
      const intensity = Math.pow(1 - distance / radius, 1.5);
      const moveX = Math.max(-17,Math.min(17,dx * intensity * .4));
      const moveY = Math.max(-12,Math.min(12,dy * intensity * .35));
      magneticCTA.style.setProperty('--mx', `${moveX.toFixed(2)}px`);
      magneticCTA.style.setProperty('--my', `${moveY.toFixed(2)}px`);
      magneticCTA.style.setProperty('--inner-x', `${(moveX*.42).toFixed(2)}px`);
      magneticCTA.style.setProperty('--inner-y', `${(moveY*.42).toFixed(2)}px`);
      magneticCTA.style.setProperty('--light-x', `${(50 + dx/rect.width*90).toFixed(1)}%`);
      magneticCTA.style.setProperty('--light-y', `${(50 + dy/rect.height*80).toFixed(1)}%`);
    });
    header?.addEventListener('pointerleave', reset);
    magneticCTA.addEventListener('blur', reset);
    pointerIsFine.addEventListener('change', reset);
    motionIsReduced.addEventListener('change', reset);
  }
</script>
