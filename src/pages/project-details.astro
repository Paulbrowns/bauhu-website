---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Your Project | Bauhu" description="Tell Bauhu the essentials about your project, budget, timing and planning position.">
  <SiteHeader />
  <main class="journey-page">
    <header class="journey-header">
      <div><p class="kicker">START YOUR PROJECT</p><h1>Tell us about the project.</h1><p>A few practical details help us understand whether a model residence, private residence or development route is the right fit.</p></div>
      <aside><span>PROJECT JOURNEY</span><strong>2 of 4 · Project</strong><small>Next: choose or confirm the home.</small></aside>
    </header>

    <section class="journey-shell">
      <form id="project-details-form" class="journey-form">
        <div class="field-grid">
          <label><span>Where do you want to build?</span><input name="buildLocation" required placeholder="Island, country or location" /></label>
          <label><span>Project route</span><select name="route" required>
            <option value="">Choose one</option><option value="model">Model residence</option><option value="private">Private residence</option><option value="development">Development / multiple buildings</option><option value="unsure">Not sure yet</option>
          </select></label>
          <label><span>Intended use</span><select name="intendedUse" required>
            <option value="">Choose one</option><option>Primary home</option><option>Second / holiday home</option><option>Rental / investment</option><option>Hospitality</option><option>Development</option><option>Other</option>
          </select></label>
          <label><span>Bedrooms / scale</span><select name="bedrooms" required>
            <option value="">Choose one</option><option>1 bedroom</option><option>2 bedrooms</option><option>3 bedrooms</option><option>4 bedrooms</option><option>5+ bedrooms</option><option>Multiple buildings</option><option>Not sure yet</option>
          </select></label>
          <label><span>Land status</span><select name="landStatus" required>
            <option value="">Choose one</option><option>Owned</option><option>Under offer / purchase in progress</option><option>Site identified</option><option>Still looking for land</option>
          </select></label>
          <label><span>Planning / approvals</span><select name="planningStatus" required>
            <option value="">Choose one</option><option>Not started</option><option>Pre-application / early discussions</option><option>Application submitted</option><option>Approved</option><option>Not sure</option>
          </select></label>
          <label><span>Approximate project budget (USD)</span><select name="budget" required>
            <option value="">Choose a range</option><option>Under $250k</option><option>$250k–$500k</option><option>$500k–$1m</option><option>$1m–$2m</option><option>$2m+</option><option>Not established yet</option>
          </select></label>
          <label><span>Target start</span><select name="targetStart" required>
            <option value="">Choose one</option><option>As soon as possible</option><option>Within 6 months</option><option>6–12 months</option><option>12+ months</option><option>Researching only</option>
          </select></label>
          <label><span>Your role</span><select name="decisionRole" required>
            <option value="">Choose one</option><option>Decision maker</option><option>Joint decision maker</option><option>Architect / adviser</option><option>Developer / representative</option><option>Researching for someone else</option>
          </select></label>
        </div>
        <label><span>Anything important we should know? <em>Optional</em></span><textarea name="notes" rows="5" placeholder="Access, slope, views, local constraints, design priorities or anything else useful."></textarea></label>
        <div class="form-actions"><a href="/site-fit">← Back to site</a><button type="submit">Continue to home choice</button></div>
      </form>
      <aside class="journey-recap">
        <p class="kicker">SITE</p>
        <h2 id="site-title">No site selected yet</h2>
        <p id="site-copy">That is fine. Tell us the intended location and continue.</p>
        <a href="/site-fit">Edit site information</a>
        <div class="site-documents">
          <strong>Supporting documents <span>Optional</span></strong>
          <p>Add anything useful you already have — survey, site plan, planning documents, sketches or photographs.</p>
          <label class="upload-box" for="site-documents-input">
            <b>＋ Add files</b>
            <small>PDF, JPG, PNG or WEBP</small>
            <input id="site-documents-input" type="file" multiple accept=".pdf,image/jpeg,image/png,image/webp,application/pdf" />
          </label>
          <div id="site-documents-list" class="site-documents-list"></div>
        </div>
      </aside>
    </section>
  </main>
  <SiteFooter />

  <script is:inline>
    (() => {
      const form = document.getElementById('project-details-form');
      let site = {};
      let previous = {};
      let documentMeta = [];
      try { site = JSON.parse(localStorage.getItem('bauhuProjectSite') || '{}'); } catch {}
      try { previous = JSON.parse(localStorage.getItem('bauhuProjectDetails') || '{}'); } catch {}
      try { documentMeta = JSON.parse(localStorage.getItem('bauhuProjectDocuments') || '[]'); } catch {}

      if (site?.hasSite) {
        document.getElementById('site-title').textContent = site.place || 'Selected site';
        document.getElementById('site-copy').textContent = [site.parcel, site.area].filter(Boolean).join(' · ') || 'Location saved. Parcel details are optional.';
        form.elements.buildLocation.value = site.place || '';
      }
      const docInput = document.getElementById('site-documents-input');
      const docList = document.getElementById('site-documents-list');

      const saveDocumentMeta = () => {
        try { localStorage.setItem('bauhuProjectDocuments', JSON.stringify(documentMeta.map(({ id, name, size, type, lastModified }) => ({ id, name, size, type, lastModified })))); } catch {}
      };

      const renderDocuments = () => {
        if (!docList) return;
        docList.innerHTML = '';
        documentMeta.forEach((file) => {
          const row = document.createElement('div');
          row.className = 'site-document-row';
          row.innerHTML = `<span><strong>${file.name}</strong><small>${Math.max(1, Math.round(file.size / 1024))} KB</small></span><button type="button" data-id="${file.id || ''}">Remove</button>`;
          docList.appendChild(row);
        });
      };

      const loadStoredFiles = async () => {
        if (!window.BauhuEnquiryFiles) return;
        try {
          const stored = await window.BauhuEnquiryFiles.list();
          documentMeta = stored.map(({ id, name, size, type, lastModified }) => ({ id, name, size, type, lastModified }));
          saveDocumentMeta();
          renderDocuments();
        } catch {}
      };

      if (docInput) {
        docInput.addEventListener('change', async () => {
          const files = Array.from(docInput.files || []);
          if (!files.length) return;
          try {
            const stored = window.BauhuEnquiryFiles ? await window.BauhuEnquiryFiles.addFiles(files) : [];
            documentMeta = [
              ...documentMeta,
              ...stored.map(({ id, name, size, type, lastModified }) => ({ id, name, size, type, lastModified }))
            ];
            saveDocumentMeta();
            renderDocuments();
          } catch {}
          docInput.value = '';
        });
      }

      docList?.addEventListener('click', async (event) => {
        const button = event.target.closest('button[data-id]');
        if (!button) return;
        const id = button.dataset.id;
        if (id && window.BauhuEnquiryFiles) {
          try { await window.BauhuEnquiryFiles.remove(id); } catch {}
        }
        documentMeta = documentMeta.filter((file) => file.id !== id);
        saveDocumentMeta();
        renderDocuments();
      });

      loadStoredFiles();

      Object.entries(previous || {}).forEach(([key, value]) => {
        if (form.elements[key] && value) form.elements[key].value = value;
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const details = Object.fromEntries(new FormData(form).entries());
        try { localStorage.setItem('bauhuProjectDetails', JSON.stringify(details)); } catch {}
        location.assign('/project-home');
      });
    })();
  </script>
</BaseLayout>

<style>
.journey-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}.journey-header{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:4rem;padding:3.4rem 4vw 2.4rem;border-bottom:1px solid rgba(23,57,76,.18)}.kicker,.journey-header aside>span{margin:0 0 .8rem;font:700 .68rem/1 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#9b7b49}.journey-header h1{margin:0 0 1rem;font:400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif}.journey-header>div>p:last-child{max-width:760px;font:300 1rem/1.7 Inter,sans-serif;color:rgba(23,57,76,.7)}.journey-header aside{display:flex;flex-direction:column;justify-content:flex-end;gap:.45rem;padding-left:2rem;border-left:1px solid rgba(23,57,76,.18);font-family:Inter,sans-serif}.journey-header aside strong{font:400 1.8rem 'Cormorant Garamond',serif}.journey-shell{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:1rem;padding:2rem 4vw 4rem}.journey-form,.journey-recap{padding:1.5rem;background:#f7f5ef;border:1px solid rgba(23,57,76,.14)}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.journey-form label{display:block;margin-bottom:1rem}.journey-form label>span{display:block;margin-bottom:.45rem;font:700 .66rem Inter,sans-serif}.journey-form label em{font-style:normal;font-weight:400;color:rgba(23,57,76,.55)}.journey-form input,.journey-form select,.journey-form textarea{width:100%;box-sizing:border-box;padding:.88rem;border:1px solid rgba(23,57,76,.2);background:#fff;color:#17394c;font:400 .78rem Inter,sans-serif}.journey-form textarea{resize:vertical}.form-actions{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-top:.5rem}.form-actions a,.journey-recap a{color:#17394c;font:700 .68rem Inter,sans-serif}.form-actions button{padding:.95rem 1.2rem;border:0;background:#17394c;color:#fff;font:700 .7rem Inter,sans-serif}.journey-recap h2{margin:.2rem 0 .7rem;font:400 2rem 'Cormorant Garamond',serif}.journey-recap p:not(.kicker){font:400 .68rem/1.6 Inter,sans-serif;color:rgba(23,57,76,.65)}.site-documents{margin-top:1.5rem;padding-top:1.2rem;border-top:1px solid rgba(23,57,76,.14)}.site-documents>strong{display:flex;justify-content:space-between;gap:.5rem;font:700 .68rem Inter,sans-serif}.site-documents>strong span{font-weight:400;color:rgba(23,57,76,.5)}.site-documents>p{margin:.5rem 0 .8rem!important}.upload-box{display:grid!important;gap:.2rem;margin:0!important;padding:1rem;border:1px dashed rgba(23,57,76,.3);background:#fff;cursor:pointer;text-align:center}.upload-box b{font:700 .7rem Inter,sans-serif}.upload-box small{font:400 .6rem Inter,sans-serif;color:rgba(23,57,76,.55)}.upload-box input{position:absolute;opacity:0;pointer-events:none}.site-documents-list{display:grid;gap:.45rem;margin-top:.75rem}.site-document-row{display:flex;justify-content:space-between;gap:.6rem;align-items:center;padding:.7rem;background:#ece9df}.site-document-row span{min-width:0}.site-document-row strong,.site-document-row small{display:block;font-family:Inter,sans-serif}.site-document-row strong{overflow:hidden;text-overflow:ellipsis;font-size:.63rem}.site-document-row small{margin-top:.15rem;font-size:.55rem;color:rgba(23,57,76,.52)}.site-document-row button{border:0;background:none;color:#7c4037;font:700 .58rem Inter,sans-serif;cursor:pointer}@media(max-width:820px){.journey-header{grid-template-columns:1fr;gap:2rem}.journey-header aside{padding:1.3rem 0 0;border-left:0;border-top:1px solid rgba(23,57,76,.18)}.journey-shell{grid-template-columns:1fr}.journey-recap{grid-row:1}}@media(max-width:620px){.field-grid{grid-template-columns:1fr}.form-actions{align-items:stretch;flex-direction:column-reverse}.form-actions button{width:100%}}
</style>