---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Project Details | Bauhu" description="Send Bauhu your contact, project and confirmed site information.">
  <SiteHeader />
  <main class="enquiry-page">
    <header class="enquiry-header"><div><p class="kicker">START YOUR PROJECT · STEP 3</p><h1>Tell us what you want to build.</h1><p>Your site information is attached automatically. Add your contact details and the project information you already know.</p></div><aside><span>PROJECT ROUTE</span><strong>Final step</strong><small>1. Locate site ✓</small><small>2. Review summary ✓</small><small>3. Send project details</small></aside></header>
    <section class="enquiry-shell">
      <aside class="site-card"><p class="kicker">SITE ATTACHED</p><h2 id="site-name">Selected site</h2><dl><div><dt>Coordinates</dt><dd id="site-coordinates">—</dd></div><div><dt>Parcel</dt><dd id="site-parcel">Not supplied</dd></div><div><dt>Area</dt><dd id="site-area">Not supplied</dd></div><div><dt>Boundary</dt><dd id="site-boundary">Not supplied</dd></div></dl><a href="/site-summary">Review site summary</a></aside>
      <form id="project-form">
        <fieldset><legend>Your details</legend><div class="two"><label><span>Name *</span><input name="name" required autocomplete="name" /></label><label><span>Email *</span><input name="email" type="email" required autocomplete="email" /></label></div><div class="two"><label><span>Phone</span><input name="phone" autocomplete="tel" /></label><label><span>Country of residence</span><input name="country" /></label></div></fieldset>
        <fieldset><legend>The project</legend><label><span>What are you planning? *</span><select name="projectType" required><option value="">Choose one</option><option>Private residence</option><option>Private island residence</option><option>Resort or retreat</option><option>Remote development</option><option>Multiple residences / private collection</option><option>Other / not sure yet</option></select></label><div class="two"><label><span>Approximate budget</span><input name="budget" placeholder="e.g. US$2m–3m" /></label><label><span>Target programme</span><input name="programme" placeholder="e.g. Start Q2 2027" /></label></div><label><span>Project description *</span><textarea name="description" required rows="6" placeholder="Tell us what you want to build, approximate size, bedrooms or unit count, design ambitions and anything important about the site."></textarea></label></fieldset>
        <fieldset><legend>Site & project status</legend><div class="two"><label><span>Site ownership</span><select name="ownership"><option>Owned</option><option>Under contract / purchase in progress</option><option>Considering a site</option><option>Other</option></select></label><label><span>Planning / approvals</span><select name="planning"><option>Not started</option><option>Early discussions</option><option>Application in progress</option><option>Approved</option><option>Not sure</option></select></label></div><label><span>Anything else we should know?</span><textarea name="notes" rows="4" placeholder="Access, utilities, survey information, consultants already appointed, special requirements, etc."></textarea></label></fieldset>
        <button class="submit" type="submit">Send project to Bauhu</button><p id="form-status" class="status"></p>
      </form>
    </section>
  </main><SiteFooter />
  <script is:inline>
  (()=>{const $=id=>document.getElementById(id);let site={};try{site=JSON.parse(localStorage.getItem('bauhuSiteProject')||'{}')}catch{}if(!Number.isFinite(site.lat)||!Number.isFinite(site.lng)){location.replace('/site-fit');return}$('site-name').textContent=site.place||'Selected site';$('site-coordinates').textContent=`${site.lat}, ${site.lng}`;$('site-parcel').textContent=site.parcel||'Not supplied';$('site-area').textContent=site.area||'Not supplied';$('site-boundary').textContent=site.boundarySource||'Not supplied';$('project-form').onsubmit=async e=>{e.preventDefault();const status=$('form-status'),button=e.currentTarget.querySelector('.submit');button.disabled=true;status.textContent='Sending…';const customer=Object.fromEntries(new FormData(e.currentTarget).entries());try{const r=await fetch('/api/project-enquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({customer,site})});const data=await r.json();if(!r.ok)throw new Error(data.error||'Unable to send enquiry');status.textContent='Thank you. Your project information has been sent to Bauhu.';e.currentTarget.reset()}catch(err){status.textContent=err.message||'We could not send the enquiry. Please try again.'}finally{button.disabled=false}}})();
  </script>
</BaseLayout>
<style>
.enquiry-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}.enquiry-header{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:4rem;padding:3.4rem 4vw 2.4rem;border-bottom:1px solid rgba(23,57,76,.18)}.kicker,.enquiry-header aside>span{margin:0 0 .8rem;font:700 .68rem Inter,sans-serif;letter-spacing:.2em;color:#9b7b49}.enquiry-header h1{margin:0 0 1rem;font:400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif}.enquiry-header>div>p:last-child{max-width:760px;color:rgba(23,57,76,.7)}.enquiry-header aside{display:flex;flex-direction:column;justify-content:flex-end;gap:.45rem;padding-left:2rem;border-left:1px solid rgba(23,57,76,.18)}.enquiry-shell{display:grid;grid-template-columns:330px minmax(0,760px);gap:4rem;justify-content:center;padding:4rem 4vw 6rem}.site-card{padding:1.4rem;background:#f7f5ef;align-self:start}.site-card h2{font:400 2rem 'Cormorant Garamond',serif}.site-card dl div{display:flex;justify-content:space-between;gap:1rem;padding:.7rem 0;border-top:1px solid rgba(23,57,76,.13);font-size:.7rem}.site-card dd{margin:0;text-align:right;font-weight:700}.site-card a{display:block;margin-top:1rem;color:#17394c;font-weight:700}form{display:grid;gap:1.3rem}fieldset{display:grid;gap:1rem;margin:0;padding:1.4rem;border:1px solid rgba(23,57,76,.18);background:#f7f5ef}legend{padding:0 .5rem;font:400 1.65rem 'Cormorant Garamond',serif}.two{display:grid;grid-template-columns:1fr 1fr;gap:1rem}label span{display:block;margin-bottom:.4rem;font:700 .68rem Inter,sans-serif}input,select,textarea{width:100%;box-sizing:border-box;padding:.8rem;border:1px solid rgba(23,57,76,.22);background:#fff;color:#17394c}.submit{padding:1rem;border:0;background:#17394c;color:#fff;font-weight:700}.status{min-height:1.3rem;margin:0;font-size:.72rem}.submit:disabled{opacity:.55}@media(max-width:800px){.enquiry-header{grid-template-columns:1fr}.enquiry-header aside{border-left:0;padding-left:0}.enquiry-shell{grid-template-columns:1fr;gap:1.5rem}.two{grid-template-columns:1fr}}
</style>