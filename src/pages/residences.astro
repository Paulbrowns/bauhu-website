---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const designReferences = ['Jade', 'Amber', 'Serenity', 'Cap d\u2019Antibes', 'Moonstone', 'Casa Lavanda', 'Jimmy Hill'];

const safetyPoints = [
  ['Patented steel frame', 'A unique Bauhu construction system engineered to give the residence a precise, resilient structural core.'],
  ['Hurricane resistant thinking', 'Homes are designed for exposed coastal conditions, with safety and strength considered from the first sketch.'],
  ['Remote build logic', 'The system is specifically suited to hard to access locations where conventional building becomes slow and uncertain.'],
  ['Architect led specification', 'Experienced architects shape each residence around the client, the land, the view and the way the home will be lived in.'],
];

const difficultSites = [
  ['Remote Caribbean land', 'Private plots where access, shipping, local labour and sequencing need to be planned with care.'],
  ['Exposed coastal positions', 'Homes designed with wind, sun, salt air, corrosion, privacy and long term maintenance in mind.'],
  ['Spectacular view sites', 'Architecture that frames the horizon, opens to terraces and creates a calm relationship with the landscape.'],
];
---
<BaseLayout title="Private Luxury Residences | Bauhu" description="One of a kind luxury Bauhu residences designed by experienced architects for remote, coastal and hurricane exposed locations.">
  <SiteHeader />
  <main class="bg-ink text-paper">
    <section class="min-h-[92svh] px-5 pb-16 pt-36 lg:px-10 lg:pb-24">
      <div class="mx-auto grid min-h-[72svh] max-w-site gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
        <div>
          <p class="eyebrow text-stone">Bauhu Residences</p>
          <h1 class="mt-6 font-display text-5xl leading-[0.92] md:text-7xl lg:text-8xl">One of a kind luxury residences for remarkable remote sites.</h1>
        </div>
        <div>
          <img src="/images/residences/residences-hero-modern-villa.webp" alt="Modern Bauhu private residence with pool terrace" class="h-[62svh] min-h-[28rem] w-full object-cover" fetchpriority="high" />
          <p class="mt-6 max-w-2xl text-lg leading-8 text-paper/72">Custom designed homes by experienced architects, created around the client, the site, the view and the realities of building safely in remote Caribbean locations.</p>
        </div>
      </div>
    </section>

    <section class="border-t border-paper/10 px-5 py-24 lg:px-10 lg:py-32">
      <div class="mx-auto grid max-w-site gap-12 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="eyebrow text-stone">Beyond Modular</p>
          <h2 class="mt-5 font-display text-4xl leading-tight md:text-6xl">This is not a modular home catalogue. It is private architecture with a safer way to build.</h2>
        </div>
        <div class="space-y-7 text-lg leading-8 text-paper/70">
          <p>Bauhu is repositioned around custom designed luxury residences for clients who want a spectacular contemporary home in a difficult location. Each residence is shaped around personal requirements, lifestyle, privacy, orientation, view and the character of the land.</p>
          <p>Behind the architecture is Bauhu\u2019s unique patented steel frame construction system. It gives the residence a serious structural foundation and makes the project better suited to remote, hard to access and hurricane exposed sites.</p>
          <p>The result is not a standardised product. It is a one of a kind residence with architectural presence, engineered safety and a practical route to delivery.</p>
        </div>
      </div>
    </section>

    <section class="bg-paper px-5 py-24 text-ink lg:px-10 lg:py-32">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-clay">Design References</p>
        <div class="mt-6 grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <h2 class="font-display text-4xl leading-tight md:text-6xl">Spectacular contemporary architecture, refined for island living.</h2>
          <p class="text-lg leading-8 text-ink/70">The visual language should feel dramatic, luxurious and highly architectural. Think long horizontal lines, shaded terraces, glass, stone, water, privacy, calm interiors and homes that make the landscape feel cinematic.</p>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-3">
          <img src="/images/residences/residences-hero-modern-villa.webp" alt="Residence design reference" class="h-80 w-full object-cover" loading="lazy" />
          <img src="/images/model-placeholder.svg" alt="Terrace design reference" class="h-80 w-full object-cover" loading="lazy" />
          <img src="/images/residence-placeholder.svg" alt="Coastal site design reference" class="h-80 w-full object-cover" loading="lazy" />
        </div>
        <div class="mt-10 flex flex-wrap gap-3">
          {designReferences.map((item) => (
            <span class="rounded-full border border-ink/15 px-4 py-2 text-sm uppercase tracking-wide text-ink/65">{item}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 py-24 lg:px-10 lg:py-32">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-stone">Safe by Design</p>
        <h2 class="mt-5 max-w-4xl font-display text-4xl leading-tight md:text-6xl">Luxury is incomplete without safety, strength and certainty.</h2>
        <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {safetyPoints.map(([title, text], index) => (
            <article class="border border-paper/12 p-7">
              <p class="eyebrow text-stone">0{index + 1}</p>
              <h3 class="mt-14 font-display text-3xl">{title}</h3>
              <p class="mt-5 leading-7 text-paper/65">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-mist px-5 py-24 text-ink lg:px-10 lg:py-32">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-clay">Difficult Sites</p>
        <div class="mt-6 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <h2 class="font-display text-4xl leading-tight md:text-6xl">Built for places where ordinary construction is not enough.</h2>
          <p class="text-lg leading-8 text-ink/70">Remote Caribbean locations can be extraordinary, but they are rarely simple. Bauhu is designed for clients who want contemporary architectural luxury without ignoring wind, logistics, structure, access and safety.</p>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-3">
          {difficultSites.map(([title, text]) => (
            <article class="bg-paper p-7">
              <h3 class="font-display text-3xl">{title}</h3>
              <p class="mt-16 leading-7 text-ink/70">{text}</p>
            </article>
          ))}
        </div>
        <div class="mt-16 grid gap-8 bg-ink p-8 text-paper md:grid-cols-[1fr_auto] md:items-center lg:p-12">
          <div>
            <p class="eyebrow text-stone">Private Commission</p>
            <h2 class="mt-5 max-w-3xl font-display text-4xl leading-tight md:text-5xl">Begin with the land, the vision and the level of residence you want to create.</h2>
          </div>
          <a href="/start-your-project" class="inline-flex justify-center rounded-full bg-paper px-7 py-4 text-sm uppercase tracking-wide text-ink">Begin a private conversation</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
