---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Page Not Found | Bauhu" description="This page could not be found." noindex={true}>
  <SiteHeader />
  <main class="not-found">
    <p class="eyebrow">404 · PAGE NOT FOUND</p>
    <h1>We couldn't find that page.</h1>
    <p>The address may have changed, or the page may no longer exist.</p>
    <a href="/">Return to Bauhu home →</a>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .not-found { min-height: 60vh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; max-width: 1000px; margin: 0 auto; padding: 5rem 5vw; }
  .not-found .eyebrow { font-size: .7rem; letter-spacing: .15em; }
  .not-found h1 { font: 400 clamp(2.5rem, 6vw, 4.8rem)/1.1 Georgia, serif; margin: 1rem 0; }
  .not-found p { max-width: 36rem; }
  .not-found a { display: inline-block; margin-top: 1.5rem; text-decoration: underline; text-underline-offset: .3em; }
</style>
