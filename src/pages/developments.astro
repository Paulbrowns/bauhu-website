---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const developmentTypes = [
  {
    title: 'Multi family residences',
    text: 'Apartment buildings, condominium projects and residential clusters where design quality, buildability and repeatable structural logic matter equally.',
  },
  {
    title: 'Resort accommodation',
    text: 'Villas, guest residences, hotel keys, wellness retreats and branded resort accommodation designed for remote or coastal island locations.',
  },
  {
    title: 'Private estates',
    text: 'Multi building private compounds with principal residences, guest houses, staff accommodation, pavilions, wellness spaces and service buildings.',
  },
];

const advantages = [
  ['01', 'Architectural consistency', 'A coherent design language across multiple buildings, while allowing variation by unit type, orientation, view and level of privacy.'],
  ['02', 'Repeatable intelligence', 'The Bauhu system allows repeated structural logic across a development, reducing uncertainty without forcing every building to look the same.'],
  ['03', 'Remote site strategy', 'A better route for locations where labour, access, sequencing, shipping and weather exposure can make conventional construction difficult.'],
  ['04', 'Resilient island buildings', 'A development approach that takes hurricane exposure, corrosion, maintenance, shade, ventilation and long term operational reality seriously.'],
];

const process = [
  ['Masterplan review', 'We begin with the land, access, views, planning context, density targets and development ambition.'],
  ['Typology strategy', 'We define the right mix of apartments, villas, guest units, service buildings, amenity spaces or model residences.'],
  ['System design', 'The architectural and structural approach is rationalised so the development can be delivered with clarity and control.'],
  ['Phased delivery', 'Buildings can be planned around construction phases, logistics, sales strategy and operational priorities.'],
];
---
<BaseLayout title="Multi Family and Resort Developments | Bauhu" description="Bauhu designs and delivers multi family buildings, condominium projects, resort residences and multi building developments for remote and coastal locations.">
  <SiteHeader />
  <main class="developments-page">
    <section class="dev-hero">
      <div class="dev-hero-inner">
        <p class="dev-kicker">BAUHU Developments</p>
        <h1>Multi family buildings, resort residences and private development estates.</h1>
        <p>Bauhu applies its architectural and steel frame construction system to larger projects where design quality, resilience and repeatable build logic need to work together.</p>
        <a class="dev-button" href="/start-your-project">Discuss a development</a>
      </div>
    </section>

    <section class="dev-intro">
      <div class="dev-two-col">
        <div>
          <p class="dev-kicker">Beyond Single Homes</p>
          <h2>For developers, landowners and resort operators building in demanding locations.</h2>
        </div>
        <div class="dev-copy">
          <p>Some sites call for more than one residence. A condominium building, a small resort village, a collection of villas, or a private estate with several buildings all need a clear architectural vision and a disciplined method of delivery.</p>
          <p>Bauhu is particularly suited to remote Caribbean developments where access, labour, weather exposure, structural safety and long term maintenance need to be considered from the start.</p>
        </div>
      </div>
    </section>

    <section class="dev-types-section">
      <div class="dev-types-inner">
        <p class="dev-kicker">Development Types</p>
        <h2>One system, multiple building strategies.</h2>
        <div class="dev-types-grid">
          {developmentTypes.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="dev-quote-section">
      <div class="dev-quote-inner">
        <p class="dev-quote">For larger projects, Bauhu brings architectural ambition and construction discipline into <em>one integrated development approach.</em></p>
      </div>
    </section>

    <section class="dev-advantages-section">
      <div class="dev-advantages-inner">
        <p class="dev-kicker">Why Bauhu for Developments</p>
        <div class="dev-advantages-grid">
          {advantages.map(([number, title, text]) => (
            <article>
              <strong>{number}</strong>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="dev-process-section">
      <div class="dev-process-inner">
        <div>
          <p class="dev-kicker">Development Route</p>
          <h2>From land and feasibility to a buildable architectural strategy.</h2>
        </div>
        <div class="dev-process-list">
          {process.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="dev-cta-section">
      <h2>Planning a multi building project?</h2>
      <p>Send us the location, site information, intended number of units or buildings, target market and broad development ambition. We can help assess whether Bauhu is the right route.</p>
      <a class="dev-button" href="/start-your-project">Start a Development Conversation</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  :global(html), :global(body) { overflow-x:hidden !important; }
  .developments-page { background:#050505; color:#f8f6f0; overflow:hidden; font-family:Inter, system-ui, sans-serif; font-weight:300; font-synthesis:none; }
  .developments-page * { box-sizing:border-box; }
  .dev-hero { position:relative; min-height:90vh; display:flex; align-items:flex-end; padding:120px 7vw 100px; background:linear-gradient(180deg, rgba(0,0,0,.28), rgba(0,0,0,.9)), url('/images/developments/bauhu-resort-developments-hero.webp') center/cover no-repeat; overflow:hidden; }
  .dev-hero-inner, .dev-two-col, .dev-types-inner, .dev-quote-inner, .dev-advantages-inner, .dev-process-inner { max-width:1500px; margin:0 auto; width:100%; }
  .dev-hero-inner { position:relative; z-index:2; }
  .dev-kicker { color:#c8a96a; text-transform:uppercase; letter-spacing:.22em; font-size:12px; margin:0 0 22px; font-weight:500; }
  .dev-hero h1, .dev-intro h2, .dev-types-section h2, .dev-quote, .dev-process-section h2, .dev-cta-section h2 { font-family:"Cormorant Garamond", Georgia, serif; font-weight:400; color:#f8f6f0; letter-spacing:-.055em; }
  .dev-hero h1 { max-width:1160px; font-size:clamp(46px,7.4vw,112px); line-height:.9; margin:0 0 28px; }
  .dev-hero p { max-width:820px; font-size:clamp(19px,2vw,28px); line-height:1.35; color:rgba(248,246,240,.76); margin:0; }
  .dev-button { display:inline-block; margin-top:34px; padding:15px 24px; border:1px solid #c8a96a; color:#f8f6f0; text-decoration:none; text-transform:uppercase; letter-spacing:.16em; font-size:12px; transition:all .3s ease; }
  .dev-button:hover { background:#c8a96a; color:#050505; }
  .dev-intro { padding:110px 7vw; background:#050505; }
  .dev-two-col { display:grid; grid-template-columns:1.1fr .9fr; gap:64px; align-items:center; }
  .dev-intro h2, .dev-types-section h2, .dev-process-section h2, .dev-cta-section h2 { font-size:clamp(44px,7vw,104px); line-height:.92; margin:0; }
  .dev-copy p { font-size:17px; line-height:1.75; color:rgba(248,246,240,.66); margin:0 0 22px; }
  .dev-types-section { padding:95px 7vw 110px; background:#0a0a0a; }
  .dev-types-section h2 { max-width:980px; }
  .dev-types-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:22px; margin-top:54px; }
  .dev-types-grid article { border:1px solid rgba(255,255,255,.16); min-height:300px; padding:38px; background:linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.01)); }
  .dev-types-grid h3, .dev-advantages-grid h3, .dev-process-list h3 { font-family:"Cormorant Garamond", Georgia, serif; font-size:clamp(28px,2.6vw,42px); line-height:1.05; font-weight:400; letter-spacing:-.035em; margin:0 0 22px; color:#f8f6f0; }
  .dev-types-grid p, .dev-advantages-grid p, .dev-process-list p { color:rgba(248,246,240,.62); line-height:1.65; margin:0; }
  .dev-quote-section { padding:120px 7vw 90px; background:#050505; }
  .dev-quote { font-size:clamp(36px,5.4vw,82px); line-height:1.02; max-width:1180px; margin:0; }
  .dev-quote em { color:#c8a96a; font-style:normal; }
  .dev-advantages-section { padding:30px 7vw 120px; background:#050505; }
  .dev-advantages-grid { display:grid; grid-template-columns:repeat(4, 1fr); border-top:1px solid rgba(255,255,255,.16); border-bottom:1px solid rgba(255,255,255,.16); }
  .dev-advantages-grid article { padding:34px 22px; border-right:1px solid rgba(255,255,255,.16); }
  .dev-advantages-grid article:last-child { border-right:0; }
  .dev-advantages-grid strong { color:#c8a96a; font-size:13px; letter-spacing:.16em; }
  .dev-advantages-grid h3 { font-size:32px; margin:24px 0 18px; }
  .dev-process-section { padding:110px 7vw; background:#0a0a0a; }
  .dev-process-inner { display:grid; grid-template-columns:.95fr 1.05fr; gap:64px; align-items:start; }
  .dev-process-list { border-top:1px solid rgba(255,255,255,.16); }
  .dev-process-list article { padding:28px 0; border-bottom:1px solid rgba(255,255,255,.16); }
  .dev-process-list h3 { font-size:36px; margin-bottom:14px; }
  .dev-cta-section { padding:135px 7vw; text-align:center; background:radial-gradient(circle at 70% 30%, rgba(200,169,106,.20), transparent 36%), linear-gradient(135deg,#050505,#15120e); }
  .dev-cta-section h2 { max-width:1000px; margin:0 auto 26px; }
  .dev-cta-section p { max-width:760px; margin:0 auto; color:rgba(248,246,240,.66); font-size:18px; line-height:1.65; }
  @media screen and (max-width:900px) {
    .dev-hero { min-height:84vh; padding:96px 22px 74px; }
    .dev-hero h1, .dev-intro h2, .dev-types-section h2, .dev-process-section h2, .dev-cta-section h2 { font-size:clamp(36px,10.5vw,62px); line-height:.96; letter-spacing:-.045em; }
    .dev-hero p { max-width:100%; }
    .dev-intro, .dev-types-section, .dev-quote-section, .dev-advantages-section, .dev-process-section, .dev-cta-section { padding-left:22px; padding-right:22px; }
    .dev-two-col, .dev-process-inner { grid-template-columns:1fr; gap:34px; }
    .dev-types-grid, .dev-advantages-grid { grid-template-columns:1fr; }
    .dev-advantages-grid article { border-right:0; border-bottom:1px solid rgba(255,255,255,.16); }
    .dev-advantages-grid article:last-child { border-bottom:0; }
    .dev-quote { font-size:clamp(34px,10.5vw,62px); line-height:1.02; letter-spacing:-.045em; }
  }
</style>
