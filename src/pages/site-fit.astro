---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Locate Your Site | Bauhu" description="Locate your project site, confirm the parcel and create a preliminary site summary for Bauhu.">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet-draw@1.0.4/dist/leaflet.draw.css" />
  <SiteHeader />
  <main class="site-fit-page">
    <header class="site-fit-header"><div><p class="kicker">START YOUR PROJECT · STEP 1</p><h1>Locate your site.</h1><p>Search for the site, refine the pin, then retrieve an available cadastral boundary or draw an approximate parcel manually.</p></div><aside><span>PROJECT ROUTE</span><strong>Site first</strong><small>1. Locate site</small><small>2. Review summary</small><small>3. Send project details</small></aside></header>
    <section class="tool-shell">
      <aside class="control-panel">
        <div class="step"><b>01</b><div><strong>Locate property</strong><small>Search, coordinates or device location.</small></div></div>
        <form id="location-search-form"><label for="location-search">Address or place</label><div class="search-row"><input id="location-search" type="search" placeholder="Island, settlement or address" /><button type="submit">Search</button></div><p id="search-feedback" class="feedback">Search is sent only when you press Search.</p><div id="search-results" class="search-results" hidden></div></form>
        <button id="use-current-location" class="secondary" type="button">◎ Use my current location</button>
        <div class="coordinate-grid"><label><span>Latitude</span><input id="latitude" type="number" step="0.000001" value="18.000000" /></label><label><span>Longitude</span><input id="longitude" type="number" step="0.000001" value="-72.000000" /></label></div>
        <button id="apply-coordinates" class="secondary" type="button">Go to coordinates</button><div class="instruction">Click the map or drag the marker to refine the exact location.</div><button id="confirm-location" class="primary" type="button">Use this location</button>
        <section id="parcel-controls" hidden><div class="step compact"><b>02</b><div><strong>Confirm parcel</strong><small>Use cadastral data or draw the boundary.</small></div></div><div id="parcel-search-state" class="parcel-state">Ready to search parcel records.</div><button id="find-parcel" class="primary" type="button">Search parcel records</button><div class="or"><span>or</span></div><button id="draw-boundary" class="secondary" type="button">Draw approximate boundary</button><button id="clear-boundary" class="text-button" type="button" hidden>Clear boundary</button><div id="parcel-result" class="parcel-result" hidden><span id="parcel-source-label">PARCEL BOUNDARY</span><strong id="parcel-reference">Selected parcel</strong><dl><div><dt>Source</dt><dd id="parcel-source">—</dd></div><div><dt>Approx. area</dt><dd id="parcel-area">—</dd></div></dl><button id="confirm-parcel" class="primary" type="button">Confirm this parcel</button></div></section>
      </aside>
      <section class="map-workspace"><div class="map-toolbar"><div class="base-switch"><button id="map-view" class="active" type="button">Map</button><button id="satellite-view" type="button">Satellite</button></div><div class="statuses"><span id="location-status">Location not confirmed</span><span id="parcel-status" class="muted">Parcel not selected</span></div></div><div class="map-stage"><div id="map-loading" class="map-loading">Loading map…</div><div id="property-map"></div><div class="map-card"><span>SELECTED POINT</span><strong id="map-place-name">Caribbean</strong><p><span id="map-latitude">18.000000</span>, <span id="map-longitude">-72.000000</span></p></div></div><footer><div><span>Location source</span><strong id="location-source">Manual map point</strong></div><div><span>Boundary source</span><strong id="boundary-source">Not selected</strong></div><div><span>Parcel area</span><strong id="footer-area">—</strong></div><div><span>Next step</span><strong id="next-step">Confirm location</strong></div></footer></section>
    </section><p class="disclaimer">Preliminary guidance only. Map positions, boundaries, planning requirements, hazards and construction suitability require professional verification.</p>
  </main><SiteFooter />
  <script is:inline src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script><script is:inline src="https://cdn.jsdelivr.net/npm/leaflet-draw@1.0.4/dist/leaflet.draw.js"></script>
  <script is:inline>
  (()=>{const $=id=>document.getElementById(id),mapEl=$('property-map');if(!window.L||!mapEl)return;let selectedName='Caribbean',selectedSource='Manual map point',activeBase,boundaryLayer,boundaryKind;const map=L.map(mapEl,{zoomControl:false,preferCanvas:true}).setView([18,-72],5);L.control.zoom({position:'bottomright'}).addTo(map);const street=L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'}),sat=L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',{maxZoom:19,attribution:'Tiles &copy; Esri'});function base(l,m){if(activeBase)map.removeLayer(activeBase);activeBase=l.addTo(map);$('map-view').classList.toggle('active',m==='map');$('satellite-view').classList.toggle('active',m==='satellite')}street.once('load',()=>{$('map-loading').hidden=true});base(street,'map');$('map-view').onclick=()=>base(street,'map');$('satellite-view').onclick=()=>base(sat,'satellite');const marker=L.marker([18,-72],{draggable:true}).addTo(map),drawn=new L.FeatureGroup().addTo(map),fmt=v=>Number(v).toFixed(6);function setPoint(lat,lng,{pan=true,zoom=16}={}){lat=Number(lat);lng=Number(lng);if(!Number.isFinite(lat)||!Number.isFinite(lng))return;marker.setLatLng([lat,lng]);if(pan)map.setView([lat,lng],Math.max(map.getZoom(),zoom));$('latitude').value=fmt(lat);$('longitude').value=fmt(lng);$('map-latitude').textContent=fmt(lat);$('map-longitude').textContent=fmt(lng);$('map-place-name').textContent=selectedName;$('location-source').textContent=selectedSource}marker.on('dragend',()=>{selectedName='Adjusted map point';selectedSource='Dragged marker';const p=marker.getLatLng();setPoint(p.lat,p.lng,{pan:false})});map.on('click',e=>{if(map._drawing)return;selectedName='Selected map point';selectedSource='Map click';setPoint(e.latlng.lat,e.latlng.lng,{pan:false})});$('apply-coordinates').onclick=()=>{selectedName='Entered coordinates';selectedSource='Latitude / longitude';setPoint($('latitude').value,$('longitude').value,{zoom:17})};$('use-current-location').onclick=()=>navigator.geolocation?.getCurrentPosition(p=>{selectedName='Current device location';selectedSource='Browser geolocation';setPoint(p.coords.latitude,p.coords.longitude,{zoom:17})},()=>{$('search-feedback').textContent='Location permission was unavailable.'});$('location-search-form').onsubmit=async e=>{e.preventDefault();const q=$('location-search').value.trim();if(q.length<3)return;$('search-feedback').textContent='Searching…';$('search-results').innerHTML='';try{const r=await fetch(`https://nominatim.openstreetmap.org/search?format=jsonv2&limit=5&q=${encodeURIComponent(q)}`),rows=await r.json();rows.forEach(row=>{const b=document.createElement('button');b.type='button';b.textContent=row.display_name;b.onclick=()=>{selectedName=row.display_name;selectedSource='OpenStreetMap search';setPoint(row.lat,row.lon,{zoom:17});$('search-results').hidden=true};$('search-results').appendChild(b)});$('search-results').hidden=false;$('search-feedback').textContent=rows.length?`${rows.length} locations found.`:'No matching locations found.'}catch{$('search-feedback').textContent='Search is temporarily unavailable.'}};function areaM2(r){const pts=r.map(p=>Array.isArray(p)?{lat:p[0],lng:p[1]}:p),lat0=pts.reduce((a,p)=>a+p.lat,0)/pts.length*Math.PI/180;let s=0;for(let i=0;i<pts.length;i++){const a=pts[i],b=pts[(i+1)%pts.length];s+=(a.lng*111320*Math.cos(lat0))*(b.lat*111320)-(b.lng*111320*Math.cos(lat0))*(a.lat*111320)}return Math.abs(s)/2}const areaText=m=>m>=4046.856?`${(m/4046.856).toFixed(2)} acres`:`${Math.round(m).toLocaleString()} m²`;function setBoundary(layer,kind,attrs={}){if(boundaryLayer){map.removeLayer(boundaryLayer);drawn.clearLayers()}boundaryLayer=layer;boundaryKind=kind;if(kind==='manual')drawn.addLayer(layer);else layer.addTo(map);const raw=layer.getLatLngs(),ring=Array.isArray(raw[0])&&Array.isArray(raw[0][0])?raw[0][0]:raw[0],a=areaM2(ring);$('parcel-result').hidden=false;$('clear-boundary').hidden=false;$('parcel-reference').textContent=attrs.PARCEL_ID||attrs.PARCEL_NO||attrs.PIN?`Parcel ${attrs.PARCEL_ID||attrs.PARCEL_NO||attrs.PIN}`:'Approximate parcel';$('parcel-source').textContent=kind==='official'?'USVI GIS cadastral service':'Drawn by user';$('parcel-area').textContent=areaText(a);$('footer-area').textContent=areaText(a);$('boundary-source').textContent=$('parcel-source').textContent;$('parcel-status').textContent='Boundary selected';map.fitBounds(layer.getBounds().pad(.25),{maxZoom:19})}function clearBoundary(){if(boundaryLayer){map.removeLayer(boundaryLayer);drawn.clearLayers()}boundaryLayer=null;$('parcel-result').hidden=true;$('clear-boundary').hidden=true}$('clear-boundary').onclick=clearBoundary;async function findParcel(){const p=marker.getLatLng();if(!(p.lat>=17.62&&p.lat<=18.48&&p.lng>=-65.15&&p.lng<=-64.45)){$('parcel-search-state').textContent='No connected cadastral provider is available for this location yet. Draw the boundary manually.';return}const geometry=JSON.stringify({x:p.lng,y:p.lat,spatialReference:{wkid:4326}}),url='https://services3.arcgis.com/UfiM23HwAqZRk1vw/arcgis/rest/services/Parcels_of_the_US_Virgin_Islands/FeatureServer/0/query?'+new URLSearchParams({geometry,geometryType:'esriGeometryPoint',inSR:'4326',spatialRel:'esriSpatialRelIntersects',outFields:'*',returnGeometry:'true',outSR:'4326',f:'json'});try{const d=await(await fetch(url)).json(),f=d.features?.[0];if(!f)throw 0;setBoundary(L.polygon(f.geometry.rings.map(r=>r.map(([lng,lat])=>[lat,lng])),{color:'#c5a66a',weight:3,fillColor:'#d9b66f',fillOpacity:.22}),'official',f.attributes||{})}catch{$('parcel-search-state').textContent='No parcel was returned. Draw an approximate boundary.'}}$('find-parcel').onclick=findParcel;const drawHandler=window.L.Draw?new L.Draw.Polygon(map,{allowIntersection:false,showArea:true,shapeOptions:{color:'#c5a66a',weight:3,fillColor:'#d9b66f',fillOpacity:.2}}):null;$('draw-boundary').onclick=()=>{clearBoundary();map._drawing=true;drawHandler?.enable()};map.on(L.Draw.Event.CREATED,e=>{map._drawing=false;setBoundary(e.layer,'manual')});$('confirm-location').onclick=()=>{$('parcel-controls').hidden=false;$('location-status').textContent='Location confirmed';$('next-step').textContent='Confirm parcel';findParcel()};$('confirm-parcel').onclick=()=>{if(!boundaryLayer)return;const p=marker.getLatLng(),raw=boundaryLayer.getLatLngs(),ring=Array.isArray(raw[0])&&Array.isArray(raw[0][0])?raw[0][0]:raw[0],data={place:selectedName,source:selectedSource,lat:+p.lat.toFixed(6),lng:+p.lng.toFixed(6),parcel:$('parcel-reference').textContent,area:$('parcel-area').textContent,boundarySource:$('parcel-source').textContent,boundary:ring.map(x=>[x.lat,x.lng]),boundaryKind,savedAt:new Date().toISOString()};localStorage.setItem('bauhuSiteProject',JSON.stringify(data));location.href='/site-summary'};requestAnimationFrame(()=>map.invalidateSize())})();
  </script>
</BaseLayout>
<style>
:global(.leaflet-container){font-family:Inter,sans-serif;background:#d9dfdc}.site-fit-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}.site-fit-header{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:4rem;padding:3.4rem 4vw 2.4rem;border-bottom:1px solid rgba(23,57,76,.18)}.kicker,.site-fit-header aside>span{margin:0 0 .8rem;font:700 .68rem Inter,sans-serif;letter-spacing:.2em;color:#9b7b49}.site-fit-header h1{margin:0 0 1rem;font:400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif}.site-fit-header>div>p:last-child{max-width:760px;color:rgba(23,57,76,.7)}.site-fit-header aside{display:flex;flex-direction:column;justify-content:flex-end;gap:.45rem;padding-left:2rem;border-left:1px solid rgba(23,57,76,.18)}.tool-shell{display:grid;grid-template-columns:310px minmax(0,1fr);min-height:760px}.control-panel{padding:1.4rem;background:#f7f5ef;border-right:1px solid rgba(23,57,76,.16)}.step{display:flex;gap:.8rem;margin-bottom:1.2rem}.step.compact{margin-top:1.4rem;padding-top:1.2rem;border-top:1px solid rgba(23,57,76,.15)}.step b{color:#9b7b49}.control-panel label,.coordinate-grid span{display:block;margin-bottom:.45rem;font:700 .68rem Inter,sans-serif}.search-row{display:grid;grid-template-columns:1fr auto}.search-row input,.coordinate-grid input{width:100%;box-sizing:border-box;padding:.8rem;border:1px solid rgba(23,57,76,.22)}button{cursor:pointer}.search-row button,.primary{border:0;background:#17394c;color:#fff;padding:.8rem 1rem;font-weight:700}.secondary{width:100%;margin:.5rem 0;padding:.72rem;border:1px solid rgba(23,57,76,.24);background:#fff;color:#17394c;font-weight:700}.coordinate-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}.feedback,.instruction,.parcel-state{font-size:.64rem;line-height:1.45;color:rgba(23,57,76,.62)}.instruction,.parcel-state{padding:.8rem;background:#ece9df}.search-results{display:grid;gap:.3rem;margin:.5rem 0}.search-results button{text-align:left;padding:.6rem;border:1px solid rgba(23,57,76,.15);background:#fff}.primary{width:100%;margin-top:.4rem}.or{text-align:center;margin:.7rem}.text-button{width:100%;border:0;background:none;color:#7c4037;text-decoration:underline}.parcel-result{margin-top:1rem;padding:1rem;background:#e9e1cf}.parcel-result>strong{display:block;margin:.4rem 0;font:400 1.3rem 'Cormorant Garamond',serif}.parcel-result dl div{display:flex;justify-content:space-between;font-size:.67rem}.parcel-result dd{margin:0}.map-workspace{display:grid;grid-template-rows:auto 1fr auto;min-width:0}.map-toolbar{display:flex;justify-content:space-between;padding:.7rem .9rem;background:#f7f5ef}.base-switch,.statuses{display:flex;gap:.35rem;align-items:center}.map-toolbar button{padding:.5rem .8rem;border:1px solid rgba(23,57,76,.18);background:#fff;color:#17394c}.map-toolbar button.active{background:#17394c;color:#fff}.statuses span{font-size:.6rem;padding:.45rem;background:#ece9df}.map-stage{position:relative;min-height:660px}.map-stage #property-map{position:absolute;inset:0}.map-loading{position:absolute;inset:0;z-index:1200;display:grid;place-items:center;background:#d9dfdc}.map-loading[hidden]{display:none}.map-card{position:absolute;z-index:900;left:1rem;bottom:1rem;padding:.9rem;background:rgba(247,245,239,.94)}.map-card strong{display:block}.map-card p{margin:.2rem 0}.map-workspace footer{display:grid;grid-template-columns:repeat(4,1fr);background:#f7f5ef}.map-workspace footer div{padding:.8rem 1rem;border-right:1px solid rgba(23,57,76,.12)}.map-workspace footer span,.map-workspace footer strong{display:block;font-size:.62rem}.disclaimer{padding:1rem 4vw;font-size:.65rem}@media(max-width:760px){.site-fit-header{grid-template-columns:1fr}.site-fit-header aside{border-left:0;padding-left:0}.tool-shell{grid-template-columns:1fr}.map-stage{min-height:520px}.map-workspace footer{grid-template-columns:1fr 1fr}}
</style>