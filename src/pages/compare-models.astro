---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Compare Bauhu Model Residences | Bauhu" description="Compare Bauhu model residences by bedrooms, bathrooms, built area and guide price.">
  <link rel="stylesheet" href="/ux-lab/prototype-kit.css" />
  <SiteHeader />
  <div class="bauhu-finder-page">
    <main><section class="intro"><p class="eyebrow">BAUHU / MODEL RESIDENCES</p><h1>Find the difference.<br><em>Find your direction.</em></h1><p>Shortlist up to three model residences to compare their published specifications in one place. The aim is clarity, not another complicated selector.</p><div class="meta">PUBLISHED MODEL SPECIFICATIONS / NOT A SITE SUITABILITY ASSESSMENT</div></section>
<section class="prototype" aria-label="Compare Bauhu Model Residences"><div class="tool"><div class="toolbar"><span><i class="dot"></i>THE MODEL COMPARISON DESK</span><span id="selected-count">0 / 3 SELECTED</span></div><div class="inner"><div class="compare-shell">
<div><span class="sectionlabel">01 / PICK YOUR SHORTLIST</span><h2>Choose up to three.</h2><p class="intro-note">Search by name or select a design. We’ll keep the differences in view.</p><div class="model-filter"><input class="control" id="model-search" type="search" placeholder="Search model names…" aria-label="Search model names"><button type="button" class="btn secondary" id="clear">CLEAR</button></div><div id="model-list" class="model-list" aria-label="Available Bauhu residences"><p>Loading model collection…</p></div></div>
<div class="compare-board" aria-live="polite"><span class="sectionlabel">02 / SIDE-BY-SIDE VIEW</span><div class="compare-actions"><h2>At a glance.</h2><span id="compare-feedback" class="small">Select a residence to begin.</span></div><div id="comparison-grid" class="comparison-grid"><div class="empty">CHOOSE YOUR FIRST MODEL ↗</div></div><div class="compare-note">Guide prices are published model starting indications, not total project costs. Actual feasibility, scope and costs depend on the site and project requirements. Missing values are shown as unpublished.</div></div>
</div></div></div></section></main>
  </div>
  <SiteFooter />
  <script is:inline src="/ux-lab/models.js" defer></script>
  <script is:inline src="/ux-lab/compare-models/compare.js" defer></script>
</BaseLayout>
<style is:global>
  .bauhu-finder-page{padding-top:88px;background:#ebe9e2;color:#17394c;min-height:78vh}
  .bauhu-finder-page .intro{padding-top:clamp(50px,7vw,85px)}
  .bauhu-finder-page .intro h1{font-family:'Cormorant Garamond',Georgia,serif;font-weight:400}
  .bauhu-finder-page .prototype{max-width:1600px}
  @media(max-width:900px){.bauhu-finder-page{padding-top:80px}}
</style>
