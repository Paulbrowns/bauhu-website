---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

// Photo-first preview. Captions/facts are grounded in the source article.
// Keep the original Squarespace site untouched.
const photos = [
  { src: 'https://images.squarespace-cdn.com/content/v1/64ca8a095698ca7a9fa869d5/1733409117947-HGNK23AUL5SFJKMMBO6O/Erecting%2Blight%2Bgauge%2Bsteel%2Bframe%2Bfor%2BBauhu%2Bhurricane%2Bresistant%2Bhome%2Bin%2BSt%2BJohn%2BVI.jpg', alt: 'Steel framing and hillside foundation during construction of a modular residence in St John', caption: 'Steel framing on the hillside site' },
  { src: 'https://images.squarespace-cdn.com/content/v1/64ca8a095698ca7a9fa869d5/1733409118029-5H68H1VROCPENTHP5DQZ/Erecting%2Blight%2Bgauge%2Bsteel%2Bframe%2Bfor%2BBauhu%2Bhurricane%2Bresistant%2Bhome%2Bin%2BSt%2BJohn%2BUSVI.jpg', alt: 'Roof trusses and wall framing taking shape at the St John residential project', caption: 'Roof trusses and wall structure' },
  { src: 'https://images.squarespace-cdn.com/content/v1/64ca8a095698ca7a9fa869d5/1733409119613-2ME2NMQ74E6S8S6G5TKK/Hurricane%2Bproof%2Blight%2Bgauge%2Bsteel%2Bframe%2Bfor%2BBauhu%2Bprefab%2Bhome.jpg', alt: 'Elevated perspective of the assembled roof framing on the hillside', caption: 'Structure progressing across the elevated site' },
];
---
<BaseLayout title="Hurricane-Resistant Modular Home Project in St John, USVI | Bauhu" description="See a hurricane-resistant modular home taking shape in St John, US Virgin Islands. Bauhu steel-frame construction, hillside installation and project progress photos.">
  <SiteHeader />
  <main class="project-preview">
    <div class="project-shell">
      <nav class="back-nav"><a href="/projects/">← All projects</a><span class="preview-label">Template preview</span></nav>
      <header class="project-heading">
        <p class="region">US Virgin Islands · Project gallery</p>
        <h1>St John</h1>
        <p class="summary">A hurricane-resistant modular home project in St John, US Virgin Islands, adapted from the Coconut Villa concept for a steep hillside site. Photographs show the light-gauge steel frame and roof structure taking shape.</p>
        <div class="project-meta"><span>Location: St John, USVI</span><span>Design: Coconut Villa concept</span><span>Construction: Steel frame</span></div>
      </header>
      <div class="photo-grid">
        {photos.map((photo, i) => <figure class:list={['photo', i===0 && 'featured']}>
          <a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={'View full-size image: '+photo.alt}>
            <img src={photo.src} alt={photo.alt} loading={i===0?'eager':'lazy'} decoding="async" />
          </a>
          <figcaption>{photo.caption}</figcaption>
        </figure>)}
      </div>
      <p class="gallery-note">Project photography from the original Bauhu Homes construction archive. The final page can show the full progress sequence, with only factual captions.</p>
      <div class="footer-strip"><div><h2>Planning an island project?</h2><p>Tell us about your location, access and proposed home.</p></div><a class="cta" href="/site-fit/">Start a site review →</a></div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .project-preview{background:#f8f8f6;color:#1a1d20;min-height:80vh}
  .project-shell{width:min(1240px,calc(100% - 40px));margin:0 auto;padding:40px 0 90px}
  .back-nav{display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:13px;color:#476074}
  .back-nav a{text-decoration:none;color:inherit}
  .preview-label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#6a7b86}
  .project-heading{padding:54px 0 28px;max-width:950px}
  .region{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#476074;margin:0 0 12px}
  h1{font-family:Georgia,serif;font-size:clamp(44px,6vw,76px);font-weight:400;letter-spacing:-.035em;line-height:1.12;margin:0 0 19px}
  .summary{max-width:760px;font-size:17px;line-height:1.65;color:#4b5660;margin:0 0 25px}
  .project-meta{display:flex;gap:10px 27px;flex-wrap:wrap;border-top:1px solid #dedfdd;padding-top:18px;font-size:13px;color:#515c64}
  .photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:24px}
  .photo{margin:0;min-width:0}
  .photo.featured{grid-column:auto}
  .photo a{display:flex;justify-content:center;align-items:center;background:#edecea;overflow:hidden}
  .photo img{width:100%;height:auto;max-height:300px;object-fit:contain;display:block}
  .photo.featured img{max-height:300px}
  figcaption{color:#667078;font-size:12px;padding:9px 0 0}
  .gallery-note{font-size:12px;color:#69747b;line-height:1.6;margin:28px 0 0}
  .footer-strip{margin-top:72px;padding:28px 0;border-top:1px solid #d6d9d9;display:flex;gap:24px;justify-content:space-between;align-items:center}
  .footer-strip h2{font-family:Georgia,serif;font-size:27px;font-weight:400;margin:0 0 8px}
  .footer-strip p{font-size:14px;margin:0;color:#667078}
  .cta{background:#143a52;color:#fff;text-decoration:none;padding:14px 21px;border-radius:2px;white-space:nowrap;font-size:13px}
  @media(max-width:680px){.project-shell{width:calc(100% - 30px);padding-top:25px}.project-heading{padding-top:37px}.photo-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.photo.featured{grid-column:auto}.photo img,.photo.featured img{max-height:260px}.footer-strip{align-items:flex-start;flex-direction:column}}
</style>
