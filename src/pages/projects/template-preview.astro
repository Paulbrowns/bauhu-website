---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

// Editorial layout prototype only. No unverified site details or completion claims.
const project = {
  title: 'Eleuthera',
  region: 'The Bahamas',
  stage: 'Current project',
  type: 'Island residence',
  lead: 'A site-responsive modular residence that brings contemporary construction methods together with the architectural character of The Bahamas.',
  hero: 'https://images.squarespace-cdn.com/content/v1/64ca8a095698ca7a9fa869d5/1733402805814-KB6MCVMWNR1OUIA4V6GO/Assembling%2Ba%2BBauhu%2Bhurricane%2Bproof%2Bhouse%2Bin%2BEleuthera%2B3.jpg',
  caption: 'Construction-stage photography from the Bauhu project archive.',
  facts: [
    { label: 'Location', value: 'Eleuthera, The Bahamas' },
    { label: 'Project type', value: 'Modular island residence' },
    { label: 'Design language', value: 'Contemporary Bahamian' },
    { label: 'Status', value: 'Project in progress' }
  ]
};
---
<BaseLayout title="Project Page Template Preview | Bauhu" description="Design preview for future Bauhu project stories.">
  <SiteHeader />
  <main class="bg-paper text-ink">
    <section class="bg-navy px-5 pb-14 pt-28 text-paper lg:px-10 lg:pt-36">
      <div class="mx-auto max-w-site">
        <div class="flex flex-wrap items-center justify-between gap-5">
          <a href="/projects/" class="text-sm text-paper/70 hover:text-paper">← Current projects</a>
          <span class="border border-paper/30 px-4 py-2 text-xs uppercase tracking-widest text-paper/75">Template preview</span>
        </div>
        <p class="eyebrow mt-16 text-stone">Bauhu project journal · {project.region}</p>
        <h1 class="mt-5 max-w-5xl font-display text-6xl leading-tight md:text-8xl">{project.title}</h1>
        <p class="mt-8 max-w-3xl text-xl leading-9 text-paper/80 md:text-2xl">{project.lead}</p>
        <div class="mt-12 flex flex-wrap gap-3 text-xs uppercase tracking-widest text-paper/75"><span class="border border-paper/25 px-4 py-2">{project.type}</span><span class="border border-paper/25 px-4 py-2">{project.stage}</span></div>
      </div>
    </section>
    <section class="bg-mist px-5 pb-14 pt-8 lg:px-10">
      <figure class="mx-auto max-w-site">
        <div class="flex min-h-[320px] items-center justify-center bg-navy/10">
          <img src={project.hero} alt="Bauhu project construction work in Eleuthera" class="mx-auto max-h-[560px] w-full object-contain" loading="eager" />
        </div>
        <figcaption class="mt-3 text-sm text-ink/60">{project.caption}</figcaption>
      </figure>
    </section>
    <section class="section-pad">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-clay">The project at a glance</p>
        <div class="mt-8 grid gap-8 border-y border-ink/15 py-10 sm:grid-cols-2 lg:grid-cols-4">
          {project.facts.map(fact => <div><p class="text-xs uppercase tracking-widest text-ink/55">{fact.label}</p><p class="mt-3 font-display text-2xl">{fact.value}</p></div>)}
        </div>
        <div class="mt-24 grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
          <div><p class="eyebrow text-clay">01 / The brief</p><h2 class="mt-5 font-display text-4xl leading-tight md:text-6xl">Architecture shaped by its island setting.</h2></div>
          <div class="space-y-5 text-lg leading-8 text-ink/75">
            <p>This project draws on familiar Bahamian architectural proportions while exploring the practical advantages of an engineered modular building system.</p>
            <p>For the finished case study, this section will describe the actual client brief, the design intent and any project constraints supported by the original source material.</p>
          </div>
        </div>
      </div>
    </section>
    <section class="bg-mist px-5 py-20 lg:px-10">
      <div class="mx-auto grid max-w-site gap-8 lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
        <div class="flex min-h-[320px] items-center justify-center border border-ink/15 bg-paper px-8 py-14 text-center"><div><p class="eyebrow text-clay">Image position 02</p><p class="mt-4 font-display text-3xl">Construction / site detail</p><p class="mt-3 max-w-md text-ink/60">Reserved for a second original high-resolution project photograph — never an enlarged thumbnail.</p></div></div>
        <div><p class="eyebrow text-clay">02 / The site</p><h2 class="mt-5 font-display text-4xl">Responding to climate, access and terrain.</h2><p class="mt-6 leading-8 text-ink/75">Describe only verified site conditions and design responses here. Location stays at island level; precise addresses and sensitive client details stay private.</p></div>
      </div>
    </section>
    <section class="section-pad">
      <div class="mx-auto grid max-w-site gap-14 lg:grid-cols-[0.85fr_1.15fr]">
        <div><p class="eyebrow text-clay">03 / Engineering & delivery</p><h2 class="mt-5 font-display text-4xl md:text-5xl">The building behind the architecture.</h2></div>
        <div class="space-y-6 leading-8 text-ink/75"><p>The published project story will explain the actual structural approach, external envelope, logistics and assembly sequence where those details are documented.</p><p>No universal wind-rating guarantees, unverified delivery dates or premature claims of completion will be added.</p></div>
      </div>
      <div class="mx-auto mt-16 grid max-w-site gap-5 md:grid-cols-2">
        {['Gallery position 03 — structure or envelope','Gallery position 04 — architectural detail'].map(label => <div class="flex min-h-[250px] items-center justify-center border border-ink/15 bg-mist p-8 text-center font-display text-2xl text-ink/60">{label}</div>)}
      </div>
    </section>
    <section class="section-pad bg-mist">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-clay">04 / Project journal</p><h2 class="mt-5 max-w-3xl font-display text-4xl md:text-5xl">Progress, documented.</h2><p class="mt-6 max-w-3xl leading-8 text-ink/75">A dated series of brief construction updates and captioned photographs will appear here when a project has sufficient original source material. The page remains a current-project record, not an invented completion story.</p>
      </div>
    </section>
    <section class="section-pad bg-navy text-paper">
      <div class="mx-auto grid max-w-site gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div><p class="eyebrow text-stone">Planning a project?</p><h2 class="mt-5 font-display text-4xl md:text-6xl">Every project begins with its site.</h2><p class="mt-6 max-w-xl leading-8 text-paper/70">Tell us about your location, land, access and ambitions. We'll help establish a practical design and delivery route.</p></div>
        <div class="lg:text-right"><a href="/site-fit/" class="inline-flex rounded-full bg-paper px-8 py-4 text-sm uppercase tracking-wide text-ink">Start your site review →</a></div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
