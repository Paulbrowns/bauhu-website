---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { projectJournal } from '../../data/project-journal.js';

export function getStaticPaths() {
  return projectJournal.map(project => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const regionalTerm = project.region === "Portugal" ? "Modern Steel-Frame Modular Home" : "Hurricane-Resistant Modular Home";
const title = `${project.title} | ${regionalTerm} Project | Bauhu`;
const description = `${project.intro} View original construction photos and the Bauhu project record.`.slice(0, 160);
---
<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main class="journal">
    <div class="shell">
      <nav class="back"><a href="/projects/">← All projects</a></nav>
      <header class="heading">
        <p class="region">{project.region} · Bauhu project journal</p>
        <h1>{project.title}</h1>
        <p class="intro">{project.intro}</p>
        <p class="facts">Bauhu modular home · {project.region} · Photographic project record</p>
      </header>
      <div class="photos">
        {project.images.map((photo, i) => <figure>
          <a href={photo.src} rel="noopener noreferrer" target="_blank" aria-label={`Open photograph ${i+1}: ${photo.alt}`}>
            <img src={photo.src} alt={photo.alt} loading={i===0?'eager':'lazy'} decoding="async" />
          </a>
        </figure>)}
      </div>
      <div class="project-links">
        <p>See the original project photography and updates on <a href={project.source} rel="noopener noreferrer" target="_blank">Bauhu Homes ↗</a></p>
        <p>Explore <a href="/steel-frame-home-kits/">steel-frame home construction</a> and <a href="/remote-locations/">building in remote locations</a>.</p>
      </div>
      <div class="enquiry"><div><h2>Planning your own project?</h2><p>Share your site and project details with Bauhu.</p></div><a href="/site-fit/">Start a site review →</a></div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .journal{background:#f8f8f6;color:#1a1d20;min-height:75vh}
  .shell{max-width:1220px;width:calc(100% - 40px);margin:auto;padding:44px 0 80px}
  .back a{font-size:13px;color:#476074;text-decoration:none}
  .heading{padding:45px 0 18px;max-width:960px}
  .region{text-transform:uppercase;letter-spacing:.12em;font-size:12px;color:#4b6475}
  h1{font:400 clamp(42px,6vw,72px)/1.1 Georgia,serif;margin:15px 0 18px}
  .intro{max-width:820px;font-size:17px;line-height:1.65;color:#44515a}
  .facts{border-top:1px solid #d8d9d8;margin-top:23px;padding-top:15px;color:#67727c;font-size:13px}
  .photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px;margin-top:20px}
  figure{margin:0;min-width:0;background:#edecea;display:flex;align-items:center;justify-content:center}
  figure a{display:block;width:100%;text-align:center}
  img{display:block;width:100%;max-height:300px;object-fit:contain}
  .project-links{margin:28px 0 50px;display:flex;flex-wrap:wrap;gap:10px 25px;color:#65717b;font-size:12px;line-height:1.6}
  .project-links p{margin:0}
  .project-links a{color:#143a52}
  .enquiry{border-top:1px solid #d8d9d8;padding-top:26px;display:flex;align-items:center;justify-content:space-between;gap:25px}
  .enquiry h2{font:400 27px Georgia,serif;margin:0 0 8px}
  .enquiry p{font-size:14px;color:#667078;margin:0}
  .enquiry>a{background:#143a52;color:white;text-decoration:none;font-size:13px;padding:14px 21px;white-space:nowrap}
  @media(max-width:760px){.photos{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.shell{width:calc(100% - 30px)}.enquiry{align-items:flex-start;flex-direction:column}}
</style>
