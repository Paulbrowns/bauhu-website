---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EditorialHero from '../components/EditorialHero.astro';

const steps = [
  ['01', 'Send your site details', 'Share the location, access, planning status, preferred size, budget range, timeline and any drawings, surveys or site photographs.'],
  ['02', 'Feasibility review', 'Bauhu reviews the site conditions, likely delivery route, model suitability and early constraints that may affect scope or cost.'],
  ['03', 'Choose the right route', 'We identify whether the project is best suited to an adapted Bauhu model, a custom residence or a larger multi-building approach.'],
  ['04', 'Design and engineering', 'Architecture, structure, openings, envelope, foundations strategy, specification and logistics are coordinated around the approved project information.'],
  ['05', 'Procure and manufacture', 'Approved information is translated into the component, procurement and manufacturing package so orders and project requirements stay aligned.'],
  ['06', 'Consolidate and ship', 'The building package is organised, checked and shipped with containerisation, handling and destination realities considered before dispatch.'],
  ['07', 'Assemble with support', 'The local team receives project-specific assembly information, with Bauhu available to assist with technical questions during the build.'],
];
---
<BaseLayout title="How It Works | Bauhu" description="The guided Bauhu buyer journey from site review to design, manufacture and delivery.">
  <SiteHeader />
  <main>
    <EditorialHero
      eyebrow="Guided buyer journey"
      title="A clear route from land to residence."
      text="Bauhu helps clients understand what is possible before committing to a full design and manufacturing process. The journey begins with the realities of the site."
      primaryHref="/site-fit"
      primaryLabel="Start your project"
      imageSrc="/images/developments/bauhu-how-it-works-hero.webp"
    />
    <section class="section-pad bg-paper">
      <div class="mx-auto grid max-w-site gap-12 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="eyebrow text-clay">Process</p>
          <h2 class="mt-5 font-display text-4xl leading-tight md:text-6xl">Designed to reduce uncertainty before you commit.</h2>
        </div>
        <p class="text-lg leading-8 text-ink/70">Remote, coastal and island projects need clarity early. Bauhu’s process identifies the right route, likely constraints and practical delivery path before detailed work begins.</p>
      </div>
      <div class="mx-auto mt-14 grid max-w-site gap-5 md:grid-cols-2">
        {steps.map(([number, title, text]) => (
          <article class="bg-mist p-7 md:p-10">
            <p class="text-sm text-clay">{number}</p>
            <h2 class="mt-10 font-display text-4xl">{title}</h2>
            <p class="mt-5 leading-7 text-ink/70">{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-pad bg-ink text-paper">
      <div class="mx-auto grid max-w-site gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="eyebrow text-stone">Controlled delivery</p>
          <h2 class="mt-5 font-display text-4xl leading-tight md:text-6xl">Built around coordination, not improvisation.</h2>
        </div>
        <div class="space-y-6 text-lg leading-8 text-paper/70">
          <p>Remote construction becomes expensive when design changes, procurement mistakes or missing information are discovered on site. Bauhu moves key decisions upstream so design, engineering, procurement, manufacture and shipping work from the same approved project information.</p>
          <p>The result is a clearer Bauhu package, clearer local responsibilities and fewer avoidable surprises after delivery.</p>
        </div>
      </div>
    </section>

    <section class="section-pad bg-mist">
      <div class="mx-auto grid max-w-site gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="eyebrow text-clay">Logistics & assembly support</p>
          <h2 class="mt-5 font-display text-4xl leading-tight md:text-6xl">One coordinated shipment. Support after delivery.</h2>
        </div>
        <div class="space-y-6 text-lg leading-8 text-ink/70">
          <p>Components are procured, consolidated and dispatched as one coordinated building package rather than a series of disconnected supplier deliveries.</p>
          <p>For assembly, Bauhu provides project-specific information covering sequencing, connections, envelope installation and key construction stages. The local contractor retains responsibility for site execution, supervision and professional judgement.</p>
        </div>
      </div>
    </section>

    <section class="section-pad bg-paper">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-clay">After you enquire</p>
        <h2 class="mt-5 max-w-4xl font-display text-4xl leading-tight md:text-6xl">A serious first review, not a generic sales callback.</h2>
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          <article class="bg-mist p-7"><h3 class="font-display text-3xl">We review the site</h3><p class="mt-4 leading-7 text-ink/70">Location, access, exposure, planning position and any survey or drawings you already have.</p></article>
          <article class="bg-mist p-7"><h3 class="font-display text-3xl">We identify the route</h3><p class="mt-4 leading-7 text-ink/70">Predesigned model, custom design or larger development — and the main constraints that should be resolved first.</p></article>
          <article class="bg-mist p-7"><h3 class="font-display text-3xl">We define the next decision</h3><p class="mt-4 leading-7 text-ink/70">Clarity on feasibility, scope and what information is needed before meaningful design or pricing work proceeds.</p></article>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
