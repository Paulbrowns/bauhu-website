---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { bauhuModels } from '../../data/models';

export function getStaticPaths() {
  return bauhuModels.map((model) => ({
    params: { slug: model.slug.replace(/^bauhu-/, '') },
    props: { model },
  }));
}

const { model } = Astro.props;
const publicSlug = model.slug.replace(/^bauhu-/, '');
---

<BaseLayout title={`Review your ${model.name} project | Bauhu`} description={`Review the selected site, placement and ${model.name} model before contacting Bauhu.`}>
  <SiteHeader />
  <main class="summary-page">
    <header class="summary-header">
      <div>
        <p class="kicker">PROJECT SUMMARY</p>
        <h1>Review your proposed Bauhu project.</h1>
        <p>Check the selected home, site and indicative placement before sharing the project with Bauhu.</p>
      </div>
      <div class="step-marker">05 / 06</div>
    </header>

    <section class="summary-grid">
      <article class="model-card">
        <img src={model.image} alt={`${model.name} Bauhu home`} onerror="this.src='/images/model-placeholder.svg'" />
        <div>
          <p class="kicker">SELECTED HOME</p>
          <h2>{model.name}</h2>
          <p>{model.shortDescription}</p>
          <dl>
            <div><dt>Bedrooms</dt><dd>{model.bedroomsLabel}</dd></div>
            <div><dt>Bathrooms</dt><dd>{model.bathroomsLabel}</dd></div>
            <div><dt>Storeys</dt><dd>{model.storeysLabel}</dd></div>
            <div><dt>Built area</dt><dd>{model.builtAreaLabel} ft²</dd></div>
          </dl>
        </div>
      </article>

      <article class="project-card">
        <p class="kicker">SITE & PLACEMENT</p>
        <h2>Your selected position</h2>
        <dl>
          <div><dt>Parcel</dt><dd id="summary-parcel">Confirmed site</dd></div>
          <div><dt>Plot area</dt><dd id="summary-area">Area not supplied</dd></div>
          <div><dt>House centre</dt><dd id="summary-coordinates">Not supplied</dd></div>
          <div><dt>Orientation</dt><dd id="summary-rotation">0°</dd></div>
          <div><dt>Survey / topo</dt><dd id="summary-documents">Not attached</dd></div>
        </dl>
        <div class="notice">This remains an indicative placement. Boundary accuracy, planning requirements, setbacks, levels, utilities and construction suitability require professional verification.</div>
      </article>

      <article class="journey-card">
        <p class="kicker">YOUR PROJECT JOURNEY</p>
        <ol>
          <li class="done"><b>1</b><span>Site located</span></li>
          <li class="done"><b>2</b><span>Parcel confirmed</span></li>
          <li class="done"><b>3</b><span>House positioned</span></li>
          <li class="done"><b>4</b><span>House explored</span></li>
          <li class="current"><b>5</b><span>Project reviewed</span></li>
          <li><b>6</b><span>Send to Bauhu</span></li>
        </ol>
      </article>
    </section>

    <footer class="summary-actions">
      <a id="back-to-viewer" class="secondary" href={`/model-viewer/${publicSlug}`}>Back to 3D model</a>
      <a id="continue-to-enquiry" class="primary" href={`/project-enquiry/${publicSlug}`}>Continue to send project</a>
    </footer>
  </main>
  <SiteFooter />

  <script is:inline>
    (() => {
      const params = new URLSearchParams(location.search);
      const value = (key, fallback) => params.get(key) || fallback;
      document.getElementById('summary-parcel').textContent = value('parcel', 'Confirmed site');
      document.getElementById('summary-area').textContent = value('area', 'Area not supplied');
      const lat = params.get('lat');
      const lng = params.get('lng');
      document.getElementById('summary-coordinates').textContent = lat && lng ? `${Number(lat).toFixed(6)}, ${Number(lng).toFixed(6)}` : 'Not supplied';
      document.getElementById('summary-rotation').textContent = `${Math.round(Number(params.get('rotation') || 0))}°`;
      document.getElementById('summary-documents').textContent = Number(params.get('documents') || 0) > 0 ? `${params.get('documents')} file(s) attached` : 'Not attached';
      ['back-to-viewer', 'continue-to-enquiry'].forEach((id) => {
        const link = document.getElementById(id);
        if (link && location.search) link.href += location.search;
      });
    })();
  </script>
</BaseLayout>

<style>
.summary-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}.summary-header{display:flex;justify-content:space-between;gap:2rem;padding:3rem 4vw 2rem;border-bottom:1px solid rgba(23,57,76,.16)}.kicker{margin:0 0 .65rem;font:700 .65rem/1 Inter,sans-serif;letter-spacing:.2em;color:#9b7b49}.summary-header h1{max-width:900px;margin:0;font:400 clamp(2.8rem,5vw,5.4rem)/.94 'Cormorant Garamond',serif}.summary-header p:last-child{max-width:700px;font:400 .86rem/1.7 Inter,sans-serif;color:rgba(23,57,76,.68)}.step-marker{font:700 .68rem Inter,sans-serif;letter-spacing:.14em}.summary-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(320px,.8fr);gap:1.2rem;padding:2rem 4vw}.model-card,.project-card,.journey-card{background:#f7f5ef;border:1px solid rgba(23,57,76,.14)}.model-card{display:grid;grid-template-columns:minmax(260px,.9fr) minmax(300px,1fr);grid-row:span 2}.model-card img{width:100%;height:100%;min-height:530px;object-fit:cover}.model-card>div,.project-card,.journey-card{padding:1.5rem}.model-card h2,.project-card h2{margin:.1rem 0 .8rem;font:400 2.4rem 'Cormorant Garamond',serif}.model-card p:not(.kicker){font:400 .75rem/1.7 Inter,sans-serif;color:rgba(23,57,76,.68)}dl{margin:1rem 0 0}dl div{display:flex;justify-content:space-between;gap:1rem;padding:.72rem 0;border-top:1px solid rgba(23,57,76,.12);font:400 .68rem Inter,sans-serif}dd{margin:0;text-align:right;font-weight:700}.notice{margin-top:1rem;padding:1rem;background:#eee4cf;font:400 .65rem/1.6 Inter,sans-serif}.journey-card ol{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem;margin:1rem 0 0;padding:0;list-style:none}.journey-card li{display:flex;align-items:center;gap:.55rem;font:600 .62rem Inter,sans-serif}.journey-card b{display:grid;place-items:center;width:26px;height:26px;border:1px solid rgba(23,57,76,.2);border-radius:50%}.journey-card .done b{background:#17394c;color:#fff}.journey-card .current b{border-color:#9b7b49;color:#9b7b49}.summary-actions{display:flex;justify-content:flex-end;gap:.7rem;padding:0 4vw 3rem}.summary-actions a{padding:.9rem 1.1rem;text-decoration:none;font:700 .7rem Inter,sans-serif}.secondary{border:1px solid rgba(23,57,76,.24);color:#17394c}.primary{background:#17394c;color:#fff}@media(max-width:900px){.summary-grid{grid-template-columns:1fr}.model-card{grid-row:auto}.journey-card ol{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.summary-header{flex-direction:column}.model-card{grid-template-columns:1fr}.model-card img{min-height:340px}.summary-actions{align-items:stretch;flex-direction:column}.summary-actions a{text-align:center}}
</style>
