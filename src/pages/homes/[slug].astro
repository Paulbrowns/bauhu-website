---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { bauhuModels } from '../../data/models';

function titleCase(value: string) {
  return value
    .toLowerCase()
    .split(' ')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

export function getStaticPaths() {
  return bauhuModels.map((model) => ({
    params: { slug: model.slug.replace(/^bauhu-/, '') },
    props: { model },
  }));
}

const { model } = Astro.props;
const cleanName = titleCase(model.name);
const slug = model.slug;
const modelPublicSlug = slug.replace(/^bauhu-/, '');
const modelImageBase = `/images/models/${slug}`;
const heroImage = `${modelImageBase}/${slug}.webp`;
const enquiryHref = `/site-fit?model=${encodeURIComponent(modelPublicSlug)}`;
const isSunsetCove = modelPublicSlug === 'sunset-cove';
const isAngel = modelPublicSlug === 'angel';
const isBahamaBeach = modelPublicSlug === 'bahama-beach';
const isAbaco = modelPublicSlug === 'abaco';
const isCaribbeanCottage = modelPublicSlug === 'caribbean-cottage';
const isCasaLavanda = modelPublicSlug === 'casa-lavanda';
const isCasita = modelPublicSlug === 'casita';
const isCharlston = modelPublicSlug === 'charlston';
const isCoconutVilla2 = modelPublicSlug === 'coconut-villa-2';
const isCoconutVilla3 = modelPublicSlug === 'coconut-villa-3';
const isArc = modelPublicSlug === 'arc';
const galleryImages = isSunsetCove
  ? Array.from({ length: 10 }, (_, index) => `${modelImageBase}/sunset-cove-${index + 1}.webp`)
  : (isAngel || isBahamaBeach)
    ? [heroImage, ...Array.from({ length: 9 }, (_, index) => `${modelImageBase}/${index + 1}.webp`)]
    : isAbaco
      ? [heroImage, ...Array.from({ length: 3 }, (_, index) => `${modelImageBase}/${index + 1}.webp`)]
      : isCaribbeanCottage
        ? [heroImage, ...Array.from({ length: 6 }, (_, index) => `${modelImageBase}/${index + 1}.webp`)]
        : isCasaLavanda
          ? [heroImage, ...Array.from({ length: 10 }, (_, index) => `${modelImageBase}/${index + 1}.webp`)]
          : isCasita
            ? [heroImage, ...Array.from({ length: 6 }, (_, index) => `${modelImageBase}/${index + 1}.webp`)]
            : isCharlston
              ? [heroImage, ...Array.from({ length: 2 }, (_, index) => `${modelImageBase}/${index + 1}.webp`)]
              : isCoconutVilla2
                ? [heroImage, ...Array.from({ length: 4 }, (_, index) => `${modelImageBase}/${index + 1}.webp`)]
                : isCoconutVilla3
                  ? [heroImage, ...Array.from({ length: 5 }, (_, index) => `${modelImageBase}/${index + 1}.webp`)]
                  : isArc
                    ? [heroImage, `${modelImageBase}/1.webp`]
                    : [
        heroImage,
        ...Array.from({ length: 9 }, (_, index) => `${modelImageBase}/${index + 1}.webp`),
      ];
const floorPlanImage = `${modelImageBase}/floorplan.webp`;
const sunsetCoveVideo = '/videos/sunset-cove.mp4';
const sunsetCovePlans = '/downloads/models/sunset-cove-plans.pdf';
const angelPlans = '/downloads/models/angel-plans.pdf';
const bahamaBeachPlans = '/downloads/models/bahama-beach-plans.pdf';
const caribbeanCottagePlans = '/downloads/models/caribbean-cottage-plans.pdf';
const casaLavandaPlans = '/downloads/models/casa-lavanda-plans.pdf';
const casitaPlans = '/downloads/models/casita-plans.pdf';
const charlstonPlans = '/downloads/models/charlston-plans.pdf';
const coconutVilla2Plans = '/downloads/models/coconut-villa-2-plans.pdf';
const coconutVilla3Plans = '/downloads/models/coconut-villa-3-plans.pdf';
const arcPlans = '/downloads/models/element-arc-plans.pdf';
---
<BaseLayout title={`${cleanName} | Bauhu Model Residence`} description={`${cleanName} is a Bauhu model residence that can be refined around your site, brief and way of living.`}>
  <SiteHeader />
  <main class="home-detail" data-model-name={model.name} data-model-slug={modelPublicSlug}>
    <section class="home-hero">
      <div class="home-hero-copy">
        <p class="home-kicker">Bauhu Model Residence</p>
        <h1>{cleanName}</h1>
        <p>{model.shortDescription}</p>
        <div class="home-actions">
          <a class="home-button" href={enquiryHref}>Start with this model</a>
        </div>
      </div>
      <div class="home-hero-image">
        <img src={heroImage} alt={`${cleanName} Bauhu model residence`} onerror="this.src='/images/model-placeholder.svg'" />
      </div>
    </section>

    <section class="home-specs" aria-label={`${cleanName} specifications`}>
      <div><span>Guide price</span><strong>{model.guidePriceLabel}</strong></div>
      <div><span>Bedrooms</span><strong>{model.bedroomsLabel}</strong></div>
      <div><span>Bathrooms</span><strong>{model.bathroomsLabel}</strong></div>
      <div><span>Storeys</span><strong>{model.storeysLabel}</strong></div>
      <div><span>Built area</span><strong>{model.builtAreaLabel} ft²</strong></div>
      <div><span>Style</span><strong>{model.style}</strong></div>
    </section>

    <section class="home-overview">
      <div>
        <p class="home-kicker">Model Overview</p>
        <h2>{isSunsetCove ? 'Open-plan island living, wrapped by a generous covered terrace.' : isAngel ? 'Compact contemporary living with three bedrooms and a strong indoor-outdoor connection.' : isBahamaBeach ? 'A compact three-bedroom island home with a shaded terrace at its heart.' : isAbaco ? 'A substantial two-storey Caribbean residence with generous verandas and a strong sense of arrival.' : isCaribbeanCottage ? 'A compact one-bedroom cottage with a shaded veranda and flexible work space.' : isCasaLavanda ? 'A large contemporary residence organised around water, landscape and expansive indoor-outdoor living.' : isCasita ? 'A compact two-bedroom residence centred on open-plan living and a covered pool terrace.' : isCharlston ? 'An elevated two-bedroom Caribbean villa with generous indoor-outdoor living and a broad wrap-around terrace.' : isCoconutVilla2 ? 'A compact two-bedroom island villa with two en-suite bedrooms and generous open-plan living.' : isCoconutVilla3 ? 'A three-bedroom island villa with three bathrooms and a flexible open-plan heart.' : isArc ? 'A compact three-bedroom contemporary home built around open-plan living and a covered terrace.' : 'A starting point for a site-specific Bauhu residence.'}</h2>
      </div>
      <div class="home-copy">
        {isSunsetCove ? (
          <>
            <p>Sunset Cove is a two-bedroom, two-bathroom residence built around spacious open-plan living and a strong connection between the interior and the covered deck.</p>
            <p>The model provides approximately 167 m² / 1,800 ft² of built area, with two 15 m² bedrooms, two bathrooms, a 46 m² living area, a 10 m² kitchen and an expansive 70 m² deck in the current architectural layout.</p>
            <p>A Bauhu model is the architectural starting point, not the finished specification. Orientation, glazing, finishes, shading, foundation strategy and other details can be refined around the site and project requirements.</p>
          </>
        ) : isAngel ? (
          <>
            <p>Angel is a three-bedroom, two-bathroom contemporary residence organised around a bright open-plan living and kitchen space, with a covered terrace extending the principal living area outdoors.</p>
            <p>The current architectural set shows a 116 m² building area plus a 26 m² terrace, with a 14 m² principal bedroom, two additional bedrooms, a 25 m² living area, 9 m² kitchen, utility room and a separate store / office.</p>
            <p>A Bauhu model is the architectural starting point, not the finished specification. Orientation, glazing, finishes, shading, foundation strategy and other details can be refined around the site and project requirements.</p>
          </>
        ) : isBahamaBeach ? (
          <>
            <p>Bahama Beach is a three-bedroom, two-bathroom single-storey residence combining a simple island-style roof form with a generous covered terrace and direct connections from the living space and bedrooms to the outdoors.</p>
            <p>The current architectural set shows approximately 83 m² / 894 ft² of enclosed building area plus a 23 m² / 251 ft² exterior terrace. The plan centres on a 29 m² open-plan living and kitchen space, with three bedrooms and two bathrooms.</p>
            <p>A Bauhu model is the architectural starting point, not the finished specification. Orientation, glazing, finishes, shading, foundation strategy and other details can be refined around the site and project requirements.</p>
          </>
        ) : isAbaco ? (
          <>
            <p>Abaco is a four-bedroom, two-storey residence with a classic Caribbean character, broad shaded verandas and a larger footprint suited to substantial family or hospitality use.</p>
            <p>The current model data records approximately 3,700 ft² of built area, with four bedrooms and four-and-a-half bathrooms.</p>
            <p>A Bauhu model is the architectural starting point, not the finished specification. Orientation, glazing, finishes, shading, foundation strategy and other details can be refined around the site and project requirements.</p>
          </>
        ) : isCaribbeanCottage ? (
          <>
            <p>Caribbean Cottage is a compact one-bedroom, one-bathroom residence designed around a 22 m² open-plan living and kitchen space, with an 8 m² office and a 17 m² covered deck.</p>
            <p>The current architectural set records approximately 60.3 m² / 649 ft² of enclosed building area, with a 14 m² bedroom and a 6 m² bathroom. Including the deck, the room schedule totals approximately 67 m² / 717 ft².</p>
            <p>A Bauhu model is the architectural starting point, not the finished specification. Orientation, glazing, finishes, shading, foundation strategy and other details can be refined around the site and project requirements.</p>
          </>
        ) : isCasaLavanda ? (
          <>
            <p>Casa Lavanda is a four-bedroom, two-storey contemporary residence arranged around generous living spaces, terraces and a strong relationship with the pool and landscape.</p>
            <p>The current architectural set records approximately 237 m² / 2,551 ft² on the ground floor and 241 m² / 2,594 ft² on the first floor, giving approximately 478 m² / 5,145 ft² of enclosed building area. The drawings also show extensive terraces, a dedicated office, pantry and laundry spaces.</p>
            <p>A Bauhu model is the architectural starting point, not the finished specification. Orientation, glazing, finishes, shading, foundation strategy and other details can be refined around the site and project requirements.</p>
          </>
        ) : isCasita ? (
          <>
            <p>Casita is a two-bedroom, two-bathroom single-storey residence arranged around a 47 m² open-plan living and kitchen space, with both bedrooms opening toward the outdoor areas.</p>
            <p>The current architectural set records a building footprint of approximately 117 m² / 1,260 ft², plus a 26 m² covered terrace and a 48 m² pool area. The plan includes a 16 m² primary bedroom with an 11 m² en-suite, a 21 m² second bedroom and a 5 m² en-suite.</p>
            <p>A Bauhu model is the architectural starting point, not the finished specification. Orientation, glazing, finishes, shading, foundation strategy and other details can be refined around the site and project requirements.</p>
          </>
        ) : isCharlston ? (
          <>
            <p>The Charlston is a two-bedroom, two-bathroom elevated Caribbean residence organised around a 40 m² open-plan living area, with both bedroom suites positioned at either end of the plan.</p>
            <p>The current architectural set records approximately 115 m² / 1,238 ft² of building area plus a 68 m² / 733 ft² exterior terrace. Each bedroom is approximately 18 m², with two 6 m² bathrooms, a powder room and a separate pantry.</p>
            <p>A Bauhu model is the architectural starting point, not the finished specification. Orientation, glazing, finishes, shading, foundation strategy and other details can be refined around the site and project requirements.</p>
          </>
        ) : isCoconutVilla2 ? (
          <>
            <p>Coconut Villa 2 is a two-bedroom, two-bathroom single-storey island residence arranged around a 40 m² open-plan living area, with a separate pantry and powder room.</p>
            <p>The current architectural set records a building footprint of approximately 114.3 m² / 1,230 ft². Both bedrooms are approximately 18 m² and each has its own 6 m² bathroom, creating a balanced layout suited to full-time living, a holiday home or guest accommodation.</p>
            <p>The imagery shown is illustrative of the Coconut Villa design family. A Bauhu model is the architectural starting point, not the finished specification, and the project is refined around the site, orientation, openings, finishes and approved scope.</p>
          </>
        ) : isCoconutVilla3 ? (
          <>
            <p>Coconut Villa 3 extends the same island-villa language into a three-bedroom, three-bathroom single-storey plan, organised around a 38 m² open-plan living area.</p>
            <p>The current architectural set records a building footprint of approximately 128 m² / 1,377 ft². The plan includes two 18 m² bedrooms, a 16 m² third bedroom, three bathrooms and a separate utility space.</p>
            <p>The imagery shown is illustrative of the Coconut Villa design family. A Bauhu model is the architectural starting point, not the finished specification, and the project is refined around the site, orientation, openings, finishes and approved scope.</p>
          </>
        ) : isArc ? (
          <>
            <p>Element ARC is a compact three-bedroom, two-bathroom single-storey residence organised around a 29 m² open-plan living and kitchen space, with a covered terrace extending the main living area outdoors.</p>
            <p>The current architectural set records approximately 83 m² / 894 ft² of building area plus a 23 m² / 243 ft² terrace. The plan includes two bedrooms of approximately 11 m², a smaller 7 m² third bedroom, a 5 m² en-suite and a 5 m² main bathroom.</p>
            <p>A Bauhu model is the architectural starting point, not the finished specification. Orientation, glazing, finishes, shading, foundation strategy and other details can be refined around the site and project requirements.</p>
          </>
        ) : (
          <>
            <p>{cleanName} gives you a proven architectural starting point while leaving room for site-specific refinement. The residence can be adapted around orientation, views, terrace layout, foundation strategy, finish level and the practical demands of building in a remote Caribbean location.</p>
            <p>When you are ready to begin a project, Bauhu starts with the site itself: location, access, survey information, planning context and the practical requirements of delivering the residence.</p>
          </>
        )}
      </div>
    </section>

    {isSunsetCove && (
      <section class="home-film" aria-label="Sunset Cove video">
        <div class="home-film-heading">
          <p class="home-kicker">Experience Sunset Cove</p>
          <h2>See the model in motion.</h2>
        </div>
        <div class="home-film-frame">
          <video autoplay muted loop playsinline preload="metadata" poster={heroImage}>
            <source src={sunsetCoveVideo} type="video/mp4" />
          </video>
        </div>
      </section>
    )}

    <section class="home-gallery" aria-label={`${cleanName} image gallery`}>
      <div class="home-section-heading"><p class="home-kicker">Gallery</p></div>
      <div class="home-gallery-grid">
        {galleryImages.map((image, index) => (
          <figure><img src={image} alt={`${cleanName} view ${index + 1}`} loading="lazy" onerror="this.closest('figure').hidden = true" /></figure>
        ))}
      </div>
    </section>

    <section class="home-floor-plan">
      <div class="home-floor-plan-heading">
        <div>
          <p class="home-kicker">Floor Plan</p>
          {isSunsetCove && <h2>Two bedrooms. Two bathrooms. Designed around the deck.</h2>}
          {isAngel && <h2>Three bedrooms, flexible work space and a covered terrace.</h2>}
          {isBahamaBeach && <h2>Three bedrooms, two bathrooms and a generous covered terrace.</h2>}
          {isCaribbeanCottage && <h2>One bedroom, flexible office space and a covered deck.</h2>}
          {isCasaLavanda && <h2>Four bedrooms across two floors, with extensive terraces and pool-facing living spaces.</h2>}
          {isCasita && <h2>Two bedrooms, two bathrooms and a covered pool terrace.</h2>}
          {isCharlston && <h2>Two bedroom suites, open-plan living and a 68 m² wrap-around terrace.</h2>}
          {isCoconutVilla2 && <h2>Two bedroom suites, open-plan living, pantry and powder room.</h2>}
          {isCoconutVilla3 && <h2>Three bedrooms, three bathrooms and an open-plan living core.</h2>}
          {isArc && <h2>Three bedrooms, two bathrooms and a covered terrace.</h2>}
        </div>
        {isSunsetCove && <a class="home-text-link" href={sunsetCovePlans} target="_blank" rel="noopener">View architectural plans ↗</a>}
        {isAngel && <a class="home-text-link" href={angelPlans} target="_blank" rel="noopener">View architectural plans ↗</a>}
        {isBahamaBeach && <a class="home-text-link" href={bahamaBeachPlans} target="_blank" rel="noopener">View architectural plans ↗</a>}
        {isCaribbeanCottage && <a class="home-text-link" href={caribbeanCottagePlans} target="_blank" rel="noopener">View architectural plans ↗</a>}
        {isCasaLavanda && <a class="home-text-link" href={casaLavandaPlans} target="_blank" rel="noopener">View architectural plans ↗</a>}
        {isCasita && <a class="home-text-link" href={casitaPlans} target="_blank" rel="noopener">View architectural plans ↗</a>}
        {isCharlston && <a class="home-text-link" href={charlstonPlans} target="_blank" rel="noopener">View architectural plans ↗</a>}
        {isCoconutVilla2 && <a class="home-text-link" href={coconutVilla2Plans} target="_blank" rel="noopener">View architectural plans ↗</a>}
        {isCoconutVilla3 && <a class="home-text-link" href={coconutVilla3Plans} target="_blank" rel="noopener">View architectural plans ↗</a>}
        {isArc && <a class="home-text-link" href={arcPlans} target="_blank" rel="noopener">View architectural plans ↗</a>}
      </div>
      <figure>
        <img src={floorPlanImage} alt={`${cleanName} floor plan`} loading="lazy" onerror="this.closest('figure').classList.add('is-missing')" />
        <figcaption>Floor plan image to be added.</figcaption>
      </figure>
      {(isSunsetCove || isAngel || isBahamaBeach || isCaribbeanCottage || isCasaLavanda || isCasita || isCharlston || isCoconutVilla2 || isCoconutVilla3 || isArc) && (
        <p class="home-plan-note">Plans shown are the current reference design and are provided for model evaluation. Final project information is developed and coordinated for the specific site and approved project scope.</p>
      )}
    </section>

    <section class="home-delivery">
      <div>
        <p class="home-kicker">More than a model</p>
        <h2>Designed, coordinated, shipped and supported through assembly.</h2>
      </div>
      <div class="home-delivery-copy">
        <p>Your Bauhu project extends beyond the architectural design. Engineering, procurement, manufacture, consolidation and shipping are coordinated around the approved project information.</p>
        <p>For site assembly, Bauhu provides detailed project information and assembly guidance covering sequencing, connections and key construction stages, and remains available to assist the local team with technical questions during assembly.</p>
        <p>The appointed local contractor and professionals remain responsible for site execution, supervision and professional judgement.</p>
      </div>
    </section>

    <section class="home-enquiry-block">
      <div>
        <p class="home-kicker">Next Step</p>
        <h2>Start your project with this model.</h2>
        <p>Use this model as your starting point and continue into the Bauhu project journey.</p>
        <div class="home-actions">
          <a class="home-button" href={enquiryHref}>Start with this model</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>



<style>
  .home-detail{background:#050505;color:#f4efe5}.home-kicker{margin:0 0 .75rem;font-family:Inter,sans-serif;font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;color:#c5a66a}.home-hero{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);min-height:84vh;border-bottom:1px solid rgba(244,239,229,.12)}.home-hero-copy{display:flex;flex-direction:column;justify-content:flex-end;padding:8rem 5vw}.home-hero h1,.home-overview h2,.home-delivery h2,.home-enquiry-block h2{margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;line-height:.96;letter-spacing:-.03em}.home-hero h1{font-size:clamp(4.5rem,10vw,10rem)}.home-overview h2,.home-delivery h2{max-width:680px;font-size:clamp(2.35rem,4.2vw,4.3rem)}.home-enquiry-block h2{max-width:850px;font-size:clamp(2.6rem,5vw,5rem)}.home-hero p:not(.home-kicker),.home-copy p,.home-delivery-copy p,.home-enquiry-block p{font-family:Inter,sans-serif;font-weight:300;line-height:1.78;color:rgba(244,239,229,.7)}.home-hero p:not(.home-kicker){max-width:620px;margin:1.5rem 0 0;font-size:clamp(1rem,1.55vw,1.28rem)}.home-hero-image{min-height:84vh;border-left:1px solid rgba(244,239,229,.12)}.home-hero-image img,.home-gallery img,.home-floor-plan img{width:100%;height:100%;display:block;object-fit:cover}.home-actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:2rem}.home-button{display:inline-flex;align-items:center;justify-content:center;border:1px solid rgba(197,166,106,.62);padding:.95rem 1.25rem;background:transparent;color:#f4efe5;font-family:Inter,sans-serif;font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;text-decoration:none;cursor:pointer}.home-specs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border-bottom:1px solid rgba(244,239,229,.12)}.home-specs div{padding:1.4rem 1.2rem;border-right:1px solid rgba(244,239,229,.12)}.home-specs span,.home-specs strong{display:block;font-family:Inter,sans-serif}.home-specs span{margin-bottom:.45rem;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(244,239,229,.48)}.home-specs strong{font-size:.96rem;font-weight:400;color:rgba(244,239,229,.88)}.home-overview,.home-gallery,.home-floor-plan,.home-delivery,.home-enquiry-block,.home-film{padding:clamp(3.5rem,6vw,6rem) 5vw}.home-overview,.home-delivery{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(2rem,5vw,5rem);width:min(1480px,100%);margin:0 auto}.home-delivery{border-top:1px solid rgba(244,239,229,.12);background:#0b0b0a}.home-copy p,.home-delivery-copy p{margin:0 0 1rem}.home-section-heading,.home-enquiry-block>div,.home-film-heading,.home-floor-plan-heading{width:min(1480px,100%);margin:0 auto 1.5rem}.home-film{background:#0b0b0a;border-top:1px solid rgba(244,239,229,.12);border-bottom:1px solid rgba(244,239,229,.12)}.home-film-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem}.home-film-heading h2,.home-floor-plan-heading h2{margin:0;font-family:'Cormorant Garamond',serif;font-size:clamp(2.35rem,4.2vw,4.3rem);font-weight:400;line-height:.96;letter-spacing:-.03em}.home-film-frame{width:min(1480px,100%);margin:2rem auto 0;aspect-ratio:16/9;overflow:hidden;background:#000}.home-film-frame video{display:block;width:100%;height:100%;object-fit:cover}.home-gallery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;width:min(1480px,100%);margin:0 auto}.home-gallery figure,.home-floor-plan figure{margin:0;min-height:380px;background:rgba(244,239,229,.05);border:1px solid rgba(244,239,229,.12);overflow:hidden}.home-gallery figure:first-child{grid-column:1/-1}.home-gallery figure:first-child img{aspect-ratio:2/1}.home-floor-plan-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem}.home-floor-plan-heading>div{max-width:900px}.home-text-link{flex:0 0 auto;color:#c5a66a;font-family:Inter,sans-serif;font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;text-decoration:none}.home-floor-plan figure{width:min(1200px,100%);margin:2.25rem auto 0;min-height:520px;background:#f3f0ea}.home-floor-plan img{object-fit:contain}.home-floor-plan figcaption{display:none;padding:3rem;font-family:Inter,sans-serif;color:rgba(244,239,229,.62);text-align:center}.home-floor-plan figure.is-missing img{display:none}.home-floor-plan figure.is-missing figcaption{display:block}.home-plan-note{width:min(1200px,100%);margin:1rem auto 0;font-family:Inter,sans-serif;font-size:.78rem;line-height:1.6;color:rgba(244,239,229,.48)}.home-enquiry-block{border-top:1px solid rgba(244,239,229,.12)}.home-enquiry-block p{max-width:760px;margin-top:1.2rem}@media(max-width:900px){.home-hero,.home-overview,.home-delivery{grid-template-columns:1fr}.home-hero-copy{padding-top:7rem}.home-hero-image{min-height:58vh;border-left:0;border-top:1px solid rgba(244,239,229,.12)}.home-specs{grid-template-columns:repeat(2,minmax(0,1fr))}.home-gallery-grid{grid-template-columns:1fr}.home-gallery figure:first-child{grid-column:auto}.home-gallery figure:first-child img{aspect-ratio:auto}.home-film-heading,.home-floor-plan-heading{align-items:flex-start;flex-direction:column}.home-film-frame{aspect-ratio:4/3}.home-floor-plan figure{min-height:0}.home-floor-plan img{height:auto;object-fit:contain}}
</style>
