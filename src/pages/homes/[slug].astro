---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { bauhuModels } from '../../data/models';

function titleCase(value: string) {
  return value
    .toLowerCase()
    .split(' ')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

export function getStaticPaths() {
  return bauhuModels.map((model) => ({
    params: { slug: model.slug.replace(/^bauhu-/, '') },
    props: { model },
  }));
}

const { model } = Astro.props;
const cleanName = titleCase(model.name);
const slug = model.slug;
const modelPublicSlug = slug.replace(/^bauhu-/, '');
const modelImageBase = `/images/models/${slug}`;
const heroImage = `${modelImageBase}/${slug}.webp`;
const enquiryHref = `/site-fit?model=${encodeURIComponent(modelPublicSlug)}`;
const isSunsetCove = modelPublicSlug === 'sunset-cove';
const galleryImages = isSunsetCove
  ? Array.from({ length: 10 }, (_, index) => `${modelImageBase}/sunset-cove-${index + 1}.webp`)
  : [
      heroImage,
      ...Array.from({ length: 9 }, (_, index) => `${modelImageBase}/${index + 1}.webp`),
    ];
const floorPlanImage = `${modelImageBase}/floorplan.webp`;
const sunsetCoveVideo = '/videos/sunset-cove.mp4';
const sunsetCovePlans = '/downloads/models/sunset-cove-plans.pdf';
---
<BaseLayout title={`${cleanName} | Bauhu Model Residence`} description={`${cleanName} is a Bauhu model residence that can be refined around your site, brief and way of living.`}>
  <SiteHeader />
  <main class="home-detail" data-model-name={model.name} data-model-slug={modelPublicSlug}>
    <section class="home-hero">
      <div class="home-hero-copy">
        <p class="home-kicker">Bauhu Model Residence</p>
        <h1>{cleanName}</h1>
        <p>{model.shortDescription}</p>
        <div class="home-actions">
          <a class="home-button" href={enquiryHref}>Start with this model</a>
        </div>
      </div>
      <div class="home-hero-image">
        <img src={heroImage} alt={`${cleanName} Bauhu model residence`} onerror="this.src='/images/model-placeholder.svg'" />
      </div>
    </section>

    <section class="home-specs" aria-label={`${cleanName} specifications`}>
      <div><span>Guide price</span><strong>{model.guidePriceLabel}</strong></div>
      <div><span>Bedrooms</span><strong>{model.bedroomsLabel}</strong></div>
      <div><span>Bathrooms</span><strong>{model.bathroomsLabel}</strong></div>
      <div><span>Storeys</span><strong>{model.storeysLabel}</strong></div>
      <div><span>Built area</span><strong>{model.builtAreaLabel} ft²</strong></div>
      <div><span>Style</span><strong>{model.style}</strong></div>
    </section>

    <section class="home-overview">
      <div>
        <p class="home-kicker">Model Overview</p>
        <h2>{isSunsetCove ? 'Open-plan island living, wrapped by a generous covered terrace.' : 'A starting point for a site-specific Bauhu residence.'}</h2>
      </div>
      <div class="home-copy">
        {isSunsetCove ? (
          <>
            <p>Sunset Cove is a two-bedroom, two-bathroom residence built around spacious open-plan living and a strong connection between the interior and the covered deck.</p>
            <p>The model provides approximately 167 m² / 1,800 ft² of built area, with two 15 m² bedrooms, two bathrooms, a 46 m² living area, a 10 m² kitchen and an expansive 70 m² deck in the current architectural layout.</p>
            <p>A Bauhu model is the architectural starting point, not the finished specification. Orientation, glazing, finishes, shading, foundation strategy and other details can be refined around the site and project requirements.</p>
          </>
        ) : (
          <>
            <p>{cleanName} gives you a proven architectural starting point while leaving room for site-specific refinement. The residence can be adapted around orientation, views, terrace layout, foundation strategy, finish level and the practical demands of building in a remote Caribbean location.</p>
            <p>When you are ready to begin a project, Bauhu starts with the site itself: location, access, survey information, planning context and the practical requirements of delivering the residence.</p>
          </>
        )}
      </div>
    </section>

    {isSunsetCove && (
      <section class="home-film" aria-label="Sunset Cove video">
        <div class="home-film-heading">
          <p class="home-kicker">Experience Sunset Cove</p>
          <h2>See the model in motion.</h2>
        </div>
        <div class="home-film-frame">
          <video autoplay muted loop playsinline preload="metadata" poster={heroImage}>
            <source src={sunsetCoveVideo} type="video/mp4" />
          </video>
        </div>
      </section>
    )}

    <section class="home-gallery" aria-label={`${cleanName} image gallery`}>
      <div class="home-section-heading"><p class="home-kicker">Gallery</p></div>
      <div class="home-gallery-grid">
        {galleryImages.map((image, index) => (
          <figure><img src={image} alt={`${cleanName} view ${index + 1}`} loading="lazy" onerror="this.closest('figure').hidden = true" /></figure>
        ))}
      </div>
    </section>

    <section class="home-floor-plan">
      <div class="home-floor-plan-heading">
        <div>
          <p class="home-kicker">Floor Plan</p>
          {isSunsetCove && <h2>Two bedrooms. Two bathrooms. Designed around the deck.</h2>}
        </div>
        {isSunsetCove && <a class="home-text-link" href={sunsetCovePlans} target="_blank" rel="noopener">View architectural plans ↗</a>}
      </div>
      <figure>
        <img src={floorPlanImage} alt={`${cleanName} floor plan`} loading="lazy" onerror="this.closest('figure').classList.add('is-missing')" />
        <figcaption>Floor plan image to be added.</figcaption>
      </figure>
      {isSunsetCove && (
        <p class="home-plan-note">Plans shown are the current reference design and are provided for model evaluation. Final project information is developed and coordinated for the specific site and approved project scope.</p>
      )}
    </section>

    <section class="home-enquiry-block">
      <div>
        <p class="home-kicker">Next Step</p>
        <h2>Start your project with this model.</h2>
        <p>Use this model as your starting point and continue into the Bauhu project journey.</p>
        <div class="home-actions">
          <a class="home-button" href={enquiryHref}>Start with this model</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>



<style>
  .home-detail{background:#050505;color:#f4efe5}.home-kicker{margin:0 0 .75rem;font-family:Inter,sans-serif;font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;color:#c5a66a}.home-hero{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);min-height:84vh;border-bottom:1px solid rgba(244,239,229,.12)}.home-hero-copy{display:flex;flex-direction:column;justify-content:flex-end;padding:8rem 5vw}.home-hero h1,.home-overview h2,.home-enquiry-block h2{margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;line-height:.96;letter-spacing:-.03em}.home-hero h1{font-size:clamp(4.5rem,10vw,10rem)}.home-overview h2{max-width:680px;font-size:clamp(2.35rem,4.2vw,4.3rem)}.home-enquiry-block h2{max-width:850px;font-size:clamp(2.6rem,5vw,5rem)}.home-hero p:not(.home-kicker),.home-copy p,.home-enquiry-block p{font-family:Inter,sans-serif;font-weight:300;line-height:1.78;color:rgba(244,239,229,.7)}.home-hero p:not(.home-kicker){max-width:620px;margin:1.5rem 0 0;font-size:clamp(1rem,1.55vw,1.28rem)}.home-hero-image{min-height:84vh;border-left:1px solid rgba(244,239,229,.12)}.home-hero-image img,.home-gallery img,.home-floor-plan img{width:100%;height:100%;display:block;object-fit:cover}.home-actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:2rem}.home-button{display:inline-flex;align-items:center;justify-content:center;border:1px solid rgba(197,166,106,.62);padding:.95rem 1.25rem;background:transparent;color:#f4efe5;font-family:Inter,sans-serif;font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;text-decoration:none;cursor:pointer}.home-specs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border-bottom:1px solid rgba(244,239,229,.12)}.home-specs div{padding:1.4rem 1.2rem;border-right:1px solid rgba(244,239,229,.12)}.home-specs span,.home-specs strong{display:block;font-family:Inter,sans-serif}.home-specs span{margin-bottom:.45rem;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(244,239,229,.48)}.home-specs strong{font-size:.96rem;font-weight:400;color:rgba(244,239,229,.88)}.home-overview,.home-gallery,.home-floor-plan,.home-enquiry-block,.home-film{padding:clamp(3.5rem,6vw,6rem) 5vw}.home-overview{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(2rem,5vw,5rem);width:min(1480px,100%);margin:0 auto}.home-copy p{margin:0 0 1rem}.home-section-heading,.home-enquiry-block>div,.home-film-heading,.home-floor-plan-heading{width:min(1480px,100%);margin:0 auto 1.5rem}.home-film{background:#0b0b0a;border-top:1px solid rgba(244,239,229,.12);border-bottom:1px solid rgba(244,239,229,.12)}.home-film-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem}.home-film-heading h2,.home-floor-plan-heading h2{margin:0;font-family:'Cormorant Garamond',serif;font-size:clamp(2.35rem,4.2vw,4.3rem);font-weight:400;line-height:.96;letter-spacing:-.03em}.home-film-frame{width:min(1480px,100%);margin:2rem auto 0;aspect-ratio:16/9;overflow:hidden;background:#000}.home-film-frame video{display:block;width:100%;height:100%;object-fit:cover}.home-gallery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;width:min(1480px,100%);margin:0 auto}.home-gallery figure,.home-floor-plan figure{margin:0;min-height:380px;background:rgba(244,239,229,.05);border:1px solid rgba(244,239,229,.12);overflow:hidden}.home-gallery figure:first-child{grid-column:1/-1}.home-gallery figure:first-child img{aspect-ratio:2/1}.home-floor-plan-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem}.home-floor-plan-heading>div{max-width:900px}.home-text-link{flex:0 0 auto;color:#c5a66a;font-family:Inter,sans-serif;font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;text-decoration:none}.home-floor-plan figure{width:min(1200px,100%);margin:2.25rem auto 0;min-height:520px;background:#f3f0ea}.home-floor-plan img{object-fit:contain}.home-floor-plan figcaption{display:none;padding:3rem;font-family:Inter,sans-serif;color:rgba(244,239,229,.62);text-align:center}.home-floor-plan figure.is-missing img{display:none}.home-floor-plan figure.is-missing figcaption{display:block}.home-plan-note{width:min(1200px,100%);margin:1rem auto 0;font-family:Inter,sans-serif;font-size:.78rem;line-height:1.6;color:rgba(244,239,229,.48)}.home-enquiry-block{border-top:1px solid rgba(244,239,229,.12)}.home-enquiry-block p{max-width:760px;margin-top:1.2rem}@media(max-width:900px){.home-hero,.home-overview{grid-template-columns:1fr}.home-hero-copy{padding-top:7rem}.home-hero-image{min-height:58vh;border-left:0;border-top:1px solid rgba(244,239,229,.12)}.home-specs{grid-template-columns:repeat(2,minmax(0,1fr))}.home-gallery-grid{grid-template-columns:1fr}.home-gallery figure:first-child{grid-column:auto}.home-gallery figure:first-child img{aspect-ratio:auto}.home-film-heading,.home-floor-plan-heading{align-items:flex-start;flex-direction:column}.home-film-frame{aspect-ratio:4/3}}
</style>
