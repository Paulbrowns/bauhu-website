---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { bauhuModels } from '../../data/models';

function titleCase(value: string) {
  return value
    .toLowerCase()
    .split(' ')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

export function getStaticPaths() {
  return bauhuModels.map((model) => ({
    params: { slug: model.slug.replace(/^bauhu-/, '') },
    props: { model },
  }));
}

const { model } = Astro.props;
const cleanName = titleCase(model.name);
const slug = model.slug;
const modelPublicSlug = slug.replace(/^bauhu-/, '');
const modelImageBase = `/images/models/${slug}`;
const heroImage = `${modelImageBase}/${slug}.webp`;
const enquiryHref = `/start-your-project?model=${encodeURIComponent(model.name)}`;
const galleryImages = [
  heroImage,
  `${modelImageBase}/1.webp`,
  `${modelImageBase}/2.webp`,
  `${modelImageBase}/3.webp`,
  `${modelImageBase}/4.webp`,
];
const floorPlanImage = `${modelImageBase}/floorplan.webp`;
---
<BaseLayout title={`${cleanName} | Bauhu Model Residence`} description={`${cleanName} is a Bauhu model residence that can be refined around your site, brief and way of living.`}>
  <SiteHeader />
  <main class="home-detail" data-model-name={model.name} data-model-slug={modelPublicSlug}>
    <section class="home-hero">
      <div class="home-hero-copy">
        <p class="home-kicker">Bauhu Model Residence</p>
        <h1>{cleanName}</h1>
        <p>{model.shortDescription}</p>
        <div class="home-actions">
          <button class="home-button" type="button" id="add-favourite">Add to favourites</button>
          <a class="home-button home-button-secondary" href={enquiryHref}>Discuss this model</a>
        </div>
      </div>
      <div class="home-hero-image">
        <img src={heroImage} alt={`${cleanName} Bauhu model residence`} onerror="this.src='/images/model-placeholder.svg'" />
      </div>
    </section>

    <section class="home-specs" aria-label={`${cleanName} specifications`}>
      <div>
        <span>Guide price</span>
        <strong>{model.guidePriceLabel}</strong>
      </div>
      <div>
        <span>Bedrooms</span>
        <strong>{model.bedroomsLabel}</strong>
      </div>
      <div>
        <span>Bathrooms</span>
        <strong>{model.bathroomsLabel}</strong>
      </div>
      <div>
        <span>Storeys</span>
        <strong>{model.storeysLabel}</strong>
      </div>
      <div>
        <span>Built area</span>
        <strong>{model.builtAreaLabel} ft²</strong>
      </div>
      <div>
        <span>Style</span>
        <strong>{model.style}</strong>
      </div>
    </section>

    <section class="home-overview">
      <div>
        <p class="home-kicker">Model Overview</p>
        <h2>A starting point for a site-specific Bauhu residence.</h2>
      </div>
      <div class="home-copy">
        <p>{cleanName} gives you a proven architectural starting point while leaving room for site-specific refinement. The residence can be adapted around orientation, views, terrace layout, foundation strategy, finish level and the practical demands of building in a remote Caribbean location.</p>
        <p>This page is a simple model detail format for images, plan information and enquiry intent. It can be expanded later with fuller specifications, options and related models.</p>
      </div>
    </section>

    <section class="home-gallery" aria-label={`${cleanName} image gallery`}>
      <div class="home-section-heading">
        <p class="home-kicker">Gallery</p>
        <h2>Images of the model.</h2>
      </div>
      <div class="home-gallery-grid">
        {galleryImages.map((image, index) => (
          <figure>
            <img src={image} alt={`${cleanName} view ${index + 1}`} loading="lazy" onerror="this.closest('figure').hidden = true" />
          </figure>
        ))}
      </div>
    </section>

    <section class="home-floor-plan">
      <div class="home-section-heading">
        <p class="home-kicker">Floor Plan</p>
        <h2>Plan information.</h2>
      </div>
      <figure>
        <img src={floorPlanImage} alt={`${cleanName} floor plan`} loading="lazy" onerror="this.closest('figure').classList.add('is-missing')" />
        <figcaption>Floor plan image to be added.</figcaption>
      </figure>
    </section>

    <section class="home-enquiry-block">
      <div>
        <p class="home-kicker">Next Step</p>
        <h2>Save this model or discuss it with Bauhu.</h2>
        <p>Add this model to favourites if you want to compare several options before making an enquiry. The enquiry form can later read your saved favourites and prefill the models of interest.</p>
        <div class="home-actions">
          <button class="home-button" type="button" id="add-favourite-bottom">Add to favourites</button>
          <a class="home-button home-button-secondary" href={enquiryHref}>Start an enquiry</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const page = document.querySelector('[data-model-name]');
  const buttons = [document.getElementById('add-favourite'), document.getElementById('add-favourite-bottom')].filter(Boolean);

  function getFavourites() {
    try {
      return JSON.parse(localStorage.getItem('bauhuModelFavourites') || '[]');
    } catch {
      return [];
    }
  }

  function setButtonState(isSaved) {
    buttons.forEach((button) => {
      button.textContent = isSaved ? 'Added to favourites' : 'Add to favourites';
    });
  }

  function addFavourite() {
    if (!page) return;
    const modelName = page.getAttribute('data-model-name');
    const modelSlug = page.getAttribute('data-model-slug');
    if (!modelName || !modelSlug) return;

    const favourites = getFavourites();
    if (!favourites.some((item) => item.slug === modelSlug)) {
      favourites.push({ slug: modelSlug, name: modelName });
      localStorage.setItem('bauhuModelFavourites', JSON.stringify(favourites));
    }

    setButtonState(true);
  }

  const currentSlug = page?.getAttribute('data-model-slug');
  setButtonState(getFavourites().some((item) => item.slug === currentSlug));
  buttons.forEach((button) => button.addEventListener('click', addFavourite));
</script>

<style>
  .home-detail {
    background: #050505;
    color: #f4efe5;
  }

  .home-kicker {
    margin: 0 0 1rem;
    font-family: Inter, sans-serif;
    font-size: 0.74rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #c5a66a;
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    min-height: 84vh;
    border-bottom: 1px solid rgba(244, 239, 229, 0.12);
  }

  .home-hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 8rem 5vw;
  }

  .home-hero h1,
  .home-overview h2,
  .home-section-heading h2,
  .home-enquiry-block h2 {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .home-hero h1 {
    font-size: clamp(4.5rem, 10vw, 10rem);
  }

  .home-hero p:not(.home-kicker),
  .home-copy p,
  .home-enquiry-block p {
    font-family: Inter, sans-serif;
    font-weight: 300;
    line-height: 1.85;
    color: rgba(244, 239, 229, 0.7);
  }

  .home-hero p:not(.home-kicker) {
    max-width: 620px;
    margin: 1.5rem 0 0;
    font-size: clamp(1rem, 1.55vw, 1.28rem);
  }

  .home-hero-image {
    min-height: 84vh;
    border-left: 1px solid rgba(244, 239, 229, 0.12);
  }

  .home-hero-image img,
  .home-gallery img,
  .home-floor-plan img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .home-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(197, 166, 106, 0.62);
    padding: 0.95rem 1.25rem;
    background: transparent;
    color: #f4efe5;
    font-family: Inter, sans-serif;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .home-button-secondary {
    border-color: rgba(244, 239, 229, 0.26);
  }

  .home-specs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-bottom: 1px solid rgba(244, 239, 229, 0.12);
  }

  .home-specs div {
    padding: 1.4rem 1.2rem;
    border-right: 1px solid rgba(244, 239, 229, 0.12);
  }

  .home-specs span,
  .home-specs strong {
    display: block;
    font-family: Inter, sans-serif;
  }

  .home-specs span {
    margin-bottom: 0.45rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(244, 239, 229, 0.48);
  }

  .home-specs strong {
    font-size: 0.96rem;
    font-weight: 400;
    color: rgba(244, 239, 229, 0.88);
  }

  .home-overview,
  .home-gallery,
  .home-floor-plan,
  .home-enquiry-block {
    padding: clamp(5rem, 9vw, 9rem) 5vw;
  }

  .home-overview {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    width: min(1480px, 100%);
    margin: 0 auto;
  }

  .home-overview h2,
  .home-section-heading h2,
  .home-enquiry-block h2 {
    max-width: 850px;
    font-size: clamp(3rem, 6vw, 6rem);
  }

  .home-copy p {
    margin: 0 0 1.5rem;
  }

  .home-section-heading,
  .home-enquiry-block > div {
    width: min(1480px, 100%);
    margin: 0 auto 2.5rem;
  }

  .home-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    width: min(1480px, 100%);
    margin: 0 auto;
  }

  .home-gallery figure,
  .home-floor-plan figure {
    margin: 0;
    min-height: 380px;
    background: rgba(244, 239, 229, 0.05);
    border: 1px solid rgba(244, 239, 229, 0.12);
    overflow: hidden;
  }

  .home-floor-plan figure {
    width: min(1100px, 100%);
    margin: 0 auto;
    min-height: 520px;
  }

  .home-floor-plan figcaption {
    display: none;
    padding: 3rem;
    font-family: Inter, sans-serif;
    color: rgba(244, 239, 229, 0.62);
    text-align: center;
  }

  .home-floor-plan figure.is-missing img {
    display: none;
  }

  .home-floor-plan figure.is-missing figcaption {
    display: block;
  }

  .home-enquiry-block {
    border-top: 1px solid rgba(244, 239, 229, 0.12);
  }

  .home-enquiry-block p {
    max-width: 760px;
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .home-hero,
    .home-overview {
      grid-template-columns: 1fr;
    }

    .home-hero-copy {
      padding-top: 7rem;
    }

    .home-hero-image {
      min-height: 58vh;
      border-left: 0;
      border-top: 1px solid rgba(244, 239, 229, 0.12);
    }

    .home-specs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
