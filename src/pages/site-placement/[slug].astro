---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { bauhuModels } from '../../data/models';

export function getStaticPaths() {
  return bauhuModels.map((model) => ({
    params: { slug: model.slug.replace(/^bauhu-/, '') },
    props: { model },
  }));
}

const { model } = Astro.props;
const publicSlug = model.slug.replace(/^bauhu-/, '');
const lat = Number(Astro.url.searchParams.get('lat') || 18.3419);
const lng = Number(Astro.url.searchParams.get('lng') || -64.9307);
const parcel = Astro.url.searchParams.get('parcel') ?? 'Confirmed site';
const area = Astro.url.searchParams.get('area') ?? 'Area not supplied';
const areaSqft = model.builtAreaSqftMin ?? 1200;
const areaM2 = areaSqft * 0.092903;
const footprintWidthM = Math.sqrt(areaM2 * 1.18);
const footprintDepthM = areaM2 / footprintWidthM;
---

<BaseLayout title={`Place ${model.name} on your site | Bauhu`} description={`Position the ${model.name} Bauhu home on the confirmed site.`}>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
  <SiteHeader />

  <main class="placement-page" data-lat={lat} data-lng={lng} data-width={footprintWidthM.toFixed(3)} data-depth={footprintDepthM.toFixed(3)}>
    <header class="placement-header">
      <div>
        <p class="kicker">BAUHU HOUSE PLACEMENT</p>
        <h1>Position {model.name} on your site.</h1>
        <p>Move and rotate the indicative footprint to explore an initial position. Final siting, setbacks and levels require professional verification.</p>
      </div>
      <aside>
        <span>Confirmed site</span>
        <strong>{parcel}</strong>
        <small>{area}</small>
        <small>{lat.toFixed(6)}, {lng.toFixed(6)}</small>
        <a href={`/site-fit/${publicSlug}`}>Return to site information</a>
      </aside>
    </header>

    <section class="workspace-shell">
      <aside class="placement-controls">
        <p class="kicker">PLACEMENT CONTROLS</p>
        <h2>{model.name}</h2>
        <dl>
          <div><dt>Indicative footprint</dt><dd>{footprintWidthM.toFixed(1)} × {footprintDepthM.toFixed(1)} m</dd></div>
          <div><dt>Built area</dt><dd>{model.builtAreaLabel} ft²</dd></div>
          <div><dt>Storeys</dt><dd>{model.storeysLabel}</dd></div>
        </dl>

        <label for="rotation">Rotation <strong id="rotation-value">0°</strong></label>
        <input id="rotation" type="range" min="0" max="359" value="0" step="1" />
        <div class="rotation-actions">
          <button id="rotate-left" type="button">−15°</button>
          <button id="north-align" type="button">North</button>
          <button id="rotate-right" type="button">+15°</button>
        </div>

        <button id="recenter-house" class="secondary" type="button">Re-centre house on site</button>
        <div class="instruction">Drag the gold handle to move the house. Use the slider to rotate it.</div>
      </aside>

      <section class="placement-map-shell">
        <div class="map-toolbar">
          <div class="base-switch">
            <button id="placement-map-view" class="active" type="button">Map</button>
            <button id="placement-satellite-view" type="button">Satellite</button>
          </div>
          <span id="placement-status">Indicative placement</span>
        </div>
        <div id="placement-map" aria-label="Interactive house placement map"></div>
        <footer>
          <div><span>House centre</span><strong id="house-centre">{lat.toFixed(6)}, {lng.toFixed(6)}</strong></div>
          <div><span>Rotation</span><strong id="footer-rotation">0°</strong></div>
          <div><span>Parcel fit</span><strong id="parcel-fit">Boundary geometry not carried forward</strong></div>
        </footer>
      </section>

      <aside class="placement-summary">
        <p class="kicker">PLACEMENT SUMMARY</p>
        <h2>Initial position</h2>
        <dl>
          <div><dt>Model</dt><dd>{model.name}</dd></div>
          <div><dt>Parcel</dt><dd>{parcel}</dd></div>
          <div><dt>Plot area</dt><dd>{area}</dd></div>
          <div><dt>Orientation</dt><dd id="summary-rotation">0°</dd></div>
          <div><dt>House centre</dt><dd id="summary-centre">{lat.toFixed(6)}, {lng.toFixed(6)}</dd></div>
          <div><dt>Coverage</dt><dd id="site-coverage">Pending parcel geometry</dd></div>
        </dl>
        <div class="warning">
          Exact parcel geometry is not yet available on this screen, so containment and setbacks cannot be verified in this first pass.
        </div>
        <button id="confirm-placement" type="button">Confirm indicative placement</button>
        <p class="note">This does not constitute planning approval, a legal setback check or a construction layout.</p>
      </aside>
    </section>
  </main>

  <SiteFooter />
  <script is:inline src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline>
    (() => {
      const page = document.querySelector('.placement-page');
      const mapEl = document.getElementById('placement-map');
      if (!page || !mapEl || !window.L) return;

      const startLat = Number(page.dataset.lat);
      const startLng = Number(page.dataset.lng);
      const width = Number(page.dataset.width);
      const depth = Number(page.dataset.depth);
      let angle = 0;
      let activeBase;

      const map = L.map(mapEl, { zoomControl: false }).setView([startLat, startLng], 19);
      L.control.zoom({ position: 'bottomright' }).addTo(map);
      const street = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 20, attribution: '&copy; OpenStreetMap contributors' });
      const satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 20, attribution: 'Tiles &copy; Esri' });

      function setBase(layer, mode) {
        if (activeBase) map.removeLayer(activeBase);
        activeBase = layer.addTo(map);
        document.getElementById('placement-map-view').classList.toggle('active', mode === 'map');
        document.getElementById('placement-satellite-view').classList.toggle('active', mode === 'satellite');
      }
      setBase(satellite, 'satellite');
      document.getElementById('placement-map-view').onclick = () => setBase(street, 'map');
      document.getElementById('placement-satellite-view').onclick = () => setBase(satellite, 'satellite');

      const handle = L.marker([startLat, startLng], { draggable: true }).addTo(map);
      let footprint = L.polygon([], { color: '#c5a66a', weight: 3, fillColor: '#17394c', fillOpacity: .5 }).addTo(map);
      footprint.bindTooltip('Indicative house footprint', { permanent: true, direction: 'center', className: 'placement-label' });

      function offset(lat, lng, east, north) {
        const r = lat * Math.PI / 180;
        return [lat + north / 111320, lng + east / (111320 * Math.cos(r))];
      }

      function corners(lat, lng) {
        const hw = width / 2;
        const hd = depth / 2;
        const rad = angle * Math.PI / 180;
        return [[-hw,-hd],[hw,-hd],[hw,hd],[-hw,hd]].map(([x,y]) => {
          const east = x * Math.cos(rad) - y * Math.sin(rad);
          const north = x * Math.sin(rad) + y * Math.cos(rad);
          return offset(lat, lng, east, north);
        });
      }

      function update() {
        const centre = handle.getLatLng();
        footprint.setLatLngs(corners(centre.lat, centre.lng));
        const coords = `${centre.lat.toFixed(6)}, ${centre.lng.toFixed(6)}`;
        document.getElementById('house-centre').textContent = coords;
        document.getElementById('summary-centre').textContent = coords;
        document.getElementById('rotation-value').textContent = `${angle}°`;
        document.getElementById('footer-rotation').textContent = `${angle}°`;
        document.getElementById('summary-rotation').textContent = `${angle}°`;
        document.getElementById('rotation').value = String(angle);
      }

      handle.on('drag', update);
      document.getElementById('rotation').addEventListener('input', (event) => {
        angle = Number(event.target.value);
        update();
      });
      document.getElementById('rotate-left').onclick = () => { angle = (angle + 345) % 360; update(); };
      document.getElementById('rotate-right').onclick = () => { angle = (angle + 15) % 360; update(); };
      document.getElementById('north-align').onclick = () => { angle = 0; update(); };
      document.getElementById('recenter-house').onclick = () => { handle.setLatLng([startLat, startLng]); map.setView([startLat, startLng], 19); update(); };
      document.getElementById('confirm-placement').onclick = () => {
        document.getElementById('placement-status').textContent = 'Indicative placement confirmed';
        document.getElementById('confirm-placement').textContent = 'Placement confirmed';
        document.getElementById('confirm-placement').disabled = true;
      };

      update();
      requestAnimationFrame(() => map.invalidateSize());
    })();
  </script>
</BaseLayout>

<style>
  :global(.leaflet-container){font-family:Inter,sans-serif;background:#d9dfdc}:global(.placement-label){border:0;background:rgba(23,57,76,.92);color:#fff;box-shadow:none;font:700 10px/1 Inter,sans-serif;letter-spacing:.08em;text-transform:uppercase}:global(.placement-label:before){display:none}
  .placement-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}.placement-header{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:4rem;padding:3.4rem 4vw 2.4rem;border-bottom:1px solid rgba(23,57,76,.18)}.kicker,.placement-header aside>span{margin:0 0 .8rem;font:700 .68rem/1 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#9b7b49}.placement-header h1{max-width:980px;margin:0 0 1rem;font:400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif}.placement-header>div>p:last-child{max-width:760px;font:300 1rem/1.7 Inter,sans-serif;color:rgba(23,57,76,.7)}.placement-header aside{display:flex;flex-direction:column;justify-content:flex-end;gap:.45rem;padding-left:2rem;border-left:1px solid rgba(23,57,76,.18);font-family:Inter,sans-serif}.placement-header aside strong{font:400 1.8rem 'Cormorant Garamond',serif}.placement-header aside a{margin-top:.55rem;color:#17394c;font-weight:700}
  .workspace-shell{display:grid;grid-template-columns:300px minmax(0,1fr) 290px;min-height:760px}.placement-controls,.placement-summary{padding:1.4rem;background:#f7f5ef}.placement-controls{border-right:1px solid rgba(23,57,76,.16)}.placement-summary{border-left:1px solid rgba(23,57,76,.16)}.placement-controls h2,.placement-summary h2{margin:.2rem 0 1rem;font:400 2rem 'Cormorant Garamond',serif}.placement-controls dl,.placement-summary dl{margin:0 0 1.2rem}.placement-controls dl div,.placement-summary dl div{display:flex;justify-content:space-between;gap:1rem;padding:.65rem 0;border-top:1px solid rgba(23,57,76,.13);font:400 .67rem Inter,sans-serif}.placement-controls dd,.placement-summary dd{margin:0;text-align:right;font-weight:700}.placement-controls label{display:flex;justify-content:space-between;margin-bottom:.5rem;font:700 .68rem Inter,sans-serif}.placement-controls input[type=range]{width:100%}.rotation-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem;margin:.75rem 0}.rotation-actions button,.secondary{padding:.7rem;border:1px solid rgba(23,57,76,.2);background:#fff;color:#17394c;font-weight:700}.secondary{width:100%;margin:0 0 .8rem}.instruction,.warning{padding:.9rem;background:#ece9df;font:400 .64rem/1.55 Inter,sans-serif}.warning{margin:1rem 0;background:#eee4cf}.placement-summary button{width:100%;padding:.9rem;border:0;background:#17394c;color:#fff;font-weight:700}.note{font:400 .58rem/1.5 Inter,sans-serif;color:rgba(23,57,76,.55)}
  .placement-map-shell{display:grid;grid-template-rows:auto 1fr auto;min-width:0}.map-toolbar{display:flex;justify-content:space-between;align-items:center;padding:.7rem .9rem;background:#f7f5ef;border-bottom:1px solid rgba(23,57,76,.16);font:700 .62rem Inter,sans-serif}.base-switch{display:flex;gap:.35rem}.map-toolbar button{padding:.5rem .8rem;border:1px solid rgba(23,57,76,.18);background:#fff;color:#17394c;font:700 .66rem Inter,sans-serif}.map-toolbar button.active{background:#17394c;color:#fff}#placement-map{min-height:660px}.placement-map-shell footer{display:grid;grid-template-columns:repeat(3,1fr);background:#f7f5ef}.placement-map-shell footer div{padding:.8rem 1rem;border-right:1px solid rgba(23,57,76,.12)}.placement-map-shell footer span,.placement-map-shell footer strong{display:block;font-family:Inter,sans-serif}.placement-map-shell footer span{font-size:.56rem;text-transform:uppercase;color:rgba(23,57,76,.5)}.placement-map-shell footer strong{margin-top:.25rem;font-size:.68rem}
  @media(max-width:1100px){.workspace-shell{grid-template-columns:280px minmax(0,1fr)}.placement-summary{grid-column:1/-1;border-left:0;border-top:1px solid rgba(23,57,76,.16)}}@media(max-width:760px){.placement-header{grid-template-columns:1fr}.placement-header aside{padding:1.5rem 0 0;border-left:0;border-top:1px solid rgba(23,57,76,.18)}.workspace-shell{grid-template-columns:1fr}.placement-controls{border-right:0;border-bottom:1px solid rgba(23,57,76,.16)}#placement-map{min-height:520px}.placement-map-shell footer{grid-template-columns:1fr}.placement-summary{grid-column:auto}.map-toolbar{align-items:flex-start;gap:.7rem;flex-direction:column}}
</style>
