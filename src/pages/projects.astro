---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projectJournal } from '../data/project-journal.js';

const fallbackImage = '/images/developments/bauhu-projects-hero.webp';

// Curated portfolio covers; project galleries retain their construction sequence.
const portfolioCovers = {
  "ft-myers-beach": "/images/project-gallery/ft-myers-beach/ft-myers-beach-elevated-steel-frame-structure.webp",
  "coral-bay-st-john": "/images/project-gallery/coral-bay-st-john/coral-bay-st-john-finished-modern-exterior.webp",
  "st-thomas-usvi": "/images/project-gallery/st-thomas-usvi/st-thomas-oceanfront-steel-frame-aerial.webp",
  "cat-island": "/images/project-gallery/cat-island/cat-island-home-beachfront-setting.webp",
  "exuma-waterfront": "/images/project-gallery/exuma-waterfront/exuma-waterfront-prefabricated-steel-framed-house.webp",
  "elbow-cay": "/images/project-gallery/elbow-cay/elbow-cay-bahamas-waterfront-home-exterior.webp"
};
const featuredProjects = projectJournal.map(p => ({ title: p.title, location: p.region, summary: p.intro, image: portfolioCovers[p.slug] || p.images[0]?.src || fallbackImage, detailSlug: p.slug }));
---
<BaseLayout title="Caribbean Modular Home Projects | Bauhu" description="Explore Bauhu's hurricane-resistant modular homes, luxury prefabricated villas and steel-frame construction projects across the Bahamas, US Virgin Islands and Caribbean.">
  <SiteHeader />
  <main class="bg-paper">
    <section class="relative flex min-h-[78vh] items-end overflow-hidden bg-navy text-paper">
      <img src={fallbackImage} alt="Current Bauhu project" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-navy/70 via-navy/30 to-navy/10"></div>
      <div class="relative z-10 mx-auto grid w-full max-w-site gap-12 px-5 pb-16 pt-36 lg:grid-cols-[0.9fr_1.1fr] lg:px-10 lg:pb-20">
        <div>
          <p class="eyebrow text-stone">Current projects</p>
          <h1 class="mt-5 max-w-4xl font-display text-5xl leading-tight md:text-7xl">Hurricane-Resistant Modular Homes. Real Caribbean Projects.</h1>
        </div>
        <div class="self-end space-y-7 text-lg leading-8 text-paper/75">
          <p>Explore Bauhu's portfolio of luxury modular homes, prefabricated steel-frame buildings and hurricane-resistant construction across the Bahamas, US Virgin Islands and wider Caribbean.</p>
          <p>From structural assembly to completed coastal residences, see how Bauhu homes take shape in challenging island locations.</p>
        </div>
      </div>
    </section>

    <section class="section-pad bg-mist">
      <div class="mx-auto max-w-site">
        <div>
          <p class="eyebrow text-clay">Our projects</p>
          <h2 class="mt-5 max-w-3xl font-display text-4xl leading-tight md:text-6xl">Modular Home Projects Across the Caribbean and Beyond.</h2>
        </div>

        <div class="project-slider mt-14" data-project-slider>
          <div class="mb-6 flex justify-end gap-2">
            <button type="button" class="project-slider-button" data-project-prev aria-label="Previous project">←</button>
            <button type="button" class="project-slider-button" data-project-next aria-label="Next project">→</button>
          </div>

          <div class="project-slider-window overflow-hidden" data-project-window>
            <div class="project-slider-track flex gap-5 transition-transform duration-500 ease-out" data-project-track>
              {featuredProjects.map((project, index) => (
                <article class="project-slide min-w-[86%] overflow-hidden bg-forest text-paper sm:min-w-[64%] lg:min-w-[38%] xl:min-w-[32%]">
                  <figure class="relative h-72 overflow-hidden bg-navy">
                    <img src={project.image} alt={`${project.title} Bauhu project`} class="h-full w-full object-cover opacity-90 transition duration-500 hover:scale-105" loading={index === 0 ? 'eager' : 'lazy'} onerror={`this.src='${fallbackImage}'`} />
                    <div class="absolute inset-0 bg-gradient-to-t from-navy/45 via-navy/5 to-transparent"></div>
                  </figure>
                  <div class="p-7">
                    <p class="text-xs uppercase tracking-wide text-stone">{project.location}</p>
                    <h3 class="mt-8 font-display text-4xl leading-tight">{project.title}</h3>
                    <p class="mt-5 min-h-20 leading-7 text-paper/70">{project.summary}</p>
                    {'detailSlug' in project && project.detailSlug && (
                      <a href={`/projects/${project.detailSlug}/`} class="mt-6 inline-flex border-b border-paper/50 pb-1 text-sm font-medium text-paper hover:border-paper">Explore project →</a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad bg-navy text-paper">
      <div class="mx-auto grid max-w-site gap-10 lg:grid-cols-[1fr_0.8fr] lg:items-center">
        <div>
          <p class="eyebrow text-stone">Start a project</p>
          <h2 class="mt-5 max-w-4xl font-display text-4xl leading-tight md:text-6xl">Planning a Modular Home in the Caribbean?</h2>
          <p class="mt-8 max-w-2xl text-lg leading-8 text-paper/70">Whether you're building a luxury island villa, a hurricane-resistant home or a coastal development, Bauhu can help assess your site, design requirements, construction strategy and delivery logistics.</p>
        </div>
        <div class="flex flex-col gap-4 sm:flex-row lg:justify-end">
          <a href="/site-fit" class="inline-flex rounded-full bg-paper px-7 py-4 text-sm uppercase tracking-wide text-ink">Start site review</a>
          <a href="/models" class="inline-flex rounded-full border border-paper/35 px-7 py-4 text-sm uppercase tracking-wide text-paper">Explore models</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .project-slider-button {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(26 29 32 / 0.18);
    border-radius: 999px;
    background: rgba(255,255,255,0.72);
    color: #1A1D20;
    transition: transform 180ms ease, background 180ms ease;
  }

  .project-slider-button:hover {
    transform: translateY(-1px);
    background: #fff;
  }
</style>

<script>
  const slider = document.querySelector('[data-project-slider]');
  const track = slider?.querySelector('[data-project-track]');
  const windowElement = slider?.querySelector('[data-project-window]');
  const slides = Array.from(slider?.querySelectorAll('.project-slide') ?? []);
  const previous = slider?.querySelector('[data-project-prev]');
  const next = slider?.querySelector('[data-project-next]');
  let currentIndex = 0;

  const getStep = () => {
    const firstSlide = slides[0];
    if (!firstSlide || !track) return 0;
    const slideWidth = firstSlide.getBoundingClientRect().width;
    const gap = Number.parseFloat(getComputedStyle(track).columnGap || '0');
    return slideWidth + gap;
  };

  const getMaxIndex = () => {
    if (!track || !windowElement || slides.length === 0) return 0;
    const step = getStep();
    if (step === 0) return 0;
    const overflowWidth = track.scrollWidth - windowElement.clientWidth;
    return Math.max(0, Math.ceil(overflowWidth / step));
  };

  const updateSlider = () => {
    if (!track || slides.length === 0) return;
    const maxIndex = getMaxIndex();
    currentIndex = Math.min(Math.max(currentIndex, 0), maxIndex);
    track.style.transform = `translateX(-${currentIndex * getStep()}px)`;
  };

  previous?.addEventListener('click', () => {
    const maxIndex = getMaxIndex();
    currentIndex = currentIndex <= 0 ? maxIndex : currentIndex - 1;
    updateSlider();
  });

  next?.addEventListener('click', () => {
    const maxIndex = getMaxIndex();
    currentIndex = currentIndex >= maxIndex ? 0 : currentIndex + 1;
    updateSlider();
  });

  window.addEventListener('resize', updateSlider);
</script>
