const projectSignals = [
  'Live assembly and construction updates',
  'Remote island and coastal logistics',
  'Hurricane-rated structural response',
  'Project-specific architecture and engineering',
];
---
<BaseLayout title="Current Projects | Bauhu" description="Current and recent Bauhu projects across coastal, island and hurricane-exposed locations.">
  <SiteHeader />
  <main class="bg-paper">
    <section class="relative flex min-h-[78vh] items-end overflow-hidden bg-ink text-paper">
      <img src="/images/developments/bauhu-projects-hero.jpg" alt="Current Bauhu project" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/45 to-ink/20"></div>
      <div class="relative z-10 mx-auto grid w-full max-w-site gap-12 px-5 pb-16 pt-36 lg:grid-cols-[0.9fr_1.1fr] lg:px-10 lg:pb-20">
        <div>
          <p class="eyebrow text-stone">Current projects</p>
          <h1 class="mt-5 max-w-4xl font-display text-5xl leading-tight md:text-7xl">Bauhu in the field, not just in the catalogue.</h1>
        </div>
        <div class="self-end space-y-7 text-lg leading-8 text-paper/75">
          <p>See how Bauhu projects are progressing across real coastal, island and hurricane-exposed locations.</p>
          <p>This page follows current and recent projects through design intent, site constraints, engineering response, logistics, assembly and delivery.</p>
        </div>
      </div>
    </section>

    <section class="section-pad bg-mist">
      <div class="mx-auto max-w-site">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div>
            <p class="eyebrow text-clay">Project news</p>
            <h2 class="mt-5 max-w-3xl font-display text-4xl leading-tight md:text-6xl">Current and recent Bauhu projects.</h2>
          </div>
          <div class="space-y-6 text-lg leading-8 text-ink/70">
            <p>The focus is shifting from a completed-project archive to an active project view: what is being assembled, what is under construction, and what recent projects prove about Bauhu’s process.</p>
            <div class="flex flex-wrap gap-3">
              {projectSignals.map((signal) => (
                <span class="rounded-full border border-ink/15 bg-paper px-4 py-2 text-xs uppercase tracking-wide text-ink/65">{signal}</span>
              ))}
            </div>
          </div>
        </div>

        <div class="project-slider mt-14" data-project-slider>
          <div class="mb-6 flex items-center justify-between gap-4">
            <p class="text-sm uppercase tracking-[0.22em] text-ink/45">Project updates</p>
            <div class="flex gap-2">
              <button type="button" class="project-slider-button" data-project-prev aria-label="Previous project">←</button>
              <button type="button" class="project-slider-button" data-project-next aria-label="Next project">→</button>
            </div>
          </div>

          <div class="project-slider-window overflow-hidden" data-project-window>
            <div class="project-slider-track flex gap-5 transition-transform duration-500 ease-out" data-project-track>
              {featuredProjects.map((project, index) => (
                <article class="project-slide min-w-[86%] overflow-hidden bg-forest text-paper sm:min-w-[64%] lg:min-w-[38%] xl:min-w-[32%]">
                  <figure class="relative h-72 overflow-hidden bg-ink">
                    <img src={project.image} alt={`${project.title} Bauhu project`} class="h-full w-full object-cover opacity-90 transition duration-500 hover:scale-105" loading={index === 0 ? 'eager' : 'lazy'} onerror="this.src='/images/developments/bauhu-projects-hero.jpg'" />
                    <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-ink/5 to-transparent"></div>
                  </figure>
                  <div class="p-7">
                    <p class="text-xs uppercase tracking-wide text-stone">{project.location}</p>
                    <h3 class="mt-8 font-display text-4xl leading-tight">{project.title}</h3>
                    <p class="mt-5 min-h-36 leading-7 text-paper/70">{project.summary}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad bg-paper">
      <div class="mx-auto grid max-w-site gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="eyebrow text-clay">What these projects show</p>
          <h2 class="mt-5 font-display text-4xl leading-tight md:text-6xl">The real work behind resilient homes.</h2>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          {[
            ['Coastal exposure', 'Flood zones, uplift, wind load and corrosion risk are design inputs, not afterthoughts.'],
            ['Remote logistics', 'Project planning considers freight, access, lifting, sequencing and local site capability.'],
            ['Hybrid steel frame', 'Bauhu’s structural approach is designed for precision, repeatability and hurricane-rated performance.'],
            ['Local assembly', 'The system supports trusted local contractors with engineered information and a controlled building package.'],
          ].map(([title, text]) => (
            <article class="bg-mist p-7">
              <h3 class="font-display text-3xl">{title}</h3>
              <p class="mt-5 leading-7 text-ink/65">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-pad bg-ink text-paper">
      <div class="mx-auto grid max-w-site gap-10 lg:grid-cols-[1fr_0.8fr] lg:items-center">
        <div>
          <p class="eyebrow text-stone">Start a project</p>
          <h2 class="mt-5 max-w-4xl font-display text-4xl leading-tight md:text-6xl">Have a difficult site? Bring Bauhu in early.</h2>
          <p class="mt-8 max-w-2xl text-lg leading-8 text-paper/70">The earlier Bauhu can review the site, climate, access, planning position and project objectives, the more control the team can build into the design and delivery strategy.</p>
        </div>
        <div class="flex flex-col gap-4 sm:flex-row lg:justify-end">
          <a href="/site-fit" class="inline-flex rounded-full bg-paper px-7 py-4 text-sm uppercase tracking-wide text-ink">Start site review</a>
          <a href="/models" class="inline-flex rounded-full border border-paper/35 px-7 py-4 text-sm uppercase tracking-wide text-paper">Explore models</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .project-slider-button {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(26 29 32 / 0.18);
    border-radius: 999px;
    background: rgba(255,255,255,0.72);
    color: #1A1D20;
    transition: transform 180ms ease, background 180ms ease;
  }

  .project-slider-button:hover {
    transform: translateY(-1px);
    background: #fff;
  }
</style>

<script>
  const slider = document.querySelector('[data-project-slider]');
  const track = slider?.querySelector('[data-project-track]');
  const windowElement = slider?.querySelector('[data-project-window]');
  const slides = Array.from(slider?.querySelectorAll('.project-slide') ?? []);
  const previous = slider?.querySelector('[data-project-prev]');
  const next = slider?.querySelector('[data-project-next]');
  let currentIndex = 0;

  const getStep = () => {
    const firstSlide = slides[0];
    if (!firstSlide || !track) return 0;
    const slideWidth = firstSlide.getBoundingClientRect().width;
    const gap = Number.parseFloat(getComputedStyle(track).columnGap || '0');
    return slideWidth + gap;
  };

  const getMaxIndex = () => {
    if (!track || !windowElement) return Math.max(0, slides.length - 1);
    const step = getStep();
    if (!step) return 0;
    const overflow = Math.max(0, track.scrollWidth - windowElement.clientWidth);
    return Math.ceil(overflow / step);
  };

  const updateSlider = () => {
    if (!track || slides.length === 0) return;
    const maxIndex = getMaxIndex();
    currentIndex = Math.min(Math.max(currentIndex, 0), maxIndex);
    track.style.transform = `translateX(-${currentIndex * getStep()}px)`;
  };

  previous?.addEventListener('click', () => {
    const maxIndex = getMaxIndex();
    currentIndex = currentIndex <= 0 ? maxIndex : currentIndex - 1;
    updateSlider();
  });

  next?.addEventListener('click', () => {
    const maxIndex = getMaxIndex();
    currentIndex = currentIndex >= maxIndex ? 0 : currentIndex + 1;
    updateSlider();
  });

  window.addEventListener('resize', updateSlider);
</script>
