---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const locations = ['Bahamas', 'Jamaica', 'Antigua', 'Tortola', 'St John', 'Eleuthera'];
---
<BaseLayout title="Projects | Bauhu" description="Bauhu project archive and case studies.">
  <SiteHeader />
  <main class="bg-paper">
    <section class="relative flex min-h-[78vh] items-end overflow-hidden bg-ink text-paper">
      <img src="/images/developments/bauhu-projects-hero.jpg" alt="Bauhu project" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/45 to-ink/20"></div>
      <div class="relative z-10 mx-auto grid w-full max-w-site gap-12 px-5 pb-16 pt-36 lg:grid-cols-[0.9fr_1.1fr] lg:px-10 lg:pb-20">
        <div>
          <p class="eyebrow text-stone">Projects</p>
          <h1 class="mt-5 max-w-4xl font-display text-5xl leading-tight md:text-7xl">Real projects are the proof of the system.</h1>
        </div>
        <div class="self-end space-y-7 text-lg leading-8 text-paper/75">
          <p>Bauhu projects span private homes, model-based residences and larger developments across remote and coastal locations.</p>
          <p>Each case study will show the real conditions behind the architecture: site constraints, engineering response, logistics, manufacture and the role Bauhu played in getting the building delivered.</p>
        </div>
      </div>
    </section>

    <section class="section-pad bg-mist">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-clay">Locations</p>
        <h2 class="mt-5 max-w-3xl font-display text-4xl leading-tight md:text-6xl">Different places. Different constraints. One controlled approach.</h2>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {locations.map((location) => (
            <article class="overflow-hidden bg-forest text-paper">
              <div class="flex min-h-56 items-center justify-center border-b border-paper/15 bg-ink/25 p-6 text-center">
                <div><p class="eyebrow text-stone">IMAGE PLACEHOLDER</p><p class="mt-3 text-sm text-paper/55">Real project / construction / completed home</p></div>
              </div>
              <div class="p-7">
                <p class="eyebrow text-stone">Project location</p>
                <h3 class="mt-4 font-display text-4xl">{location}</h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-pad bg-paper">
      <div class="mx-auto grid max-w-site gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="eyebrow text-clay">What the case studies will show</p>
          <h2 class="mt-5 font-display text-4xl leading-tight md:text-6xl">Proof beyond the finished photograph.</h2>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          {['The site and constraint','The architectural response','Engineering and manufacture','Shipping, assembly and outcome'].map((item) => (
            <div class="bg-mist p-7"><p class="font-display text-3xl">{item}</p></div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
