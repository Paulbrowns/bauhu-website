---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { bauhuModels } from '../data/models';

const filterGroups = [
  {
    key: 'style',
    label: 'Style',
    options: [
      { label: 'All', value: 'all' },
      { label: 'Classic', value: 'Classic' },
      { label: 'Contemporary', value: 'Contemporary' },
    ],
  },
  {
    key: 'price',
    label: 'Guide price',
    options: [
      { label: 'All', value: 'all' },
      { label: 'Under $250k', value: '0-250000' },
      { label: '$250k-$500k', value: '250000-500000' },
      { label: '$500k-$750k', value: '500000-750000' },
      { label: '$750k-$1m', value: '750000-1000000' },
      { label: '$1m+', value: '1000000-' },
    ],
  },
  {
    key: 'bedrooms',
    label: 'Bedrooms',
    options: [
      { label: 'All', value: 'all' },
      { label: '1+', value: '1' },
      { label: '2+', value: '2' },
      { label: '3+', value: '3' },
      { label: '4+', value: '4' },
      { label: '5+', value: '5' },
    ],
  },
  {
    key: 'bathrooms',
    label: 'Bathrooms',
    options: [
      { label: 'All', value: 'all' },
      { label: '1+', value: '1' },
      { label: '2+', value: '2' },
      { label: '3+', value: '3' },
      { label: '4+', value: '4' },
    ],
  },
  {
    key: 'storeys',
    label: 'Storeys',
    options: [
      { label: 'All', value: 'all' },
      { label: '1', value: '1' },
      { label: '2', value: '2' },
      { label: '3', value: '3' },
    ],
  },
  {
    key: 'area',
    label: 'Built area',
    options: [
      { label: 'All', value: 'all' },
      { label: 'Under 1,000 ft²', value: '0-1000' },
      { label: '1,000-1,500 ft²', value: '1000-1500' },
      { label: '1,500-2,500 ft²', value: '1500-2500' },
      { label: '2,500-4,000 ft²', value: '2500-4000' },
      { label: '4,000+ ft²', value: '4000-' },
    ],
  },
];

const steps = [
  ['01', 'Choose a design direction', 'Begin with a Bauhu model that already suits your preferred style, scale, bedroom count, budget and way of living.'],
  ['02', 'Refine it around your site', 'We adapt the model around orientation, access, views, exposure, terraces, foundations and local construction realities.'],
  ['03', 'Specify the residence', 'Layouts, finishes, shading, glazing, pool terraces and outdoor areas are developed around your brief.'],
  ['04', 'Engineer for place', 'The final home is prepared through Bauhu’s steel frame system for the demands of the site and climate.'],
];
---
<BaseLayout title="Model Residences | Bauhu" description="Choose a Bauhu model residence through a guided selector and refine it around your site, budget and way of living.">
  <SiteHeader />
  <main class="models-page">
    <section class="models-hero">
      <div class="models-hero-inner">
        <p class="models-kicker">BAUHU Model Residences</p>
        <h1>Choose a design direction. Refine it around your site. Make it your own.</h1>
        <p>BAUHU model residences are architect-designed starting points for private Caribbean homes. They offer a faster route to a Bauhu residence without beginning from a blank page.</p>
        <a class="models-button" href="#choose-my-home">Choose My Home</a>
      </div>
    </section>

    <section class="models-intro">
      <div class="models-two-col">
        <div>
          <p class="models-kicker">Model Route</p>
          <h2>A curated collection, not a catalogue of kit homes.</h2>
        </div>
        <div class="models-copy">
          <p>With more than thirty Bauhu model residences available, the important question is not which homes exist. It is which homes are right for your site, budget, bedroom requirement and way of living.</p>
          <p>Each model gives you a proven architectural starting point. From there, the residence can be adapted around the land, the climate, the view, local construction realities and the level of finish you want to achieve.</p>
        </div>
      </div>
    </section>

    <section class="models-selector" id="choose-my-home">
      <div class="models-selector-inner">
        <div class="models-selector-heading">
          <p class="models-kicker">Choose My Home</p>
          <h2>Find the Bauhu models that suit your brief.</h2>
          <p>Filter the collection by style, guide price, bedroom count, bathrooms, storeys and built area. The result is a shortlist of model residences that can be refined around your site.</p>
          <div class="models-filter-status">
            <span id="model-result-count">{bauhuModels.length}</span> model residences shown
          </div>
          <button class="models-reset" type="button" id="model-reset-filters">Reset filters</button>
        </div>

        <div class="models-filter-panel" aria-label="Model residence selector">
          {filterGroups.map((group) => (
            <div class="models-filter-group" data-filter-group={group.key}>
              <h3>{group.label}</h3>
              <div class="models-filter-options">
                {group.options.map((option, index) => (
                  <button
                    type="button"
                    class={index === 0 ? 'is-active' : ''}
                    data-filter-key={group.key}
                    data-filter-value={option.value}
                  >
                    {option.label}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="models-results">
      <div class="models-results-inner">
        <div class="models-results-heading">
          <p class="models-kicker">Selected Models</p>
          <h2>Architect-designed residences that can be adapted to place.</h2>
        </div>

        <div class="models-grid" id="models-grid">
          {bauhuModels.map((model) => (
            <article
              class="model-card"
              data-model-card
              data-style={model.style}
              data-price-min={model.guidePriceUsd ?? ''}
              data-price-max={model.guidePriceUsdMax ?? ''}
              data-bedrooms-min={model.bedroomsMin ?? ''}
              data-bedrooms-max={model.bedroomsMax ?? ''}
              data-bathrooms-min={model.bathroomsMin ?? ''}
              data-bathrooms-max={model.bathroomsMax ?? ''}
              data-storeys-min={model.storeysMin ?? ''}
              data-storeys-max={model.storeysMax ?? ''}
              data-area-min={model.builtAreaSqftMin ?? ''}
              data-area-max={model.builtAreaSqftMax ?? ''}
            >
              <img src={model.image} alt={`${model.name} Bauhu model residence`} loading="lazy" onerror="this.src='/images/model-placeholder.svg'" />
              <div class="model-card-body">
                <div class="model-card-topline">
                  <h3>{model.name}</h3>
                  <span>{model.guidePriceLabel}</span>
                </div>
                <div class="model-style">{model.style}</div>
                <div class="model-meta">
                  <span>{model.bedroomsLabel} bedrooms</span>
                  <span>{model.bathroomsLabel} bathrooms</span>
                  <span>{model.storeysLabel} storeys</span>
                  <span>{model.builtAreaLabel} ft²</span>
                </div>
                <p>{model.shortDescription}</p>
                <a href="/start-your-project">Discuss this model</a>
              </div>
            </article>
          ))}
        </div>

        <div class="models-empty" id="models-empty" hidden>
          <h3>No matching models found.</h3>
          <p>Try widening the guide price, bedroom count or built area filters, or send us your brief and we can recommend suitable options.</p>
        </div>
      </div>
    </section>

    <section class="models-process">
      <div class="models-process-inner">
        <p class="models-kicker">How Models Work</p>
        <h2>A faster route to a private Bauhu home.</h2>
        <div class="models-process-grid">
          {steps.map(([number, title, text]) => (
            <article>
              <strong>{number}</strong>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="models-residences-link">
      <div>
        <p class="models-kicker">Need Something Fully Bespoke?</p>
        <h2>Private Residences are for clients who want a complete architectural commission.</h2>
        <p>Models are ideal when you want a strong architectural starting point. Private Residences are for clients who want a one-of-a-kind home designed entirely from their own brief and site.</p>
        <a class="models-button" href="/residences">Explore Private Residences</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const activeFilters = {
    style: 'all',
    price: 'all',
    bedrooms: 'all',
    bathrooms: 'all',
    storeys: 'all',
    area: 'all',
  };

  const cards = Array.from(document.querySelectorAll('[data-model-card]'));
  const countElement = document.getElementById('model-result-count');
  const emptyElement = document.getElementById('models-empty');
  const resetButton = document.getElementById('model-reset-filters');
  const filterButtons = Array.from(document.querySelectorAll('[data-filter-key]'));

  function parseNumber(value) {
    if (value === undefined || value === null || value === '') return null;
    const number = Number(value);
    return Number.isFinite(number) ? number : null;
  }

  function parseRange(value) {
    if (value === 'all') return null;
    const [minRaw, maxRaw] = value.split('-');
    return {
      min: minRaw === '' ? null : Number(minRaw),
      max: maxRaw === '' ? null : Number(maxRaw),
    };
  }

  function overlapsRange(itemMin, itemMax, filterRange) {
    if (!filterRange) return true;
    if (itemMin === null && itemMax === null) return false;
    const actualMin = itemMin ?? itemMax;
    const actualMax = itemMax ?? itemMin;
    const filterMin = filterRange.min ?? Number.NEGATIVE_INFINITY;
    const filterMax = filterRange.max ?? Number.POSITIVE_INFINITY;
    return actualMax >= filterMin && actualMin <= filterMax;
  }

  function meetsMinimum(itemMin, itemMax, requiredValue) {
    if (requiredValue === 'all') return true;
    if (itemMin === null && itemMax === null) return false;
    const actualMax = itemMax ?? itemMin;
    return actualMax >= Number(requiredValue);
  }

  function includesExact(itemMin, itemMax, requiredValue) {
    if (requiredValue === 'all') return true;
    if (itemMin === null && itemMax === null) return false;
    const required = Number(requiredValue);
    const actualMin = itemMin ?? itemMax;
    const actualMax = itemMax ?? itemMin;
    return actualMin <= required && actualMax >= required;
  }

  function cardMatches(card) {
    if (activeFilters.style !== 'all' && card.dataset.style !== activeFilters.style) return false;

    const priceMin = parseNumber(card.dataset.priceMin);
    const priceMax = parseNumber(card.dataset.priceMax);
    if (!overlapsRange(priceMin, priceMax, parseRange(activeFilters.price))) return false;

    const bedroomsMin = parseNumber(card.dataset.bedroomsMin);
    const bedroomsMax = parseNumber(card.dataset.bedroomsMax);
    if (!meetsMinimum(bedroomsMin, bedroomsMax, activeFilters.bedrooms)) return false;

    const bathroomsMin = parseNumber(card.dataset.bathroomsMin);
    const bathroomsMax = parseNumber(card.dataset.bathroomsMax);
    if (!meetsMinimum(bathroomsMin, bathroomsMax, activeFilters.bathrooms)) return false;

    const storeysMin = parseNumber(card.dataset.storeysMin);
    const storeysMax = parseNumber(card.dataset.storeysMax);
    if (!includesExact(storeysMin, storeysMax, activeFilters.storeys)) return false;

    const areaMin = parseNumber(card.dataset.areaMin);
    const areaMax = parseNumber(card.dataset.areaMax);
    if (!overlapsRange(areaMin, areaMax, parseRange(activeFilters.area))) return false;

    return true;
  }

  function updateCards() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const isVisible = cardMatches(card);
      card.toggleAttribute('hidden', !isVisible);
      if (isVisible) visibleCount += 1;
    });

    if (countElement) countElement.textContent = String(visibleCount);
    if (emptyElement) emptyElement.hidden = visibleCount > 0;
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.filterKey;
      const value = button.dataset.filterValue;
      if (!key || !value) return;

      activeFilters[key] = value;

      filterButtons
        .filter((candidate) => candidate.dataset.filterKey === key)
        .forEach((candidate) => candidate.classList.toggle('is-active', candidate === button));

      updateCards();
    });
  });

  resetButton?.addEventListener('click', () => {
    Object.keys(activeFilters).forEach((key) => {
      activeFilters[key] = 'all';
    });

    filterButtons.forEach((button) => {
      button.classList.toggle('is-active', button.dataset.filterValue === 'all');
    });

    updateCards();
  });

  updateCards();
</script>

<style>
  :global(html), :global(body) { overflow-x: hidden !important; }
  .models-page { background:#050505; color:#f8f6f0; overflow:hidden; font-family:Inter, system-ui, sans-serif; font-weight:300; font-synthesis:none; }
  .models-page * { box-sizing:border-box; }
  .models-hero { min-height:88vh; display:flex; align-items:flex-end; padding:120px 7vw 100px; background:radial-gradient(circle at 72% 18%, rgba(200,169,106,.16), transparent 34%), linear-gradient(135deg, #050505, #11100e 58%, #050505); }
  .models-hero-inner, .models-selector-inner, .models-results-inner, .models-process-inner, .models-two-col { max-width:1500px; margin:0 auto; width:100%; }
  .models-kicker { color:#c8a96a; text-transform:uppercase; letter-spacing:.22em; font-size:12px; margin:0 0 22px; font-weight:500; }
  .models-hero h1, .models-intro h2, .models-selector-heading h2, .models-results-heading h2, .models-process h2, .models-residences-link h2 { font-family:"Cormorant Garamond", Georgia, serif; font-weight:400; color:#f8f6f0; letter-spacing:-.055em; }
  .models-hero h1 { max-width:1120px; font-size:clamp(46px,7.4vw,112px); line-height:.9; margin:0 0 28px; }
  .models-hero p { max-width:780px; font-size:clamp(19px,2vw,28px); line-height:1.35; color:rgba(248,246,240,.76); margin:0; }
  .models-button { display:inline-block; margin-top:34px; padding:15px 24px; border:1px solid #c8a96a; color:#f8f6f0; text-decoration:none; text-transform:uppercase; letter-spacing:.16em; font-size:12px; transition:all .3s ease; }
  .models-button:hover { background:#c8a96a; color:#050505; }
  .models-intro { padding:110px 7vw; background:#050505; }
  .models-two-col { display:grid; grid-template-columns:1.1fr .9fr; gap:64px; align-items:center; }
  .models-intro h2, .models-selector-heading h2, .models-results-heading h2, .models-process h2, .models-residences-link h2 { font-size:clamp(44px,7vw,104px); line-height:.92; margin:0; }
  .models-copy p { font-size:17px; line-height:1.75; color:rgba(248,246,240,.66); margin:0 0 22px; }
  .models-selector { padding:100px 7vw; background:#0a0a0a; }
  .models-selector-inner { display:grid; grid-template-columns:.9fr 1.1fr; gap:58px; align-items:start; }
  .models-selector-heading p:not(.models-kicker) { max-width:680px; font-size:18px; line-height:1.65; color:rgba(248,246,240,.66); margin:26px 0 0; }
  .models-filter-status { margin-top:28px; color:rgba(248,246,240,.72); font-size:14px; letter-spacing:.08em; text-transform:uppercase; }
  .models-filter-status span { color:#c8a96a; }
  .models-reset { margin-top:18px; appearance:none; border:0; border-bottom:1px solid #c8a96a; background:transparent; color:#f8f6f0; padding:0 0 7px; text-transform:uppercase; letter-spacing:.16em; font-size:12px; cursor:pointer; }
  .models-filter-panel { border-top:1px solid rgba(255,255,255,.16); }
  .models-filter-group { display:grid; grid-template-columns:190px 1fr; gap:24px; padding:24px 0; border-bottom:1px solid rgba(255,255,255,.16); }
  .models-filter-group h3 { font-family:"Cormorant Garamond", Georgia, serif; font-size:28px; line-height:1.05; font-weight:400; margin:0; color:#f8f6f0; letter-spacing:-.035em; }
  .models-filter-options { display:flex; flex-wrap:wrap; gap:10px; }
  .models-filter-options button { appearance:none; border:1px solid rgba(255,255,255,.18); background:rgba(255,255,255,.035); color:rgba(248,246,240,.78); padding:11px 14px; font:inherit; font-size:13px; cursor:pointer; }
  .models-filter-options button.is-active { border-color:#c8a96a; color:#f8f6f0; background:rgba(200,169,106,.12); }
  .models-results { padding:100px 7vw 120px; background:#050505; }
  .models-results-heading { max-width:1040px; margin-bottom:48px; }
  .models-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:22px; }
  .model-card { border:1px solid rgba(255,255,255,.16); background:linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.01)); }
  .model-card[hidden] { display:none; }
  .model-card img { width:100%; height:300px; object-fit:cover; display:block; background:#111; }
  .model-card-body { padding:30px; }
  .model-card-topline { display:flex; justify-content:space-between; gap:20px; align-items:start; }
  .model-card h3 { font-family:"Cormorant Garamond", Georgia, serif; font-size:42px; line-height:1; font-weight:400; letter-spacing:-.04em; margin:0; color:#f8f6f0; }
  .model-card-topline span { color:#c8a96a; font-size:12px; letter-spacing:.12em; text-transform:uppercase; white-space:nowrap; padding-top:7px; text-align:right; }
  .model-style { margin-top:12px; color:rgba(248,246,240,.52); text-transform:uppercase; letter-spacing:.16em; font-size:11px; }
  .model-meta { display:flex; flex-wrap:wrap; gap:8px; margin:24px 0; }
  .model-meta span { border:1px solid rgba(255,255,255,.14); padding:8px 10px; color:rgba(248,246,240,.66); font-size:12px; }
  .model-card p { color:rgba(248,246,240,.64); line-height:1.65; font-size:16px; margin:0; }
  .model-card a { display:inline-block; margin-top:28px; color:#f8f6f0; text-decoration:none; text-transform:uppercase; letter-spacing:.16em; font-size:12px; border-bottom:1px solid #c8a96a; padding-bottom:7px; }
  .models-empty { border:1px solid rgba(255,255,255,.16); padding:42px; margin-top:22px; }
  .models-empty h3 { font-family:"Cormorant Garamond", Georgia, serif; font-size:42px; line-height:1; font-weight:400; margin:0 0 18px; }
  .models-empty p { color:rgba(248,246,240,.64); line-height:1.65; margin:0; }
  .models-process { padding:110px 7vw; background:#0a0a0a; }
  .models-process h2 { max-width:980px; }
  .models-process-grid { display:grid; grid-template-columns:repeat(4, 1fr); border-top:1px solid rgba(255,255,255,.16); border-bottom:1px solid rgba(255,255,255,.16); margin-top:54px; }
  .models-process-grid article { padding:34px 22px; border-right:1px solid rgba(255,255,255,.16); }
  .models-process-grid article:last-child { border-right:0; }
  .models-process-grid strong { color:#c8a96a; font-size:13px; letter-spacing:.16em; }
  .models-process-grid h3 { font-family:"Cormorant Garamond", Georgia, serif; font-size:32px; line-height:1.05; font-weight:400; letter-spacing:-.035em; margin:24px 0 18px; }
  .models-process-grid p { color:rgba(248,246,240,.62); line-height:1.6; margin:0; }
  .models-residences-link { padding:135px 7vw; text-align:center; background:radial-gradient(circle at 70% 30%, rgba(200,169,106,.20), transparent 36%), linear-gradient(135deg,#050505,#15120e); }
  .models-residences-link > div { max-width:1040px; margin:0 auto; }
  .models-residences-link p:not(.models-kicker) { max-width:760px; margin:26px auto 0; color:rgba(248,246,240,.66); font-size:18px; line-height:1.65; }
  @media screen and (max-width:900px) {
    .models-hero { min-height:82vh; padding:96px 22px 74px; }
    .models-hero h1, .models-intro h2, .models-selector-heading h2, .models-results-heading h2, .models-process h2, .models-residences-link h2 { font-size:clamp(36px,10.5vw,62px); line-height:.96; letter-spacing:-.045em; }
    .models-hero p { max-width:100%; }
    .models-intro, .models-selector, .models-results, .models-process, .models-residences-link { padding-left:22px; padding-right:22px; }
    .models-two-col, .models-selector-inner { grid-template-columns:1fr; gap:34px; }
    .models-filter-group { grid-template-columns:1fr; gap:14px; }
    .models-grid, .models-process-grid { grid-template-columns:1fr; }
    .models-process-grid article { border-right:0; border-bottom:1px solid rgba(255,255,255,.16); }
    .models-process-grid article:last-child { border-bottom:0; }
    .model-card img { height:280px; }
    .model-card-topline { display:block; }
    .model-card-topline span { display:block; text-align:left; margin-top:12px; }
  }
</style>
