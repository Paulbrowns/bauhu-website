---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { bauhuModels } from '../data/models';

function publicSlug(modelSlug: string) {
  return modelSlug.replace(/^bauhu-/, '');
}

const filterGroups = [
  {
    key: 'style',
    label: 'Style',
    options: [
      { label: 'All', value: 'all' },
      { label: 'Classic', value: 'Classic' },
      { label: 'Contemporary', value: 'Contemporary' },
      { label: 'Caribbean', value: 'Caribbean' },
    ],
  },
  {
    key: 'price',
    label: 'Guide price',
    options: [
      { label: 'All', value: 'all' },
      { label: 'Under $250k', value: '0-250000' },
      { label: '$250k to $500k', value: '250000-500000' },
      { label: '$500k to $750k', value: '500000-750000' },
      { label: '$750k to $1m', value: '750000-1000000' },
      { label: '$1m+', value: '1000000-' },
    ],
  },
  {
    key: 'bedrooms',
    label: 'Bedrooms',
    options: [
      { label: 'All', value: 'all' },
      { label: '1+', value: '1' },
      { label: '2+', value: '2' },
      { label: '3+', value: '3' },
      { label: '4+', value: '4' },
      { label: '5+', value: '5' },
    ],
  },
  {
    key: 'bathrooms',
    label: 'Bathrooms',
    options: [
      { label: 'All', value: 'all' },
      { label: '1+', value: '1' },
      { label: '2+', value: '2' },
      { label: '3+', value: '3' },
      { label: '4+', value: '4' },
    ],
  },
  {
    key: 'storeys',
    label: 'Storeys',
    options: [
      { label: 'All', value: 'all' },
      { label: '1', value: '1' },
      { label: '2', value: '2' },
      { label: '3', value: '3' },
    ],
  },
  {
    key: 'area',
    label: 'Built area',
    options: [
      { label: 'All', value: 'all' },
      { label: 'Under 1,000 ft²', value: '0-1000' },
      { label: '1,000 to 1,500 ft²', value: '1000-1500' },
      { label: '1,500 to 2,500 ft²', value: '1500-2500' },
      { label: '2,500 to 4,000 ft²', value: '2500-4000' },
      { label: '4,000+ ft²', value: '4000-' },
    ],
  },
];

const steps = [
  ['01', 'Choose a design direction', 'Begin with a Bauhu model that already suits your preferred style, scale, bedroom count, budget and way of living.'],
  ['02', 'Refine it around your site', 'We adapt the model around orientation, access, views, exposure, terraces, foundations and local construction realities.'],
  ['03', 'Specify the residence', 'Layouts, finishes, shading, glazing, pool terraces and outdoor areas are developed around your brief.'],
  ['04', 'Engineer for place', 'The final home is prepared through Bauhu’s steel frame system for the demands of the site and climate.'],
];
---
<BaseLayout title="Model Residences | Bauhu" description="Choose a Bauhu model residence through a guided selector and refine it around your site, budget and way of living.">
  <SiteHeader />
  <main class="models-page">
    <section class="models-hero">
      <div class="models-hero-inner">
        <p class="models-kicker">BAUHU Model Residences</p>
        <h1>Choose a design direction. Refine it around your site. Make it your own.</h1>
        <p>BAUHU model residences are architect-designed starting points for private Caribbean homes. They offer a faster route to a Bauhu residence without beginning from a blank page.</p>
        <a class="models-button" href="#choose-my-home">Choose My Home</a>
      </div>
    </section>

    <section class="models-intro">
      <div class="models-two-col">
        <div>
          <p class="models-kicker">Model Route</p>
          <h2>A curated collection, not a catalogue of kit homes.</h2>
        </div>
        <div class="models-copy">
          <p>With sixty Bauhu model residences available, the important question is not which homes exist. It is which homes are right for your site, budget, bedroom requirement and way of living.</p>
          <p>Each model gives you a proven architectural starting point. From there, the residence can be adapted around the land, the climate, the view, local construction realities and the level of finish you want to achieve.</p>
        </div>
      </div>
    </section>

    <section class="models-selector" id="choose-my-home">
      <div class="models-selector-inner">
        <div class="models-selector-heading">
          <p class="models-kicker">Choose My Home</p>
          <h2>Find the Bauhu models that suit your brief.</h2>
          <p>Filter the collection by style, guide price, bedroom count, bathrooms, storeys and built area. The result is a shortlist of model residences that can be refined around your site.</p>
          <div class="models-filter-status">
            <span id="model-result-count">{bauhuModels.length}</span> model residences shown
          </div>
          <button class="models-reset" type="button" id="model-reset-filters">Reset filters</button>
        </div>

        <div class="models-filter-panel" aria-label="Model residence selector">
          {filterGroups.map((group) => (
            <div class="models-filter-group" data-filter-group={group.key}>
              <h3>{group.label}</h3>
              <div class="models-filter-options">
                {group.options.map((option, index) => (
                  <button
                    type="button"
                    class={index === 0 ? 'is-active' : ''}
                    data-filter-key={group.key}
                    data-filter-value={option.value}
                  >
                    {option.label}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="models-results">
      <div class="models-results-inner">
        <div class="models-results-heading">
          <p class="models-kicker">Selected Models</p>
          <h2>Architect-designed residences that can be adapted to place.</h2>
        </div>

        <div class="models-grid" id="models-grid">
          {bauhuModels.map((model) => (
            <article
              class="model-card"
              data-model-card
              data-style={model.style}
              data-price-min={model.guidePriceUsd ?? ''}
              data-price-max={model.guidePriceUsdMax ?? ''}
              data-bedrooms-min={model.bedroomsMin ?? ''}
              data-bedrooms-max={model.bedroomsMax ?? ''}
              data-bathrooms-min={model.bathroomsMin ?? ''}
              data-bathrooms-max={model.bathroomsMax ?? ''}
              data-storeys-min={model.storeysMin ?? ''}
              data-storeys-max={model.storeysMax ?? ''}
              data-area-min={model.builtAreaSqftMin ?? ''}
              data-area-max={model.builtAreaSqftMax ?? ''}
            >
              <a class="model-card-image" href={`/homes/${publicSlug(model.slug)}`} aria-label={`View ${model.name}`}>
                <img src={model.image} alt={`${model.name} Bauhu model residence`} loading="lazy" onerror="this.src='/images/model-placeholder.svg'" />
              </a>
              <div class="model-card-body">
                <div class="model-card-topline">
                  <h3>{model.name}</h3>
                  <span>{model.guidePriceLabel}</span>
                </div>
                <div class="model-style">{model.style}</div>
                <div class="model-meta">
                  <span>{model.bedroomsLabel} bedrooms</span>
                  <span>{model.bathroomsLabel} bathrooms</span>
                  <span>{model.storeysLabel} storeys</span>
                  <span>{model.builtAreaLabel} ft²</span>
                </div>
                <p>{model.shortDescription}</p>
                <a class="model-card-link" href={`/homes/${publicSlug(model.slug)}`}>View this model</a>
              </div>
            </article>
          ))}
        </div>

        <div class="models-empty" id="models-empty" hidden>
          <h3>No matching models found.</h3>
          <p>Try widening the guide price, bedroom count or built area filters, or send us your brief and we can recommend suitable options.</p>
        </div>
      </div>
    </section>

    <section class="models-process">
      <div class="models-process-inner">
        <p class="models-kicker">How Models Work</p>
        <h2>A faster route to a private Bauhu home.</h2>
        <div class="models-process-grid">
          {steps.map(([number, title, text]) => (
            <article>
              <strong>{number}</strong>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="models-residences-link">
      <div>
        <p class="models-kicker">Need Something Fully Bespoke?</p>
        <h2>Private Residences are for clients who want a complete architectural commission.</h2>
        <p>Models are ideal when you want a strong architectural starting point. Private Residences are for clients who want a one-of-a-kind home designed entirely from their own brief and site.</p>
        <a class="models-button" href="/residences">Explore Private Residences</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const activeFilters = {
    style: 'all',
    price: 'all',
    bedrooms: 'all',
    bathrooms: 'all',
    storeys: 'all',
    area: 'all',
  };

  const cards = Array.from(document.querySelectorAll('[data-model-card]'));
  const countElement = document.getElementById('model-result-count');
  const emptyElement = document.getElementById('models-empty');
  const resetButton = document.getElementById('model-reset-filters');
  const filterButtons = Array.from(document.querySelectorAll('[data-filter-key]'));

  function parseNumber(value) {
    if (value === undefined || value === null || value === '') return null;
    const number = Number(value);
    return Number.isFinite(number) ? number : null;
  }

  function parseRange(value) {
    if (value === 'all') return null;
    const [minRaw, maxRaw] = value.split('-');
    return {
      min: minRaw === '' ? null : Number(minRaw),
      max: maxRaw === '' ? null : Number(maxRaw),
    };
  }

  function overlapsRange(itemMin, itemMax, filterRange) {
    if (!filterRange) return true;
    if (itemMin === null && itemMax === null) return false;
    const actualMin = itemMin ?? itemMax;
    const actualMax = itemMax ?? itemMin;
    const filterMin = filterRange.min ?? Number.NEGATIVE_INFINITY;
    const filterMax = filterRange.max ?? Number.POSITIVE_INFINITY;
    return actualMax >= filterMin && actualMin <= filterMax;
  }

  function meetsMinimum(itemMin, itemMax, requiredValue) {
    if (requiredValue === 'all') return true;
    if (itemMin === null && itemMax === null) return false;
    const actualMax = itemMax ?? itemMin;
    return actualMax >= Number(requiredValue);
  }

  function includesExact(itemMin, itemMax, requiredValue) {
    if (requiredValue === 'all') return true;
    if (itemMin === null && itemMax === null) return false;
    const required = Number(requiredValue);
    const actualMin = itemMin ?? itemMax;
    const actualMax = itemMax ?? itemMin;
    return actualMin <= required && actualMax >= required;
  }

  function cardMatches(card) {
    if (activeFilters.style !== 'all' && card.dataset.style !== activeFilters.style) return false;
    if (!overlapsRange(parseNumber(card.dataset.priceMin), parseNumber(card.dataset.priceMax), parseRange(activeFilters.price))) return false;
    if (!meetsMinimum(parseNumber(card.dataset.bedroomsMin), parseNumber(card.dataset.bedroomsMax), activeFilters.bedrooms)) return false;
    if (!meetsMinimum(parseNumber(card.dataset.bathroomsMin), parseNumber(card.dataset.bathroomsMax), activeFilters.bathrooms)) return false;
    if (!includesExact(parseNumber(card.dataset.storeysMin), parseNumber(card.dataset.storeysMax), activeFilters.storeys)) return false;
    if (!overlapsRange(parseNumber(card.dataset.areaMin), parseNumber(card.dataset.areaMax), parseRange(activeFilters.area))) return false;
    return true;
  }

  function updateCards() {
    let visibleCount = 0;
    cards.forEach((card) => {
      const isVisible = cardMatches(card);
      card.toggleAttribute('hidden', !isVisible);
      if (isVisible) visibleCount += 1;
    });
    if (countElement) countElement.textContent = String(visibleCount);
    if (emptyElement) emptyElement.hidden = visibleCount > 0;
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const { filterKey, filterValue } = button.dataset;
      if (!filterKey || !filterValue) return;
      activeFilters[filterKey] = filterValue;
      filterButtons
        .filter((item) => item.dataset.filterKey === filterKey)
        .forEach((item) => item.classList.toggle('is-active', item === button));
      updateCards();
    });
  });

  resetButton?.addEventListener('click', () => {
    Object.keys(activeFilters).forEach((key) => {
      activeFilters[key] = 'all';
    });
    filterButtons.forEach((button) => {
      button.classList.toggle('is-active', button.dataset.filterValue === 'all');
    });
    updateCards();
  });

  updateCards();
</script>

<style>
  .models-page {
    background: #050505;
    color: #f4efe5;
    overflow-x: hidden;
  }

  .models-page * {
    box-sizing: border-box;
  }

  .models-kicker {
    margin: 0 0 1rem;
    font-family: Inter, sans-serif;
    font-size: 0.74rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #c5a66a;
  }

  .models-hero {
    display: flex;
    min-height: 78vh;
    align-items: flex-end;
    padding: 8rem 5vw;
    background: radial-gradient(circle at 75% 20%, rgba(189, 153, 91, 0.18), transparent 34%), #050505;
  }

  .models-hero-inner,
  .models-two-col,
  .models-selector-inner,
  .models-results-inner,
  .models-process-inner,
  .models-residences-link > div {
    width: min(1480px, 100%);
    margin: 0 auto;
  }

  .models-hero-inner {
    width: min(920px, 100%);
    margin: 0;
  }

  .models-hero h1,
  .models-intro h2,
  .models-selector-heading h2,
  .models-results-heading h2,
  .models-process h2,
  .models-residences-link h2 {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .models-hero h1 {
    max-width: 900px;
    font-size: clamp(4.2rem, 10vw, 9.5rem);
  }

  .models-hero p:not(.models-kicker),
  .models-copy,
  .models-selector-heading > p,
  .models-process p,
  .models-residences-link p,
  .model-card p,
  .models-empty p {
    font-family: Inter, sans-serif;
    font-weight: 300;
    line-height: 1.85;
    color: rgba(244, 239, 229, 0.68);
  }

  .models-hero p:not(.models-kicker) {
    max-width: 640px;
    margin: 1.8rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.45rem);
    line-height: 1.7;
  }

  .models-button,
  .model-card-link,
  .models-reset {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 2rem;
    border: 1px solid rgba(197, 166, 106, 0.62);
    padding: 0.95rem 1.25rem;
    background: transparent;
    color: #f4efe5;
    font-family: Inter, sans-serif;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .models-intro,
  .models-selector,
  .models-results,
  .models-process,
  .models-residences-link {
    padding: clamp(5rem, 9vw, 9rem) 5vw;
  }

  .models-two-col,
  .models-selector-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 8vw, 8rem);
  }

  .models-intro h2,
  .models-selector-heading h2,
  .models-results-heading h2,
  .models-process h2,
  .models-residences-link h2 {
    max-width: 850px;
    font-size: clamp(3rem, 6vw, 6rem);
  }

  .models-copy p {
    margin: 0 0 1.5rem;
    font-size: 1.02rem;
  }

  .models-selector,
  .models-process {
    border-top: 1px solid rgba(244, 239, 229, 0.12);
    border-bottom: 1px solid rgba(244, 239, 229, 0.12);
  }

  .models-selector-heading > p {
    max-width: 580px;
    margin: 1.5rem 0 0;
  }

  .models-filter-status {
    margin-top: 2rem;
    font-family: Inter, sans-serif;
    color: rgba(244, 239, 229, 0.72);
  }

  .models-filter-status span {
    color: #c5a66a;
  }

  .models-filter-panel {
    display: grid;
    gap: 1rem;
  }

  .models-filter-group {
    border: 1px solid rgba(244, 239, 229, 0.12);
    padding: 1.25rem;
  }

  .models-filter-group h3 {
    margin: 0 0 1rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.8rem;
    font-weight: 400;
  }

  .models-filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .models-filter-options button {
    border: 1px solid rgba(244, 239, 229, 0.18);
    padding: 0.7rem 0.85rem;
    background: transparent;
    color: rgba(244, 239, 229, 0.72);
    font-family: Inter, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .models-filter-options button.is-active {
    border-color: rgba(197, 166, 106, 0.8);
    color: #f4efe5;
  }

  .models-results-heading {
    margin-bottom: 3rem;
  }

  .models-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .model-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    border: 1px solid rgba(244, 239, 229, 0.12);
    background: rgba(244, 239, 229, 0.035);
  }

  .model-card[hidden] {
    display: none;
  }

  .model-card-image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(244, 239, 229, 0.06);
  }

  .model-card-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .model-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.4rem;
  }

  .model-card-topline {
    display: grid;
    gap: 0.65rem;
  }

  .model-card h3 {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 400;
    line-height: 1;
  }

  .model-card-topline span,
  .model-style,
  .model-meta,
  .models-empty {
    font-family: Inter, sans-serif;
  }

  .model-card-topline span,
  .model-style {
    color: #c5a66a;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .model-style {
    margin-top: 1rem;
  }

  .model-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
    color: rgba(244, 239, 229, 0.62);
    font-size: 0.82rem;
  }

  .model-meta span {
    border: 1px solid rgba(244, 239, 229, 0.13);
    padding: 0.35rem 0.55rem;
  }

  .model-card p {
    margin: 1rem 0 0;
  }

  .model-card-link {
    margin-top: auto;
    align-self: flex-start;
  }

  .models-empty {
    margin-top: 3rem;
    border: 1px solid rgba(244, 239, 229, 0.12);
    padding: 2rem;
    text-align: center;
  }

  .models-empty h3,
  .models-process h3 {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.4rem;
    font-weight: 400;
  }

  .models-process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3rem;
  }

  .models-process-grid article {
    border: 1px solid rgba(244, 239, 229, 0.12);
    padding: 1.5rem;
  }

  .models-process-grid strong {
    display: block;
    margin-bottom: 4rem;
    color: #c5a66a;
    font-family: Inter, sans-serif;
    font-weight: 400;
  }

  .models-residences-link {
    border-top: 1px solid rgba(244, 239, 229, 0.12);
  }

  .models-residences-link p {
    max-width: 760px;
    margin-top: 1.5rem;
  }

  @media (max-width: 1100px) {
    .models-grid,
    .models-process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .models-hero {
      min-height: auto;
      padding-top: 7rem;
    }

    .models-two-col,
    .models-selector-inner {
      grid-template-columns: 1fr;
    }

    .models-grid,
    .models-process-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .models-hero,
    .models-intro,
    .models-selector,
    .models-results,
    .models-process,
    .models-residences-link {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .models-hero h1 {
      font-size: clamp(3.4rem, 17vw, 5rem);
    }
  }
</style>
