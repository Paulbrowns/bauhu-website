---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Site Summary | Bauhu" description="Review, save, share and download your Bauhu project site summary.">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" /><SiteHeader />
  <main class="summary-page"><header class="summary-header"><div><p class="kicker">START YOUR PROJECT · STEP 2</p><h1>Site summary.</h1><p>Review the location and parcel information before continuing to the project enquiry.</p></div><aside><span>PROJECT ROUTE</span><strong>Site confirmed</strong><small>1. Locate site ✓</small><small>2. Review summary</small><small>3. Send project details</small></aside></header>
    <section class="summary-shell"><div class="map-shell"><div id="summary-map"></div></div><aside class="summary-card"><p class="kicker">YOUR SITE</p><h2 id="site-name">Selected site</h2><dl><div><dt>Coordinates</dt><dd id="coordinates">—</dd></div><div><dt>Location source</dt><dd id="source">—</dd></div><div><dt>Parcel / property</dt><dd id="parcel">Not supplied</dd></div><div><dt>Approx. area</dt><dd id="area">Not supplied</dd></div><div><dt>Boundary source</dt><dd id="boundary-source">Not supplied</dd></div></dl><div class="actions"><button id="save-site">Save</button><button id="share-site">Share</button><button id="download-site">Download</button></div><a class="secondary" href="/site-fit">Edit site</a><a class="primary" href="/project-enquiry">Continue to project details</a><p id="action-feedback" class="feedback"></p></aside></section><p class="disclaimer">This is a preliminary site record, not a legal survey, planning opinion or construction assessment.</p>
  </main><SiteFooter /><script is:inline src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script><script is:inline>(()=>{const $=id=>document.getElementById(id);let d={};try{d=JSON.parse(localStorage.getItem('bauhuSiteProject')||'{}')}catch{}if(!Number.isFinite(d.lat)||!Number.isFinite(d.lng)){location.replace('/site-fit');return}$('site-name').textContent=d.place||'Selected site';$('coordinates').textContent=`${(+d.lat).toFixed(6)}, ${(+d.lng).toFixed(6)}`;$('source').textContent=d.source||'Map point';$('parcel').textContent=d.parcel||'Not supplied';$('area').textContent=d.area||'Not supplied';$('boundary-source').textContent=d.boundarySource||'Not supplied';const map=L.map('summary-map',{zoomControl:false}).setView([d.lat,d.lng],17);L.control.zoom({position:'bottomright'}).addTo(map);L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',{maxZoom:19,attribution:'Tiles &copy; Esri'}).addTo(map);L.marker([d.lat,d.lng]).addTo(map);if(Array.isArray(d.boundary)&&d.boundary.length>2){const p=L.polygon(d.boundary,{color:'#c5a66a',weight:3,fillColor:'#d9b66f',fillOpacity:.2}).addTo(map);map.fitBounds(p.getBounds().pad(.2),{maxZoom:19})}const text=()=>`BAUHU SITE SUMMARY\n\nLocation: ${d.place||'Selected site'}\nCoordinates: ${d.lat}, ${d.lng}\nParcel: ${d.parcel||'Not supplied'}\nApprox. area: ${d.area||'Not supplied'}\nBoundary source: ${d.boundarySource||'Not supplied'}\n\nPreliminary site record only.`;$('save-site').onclick=()=>{localStorage.setItem('bauhuSiteProject',JSON.stringify({...d,savedAt:new Date().toISOString()}));$('action-feedback').textContent='Site saved on this device.'};$('share-site').onclick=async()=>{try{navigator.share?await navigator.share({title:'Bauhu site summary',text:text()}):(await navigator.clipboard.writeText(text()),$('action-feedback').textContent='Site summary copied to clipboard.')}catch{}};$('download-site').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text()],{type:'text/plain'}));a.download='bauhu-site-summary.txt';a.click()};requestAnimationFrame(()=>map.invalidateSize())})()</script></BaseLayout>
<style>.summary-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}.summary-header{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:4rem;padding:3.4rem 4vw 2.4rem;border-bottom:1px solid rgba(23,57,76,.18)}.kicker,.summary-header aside>span{margin:0 0 .8rem;font:700 .68rem Inter,sans-serif;letter-spacing:.2em;color:#9b7b49}.summary-header h1{margin:0 0 1rem;font:400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif}.summary-header aside{display:flex;flex-direction:column;justify-content:flex-end;gap:.45rem;padding-left:2rem;border-left:1px solid rgba(23,57,76,.18)}.summary-shell{display:grid;grid-template-columns:minmax(0,1fr) 370px;min-height:680px}.map-shell{position:relative}.map-shell #summary-map{position:absolute;inset:0}.summary-card{padding:1.8rem;background:#f7f5ef}.summary-card h2{font:400 2.3rem 'Cormorant Garamond',serif}.summary-card dl div{display:flex;justify-content:space-between;gap:1rem;padding:.75rem 0;border-top:1px solid rgba(23,57,76,.13);font-size:.7rem}.summary-card dd{margin:0;text-align:right;font-weight:700}.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem;margin:1.4rem 0}.actions button,.summary-card a{padding:.8rem;border:1px solid rgba(23,57,76,.2);background:#fff;color:#17394c;text-align:center;text-decoration:none;font-weight:700}.summary-card a{display:block;margin-top:.55rem}.summary-card a.primary{background:#17394c;color:#fff}.feedback,.disclaimer{font-size:.65rem}.disclaimer{padding:1rem 4vw}@media(max-width:820px){.summary-header,.summary-shell{grid-template-columns:1fr}.summary-header aside{border-left:0;padding-left:0}.map-shell{min-height:480px}}</style>