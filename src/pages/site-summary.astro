---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Site Summary | Bauhu" description="Review, save, share and download your Bauhu project site summary.">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
  <SiteHeader />
  <main class="summary-page">
    <header class="summary-header">
      <div><p class="kicker">START YOUR PROJECT · STEP 2</p><h1>Site summary.</h1><p>Review the location and site information before continuing to the project enquiry.</p></div>
      <aside><span>PROJECT ROUTE</span><strong>Site confirmed</strong><small>1. Locate site ✓</small><small>2. Review summary</small><small>3. Send project details</small></aside>
    </header>
    <section class="summary-shell">
      <div class="map-shell"><div id="summary-map"></div></div>
      <aside class="summary-card">
        <p class="kicker">YOUR SITE</p>
        <h2 id="site-name">Selected site</h2>
        <dl>
          <div><dt>Coordinates</dt><dd id="coordinates">—</dd></div>
          <div><dt>Location source</dt><dd id="source">—</dd></div>
          <div><dt>Parcel / property</dt><dd id="parcel">Not supplied</dd></div>
          <div><dt>Approx. area</dt><dd id="area">Not supplied</dd></div>
          <div><dt>Jurisdiction</dt><dd id="jurisdiction">Not supplied</dd></div>
          <div><dt>Access</dt><dd id="access">Not supplied</dd></div>
        </dl>
        <div class="actions">
          <button id="save-site" type="button">Save</button>
          <button id="share-site" type="button">Share</button>
          <button id="download-site" type="button">Download</button>
        </div>
        <a class="secondary" href="/site-fit">Edit site</a>
        <a class="primary" href="/project-enquiry">Continue to project details</a>
        <p id="action-feedback" class="feedback"></p>
      </aside>
    </section>
    <p class="disclaimer">This is a preliminary site record, not a legal survey, planning opinion or construction assessment.</p>
  </main>
  <SiteFooter />
  <script is:inline src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline>
    (()=>{
      const $=(id)=>document.getElementById(id); let data={}; try{data=JSON.parse(localStorage.getItem('bauhuSiteProject')||'{}')}catch{}
      if(!Number.isFinite(data.lat)||!Number.isFinite(data.lng)){window.location.replace('/site-fit');return;}
      $('site-name').textContent=data.place||'Selected site'; $('coordinates').textContent=`${Number(data.lat).toFixed(6)}, ${Number(data.lng).toFixed(6)}`; $('source').textContent=data.source||'Map point'; $('parcel').textContent=data.parcel||'Not supplied'; $('area').textContent=data.area||'Not supplied'; $('jurisdiction').textContent=data.jurisdiction||'Not supplied'; $('access').textContent=data.access||'Not supplied';
      const map=L.map('summary-map',{zoomControl:false,dragging:true}).setView([data.lat,data.lng],17); L.control.zoom({position:'bottomright'}).addTo(map); L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',{maxZoom:19,attribution:'Tiles &copy; Esri'}).addTo(map); L.marker([data.lat,data.lng]).addTo(map);
      const text=()=>`BAUHU SITE SUMMARY\n\nLocation: ${data.place||'Selected site'}\nCoordinates: ${data.lat}, ${data.lng}\nParcel / property: ${data.parcel||'Not supplied'}\nApprox. area: ${data.area||'Not supplied'}\nJurisdiction: ${data.jurisdiction||'Not supplied'}\nAccess: ${data.access||'Not supplied'}\n\nPreliminary site record only.`;
      $('save-site').onclick=()=>{localStorage.setItem('bauhuSiteProject',JSON.stringify({...data,savedAt:new Date().toISOString()}));$('action-feedback').textContent='Site saved on this device.';};
      $('share-site').onclick=async()=>{const url=location.href;try{if(navigator.share){await navigator.share({title:'Bauhu site summary',text:text(),url});}else{await navigator.clipboard.writeText(text());$('action-feedback').textContent='Site summary copied to clipboard.';}}catch{}};
      $('download-site').onclick=()=>{const blob=new Blob([text()],{type:'text/plain;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='bauhu-site-summary.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);};
      requestAnimationFrame(()=>map.invalidateSize());
    })();
  </script>
</BaseLayout>
<style>
.summary-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}.summary-header{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:4rem;padding:3.4rem 4vw 2.4rem;border-bottom:1px solid rgba(23,57,76,.18)}.kicker,.summary-header aside>span{margin:0 0 .8rem;font:700 .68rem/1 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#9b7b49}.summary-header h1{margin:0 0 1rem;font:400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif}.summary-header>div>p:last-child{font:300 1rem/1.7 Inter,sans-serif;color:rgba(23,57,76,.7)}.summary-header aside{display:flex;flex-direction:column;justify-content:flex-end;gap:.45rem;padding-left:2rem;border-left:1px solid rgba(23,57,76,.18);font-family:Inter,sans-serif}.summary-header aside strong{font:400 1.8rem 'Cormorant Garamond',serif}.summary-shell{display:grid;grid-template-columns:minmax(0,1fr) 370px;min-height:680px}.map-shell{position:relative;min-height:680px}.map-shell #summary-map{position:absolute;inset:0}.summary-card{padding:1.8rem;background:#f7f5ef;border-left:1px solid rgba(23,57,76,.16)}.summary-card h2{margin:.2rem 0 1.3rem;font:400 2.3rem 'Cormorant Garamond',serif}.summary-card dl{margin:0}.summary-card dl div{display:flex;justify-content:space-between;gap:1rem;padding:.75rem 0;border-top:1px solid rgba(23,57,76,.13);font:400 .7rem/1.4 Inter,sans-serif}.summary-card dd{margin:0;max-width:58%;text-align:right;font-weight:700}.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem;margin:1.4rem 0}.actions button,.summary-card a{padding:.8rem;border:1px solid rgba(23,57,76,.2);background:#fff;color:#17394c;text-align:center;text-decoration:none;font:700 .68rem Inter,sans-serif}.summary-card a{display:block;margin-top:.55rem}.summary-card a.primary{background:#17394c;color:#fff}.feedback{min-height:1rem;font-size:.62rem;color:rgba(23,57,76,.62)}.disclaimer{margin:0;padding:1.2rem 4vw;font-size:.68rem;color:rgba(23,57,76,.62)}@media(max-width:820px){.summary-header{grid-template-columns:1fr;gap:2rem}.summary-header aside{padding:1.3rem 0 0;border-left:0;border-top:1px solid rgba(23,57,76,.18)}.summary-shell{grid-template-columns:1fr}.map-shell{min-height:480px}.summary-card{border-left:0;border-top:1px solid rgba(23,57,76,.16)}}
</style>