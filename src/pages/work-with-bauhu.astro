---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const partnerTypes = [
  ['Contractors and assembly teams', 'Local contractors, site managers and assembly teams who can support foundations, unloading, installation, weather-tightness, MEP coordination, finishes and completion.'],
  ['Engineers and consultants', 'Structural engineers, architects, surveyors, quantity surveyors, planning advisers and project managers with local knowledge and professional capability.'],
  ['Logistics and delivery support', 'Shipping, customs, transport, craneage, unloading, warehousing and island delivery partners who understand remote or constrained sites.'],
  ['Developers and project introducers', 'Developers, landowners, brokers and advisers with suitable sites or serious projects where Bauhu could add delivery control and architectural value.'],
];

const capabilities = [
  'Remote, island or coastal site experience',
  'Reliable communication and documentation',
  'Professional licensing, insurance or trade credentials where applicable',
  'Ability to work from drawings, schedules and coordinated project information',
  'Practical understanding of sequencing, weather, access and local labour constraints',
  'Respect for high-quality residential, resort or development work',
];
---
<BaseLayout title="Work With Bauhu | Contractors, Consultants & Project Partners" description="Register interest in working with Bauhu as a contractor, consultant, logistics partner, local delivery team or project introducer for remote, coastal and island projects.">
  <SiteHeader />
  <main class="partner-page">
    <section class="partner-hero">
      <div class="partner-hero-inner">
        <p class="partner-kicker">Work With Bauhu</p>
        <h1>Partner with Bauhu on remote, coastal and island projects.</h1>
        <p>Bauhu works with capable local and regional professionals who can help deliver architect-designed, precision-engineered buildings in demanding locations.</p>
      </div>
    </section>

    <section class="partner-intro">
      <div class="partner-two-col">
        <div>
          <p class="partner-kicker">Delivery Network</p>
          <h2>Good projects need good local capability.</h2>
        </div>
        <div class="partner-copy">
          <p>Bauhu’s route is based on resolving more of the building before it reaches site: architecture, engineering, manufacture, procurement, packing and delivery information. But successful projects still depend on capable people on the ground.</p>
          <p>We are interested in contractors, consultants and project partners who can support foundations, unloading, assembly, MEP coordination, finishes, site supervision, approvals, logistics and local delivery.</p>
        </div>
      </div>
    </section>

    <section class="partner-types-section">
      <div class="partner-inner">
        <p class="partner-kicker">Who This Is For</p>
        <h2>Contractors, consultants, logistics partners and project introducers.</h2>
        <div class="partner-types-grid">
          {partnerTypes.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="partner-what-section">
      <div class="partner-two-col partner-what-grid">
        <div>
          <p class="partner-kicker">What Bauhu Provides</p>
          <h2>A clearer building package for difficult locations.</h2>
        </div>
        <div class="partner-copy">
          <p>Bauhu can provide the design route, project information, engineered frame strategy, componentised building system, procurement coordination and delivery planning needed to reduce uncertainty on remote or exposed sites.</p>
          <p>The local delivery scope is defined project by project. That may include foundations, services, site works, unloading, assembly support, waterproofing, finishes, approvals, inspections and completion works.</p>
        </div>
      </div>
    </section>

    <section class="partner-capability-section">
      <div class="partner-inner">
        <p class="partner-kicker">What We Look For</p>
        <h2>Capability, reliability and a willingness to work from coordinated information.</h2>
        <div class="partner-capability-list">
          {capabilities.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </section>

    <section class="partner-form-section" id="partner-profile">
      <div class="partner-form-grid">
        <div>
          <p class="partner-kicker">Register Interest</p>
          <h2>Introduce your capability.</h2>
          <p class="partner-form-lead">Tell us where you work, what you do, and how you could support Bauhu projects. This form is for professional, contractor and project partner enquiries rather than private client site-fit submissions.</p>
        </div>
        <form class="partner-form" data-partner-form>
          <label>
            Name
            <input name="name" required autocomplete="name" />
          </label>
          <label>
            Company
            <input name="company" autocomplete="organization" />
          </label>
          <label>
            Email
            <input name="email" type="email" required autocomplete="email" />
          </label>
          <label>
            Phone
            <input name="phone" autocomplete="tel" />
          </label>
          <label>
            Operating region / location
            <input name="location" required placeholder="e.g. The Bahamas, USVI, Turks and Caicos" />
          </label>
          <label>
            Role or trade
            <select name="role" required>
              <option value="">Select one</option>
              <option>General contractor</option>
              <option>Assembly / installation team</option>
              <option>Site manager / project manager</option>
              <option>Engineer</option>
              <option>Architect / designer</option>
              <option>Quantity surveyor / cost consultant</option>
              <option>Planning / approvals consultant</option>
              <option>Shipping / logistics partner</option>
              <option>Developer / landowner</option>
              <option>Estate agent / project introducer</option>
              <option>Other</option>
            </select>
          </label>
          <label>
            Relevant experience
            <textarea name="experience" rows="4" placeholder="Remote sites, island construction, coastal projects, steel frame, high-end residential, resorts, logistics, approvals..."></textarea>
          </label>
          <label>
            Licensing / insurance / credentials
            <textarea name="credentials" rows="3" placeholder="Professional registration, contractor licence, insurance, trade credentials, local approvals experience..."></textarea>
          </label>
          <label>
            How would you like to work with Bauhu?
            <textarea name="message" rows="5" required></textarea>
          </label>
          <label class="partner-consent">
            <input name="consent" type="checkbox" required />
            <span>I consent to Bauhu storing and reviewing this information in relation to professional, contractor or project partner opportunities.</span>
          </label>
          <button type="submit">Submit partner profile</button>
          <p class="partner-form-status" data-partner-status aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const form = document.querySelector('[data-partner-form]');
  const status = document.querySelector('[data-partner-status]');

  const getAttribution = () => {
    const params = new URLSearchParams(window.location.search);
    return {
      utmSource: params.get('utm_source') || document.referrer ? 'partner-page' : 'direct',
      utmMedium: params.get('utm_medium') || 'website',
      utmCampaign: params.get('utm_campaign') || 'partner-network',
      utmContent: params.get('utm_content') || '',
      utmTerm: params.get('utm_term') || '',
      landingPage: window.location.pathname,
      referrer: document.referrer || ''
    };
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    status.textContent = 'Submitting…';
    const data = new FormData(form);
    const role = data.get('role')?.toString() || '';
    const company = data.get('company')?.toString() || '';
    const location = data.get('location')?.toString() || '';
    const experience = data.get('experience')?.toString() || '';
    const credentials = data.get('credentials')?.toString() || '';
    const message = data.get('message')?.toString() || '';

    const payload = {
      sourceUrl: window.location.href,
      contact: {
        name: data.get('name')?.toString() || '',
        email: data.get('email')?.toString() || '',
        phone: data.get('phone')?.toString() || '',
        contactPreference: 'Email',
        consent: data.get('consent') === 'on',
        message: [
          `Partner / contractor enquiry`,
          company ? `Company: ${company}` : '',
          role ? `Role / trade: ${role}` : '',
          location ? `Operating region: ${location}` : '',
          experience ? `Relevant experience: ${experience}` : '',
          credentials ? `Credentials: ${credentials}` : '',
          message ? `How they would like to work with Bauhu: ${message}` : ''
        ].filter(Boolean).join('\n\n')
      },
      site: {
        place: location,
        source: 'partner-profile'
      },
      project: {
        route: 'partner',
        intendedUse: `Partner / contractor: ${role}`,
        bedrooms: 'Not applicable',
        landStatus: 'Not applicable',
        planningStatus: 'Not applicable',
        budget: 'Not applicable',
        targetStart: 'Partner profile',
        decisionRole: role,
        buildLocation: location,
        notes: `${company ? `Company: ${company}\n` : ''}${experience ? `Experience: ${experience}\n` : ''}${credentials ? `Credentials: ${credentials}\n` : ''}${message}`
      },
      home: {
        homeChoice: 'partner'
      },
      attribution: getAttribution()
    };

    const requestBody = new FormData();
    requestBody.append('payload', JSON.stringify(payload));

    try {
      const response = await fetch('/api/enquiries', { method: 'POST', body: requestBody });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Submission failed.');
      form.reset();
      status.textContent = `Thank you. Your partner profile has been submitted. Reference: ${result.reference || 'received'}.`;
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please email contact@bauhu.com.';
    }
  });
</script>

<style>
  :global(html), :global(body) { overflow-x:hidden !important; }
  .partner-page { background:#050505; color:#f8f6f0; overflow:hidden; font-family:Inter, system-ui, sans-serif; font-weight:300; }
  .partner-page * { box-sizing:border-box; }
  .partner-hero { min-height:82vh; display:flex; align-items:flex-end; padding:120px 7vw 105px; background:linear-gradient(180deg,rgba(5,5,5,.16),rgba(5,5,5,.86)),url('/images/developments/bauhu-projects-hero.webp') center/cover no-repeat; }
  .partner-hero-inner, .partner-two-col, .partner-inner, .partner-form-grid { max-width:1500px; margin:0 auto; width:100%; }
  .partner-kicker { color:#c8a96a; text-transform:uppercase; letter-spacing:.22em; font-size:12px; margin:0 0 22px; font-weight:500; }
  .partner-hero h1, .partner-intro h2, .partner-types-section h2, .partner-what-section h2, .partner-capability-section h2, .partner-form-section h2 { font-family:"Cormorant Garamond", Georgia, serif; font-weight:400; color:#f8f6f0; letter-spacing:-.055em; }
  .partner-hero h1 { max-width:1160px; font-size:clamp(46px,7.2vw,112px); line-height:.9; margin:0 0 28px; }
  .partner-hero p { max-width:850px; font-size:clamp(19px,2vw,28px); line-height:1.35; color:rgba(248,246,240,.76); margin:0; }
  .partner-intro, .partner-what-section { padding:110px 7vw; background:#050505; }
  .partner-two-col { display:grid; grid-template-columns:1.05fr .95fr; gap:64px; align-items:center; }
  .partner-intro h2, .partner-types-section h2, .partner-what-section h2, .partner-capability-section h2, .partner-form-section h2 { font-size:clamp(42px,6.7vw,100px); line-height:.94; margin:0; }
  .partner-copy p, .partner-form-lead { font-size:17px; line-height:1.75; color:rgba(248,246,240,.66); margin:0 0 22px; }
  .partner-types-section, .partner-capability-section { padding:100px 7vw 115px; background:#0a0a0a; }
  .partner-types-section h2, .partner-capability-section h2 { max-width:1100px; }
  .partner-types-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-top:54px; }
  .partner-types-grid article { border:1px solid rgba(255,255,255,.16); min-height:320px; padding:34px; background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.01)); }
  .partner-types-grid h3 { font-family:"Cormorant Garamond", Georgia, serif; font-size:clamp(26px,2.1vw,36px); line-height:1.06; font-weight:400; letter-spacing:-.035em; margin:0 0 20px; color:#f8f6f0; }
  .partner-types-grid p { color:rgba(248,246,240,.62); line-height:1.65; margin:0; }
  .partner-what-section { background:#050505; }
  .partner-capability-list { display:flex; flex-wrap:wrap; gap:12px; margin-top:50px; max-width:1180px; }
  .partner-capability-list span { border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.035); padding:13px 16px; color:rgba(248,246,240,.68); font-size:13px; line-height:1.25; }
  .partner-form-section { padding:115px 7vw 135px; background:radial-gradient(circle at 70% 18%,rgba(200,169,106,.18),transparent 35%),#050505; }
  .partner-form-grid { display:grid; grid-template-columns:.88fr 1.12fr; gap:70px; align-items:start; }
  .partner-form { display:grid; grid-template-columns:1fr 1fr; gap:20px; border:1px solid rgba(255,255,255,.14); padding:34px; background:rgba(255,255,255,.035); }
  .partner-form label { display:grid; gap:9px; color:rgba(248,246,240,.68); font-size:12px; letter-spacing:.08em; text-transform:uppercase; }
  .partner-form label:nth-of-type(5), .partner-form label:nth-of-type(n+7), .partner-consent, .partner-form button, .partner-form-status { grid-column:1 / -1; }
  .partner-form input, .partner-form select, .partner-form textarea { width:100%; border:1px solid rgba(255,255,255,.18); background:rgba(0,0,0,.32); color:#f8f6f0; padding:14px 14px; font:400 15px/1.4 Inter, system-ui, sans-serif; outline:none; }
  .partner-form textarea { resize:vertical; }
  .partner-form input:focus, .partner-form select:focus, .partner-form textarea:focus { border-color:#c8a96a; }
  .partner-consent { display:flex !important; grid-template-columns:auto 1fr !important; align-items:start; gap:12px !important; text-transform:none !important; letter-spacing:0 !important; font-size:13px !important; line-height:1.5; }
  .partner-consent input { width:auto; margin-top:3px; }
  .partner-form button { justify-self:start; border:1px solid #c8a96a; background:transparent; color:#f8f6f0; padding:15px 24px; text-transform:uppercase; letter-spacing:.16em; font-size:12px; cursor:pointer; transition:all .3s ease; }
  .partner-form button:hover { background:#c8a96a; color:#050505; }
  .partner-form-status { color:rgba(248,246,240,.72); line-height:1.6; margin:0; }
  @media screen and (max-width:1100px) {
    .partner-types-grid { grid-template-columns:repeat(2,1fr); }
  }
  @media screen and (max-width:900px) {
    .partner-hero { min-height:78vh; padding:96px 22px 74px; }
    .partner-hero h1, .partner-intro h2, .partner-types-section h2, .partner-what-section h2, .partner-capability-section h2, .partner-form-section h2 { font-size:clamp(36px,10.5vw,62px); line-height:.96; letter-spacing:-.045em; }
    .partner-intro, .partner-types-section, .partner-what-section, .partner-capability-section, .partner-form-section { padding-left:22px; padding-right:22px; }
    .partner-two-col, .partner-form-grid, .partner-types-grid, .partner-form { grid-template-columns:1fr; gap:34px; }
    .partner-types-grid article { min-height:auto; }
  }
</style>
