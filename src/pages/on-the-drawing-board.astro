---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { drawingBoardProjects } from '../data/drawing-board.js';
---
<BaseLayout title="On the Drawing Board | Architecture in Development | Bauhu" description="Explore Bauhu's architectural designs in development in the Exuma Cays and New Providence, The Bahamas. Bespoke island residences and architectural visualisations.">
  <SiteHeader />
  <main class="bg-paper text-ink">
    <section class="border-b border-ink/15">
      <div class="mx-auto grid max-w-site gap-8 px-5 pb-12 pt-24 sm:pb-16 sm:pt-32 lg:grid-cols-[1.3fr_0.7fr] lg:items-end lg:gap-12 lg:px-10 lg:pb-20 lg:pt-44">
        <div class="min-w-0">
          <p class="eyebrow text-clay">Bauhu / Architecture in development</p>
          <h1 class="mt-6 font-display text-[clamp(2.75rem,11vw,5rem)] leading-[1] tracking-tight sm:mt-8 md:text-8xl xl:text-[8rem]">On the<br /><em>Drawing Board.</em></h1>
        </div>
        <div class="min-w-0 max-w-md">
          <p class="text-lg leading-7 sm:text-xl sm:leading-9">A look at the homes taking shape before they take shape.</p>
          <p class="mt-4 leading-7 text-ink/65 sm:mt-5 sm:leading-8">Architectural studies and developing residential designs. Each project begins with its own site, brief and ambitions.</p>
          <p class="mt-6 text-xs uppercase leading-5 tracking-[0.12em] text-ink/50 sm:mt-8">Concepts and visualisations / Not completed buildings</p>
        </div>
      </div>
    </section>
    <section class="mx-auto max-w-site px-5 py-12 sm:py-16 lg:px-10 lg:py-24">
      <div class="mb-8 flex flex-wrap justify-between gap-3 border-b border-ink/20 pb-5 text-xs uppercase tracking-[0.12em] text-ink/55 sm:mb-12 sm:tracking-[0.18em]">
        <span>Selected designs</span><span>{String(drawingBoardProjects.length).padStart(2, '0')} projects</span>
      </div>
      <div class="space-y-16 sm:space-y-24 lg:space-y-36">
        {drawingBoardProjects.map((project, index) => (
          <article id={project.slug} class="scroll-mt-24">
            <div class="grid min-w-0 gap-6 lg:grid-cols-[1.25fr_0.75fr] lg:gap-12">
              <div class="min-w-0 overflow-hidden bg-[#dfe3de]">
                {project.images.length ? (
                  <img src={project.images[0].src} alt={project.images[0].alt} loading="lazy" decoding="async" class="block h-auto w-full object-contain" />
                ) : (
                  <div class="flex min-h-64 flex-col justify-between p-6 sm:min-h-96 sm:p-12">
                    <span class="text-xs uppercase tracking-[0.14em] text-[#68746c]">Visualisation reserved / {String(index + 1).padStart(2, '0')}</span>
                    <div class="border-t border-[#9daaa1] pt-6">
                      <span class="font-display text-4xl text-[#738078] sm:text-6xl">{project.title}</span>
                      <p class="mt-3 text-sm text-[#68746c]">New architectural imagery to follow</p>
                    </div>
                  </div>
                )}
              </div>
              <div class="flex min-w-0 flex-col justify-between">
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-ink/20 pb-4 text-[0.7rem] uppercase leading-5 tracking-[0.1em] text-ink/50 sm:text-xs sm:tracking-[0.16em]">
                    <span>{String(index + 1).padStart(2, '0')} / {project.category}</span><span>In design</span>
                  </div>
                  <p class="eyebrow mt-6 text-clay sm:mt-10">{project.location}</p>
                  <h2 class="mt-3 font-display text-[clamp(2.4rem,10vw,4.5rem)] leading-[1.05] sm:mt-5 lg:text-6xl xl:text-7xl">{project.title}</h2>
                  <p class="mt-5 max-w-md text-base leading-7 text-ink/65 sm:mt-8 sm:text-lg sm:leading-8">{project.overview}</p>
                </div>
                <p class="mt-8 border-t border-ink/15 pt-5 text-xs leading-6 text-ink/50 lg:mt-12">Architectural concept in development. Visualisations do not represent a completed property.</p>
              </div>
            </div>
            {project.images.length > 1 && (
              <div class="mt-4 grid gap-4 sm:mt-5 sm:gap-5">
                {project.images.slice(1).map(image => <img src={image.src} alt={image.alt} class="block h-auto w-full object-contain" loading="lazy" decoding="async" />)}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
    <section class="bg-mist">
      <div class="mx-auto grid max-w-site gap-6 px-5 py-14 sm:py-20 lg:grid-cols-[1fr_1fr] lg:items-end lg:px-10">
        <div><p class="eyebrow text-clay">From idea to architecture</p><h2 class="mt-5 font-display text-4xl leading-tight sm:text-5xl md:text-6xl">Every residence starts somewhere.</h2></div>
        <div><p class="max-w-lg text-base leading-7 text-ink/65 sm:text-lg sm:leading-8">Have a site or a concept of your own? Talk to Bauhu about how your project could take shape.</p><a class="mt-8 inline-block border-b border-ink pb-2 text-sm font-semibold" href="/site-fit/">Start your project →</a></div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
