---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EditorialHero from '../components/EditorialHero.astro';
---
<BaseLayout title="Hurricane-Resistant Caribbean Homes | Prefab & Modular | Bauhu" description="Bauhu designs hurricane-resistant Caribbean homes, from custom residences to prefabricated and modular steel-frame building systems for coastal and remote island sites.">
  <SiteHeader />
  <main>
    <EditorialHero
      eyebrow="Hurricane-resistant Caribbean homes"
      title="Architect-designed homes engineered for the Caribbean."
      text="Bauhu designs luxury modular and prefabricated homes for the Caribbean and The Bahamas, combining refined architecture with hurricane-resistant steel-frame engineering for coastal and remote island sites."
      primaryHref="/residences"
      primaryLabel="Commission a residence"
      secondaryHref="/models"
      secondaryLabel="Explore models"
      imageSrc="/images/home/bauhu-engineered-residences-hero.webp"
    />

    <!-- Preserved Bauhu Approach copy for possible reuse:
      Eyebrow: The Bauhu approach
      Heading: Architecture, engineering and delivery considered as one.
      Body: The site, climate, structure, procurement, shipping route and local build conditions are reviewed together from the beginning. The result is a home designed not only to look right, but to be engineered, manufactured, shipped and assembled with far greater control.
      Image: /images/home/bauhu-architecture-engineering.webp
    -->

    <section class="section-pad bg-mist">
      <div class="mx-auto grid max-w-site gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="eyebrow text-clay">Two routes</p>
          <h2 class="mt-5 font-display text-4xl leading-tight md:text-6xl">Custom residences or predesigned model homes.</h2>
        </div>
        <p class="text-lg leading-8 text-ink/70">Explore luxury modular homes and architect-designed prefab homes for the Caribbean and The Bahamas. Commission a bespoke residence shaped around your land, views and lifestyle, or adapt an existing Bauhu model as the starting point for a hurricane-resistant island home.</p>
      </div>
      <div class="mx-auto mt-14 grid max-w-site gap-5 md:grid-cols-2">
        <a href="/residences" class="group overflow-hidden bg-navy text-paper transition hover:-translate-y-1">
          <img src="/images/home/bauhu-contemporary-residences.webp" alt="Contemporary Bauhu custom residence" class="h-64 w-full object-cover opacity-85" loading="lazy" />
          <div class="p-8">
            <p class="eyebrow text-stone">Custom route</p>
            <h3 class="mt-16 font-display text-4xl md:text-5xl">Commission a Residence</h3>
            <p class="mt-5 max-w-md leading-7 text-paper/70">A design led route for clients seeking a home shaped around site, climate, privacy and view.</p>
          </div>
        </a>
        <a href="/models" class="group overflow-hidden bg-stone text-ink transition hover:-translate-y-1">
          <img src="/images/home/bauhu-model-home.webp" alt="Bauhu model home starting point" class="h-64 w-full object-cover" loading="lazy" />
          <div class="p-8">
            <p class="eyebrow text-clay">Model route</p>
            <h3 class="mt-16 font-display text-4xl md:text-5xl">Adapt a Bauhu Model</h3>
            <p class="mt-5 max-w-md leading-7 text-ink/70">A clear starting point using proven Bauhu ranges, refined for your site and budget.</p>
          </div>
        </a>
      </div>
    </section>


    <section class="section-pad bg-paper" aria-labelledby="featured-caribbean-models">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-clay">Explore Bauhu homes</p>
        <div class="mt-5 flex flex-wrap items-end justify-between gap-6">
          <div>
            <h2 id="featured-caribbean-models" class="font-display text-4xl leading-tight md:text-6xl">Prefab and modular homes for Caribbean living.</h2>
            <p class="mt-5 max-w-3xl text-lg leading-8 text-ink/70">Explore individual Bauhu designs for island sites, from compact holiday homes to larger family residences. Each model is a starting point for a site-specific project.</p>
          </div>
          <a href="/models/" class="text-sm font-semibold underline underline-offset-4">View all home models</a>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {[
            { name: 'Caribbean Cottage', href: '/homes/caribbean-cottage/', image: '/images/models/bauhu-caribbean-cottage/caribbean-cottage-original-hero.webp', description: 'Two-bedroom hurricane-resistant cottage' },
            { name: 'Angel', href: '/homes/angel/', image: '/images/models/bauhu-angel/bauhu-angel.webp', description: 'Three-bedroom contemporary island home' },
            { name: 'Bahama Beach', href: '/homes/bahama-beach/', image: '/images/models/bauhu-bahama-beach/bauhu-bahama-beach.webp', description: 'Three-bedroom home with a covered terrace' },
            { name: 'Sunset Cove', href: '/homes/sunset-cove/', image: '/images/models/bauhu-sunset-cove/bauhu-sunset-cove.webp', description: 'Two-bedroom home for indoor-outdoor living' },
          ].map((model) => (
            <a href={model.href} class="group block border border-ink/15 bg-mist">
              <img src={model.image} alt={`Bauhu ${model.name} modular home design`} loading="lazy" class="h-52 w-full object-cover" />
              <div class="p-5">
                <h3 class="font-display text-3xl">{model.name}</h3>
                <p class="mt-2 text-sm leading-6 text-ink/70">{model.description}</p>
                <span class="mt-4 inline-block text-sm font-semibold underline underline-offset-4">Explore this home</span>
              </div>
            </a>
          ))}
        </div>
        <p class="mt-7 text-base leading-7 text-ink/70">Planning a home in a specific location? Explore <a class="underline underline-offset-4" href="/locations/bahamas/">building in The Bahamas</a>, <a class="underline underline-offset-4" href="/remote-locations/">remote island construction</a> and <a class="underline underline-offset-4" href="/engineering/">hurricane-resistant engineering</a>.</p>
      </div>
    </section>

    <section class="section-pad bg-navy text-paper">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-stone">Why Bauhu</p>
        <h2 class="mt-5 max-w-5xl font-display text-4xl leading-tight md:text-6xl">Architect designed. Precision engineered. Controlled from design through delivery.</h2>
        <div class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          <article class="border border-paper/15 p-7">
            <p class="eyebrow text-stone">01 · Architecture</p>
            <h3 class="mt-10 font-display text-3xl">Homes worth building.</h3>
            <p class="mt-5 leading-7 text-paper/65">Custom residences and predesigned models begin with architecture, not with a catalogue of generic modules.</p>
          </article>
          <article class="border border-paper/15 p-7">
            <p class="eyebrow text-stone">02 · Engineering</p>
            <h3 class="mt-10 font-display text-3xl">Designed for exposure.</h3>
            <p class="mt-5 leading-7 text-paper/65">Structure, uplift, connections, openings and envelope are considered for demanding coastal and hurricane-exposed environments.</p>
          </article>
          <article class="border border-paper/15 p-7">
            <p class="eyebrow text-stone">03 · Control</p>
            <h3 class="mt-10 font-display text-3xl">Decisions moved upstream.</h3>
            <p class="mt-5 leading-7 text-paper/65">Design, specification, procurement and manufacture are coordinated before avoidable problems become expensive site problems.</p>
          </article>
          <article class="border border-paper/15 p-7">
            <p class="eyebrow text-stone">04 · Delivery</p>
            <h3 class="mt-10 font-display text-3xl">Built for difficult places.</h3>
            <p class="mt-5 leading-7 text-paper/65">Packing, shipping, handling and assembly are considered as part of the building strategy from the start.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section-pad bg-paper">
      <div class="mx-auto grid max-w-site gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="eyebrow text-clay">What Bauhu delivers</p>
          <h2 class="mt-5 font-display text-4xl leading-tight md:text-6xl">A coordinated building package, not just a drawing set or a frame.</h2>
          <p class="mt-8 text-lg leading-8 text-ink/70">Bauhu coordinates the architecture, structural system, project information, manufactured components and delivery strategy as one project. Local foundations, approvals, services and completion works are defined clearly for each location and project scope.</p>
          <p class="mt-6 text-lg leading-8 text-ink/70"><strong>Bauhu is not a catalogue-home supplier.</strong> It is a design and engineered delivery system for serious residential and hospitality projects.</p>
        </div>
        <div class="overflow-hidden border border-ink/15 bg-navy">
          <video class="h-full min-h-[30rem] w-full object-cover" autoplay muted loop playsinline preload="metadata" aria-label="Bauhu project delivery and completed residence">
            <source src="/videos/bauhu-delivers.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </section>

    <section class="section-pad bg-mist">
      <div class="mx-auto grid max-w-site gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="eyebrow text-clay">Controlled from design to delivery</p>
          <h2 class="mt-5 font-display text-4xl leading-tight md:text-6xl">We coordinate the journey after manufacture too.</h2>
        </div>
        <div class="space-y-6 text-lg leading-8 text-ink/70">
          <p>Bauhu coordinates procurement, consolidation and shipping so the building package is organised against the approved project information before dispatch. For remote and island projects, that means fewer disconnected supplier deliveries and more control over what reaches site.</p>
          <p>Once the package is delivered, Bauhu remains available to assist the local team during assembly. Detailed project information and assembly guidance support sequencing, structural connections, envelope installation and key construction stages.</p>
        </div>
      </div>
    </section>

    <section class="section-pad bg-navy text-paper">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-stone">Guided buyer journey</p>
        <h2 class="mt-5 max-w-4xl font-display text-4xl leading-tight md:text-6xl">From site review to manufactured building system.</h2>
        <div class="mt-14 grid gap-5 md:grid-cols-3">
          {['Start your project', 'Review site and feasibility', 'Design, engineer and deliver'].map((item, index) => (
            <div class="border border-paper/12 p-7">
              <p class="text-sm text-stone">0{index + 1}</p>
              <h3 class="mt-10 font-display text-3xl">{item}</h3>
            </div>
          ))}
        </div>
        <a href="/how-it-works" class="mt-12 inline-flex rounded-full border border-paper/40 px-6 py-3 text-sm uppercase tracking-wide">View the process</a>
      </div>
    </section>

    <section class="section-pad bg-paper">
      <div class="mx-auto max-w-site text-center">
        <p class="eyebrow text-clay">Begin</p>
        <h2 class="mx-auto mt-5 max-w-3xl font-display text-4xl leading-tight md:text-6xl">Start with the realities of your site.</h2>
        <p class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-ink/70">Send Bauhu the location, access information, planning status and any drawings or photographs. The first response should help clarify the right route.</p>
        <a href="/site-fit" class="mt-10 inline-flex rounded-full bg-navy px-7 py-4 text-sm uppercase tracking-wide text-paper">Start your project</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
