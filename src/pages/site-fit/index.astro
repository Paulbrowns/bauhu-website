---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<BaseLayout title="Locate Your Site | Bauhu" description="Locate your project site, confirm the parcel and create a preliminary Bauhu site summary.">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet-draw@1.0.4/dist/leaflet.draw.css" />
  <SiteHeader />

  <main class="site-fit-page">
    <header class="site-fit-header">
      <div>
        <p class="kicker">BAUHU SITE FIT</p>
        <h1>Locate your site</h1>
        <p>Search for the site, refine the pin, then retrieve an available cadastral boundary or draw an approximate parcel manually.</p>
      </div>
      <aside>
        <span>START YOUR PROJECT</span>
        <strong>Begin with the site</strong>
        <small>Locate the property first. You can choose a residence later.</small>
      </aside>
    </header>

    <section class="tool-shell">
      <aside class="control-panel">
        <div class="step"><b>01</b><div><strong>Locate property</strong><small>Search, coordinates or device location.</small></div></div>

        <form id="location-search-form">
          <label for="location-search">Address or place</label>
          <div class="search-row">
            <input id="location-search" type="search" placeholder="Island, settlement or address" />
            <button type="submit">Search</button>
          </div>
          <p id="search-feedback" class="feedback">Search is sent only when you press Search.</p>
          <div id="search-results" class="search-results" hidden></div>
        </form>

        <button id="use-current-location" class="secondary" type="button">◎ Use my current location</button>

        <div class="coordinate-grid">
          <label><span>Latitude</span><input id="latitude" type="number" step="0.000001" value="18.000000" /></label>
          <label><span>Longitude</span><input id="longitude" type="number" step="0.000001" value="-72.000000" /></label>
        </div>
        <button id="apply-coordinates" class="secondary" type="button">Go to coordinates</button>
        <div class="instruction">Click the map or drag the marker to refine the exact location.</div>
        <button id="confirm-location" class="primary" type="button">Use this location</button>

        <a class="skip-link" href="/start-your-project">Not found a site yet? Skip this step →</a>

        <section id="parcel-controls" hidden>
          <div class="step compact"><b>02</b><div><strong>Confirm parcel</strong><small>Use cadastral data or draw the boundary.</small></div></div>
          <div id="parcel-search-state" class="parcel-state">Ready to search parcel records.</div>
          <button id="find-parcel" class="primary" type="button">Search parcel records</button>
          <div class="or"><span>or</span></div>
          <button id="draw-boundary" class="secondary" type="button">Draw approximate boundary</button>
          <button id="clear-boundary" class="text-button" type="button" hidden>Clear boundary</button>

          <div id="parcel-result" class="parcel-result" hidden>
            <span id="parcel-source-label">PARCEL BOUNDARY</span>
            <strong id="parcel-reference">Selected parcel</strong>
            <dl>
              <div><dt>Source</dt><dd id="parcel-source">—</dd></div>
              <div><dt>Approx. area</dt><dd id="parcel-area">—</dd></div>
            </dl>
            <button id="confirm-parcel" class="primary" type="button">Confirm this parcel</button>
          </div>
        </section>
      </aside>

      <section class="map-workspace">
        <div class="map-toolbar">
          <div class="base-switch">
            <button id="map-view" class="active" type="button">Map</button>
            <button id="satellite-view" type="button">Satellite</button>
          </div>
          <div class="statuses">
            <span id="location-status">Location not confirmed</span>
            <span id="parcel-status" class="muted">Parcel not selected</span>
          </div>
        </div>

        <div class="map-stage">
          <div id="map-loading" class="map-loading">Loading map…</div>
          <div id="property-map" aria-label="Interactive property and parcel map"></div>
          <div class="map-card">
            <span>SELECTED POINT</span>
            <strong id="map-place-name">Caribbean</strong>
            <p><span id="map-latitude">18.000000</span>, <span id="map-longitude">-72.000000</span></p>
          </div>
        </div>

        <footer>
          <div><span>Location source</span><strong id="location-source">Manual map point</strong></div>
          <div><span>Boundary source</span><strong id="boundary-source">Not selected</strong></div>
          <div><span>Parcel area</span><strong id="footer-area">—</strong></div>
          <div><span>Next step</span><strong id="next-step">Confirm location</strong></div>
        </footer>
      </section>
    </section>

    <p class="disclaimer">Preliminary guidance only. Map positions, boundaries, planning requirements, hazards and construction suitability require professional verification.</p>
  </main>

  <SiteFooter />
  <script is:inline src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/leaflet-draw@1.0.4/dist/leaflet.draw.js"></script>
  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const mapElement = $('property-map');
      if (!mapElement || !window.L) return;

      const latInput = $('latitude');
      const lngInput = $('longitude');
      const feedback = $('search-feedback');
      const resultsBox = $('search-results');
      const loading = $('map-loading');
      let selectedName = 'Caribbean';
      let selectedSource = 'Manual map point';
      let activeBase = null;
      let boundaryLayer = null;
      let boundaryKind = null;
      let parcelAttributes = {};

      const map = L.map(mapElement, { zoomControl: false, preferCanvas: true }).setView([18, -72], 5);
      L.control.zoom({ position: 'bottomright' }).addTo(map);

      const street = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        crossOrigin: true,
        attribution: '&copy; OpenStreetMap contributors'
      });
      const satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 19,
        crossOrigin: true,
        attribution: 'Tiles &copy; Esri'
      });

      function setBase(layer, mode) {
        if (activeBase) map.removeLayer(activeBase);
        activeBase = layer.addTo(map);
        $('map-view').classList.toggle('active', mode === 'map');
        $('satellite-view').classList.toggle('active', mode === 'satellite');
        setTimeout(() => map.invalidateSize(), 50);
      }

      street.once('load', () => { loading.hidden = true; });
      street.on('tileerror', () => {
        loading.textContent = 'Some map tiles could not load. Try Satellite.';
        loading.classList.add('error');
      });
      setBase(street, 'map');
      $('map-view').onclick = () => setBase(street, 'map');
      $('satellite-view').onclick = () => setBase(satellite, 'satellite');

      const marker = L.marker([18, -72], { draggable: true }).addTo(map);
      const drawnItems = new L.FeatureGroup().addTo(map);
      const format = (value) => Number(value).toFixed(6);

      function setPoint(lat, lng, { pan = true, zoom = 16 } = {}) {
        lat = Number(lat);
        lng = Number(lng);
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
        marker.setLatLng([lat, lng]);
        if (pan) map.setView([lat, lng], Math.max(map.getZoom(), zoom));
        latInput.value = format(lat);
        lngInput.value = format(lng);
        $('map-latitude').textContent = format(lat);
        $('map-longitude').textContent = format(lng);
        $('map-place-name').textContent = selectedName;
        $('location-source').textContent = selectedSource;
      }

      marker.on('dragend', () => {
        selectedName = 'Adjusted map point';
        selectedSource = 'Dragged marker';
        const point = marker.getLatLng();
        setPoint(point.lat, point.lng, { pan: false });
      });

      map.on('click', (event) => {
        if (map._bauhuDrawing) return;
        selectedName = 'Selected map point';
        selectedSource = 'Map click';
        setPoint(event.latlng.lat, event.latlng.lng, { pan: false });
      });

      $('apply-coordinates').onclick = () => {
        selectedName = 'Entered coordinates';
        selectedSource = 'Latitude / longitude';
        setPoint(latInput.value, lngInput.value, { zoom: 17 });
      };

      $('use-current-location').onclick = () => {
        if (!navigator.geolocation) {
          feedback.textContent = 'Geolocation is unavailable.';
          return;
        }
        navigator.geolocation.getCurrentPosition((position) => {
          selectedName = 'Current device location';
          selectedSource = 'Browser geolocation';
          setPoint(position.coords.latitude, position.coords.longitude, { zoom: 17 });
          feedback.textContent = `Location accuracy approximately ${Math.round(position.coords.accuracy)} m.`;
        }, () => {
          feedback.textContent = 'Location permission was unavailable.';
        });
      };

      $('location-search-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const query = $('location-search').value.trim();
        if (query.length < 3) {
          feedback.textContent = 'Enter at least three characters.';
          return;
        }
        feedback.textContent = 'Searching…';
        resultsBox.hidden = true;
        resultsBox.innerHTML = '';
        try {
          const response = await fetch(`https://nominatim.openstreetmap.org/search?format=jsonv2&limit=5&q=${encodeURIComponent(query)}`, {
            headers: { 'Accept-Language': navigator.language || 'en' }
          });
          if (!response.ok) throw new Error('search failed');
          const rows = await response.json();
          if (!rows.length) {
            feedback.textContent = 'No matching locations found.';
            return;
          }
          rows.forEach((row) => {
            const button = document.createElement('button');
            button.type = 'button';
            const title = document.createElement('strong');
            const detail = document.createElement('span');
            title.textContent = row.display_name.split(',')[0];
            detail.textContent = row.display_name;
            button.append(title, detail);
            button.onclick = () => {
              selectedName = row.display_name;
              selectedSource = 'OpenStreetMap search';
              setPoint(row.lat, row.lon, { zoom: 17 });
              resultsBox.hidden = true;
              feedback.textContent = 'Location selected. Refine the pin, then confirm.';
            };
            resultsBox.appendChild(button);
          });
          resultsBox.hidden = false;
          feedback.textContent = `${rows.length} locations found.`;
        } catch {
          feedback.textContent = 'Search is temporarily unavailable. Enter coordinates or use the map.';
        }
      });

      function inUsvi(lat, lng) {
        return lat >= 17.62 && lat <= 18.48 && lng >= -65.15 && lng <= -64.45;
      }

      function polygonAreaM2(latlngs) {
        const points = latlngs.map((point) => Array.isArray(point) ? { lat: point[0], lng: point[1] } : point);
        if (points.length < 3) return 0;
        const lat0 = points.reduce((sum, point) => sum + point.lat, 0) / points.length * Math.PI / 180;
        let total = 0;
        for (let i = 0; i < points.length; i += 1) {
          const a = points[i];
          const b = points[(i + 1) % points.length];
          const ax = a.lng * 111320 * Math.cos(lat0);
          const ay = a.lat * 111320;
          const bx = b.lng * 111320 * Math.cos(lat0);
          const by = b.lat * 111320;
          total += ax * by - bx * ay;
        }
        return Math.abs(total) / 2;
      }

      function displayArea(m2) {
        return m2 >= 4046.856 ? `${(m2 / 4046.856).toFixed(2)} acres` : `${Math.round(m2).toLocaleString()} m²`;
      }

      function getRing(layer) {
        const raw = layer.getLatLngs();
        return Array.isArray(raw[0]) && Array.isArray(raw[0][0]) ? raw[0][0] : raw[0];
      }

      function clearBoundary() {
        if (boundaryLayer) {
          map.removeLayer(boundaryLayer);
          drawnItems.clearLayers();
        }
        boundaryLayer = null;
        boundaryKind = null;
        parcelAttributes = {};
        $('parcel-result').hidden = true;
        $('clear-boundary').hidden = true;
        $('parcel-status').textContent = 'Parcel not selected';
        $('parcel-status').className = 'muted';
        $('boundary-source').textContent = 'Not selected';
        $('footer-area').textContent = '—';
      }

      function setBoundary(layer, kind, attributes = {}) {
        if (boundaryLayer) {
          map.removeLayer(boundaryLayer);
          drawnItems.clearLayers();
        }
        boundaryLayer = layer;
        boundaryKind = kind;
        parcelAttributes = attributes;
        if (kind === 'manual') drawnItems.addLayer(layer);
        else layer.addTo(map);

        const area = polygonAreaM2(getRing(layer));
        const parcelId = attributes.PARCEL_ID || attributes.PARCELID || attributes.PARCEL_NO || attributes.PIN || attributes.OBJECTID;
        $('parcel-result').hidden = false;
        $('clear-boundary').hidden = false;
        $('parcel-source-label').textContent = kind === 'official' ? 'AVAILABLE CADASTRAL PARCEL' : 'USER-DRAWN BOUNDARY';
        $('parcel-reference').textContent = parcelId ? `Parcel ${parcelId}` : 'Approximate parcel';
        $('parcel-source').textContent = kind === 'official' ? 'USVI GIS cadastral service' : 'Drawn by user';
        $('parcel-area').textContent = displayArea(area);
        $('footer-area').textContent = displayArea(area);
        $('boundary-source').textContent = kind === 'official' ? 'USVI GIS' : 'User drawn';
        $('parcel-status').textContent = 'Boundary selected';
        $('parcel-status').className = 'confirmed-status';
        $('next-step').textContent = 'Confirm parcel';
        map.fitBounds(layer.getBounds().pad(.25), { maxZoom: 19 });
      }

      async function findParcel() {
        const point = marker.getLatLng();
        $('parcel-search-state').textContent = 'Searching available parcel records…';
        $('find-parcel').disabled = true;

        if (!inUsvi(point.lat, point.lng)) {
          $('parcel-search-state').textContent = 'No connected cadastral provider is available for this location yet. Draw the boundary manually.';
          $('find-parcel').disabled = false;
          return;
        }

        const geometry = JSON.stringify({ x: point.lng, y: point.lat, spatialReference: { wkid: 4326 } });
        const url = 'https://services3.arcgis.com/UfiM23HwAqZRk1vw/arcgis/rest/services/Parcels_of_the_US_Virgin_Islands/FeatureServer/0/query?' + new URLSearchParams({
          geometry,
          geometryType: 'esriGeometryPoint',
          inSR: '4326',
          spatialRel: 'esriSpatialRelIntersects',
          outFields: '*',
          returnGeometry: 'true',
          outSR: '4326',
          f: 'json'
        });

        try {
          const response = await fetch(url);
          if (!response.ok) throw new Error('parcel service failed');
          const data = await response.json();
          const feature = data.features?.[0];
          if (!feature?.geometry?.rings?.length) {
            $('parcel-search-state').textContent = 'No parcel intersected the selected point. Move the pin inside the property or draw the boundary manually.';
            return;
          }
          const latlngs = feature.geometry.rings.map((ring) => ring.map(([lng, lat]) => [lat, lng]));
          const layer = L.polygon(latlngs, { color: '#c5a66a', weight: 3, fillColor: '#d9b66f', fillOpacity: .22 });
          setBoundary(layer, 'official', feature.attributes || {});
          $('parcel-search-state').textContent = 'A cadastral parcel was found. Check the highlighted boundary before confirming.';
        } catch {
          $('parcel-search-state').textContent = 'The parcel service did not respond. Draw an approximate boundary or try again.';
        } finally {
          $('find-parcel').disabled = false;
        }
      }

      const drawHandler = window.L.Draw ? new L.Draw.Polygon(map, {
        allowIntersection: false,
        showArea: true,
        shapeOptions: { color: '#c5a66a', weight: 3, fillColor: '#d9b66f', fillOpacity: .2 }
      }) : null;

      $('draw-boundary').onclick = () => {
        clearBoundary();
        if (!drawHandler) {
          $('parcel-search-state').textContent = 'Drawing tools could not load. Refresh the page.';
          return;
        }
        map._bauhuDrawing = true;
        drawHandler.enable();
        $('parcel-search-state').textContent = 'Click around the parcel perimeter. Click the first point to close the boundary.';
      };

      map.on(L.Draw.Event.CREATED, (event) => {
        map._bauhuDrawing = false;
        setBoundary(event.layer, 'manual');
        $('parcel-search-state').textContent = 'Approximate boundary drawn. Check it before confirming.';
      });
      map.on('draw:drawstop', () => { map._bauhuDrawing = false; });

      $('clear-boundary').onclick = clearBoundary;
      $('find-parcel').onclick = findParcel;

      $('confirm-location').onclick = () => {
        $('parcel-controls').hidden = false;
        $('location-status').textContent = 'Location confirmed';
        $('location-status').className = 'confirmed-status';
        $('next-step').textContent = 'Search parcel records';
        $('confirm-location').textContent = 'Update confirmed location';
        findParcel();
      };

      $('confirm-parcel').onclick = () => {
        if (!boundaryLayer) return;
        const point = marker.getLatLng();
        const ring = getRing(boundaryLayer);
        const projectSite = {
          place: selectedName,
          source: selectedSource,
          lat: Number(point.lat.toFixed(6)),
          lng: Number(point.lng.toFixed(6)),
          parcel: $('parcel-reference').textContent,
          area: $('parcel-area').textContent,
          boundarySource: $('parcel-source').textContent,
          boundaryKind,
          boundary: ring.map((item) => [item.lat, item.lng]),
          parcelAttributes,
          savedAt: new Date().toISOString()
        };
        try { localStorage.setItem('bauhuProjectSite', JSON.stringify(projectSite)); } catch {}
        window.location.href = '/site-summary';
      };

      requestAnimationFrame(() => map.invalidateSize());
      setTimeout(() => map.invalidateSize(), 300);
    })();
  </script>
</BaseLayout>

<style>
  :global(.leaflet-container){font-family:Inter,sans-serif;background:#d9dfdc}
  .site-fit-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}
  .site-fit-header{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:4rem;padding:3.4rem 4vw 2.4rem;border-bottom:1px solid rgba(23,57,76,.18)}
  .kicker,.site-fit-header aside>span{margin:0 0 .8rem;font:700 .68rem/1 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#9b7b49}
  .site-fit-header h1{max-width:980px;margin:0 0 1rem;font:400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif}
  .site-fit-header>div>p:last-child{max-width:760px;font:300 1rem/1.7 Inter,sans-serif;color:rgba(23,57,76,.7)}
  .site-fit-header aside{display:flex;flex-direction:column;justify-content:flex-end;gap:.45rem;padding-left:2rem;border-left:1px solid rgba(23,57,76,.18);font-family:Inter,sans-serif}
  .site-fit-header aside strong{font:400 1.9rem 'Cormorant Garamond',serif}
  .tool-shell{display:grid;grid-template-columns:310px minmax(0,1fr);min-height:760px}
  .control-panel{padding:1.4rem;background:#f7f5ef;border-right:1px solid rgba(23,57,76,.16)}
  .step{display:flex;gap:.8rem;margin-bottom:1.3rem}
  .step b{display:grid;place-items:center;flex:0 0 32px;height:32px;border-radius:50%;background:#17394c;color:#fff;font:700 .68rem Inter,sans-serif}
  .step strong,.step small{display:block;font-family:Inter,sans-serif}
  .step strong{font-size:.82rem}.step small{margin-top:.2rem;color:rgba(23,57,76,.58)}
  .step.compact{margin-top:1.4rem;padding-top:1.3rem;border-top:1px solid rgba(23,57,76,.15)}
  .step.compact b{background:#c5a66a;color:#17394c}
  form label,.coordinate-grid span{display:block;margin-bottom:.45rem;font:700 .68rem Inter,sans-serif}
  .search-row{display:grid;grid-template-columns:1fr auto}
  .search-row input,.coordinate-grid input{width:100%;min-width:0;box-sizing:border-box;border:1px solid rgba(23,57,76,.22);background:#fff;padding:.8rem}
  .search-row button,.primary{border:0;background:#17394c;color:#fff;padding:0 1rem;font-weight:700;cursor:pointer}
  .feedback{min-height:2.2em;margin:.5rem 0 .8rem;font:400 .64rem/1.45 Inter,sans-serif;color:rgba(23,57,76,.58)}
  .search-results{display:grid;gap:.35rem;margin-bottom:.8rem}.search-results button{display:grid;gap:.2rem;padding:.7rem;border:1px solid rgba(23,57,76,.15);background:#fff;text-align:left;color:#17394c}.search-results span{font-size:.6rem;color:rgba(23,57,76,.58)}
  .secondary{width:100%;margin-bottom:.8rem;padding:.72rem;border:1px solid rgba(23,57,76,.24);background:transparent;color:#17394c;font-weight:700;cursor:pointer}
  .coordinate-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}
  .instruction,.parcel-state{margin:.2rem 0 .8rem;padding:.8rem;background:#ece9df;font:400 .64rem/1.45 Inter,sans-serif}
  .primary{width:100%;padding:.9rem}
  .skip-link{display:block;margin:1rem 0 0;padding:.8rem 0;border-top:1px solid rgba(23,57,76,.14);color:#17394c;font:700 .68rem/1.4 Inter,sans-serif;text-decoration:none}
  .skip-link:hover{text-decoration:underline}
  .or{display:flex;align-items:center;gap:.5rem;margin:.8rem 0;color:rgba(23,57,76,.45);font:700 .6rem Inter,sans-serif}.or:before,.or:after{content:'';height:1px;flex:1;background:rgba(23,57,76,.15)}
  .text-button{width:100%;border:0;background:none;color:#7c4037;text-decoration:underline;cursor:pointer}
  .parcel-result{margin-top:1rem;padding:1rem;background:#e9e1cf}.parcel-result>span{font:700 .58rem Inter,sans-serif;letter-spacing:.13em;color:#9b7b49}.parcel-result>strong{display:block;margin:.3rem 0 .8rem;font:400 1.35rem 'Cormorant Garamond',serif}.parcel-result dl{margin:0 0 .8rem}.parcel-result dl div{display:flex;justify-content:space-between;padding:.5rem 0;border-top:1px solid rgba(23,57,76,.12);font:400 .66rem Inter,sans-serif}.parcel-result dd{margin:0;font-weight:700}
