dding:clamp(2rem,5vw,5rem);height:100%;box-sizing:border-box;background:#e2e8e3}.analysis-panel h2,.three-d-placeholder h2{max-width:720px;margin:0 0 2rem;font:400 clamp(2rem,4vw,4rem)/1 'Cormorant Garamond',serif}.option-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;max-width:900px}.option-grid button{display:grid;gap:.5rem;min-height:140px;padding:1.4rem;text-align:left;border:1px solid rgba(23,57,76,.2);background:#f7f4ed;color:#17394c}.option-grid strong{font:400 1.5rem 'Cormorant Garamond',serif}.option-grid span,.analysis-note,.climate-message{font:400 .78rem/1.6 Inter,sans-serif;color:#69777d}.analysis-note{max-width:760px;margin-top:1.5rem}.priority-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;max-width:850px}.priority-grid label span{display:block;margin-bottom:.45rem;font:700 .7rem Inter,sans-serif}.climate-message{max-width:760px;margin-top:2rem;padding:1rem;border-left:3px solid #b6843e;background:#f7f4ed}.three-d-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:3rem;text-align:center;background:linear-gradient(#dce5df,#aebcb2)}.three-d-placeholder p{max-width:650px;font:400 .85rem/1.7 Inter,sans-serif}.massing{position:relative;width:260px;height:170px;margin-bottom:2rem;transform:skewY(-7deg);background:#f4efe5;box-shadow:25px 22px 0 rgba(23,57,76,.15)}.massing:before{content:'';position:absolute;left:-18px;right:-18px;top:-60px;height:70px;background:#e8e5dc;clip-path:polygon(50% 0,100% 78%,88% 100%,12% 100%,0 78%)}.massing i,.massing b,.massing span{position:absolute;bottom:0;width:9px;height:115px;background:#f4efe5;border:1px solid #c7c2b8}.massing i{left:-25px}.massing b{left:50%}.massing span{right:-25px}.summary-list{max-width:850px}.summary-list div{display:flex;justify-content:space-between;gap:2rem;padding:1rem 0;border-top:1px solid rgba(23,57,76,.15);font:400 .8rem Inter,sans-serif}.summary-list strong{text-align:right}.summary-action{display:inline-flex;margin-top:2rem;padding:1rem 1.3rem;background:#17394c;color:#fff;text-decoration:none;font:700 .72rem Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase}.site-fit-summary img{width:100%;aspect-ratio:4/3;object-fit:cover;margin-bottom:1rem}.site-fit-summary dl{margin:0}.site-fit-summary dl div{display:flex;justify-content:space-between;gap:1rem;padding:.7rem 0;border-top:1px solid rgba(23,57,76,.13);font:400 .75rem Inter,sans-serif}.site-fit-summary dd{margin:0;text-align:right;font-weight:700}.site-fit-status{display:grid;gap:.35rem;margin-top:1.5rem;padding:1rem;background:#ece9e1;font:400 .72rem/1.4 Inter,sans-serif}.site-fit-status.active{border-left:3px solid #547660}.site-fit-status.warning{border-left:3px solid #b6843e}.site-fit-disclaimer{margin:0;padding:1.2rem 4vw;font:400 .68rem/1.5 Inter,sans-serif;color:rgba(23,57,76,.62)}[hidden]{display:none!important}@media(max-width:1100px){.site-fit-shell{grid-template-columns:260px minmax(0,1fr)}.site-fit-summary{display:none}}@media(max-width:780px){.site-fit-header{grid-template-columns:1fr}.site-fit-model-summary{border-left:0;border-top:1px solid rgba(23,57,76,.18);padding:1.5rem 0 0}.site-fit-shell{grid-template-columns:1fr}.site-fit-steps{border-right:0;border-bottom:1px solid rgba(23,57,76,.16)}.site-fit-toolbar{overflow:auto}.site-fit-empty{min-height:500px}.workspace-readout{grid-template-columns:repeat(2,1fr);height:auto}.option-grid,.priority-grid{grid-template-columns:1fr}.site-canvas{min-height:480px}}
</style>