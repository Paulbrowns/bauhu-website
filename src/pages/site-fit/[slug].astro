---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { bauhuModels } from '../../data/models';

export function getStaticPaths() {
  return bauhuModels.map((model) => ({
    params: { slug: model.slug.replace(/^bauhu-/, '') },
    props: { model },
  }));
}

const { model } = Astro.props;
const publicSlug = model.slug.replace(/^bauhu-/, '');
const modelPageHref = `/homes/${publicSlug}`;
const modelAreaSqft = model.builtAreaSqftMax ?? model.builtAreaSqftMin ?? 1200;
const modelAreaM2 = Math.round(modelAreaSqft * 0.092903);
const assumedRatio = 1.18;
const modelDepthM = Math.sqrt(modelAreaM2 / assumedRatio);
const modelWidthM = modelDepthM * assumedRatio;
---

<BaseLayout title={`Test ${model.name} on your site | Bauhu`} description={`Use Bauhu's preliminary site-fit tool to test ${model.name} against your property.`}>
  <SiteHeader />
  <main
    class="site-fit-page"
    data-model-slug={publicSlug}
    data-model-name={model.name}
    data-model-width={modelWidthM.toFixed(2)}
    data-model-depth={modelDepthM.toFixed(2)}
    data-model-area={modelAreaM2}
  >
    <header class="site-fit-header">
      <div>
        <p>BAUHU SITE FIT</p>
        <h1>Test {model.name} on your property.</h1>
        <span>Add your property, set a working site envelope and explore preliminary placement, access, orientation and site constraints.</span>
      </div>
      <div class="site-fit-model-summary">
        <strong>{model.name}</strong>
        <span>{model.guidePriceLabel}</span>
        <span>{model.bedroomsLabel} bedrooms · {model.bathroomsLabel} bathrooms</span>
        <span>{model.builtAreaLabel} ft² · {model.storeysLabel} storeys</span>
        <a href={modelPageHref}>Return to model page</a>
      </div>
    </header>

    <section class="site-fit-shell" aria-label={`${model.name} preliminary site-fit tool`}>
      <aside class="site-fit-steps">
        <p>YOUR PROPERTY</p>
        <h2>Add a site to begin</h2>
        <form id="property-form">
          <label><span>Address or property name</span><input id="property-name" type="text" placeholder="Enter an address or location" required /></label>
          <label><span>Parcel reference</span><input id="parcel-reference" type="text" placeholder="Optional" /></label>
          <label><span>Country or jurisdiction</span><input id="jurisdiction" type="text" placeholder="Country, island or territory" required /></label>
          <div class="site-dimensions">
            <label><span>Working width</span><input id="plot-width" type="number" min="15" max="150" value="42" /><em>m</em></label>
            <label><span>Working depth</span><input id="plot-depth" type="number" min="15" max="150" value="32" /><em>m</em></label>
          </div>
          <button type="submit">Start site-fit study</button>
        </form>
        <div class="site-fit-upload">
          <strong>Upload survey or site plan</strong>
          <span id="upload-status">PDF or image. The file remains in this browser prototype.</span>
          <input id="survey-upload" type="file" accept=".pdf,.png,.jpg,.jpeg,.webp" />
        </div>
        <div class="placement-controls" id="placement-controls" hidden>
          <p>MODEL PLACEMENT</p>
          <label><span>Horizontal position <strong id="x-value">50%</strong></span><input id="position-x" type="range" min="8" max="92" value="50" /></label>
          <label><span>Vertical position <strong id="y-value">50%</strong></span><input id="position-y" type="range" min="8" max="92" value="50" /></label>
          <label><span>Rotation <strong id="rotation-value">0°</strong></span><input id="rotation" type="range" min="-90" max="90" step="5" value="0" /></label>
          <button id="reset-placement" type="button" class="secondary-control">Reset placement</button>
        </div>
      </aside>

      <div class="site-fit-workspace">
        <div class="site-fit-toolbar">
          <div role="tablist" aria-label="Site-fit views">
            <button type="button" class="is-active" data-view="site">Site fit</button>
            <button type="button" data-view="placement">Placement options</button>
            <button type="button" data-view="climate">Sun, views & access</button>
            <button type="button" data-view="three-d">3D site</button>
            <button type="button" data-view="summary">Summary</button>
          </div>
          <span>Preliminary assessment</span>
        </div>

        <div class="site-fit-empty" id="empty-state">
          <div class="site-fit-marker">+</div>
          <h2>Locate your property</h2>
          <p>Enter a property and a working site envelope. The tool will place the {model.name} footprint at an indicative scale for an early fit review.</p>
        </div>

        <div class="active-workspace" id="active-workspace" hidden>
          <section class="workspace-view is-active" data-panel="site">
            <div class="site-canvas" id="site-canvas">
              <div class="north-arrow"><b>N</b><i></i></div>
              <div class="road-edge">INDICATIVE ACCESS EDGE</div>
              <div class="setback-envelope"></div>
              <div class="model-footprint" id="model-footprint">
                <span>{model.name}</span>
                <small>Indicative footprint</small>
              </div>
              <div class="view-arrow">PRIMARY VIEW →</div>
            </div>
            <div class="workspace-readout">
              <div><span>Working site</span><strong id="site-size-readout">42 × 32 m</strong></div>
              <div><span>Model footprint</span><strong>{modelWidthM.toFixed(1)} × {modelDepthM.toFixed(1)} m</strong></div>
              <div><span>Indicative coverage</span><strong id="coverage-readout">—</strong></div>
              <div><span>Boundary review</span><strong id="boundary-readout">Awaiting calculation</strong></div>
            </div>
          </section>

          <section class="workspace-view" data-panel="placement">
            <div class="analysis-panel"><p>PLACEMENT OPTIONS</p><h2>Compare site strategies without changing the Bauhu model.</h2><div class="option-grid"><button type="button" data-placement="baseline"><strong>Baseline</strong><span>Centred working placement</span></button><button type="button" data-placement="view"><strong>Best view</strong><span>Move toward the selected outlook</span></button><button type="button" data-placement="access"><strong>Best access</strong><span>Reduce distance to access edge</span></button><button type="button" data-placement="grading"><strong>Lower grading impact</strong><span>Hold a more central site position</span></button></div><p class="analysis-note">These options are interface studies only until survey contours, access geometry and view bearings are processed.</p></div>
          </section>

          <section class="workspace-view" data-panel="climate">
            <div class="analysis-panel"><p>SUN, VIEWS & ACCESS</p><h2>Record the priorities that should influence placement.</h2><div class="priority-grid"><label><span>Primary view direction</span><select id="view-direction"><option>West</option><option>North</option><option>East</option><option>South</option></select></label><label><span>Access side</span><select id="access-side"><option>South</option><option>North</option><option>East</option><option>West</option></select></label><label><span>Morning sun priority</span><select><option>Balanced</option><option>Bedrooms</option><option>Living spaces</option><option>Low priority</option></select></label><label><span>Afternoon shading</span><select><option>High priority</option><option>Balanced</option><option>Low priority</option></select></label></div><div class="climate-message">Site-specific solar, wind and shading conclusions require coordinates, terrain and verified orientation.</div></div>
          </section>

          <section class="workspace-view" data-panel="three-d">
            <div class="three-d-placeholder"><div class="massing"><i></i><b></b><span></span></div><h2>3D site view</h2><p>The next geometry stage will place the catalogue model on terrain generated from the user’s survey. This placeholder shows the intended integrated view rather than a standalone model viewer.</p></div>
          </section>

          <section class="workspace-view" data-panel="summary">
            <div class="analysis-panel"><p>PRELIMINARY SUMMARY</p><h2 id="summary-title">Site-fit study</h2><div class="summary-list"><div><span>Property</span><strong id="summary-property">—</strong></div><div><span>Jurisdiction</span><strong id="summary-jurisdiction">—</strong></div><div><span>Parcel</span><strong id="summary-parcel">Not supplied</strong></div><div><span>Selected model</span><strong>{model.name}</strong></div><div><span>Working site coverage</span><strong id="summary-coverage">—</strong></div><div><span>Survey</span><strong id="summary-survey">Not uploaded</strong></div></div><a class="summary-action" href={`/start-your-project?model=${encodeURIComponent(model.name)}`}>Send this project to Bauhu</a></div>
          </section>
        </div>
      </div>

      <aside class="site-fit-summary">
        <p>SELECTED HOME</p>
        <img src={model.image} alt={`${model.name} Bauhu model residence`} onerror="this.src='/images/model-placeholder.svg'" />
        <h2>{model.name}</h2>
        <dl>
          <div><dt>Guide price</dt><dd>{model.guidePriceLabel}</dd></div>
          <div><dt>Bedrooms</dt><dd>{model.bedroomsLabel}</dd></div>
          <div><dt>Bathrooms</dt><dd>{model.bathroomsLabel}</dd></div>
          <div><dt>Built area</dt><dd>{model.builtAreaLabel} ft²</dd></div>
        </dl>
        <div class="site-fit-status" id="fit-status"><strong>Awaiting property</strong><span>Site-fit results activate after a property is added.</span></div>
      </aside>
    </section>

    <p class="site-fit-disclaimer">Preliminary guidance only. The working envelope is not a legal boundary. Boundaries, setbacks, planning requirements, hazards, structural design and construction suitability require verification by appropriately qualified professionals.</p>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const page = document.querySelector('.site-fit-page');
  const form = document.getElementById('property-form');
  const emptyState = document.getElementById('empty-state');
  const activeWorkspace = document.getElementById('active-workspace');
  const controls = document.getElementById('placement-controls');
  const footprint = document.getElementById('model-footprint');
  const upload = document.getElementById('survey-upload');
  const modelWidth = Number(page?.getAttribute('data-model-width') || 10);
  const modelDepth = Number(page?.getAttribute('data-model-depth') || 10);
  let siteActive = false;

  function value(id) { return document.getElementById(id)?.value || ''; }
  function numberValue(id) { return Number(value(id) || 0); }

  function updateStudy() {
    if (!siteActive || !footprint) return;
    const plotWidth = Math.max(1, numberValue('plot-width'));
    const plotDepth = Math.max(1, numberValue('plot-depth'));
    const x = numberValue('position-x');
    const y = numberValue('position-y');
    const rotation = numberValue('rotation');
    const widthPercent = Math.min(80, (modelWidth / plotWidth) * 100);
    const depthPercent = Math.min(80, (modelDepth / plotDepth) * 100);
    footprint.style.width = `${widthPercent}%`;
    footprint.style.height = `${depthPercent}%`;
    footprint.style.left = `${x}%`;
    footprint.style.top = `${y}%`;
    footprint.style.transform = `translate(-50%, -50%) rotate(${rotation}deg)`;
    document.getElementById('x-value').textContent = `${x}%`;
    document.getElementById('y-value').textContent = `${y}%`;
    document.getElementById('rotation-value').textContent = `${rotation}°`;
    document.getElementById('site-size-readout').textContent = `${plotWidth} × ${plotDepth} m`;
    const coverage = Math.round(((modelWidth * modelDepth) / (plotWidth * plotDepth)) * 100);
    document.getElementById('coverage-readout').textContent = `${coverage}%`;
    document.getElementById('summary-coverage').textContent = `${coverage}% of working envelope`;
    const edgeRisk = x - widthPercent / 2 < 5 || x + widthPercent / 2 > 95 || y - depthPercent / 2 < 5 || y + depthPercent / 2 > 95;
    document.getElementById('boundary-readout').textContent = edgeRisk ? 'Near working boundary' : 'Within working envelope';
    const status = document.getElementById('fit-status');
    status.className = `site-fit-status ${edgeRisk ? 'warning' : 'active'}`;
    status.innerHTML = `<strong>${edgeRisk ? 'Placement needs review' : 'Working placement established'}</strong><span>${coverage}% indicative site coverage. Verify against the legal survey and local rules.</span>`;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    siteActive = true;
    emptyState.hidden = true;
    activeWorkspace.hidden = false;
    controls.hidden = false;
    document.getElementById('summary-property').textContent = value('property-name');
    document.getElementById('summary-jurisdiction').textContent = value('jurisdiction');
    document.getElementById('summary-parcel').textContent = value('parcel-reference') || 'Not supplied';
    document.getElementById('summary-title').textContent = `${value('property-name')} · preliminary site fit`;
    updateStudy();
  });

  ['plot-width','plot-depth','position-x','position-y','rotation'].forEach((id) => document.getElementById(id)?.addEventListener('input', updateStudy));
  document.getElementById('reset-placement')?.addEventListener('click', () => {
    document.getElementById('position-x').value = '50';
    document.getElementById('position-y').value = '50';
    document.getElementById('rotation').value = '0';
    updateStudy();
  });

  upload?.addEventListener('change', () => {
    const file = upload.files?.[0];
    document.getElementById('upload-status').textContent = file ? `${file.name} selected · processing not connected yet` : 'PDF or image. The file remains in this browser prototype.';
    document.getElementById('summary-survey').textContent = file ? file.name : 'Not uploaded';
  });

  document.querySelectorAll('[data-view]').forEach((button) => button.addEventListener('click', () => {
    document.querySelectorAll('[data-view]').forEach((item) => item.classList.toggle('is-active', item === button));
    document.querySelectorAll('[data-panel]').forEach((panel) => panel.classList.toggle('is-active', panel.getAttribute('data-panel') === button.getAttribute('data-view')));
  }));

  document.querySelectorAll('[data-placement]').forEach((button) => button.addEventListener('click', () => {
    const mode = button.getAttribute('data-placement');
    const presets = { baseline:[50,50,0], view:[28,48,-10], access:[50,72,0], grading:[52,50,5] };
    const preset = presets[mode] || presets.baseline;
    document.getElementById('position-x').value = String(preset[0]);
    document.getElementById('position-y').value = String(preset[1]);
    document.getElementById('rotation').value = String(preset[2]);
    updateStudy();
  }));
</script>

<style>
