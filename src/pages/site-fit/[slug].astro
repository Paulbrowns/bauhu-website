---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { bauhuModels } from '../../data/models';

export function getStaticPaths() {
  return bauhuModels.map((model) => ({
    params: { slug: model.slug.replace(/^bauhu-/, '') },
    props: { model },
  }));
}

const { model } = Astro.props;
const publicSlug = model.slug.replace(/^bauhu-/, '');
const modelPageHref = `/homes/${publicSlug}`;
const areaSqft = model.builtAreaSqftMin ?? 1200;
const areaM2 = areaSqft * 0.092903;
const footprintWidthM = Math.sqrt(areaM2 * 1.18);
const footprintDepthM = areaM2 / footprintWidthM;
---

<BaseLayout
  title={`Test ${model.name} on your site | Bauhu`}
  description={`Locate your property and use Bauhu's preliminary site-fit tool to test ${model.name} against the site.`}
>
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIINfQ3ynhSVOmHqkPDLUGJTDy8hJ2jW+7k="
    crossorigin=""
  />
  <SiteHeader />

  <main
    class="site-fit-page"
    data-model-slug={publicSlug}
    data-model-name={model.name}
    data-footprint-width={footprintWidthM.toFixed(3)}
    data-footprint-depth={footprintDepthM.toFixed(3)}
  >
    <header class="site-fit-header">
      <div>
        <p class="site-fit-kicker">BAUHU SITE FIT</p>
        <h1>Find your property. Test {model.name} on the site.</h1>
        <span>
          Search for the property, correct the pin if necessary, then confirm the latitude and longitude before beginning the placement study.
        </span>
      </div>
      <div class="site-fit-model-summary">
        <span class="site-fit-label">Selected Bauhu home</span>
        <strong>{model.name}</strong>
        <span>{model.bedroomsLabel} bedrooms · {model.bathroomsLabel} bathrooms</span>
        <span>{model.builtAreaLabel} ft² · {model.storeysLabel} storeys</span>
        <a href={modelPageHref}>Return to model page</a>
      </div>
    </header>

    <section class="site-fit-shell" aria-label={`${model.name} property location tool`}>
      <aside class="location-panel">
        <div class="panel-step">
          <span>01</span>
          <div>
            <strong>Locate the property</strong>
            <small>Search, use your location or enter coordinates.</small>
          </div>
        </div>

        <form id="location-search-form" class="location-search">
          <label for="location-search">Address, place or parcel area</label>
          <div class="search-row">
            <input id="location-search" type="search" placeholder="e.g. Coral Bay, St John, USVI" autocomplete="street-address" />
            <button type="submit">Search</button>
          </div>
          <p id="search-feedback" class="search-feedback" aria-live="polite">Search is user-triggered; no autocomplete requests are sent.</p>
          <div id="search-results" class="search-results" hidden></div>
        </form>

        <button id="use-current-location" class="location-secondary" type="button">
          <span class="target-icon">◎</span>
          Use my current location
        </button>

        <div class="coordinate-grid">
          <label>
            <span>Latitude</span>
            <input id="latitude" type="number" step="0.000001" min="-90" max="90" value="18.341900" />
          </label>
          <label>
            <span>Longitude</span>
            <input id="longitude" type="number" step="0.000001" min="-180" max="180" value="-64.930700" />
          </label>
        </div>
        <button id="apply-coordinates" class="location-secondary compact" type="button">Go to coordinates</button>

        <div class="location-instruction">
          <span>+</span>
          <p>Click anywhere on the map or drag the marker to refine the exact site location.</p>
        </div>

        <button id="confirm-location" class="location-primary" type="button">Use this location</button>

        <div id="confirmed-location" class="confirmed-location" hidden>
          <span>Location confirmed</span>
          <strong id="confirmed-place">Selected map point</strong>
          <small id="confirmed-coordinates"></small>
        </div>

        <div id="placement-controls" class="placement-controls" hidden>
          <div class="panel-step small-step">
            <span>02</span>
            <div>
              <strong>Initial placement</strong>
              <small>Rotate the indicative model footprint.</small>
            </div>
          </div>
          <label class="rotation-control">
            <span>Model rotation <strong id="rotation-value">0°</strong></span>
            <input id="model-rotation" type="range" min="-180" max="180" step="5" value="0" />
          </label>
          <button id="centre-model" class="location-secondary compact" type="button">Centre model on pin</button>
        </div>

        <div class="provider-note">
          <strong>Prototype map service</strong>
          <p>OpenStreetMap provides the map context. Production address search can be switched to Mapbox, Google or another managed geocoder.</p>
        </div>
      </aside>

      <section class="map-workspace">
        <div class="map-toolbar">
          <div>
            <button class="is-active" type="button">Map</button>
            <button class="is-disabled" type="button" title="Satellite provider to be connected">Satellite</button>
          </div>
          <div class="map-statuses">
            <span id="location-status" class="status-pending">Location not confirmed</span>
            <span id="model-status" class="status-muted">Model hidden</span>
          </div>
        </div>

        <div class="map-stage">
          <div id="property-map" aria-label="Interactive property location map"></div>
          <div class="map-crosshair" aria-hidden="true"><i></i><i></i></div>
          <div class="map-tip">
            <strong>Set the property location</strong>
            <span>Search, click or drag the pin</span>
          </div>
          <div id="map-location-card" class="map-location-card">
            <span>SELECTED MAP POINT</span>
            <strong id="map-place-name">St John, US Virgin Islands</strong>
            <p><span id="map-latitude">18.341900</span>, <span id="map-longitude">-64.930700</span></p>
          </div>
          <div id="model-card" class="model-map-card" hidden>
            <span>INDICATIVE FOOTPRINT</span>
            <strong>{model.name}</strong>
            <p>{footprintWidthM.toFixed(1)} × {footprintDepthM.toFixed(1)} m estimated from published built area</p>
          </div>
        </div>

        <footer class="workspace-footer">
          <div><span>Location source</span><strong id="location-source">Manual map point</strong></div>
          <div><span>Latitude</span><strong id="footer-latitude">18.341900</strong></div>
          <div><span>Longitude</span><strong id="footer-longitude">-64.930700</strong></div>
          <div><span>Next step</span><strong id="next-step">Confirm location</strong></div>
        </footer>
      </section>

      <aside class="model-panel">
        <p class="site-fit-kicker">SELECTED HOME</p>
        <img src={model.image} alt={`${model.name} Bauhu model residence`} onerror="this.src='/images/model-placeholder.svg'" />
        <h2>{model.name}</h2>
        <dl>
          <div><dt>Guide price</dt><dd>{model.guidePriceLabel}</dd></div>
          <div><dt>Bedrooms</dt><dd>{model.bedroomsLabel}</dd></div>
          <div><dt>Bathrooms</dt><dd>{model.bathroomsLabel}</dd></div>
          <div><dt>Built area</dt><dd>{model.builtAreaLabel} ft²</dd></div>
          <div><dt>Indicative footprint</dt><dd>{footprintWidthM.toFixed(1)} × {footprintDepthM.toFixed(1)} m</dd></div>
        </dl>
        <div class="fit-process">
          <div class="is-current"><span>1</span><p><strong>Locate property</strong><small>Map point and coordinates</small></p></div>
          <div><span>2</span><p><strong>Find parcel</strong><small>GIS or survey boundary</small></p></div>
          <div><span>3</span><p><strong>Test placement</strong><small>Fit, access and orientation</small></p></div>
          <div><span>4</span><p><strong>Send to Bauhu</strong><small>Qualified site enquiry</small></p></div>
        </div>
        <div class="model-panel-note">
          Coordinates identify the location, not the legal parcel. Boundary, setback and buildability checks require cadastral data or a verified survey.
        </div>
      </aside>
    </section>

    <p class="site-fit-disclaimer">
      Preliminary guidance only. Map positions, property boundaries, planning requirements, hazards, structural design and construction suitability require verification by appropriately qualified professionals.
    </p>
  </main>

  <SiteFooter />

  <script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>

  <script is:inline>
    (() => {
      const page = document.querySelector('.site-fit-page');
      const mapElement = document.getElementById('property-map');
      if (!page || !mapElement || !window.L) return;

      const modelName = page.dataset.modelName || 'Selected Bauhu model';
      const footprintWidth = Number(page.dataset.footprintWidth || 10);
      const footprintDepth = Number(page.dataset.footprintDepth || 10);
      const latitudeInput = document.getElementById('latitude');
      const longitudeInput = document.getElementById('longitude');
      const searchForm = document.getElementById('location-search-form');
      const searchInput = document.getElementById('location-search');
      const searchFeedback = document.getElementById('search-feedback');
      const searchResults = document.getElementById('search-results');
      const confirmButton = document.getElementById('confirm-location');
      const placementControls = document.getElementById('placement-controls');
      const confirmedLocation = document.getElementById('confirmed-location');
      const confirmedPlace = document.getElementById('confirmed-place');
      const confirmedCoordinates = document.getElementById('confirmed-coordinates');
      const locationStatus = document.getElementById('location-status');
      const modelStatus = document.getElementById('model-status');
      const nextStep = document.getElementById('next-step');
      const modelCard = document.getElementById('model-card');
      const rotationInput = document.getElementById('model-rotation');
      const rotationValue = document.getElementById('rotation-value');
      const locationSource = document.getElementById('location-source');

      let selectedName = 'St John, US Virgin Islands';
      let selectedSource = 'Manual map point';
      let footprintLayer = null;
      let lastSearchAt = 0;

      const initial = [18.3419, -64.9307];
      const map = L.map(mapElement, { zoomControl: false }).setView(initial, 12);
      L.control.zoom({ position: 'bottomright' }).addTo(map);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors',
      }).addTo(map);

      const marker = L.marker(initial, { draggable: true }).addTo(map);

      function formatCoordinate(value) {
        return Number(value).toFixed(6);
      }

      function setPoint(lat, lng, options = {}) {
        const safeLat = Math.max(-90, Math.min(90, Number(lat)));
        const safeLng = Math.max(-180, Math.min(180, Number(lng)));
        if (!Number.isFinite(safeLat) || !Number.isFinite(safeLng)) return;

        marker.setLatLng([safeLat, safeLng]);
        if (options.pan !== false) map.setView([safeLat, safeLng], options.zoom || Math.max(map.getZoom(), 16));
        latitudeInput.value = formatCoordinate(safeLat);
        longitudeInput.value = formatCoordinate(safeLng);
        document.getElementById('map-latitude').textContent = formatCoordinate(safeLat);
        document.getElementById('map-longitude').textContent = formatCoordinate(safeLng);
        document.getElementById('footer-latitude').textContent = formatCoordinate(safeLat);
        document.getElementById('footer-longitude').textContent = formatCoordinate(safeLng);
        document.getElementById('map-place-name').textContent = selectedName;
        locationSource.textContent = selectedSource;
        updateFootprint();
      }

      function offsetPoint(lat, lng, eastM, northM) {
        const latRadians = lat * Math.PI / 180;
        return [
          lat + northM / 111320,
          lng + eastM / (111320 * Math.cos(latRadians)),
        ];
      }

      function rotatePoint(east, north, angleDegrees) {
        const angle = angleDegrees * Math.PI / 180;
        return [
          east * Math.cos(angle) - north * Math.sin(angle),
          east * Math.sin(angle) + north * Math.cos(angle),
        ];
      }

      function footprintPoints() {
        const { lat, lng } = marker.getLatLng();
        const halfW = footprintWidth / 2;
        const halfD = footprintDepth / 2;
        const rotation = Number(rotationInput.value || 0);
        return [
          [-halfW, -halfD],
          [halfW, -halfD],
          [halfW, halfD],
          [-halfW, halfD],
        ].map(([east, north]) => {
          const [rotatedEast, rotatedNorth] = rotatePoint(east, north, rotation);
          return offsetPoint(lat, lng, rotatedEast, rotatedNorth);
        });
      }

      function updateFootprint() {
        if (!placementControls || placementControls.hidden) return;
        const points = footprintPoints();
        if (!footprintLayer) {
          footprintLayer = L.polygon(points, {
            color: '#c5a66a',
            weight: 3,
            fillColor: '#17394c',
            fillOpacity: 0.48,
          }).addTo(map);
          footprintLayer.bindTooltip(modelName, { permanent: true, direction: 'center', className: 'model-map-label' });
        } else {
          footprintLayer.setLatLngs(points);
        }
      }

      function confirmCurrentLocation() {
        const { lat, lng } = marker.getLatLng();
        confirmedLocation.hidden = false;
        placementControls.hidden = false;
        modelCard.hidden = false;
        confirmedPlace.textContent = selectedName;
        confirmedCoordinates.textContent = `${formatCoordinate(lat)}, ${formatCoordinate(lng)}`;
        locationStatus.textContent = 'Location confirmed';
        locationStatus.className = 'status-confirmed';
        modelStatus.textContent = 'Indicative footprint shown';
        modelStatus.className = 'status-confirmed';
        nextStep.textContent = 'Find parcel or upload survey';
        confirmButton.textContent = 'Update confirmed location';
        updateFootprint();
        map.fitBounds(L.latLngBounds(footprintPoints()).pad(1.8), { maxZoom: 18 });
      }

      marker.on('dragend', () => {
        selectedName = 'Adjusted map point';
        selectedSource = 'Dragged map marker';
        const { lat, lng } = marker.getLatLng();
        setPoint(lat, lng, { pan: false });
      });

      map.on('click', (event) => {
        selectedName = 'Selected map point';
        selectedSource = 'Map click';
        setPoint(event.latlng.lat, event.latlng.lng, { pan: false });
      });

      document.getElementById('apply-coordinates').addEventListener('click', () => {
        selectedName = 'Entered coordinates';
        selectedSource = 'Latitude / longitude';
        setPoint(latitudeInput.value, longitudeInput.value, { zoom: 17 });
      });

      document.getElementById('use-current-location').addEventListener('click', () => {
        if (!navigator.geolocation) {
          searchFeedback.textContent = 'Your browser does not provide geolocation.';
          return;
        }
        searchFeedback.textContent = 'Requesting your current location…';
        navigator.geolocation.getCurrentPosition(
          (position) => {
            selectedName = 'Current device location';
            selectedSource = 'Browser geolocation';
            setPoint(position.coords.latitude, position.coords.longitude, { zoom: 17 });
            searchFeedback.textContent = `Location accuracy approximately ${Math.round(position.coords.accuracy)} m.`;
          },
          () => {
            searchFeedback.textContent = 'Location permission was unavailable. Search or enter coordinates instead.';
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      });

      searchForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const query = searchInput.value.trim();
        if (query.length < 3) {
          searchFeedback.textContent = 'Enter at least three characters.';
          return;
        }

        const now = Date.now();
        if (now - lastSearchAt < 1100) {
          searchFeedback.textContent = 'Please wait a moment before searching again.';
          return;
        }
        lastSearchAt = now;
        searchFeedback.textContent = 'Searching OpenStreetMap…';
        searchResults.hidden = true;
        searchResults.innerHTML = '';

        try {
          const cacheKey = `bauhu-geocode:${query.toLowerCase()}`;
          let results = null;
          try { results = JSON.parse(localStorage.getItem(cacheKey) || 'null'); } catch {}
          if (!Array.isArray(results)) {
            const response = await fetch(`https://nominatim.openstreetmap.org/search?format=jsonv2&limit=5&addressdetails=1&q=${encodeURIComponent(query)}`, {
              headers: { 'Accept-Language': navigator.language || 'en' },
            });
            if (!response.ok) throw new Error('Search request failed');
            results = await response.json();
            try { localStorage.setItem(cacheKey, JSON.stringify(results)); } catch {}
          }

          if (!results.length) {
            searchFeedback.textContent = 'No matching locations found. Try a broader place name or enter coordinates.';
            return;
          }

          results.forEach((result) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.innerHTML = `<strong>${result.display_name.split(',')[0]}</strong><span>${result.display_name}</span>`;
            button.addEventListener('click', () => {
              selectedName = result.display_name;
              selectedSource = 'OpenStreetMap search';
              setPoint(Number(result.lat), Number(result.lon), { zoom: 17 });
              searchResults.hidden = true;
              searchFeedback.textContent = 'Location selected. Drag the pin to refine it, then confirm.';
            });
            searchResults.appendChild(button);
          });
          searchResults.hidden = false;
          searchFeedback.textContent = `${results.length} location${results.length === 1 ? '' : 's'} found.`;
        } catch (error) {
          searchFeedback.textContent = 'Address search is temporarily unavailable. Enter latitude and longitude or use the map directly.';
        }
      });

      confirmButton.addEventListener('click', confirmCurrentLocation);
      rotationInput.addEventListener('input', () => {
        rotationValue.textContent = `${rotationInput.value}°`;
        updateFootprint();
      });
      document.getElementById('centre-model').addEventListener('click', () => {
        updateFootprint();
        map.fitBounds(L.latLngBounds(footprintPoints()).pad(1.8), { maxZoom: 18 });
      });

      setPoint(initial[0], initial[1], { pan: false });
      setTimeout(() => map.invalidateSize(), 150);
    })();
  </script>
</BaseLayout>

<style>
  :global(.leaflet-control-attribution) { font-family: Inter, sans-serif; font-size: 10px; }
  :global(.model-map-label) { border: 0; background: rgba(23,57,76,.9); color: #fff; box-shadow: none; font: 700 10px/1 Inter,sans-serif; letter-spacing: .08em; text-transform: uppercase; }
  :global(.model-map-label:before) { display: none; }
  .site-fit-page { min-height: 100vh; padding-top: 5.5rem; background: #ebe9e2; color: #17394c; }
  .site-fit-header { display: grid; grid-template-columns: minmax(0,1fr) 320px; gap: 4rem; padding: 3.4rem 4vw 2.4rem; border-bottom: 1px solid rgba(23,57,76,.18); }
  .site-fit-kicker, .site-fit-label { margin: 0 0 .8rem; font: 700 .68rem/1 Inter,sans-serif; letter-spacing: .2em; text-transform: uppercase; color: #9b7b49; }
  .site-fit-header h1 { max-width: 980px; margin: 0 0 1rem; font: 400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif; letter-spacing: -.035em; }
  .site-fit-header > div > span:not(.site-fit-label) { display: block; max-width: 780px; font: 300 1rem/1.7 Inter,sans-serif; color: rgba(23,57,76,.7); }
  .site-fit-model-summary { display: flex; flex-direction: column; justify-content: flex-end; gap: .45rem; padding-left: 2rem; border-left: 1px solid rgba(23,57,76,.18); font: 400 .82rem/1.45 Inter,sans-serif; }
  .site-fit-model-summary strong { font: 400 1.9rem/1.05 'Cormorant Garamond',serif; }
  .site-fit-model-summary a { margin-top: .55rem; color: #17394c; font-weight: 700; }
  .site-fit-shell { display: grid; grid-template-columns: 300px minmax(0,1fr) 290px; min-height: 720px; border-bottom: 1px solid rgba(23,57,76,.18); }
  .location-panel, .model-panel { padding: 1.4rem; background: #f7f5ef; }
  .location-panel { border-right: 1px solid rgba(23,57,76,.16); }
  .model-panel { border-left: 1px solid rgba(23,57,76,.16); }
  .panel-step { display: flex; gap: .8rem; align-items: flex-start; margin-bottom: 1.4rem; }
  .panel-step > span { display: grid; place-items: center; flex: 0 0 32px; width: 32px; height: 32px; border-radius: 50%; background: #17394c; color: #fff; font: 700 .68rem Inter,sans-serif; }
  .panel-step strong, .panel-step small { display: block; font-family: Inter,sans-serif; }
  .panel-step strong { margin: .05rem 0 .25rem; font-size: .82rem; }
  .panel-step small { color: rgba(23,57,76,.58); line-height: 1.45; }
  .location-search label, .coordinate-grid label > span, .rotation-control > span { display: block; margin-bottom: .45rem; font: 700 .68rem/1 Inter,sans-serif; }
  .search-row { display: grid; grid-template-columns: 1fr auto; }
  .search-row input, .coordinate-grid input { width: 100%; min-width: 0; box-sizing: border-box; border: 1px solid rgba(23,57,76,.22); background: #fff; color: #17394c; padding: .82rem; font: 400 .76rem Inter,sans-serif; }
  .search-row button, .location-primary { border: 0; background: #17394c; color: #fff; padding: 0 1rem; font: 700 .7rem Inter,sans-serif; cursor: pointer; }
  .search-feedback { min-height: 2.2em; margin: .55rem 0 .8rem; font: 400 .64rem/1.45 Inter,sans-serif; color: rgba(23,57,76,.58); }
  .search-results { display: grid; gap: .35rem; margin: -.2rem 0 .9rem; }
  .search-results button { display: grid; gap: .2rem; width: 100%; padding: .7rem; border: 1px solid rgba(23,57,76,.15); background: #fff; color: #17394c; text-align: left; cursor: pointer; }
  .search-results strong, .search-results span { font-family: Inter,sans-serif; }
  .search-results strong { font-size: .72rem; }
  .search-results span { overflow: hidden; font-size: .6rem; line-height: 1.35; color: rgba(23,57,76,.58); text-overflow: ellipsis; }
  .location-secondary { display: flex; align-items: center; justify-content: center; gap: .5rem; width: 100%; margin-bottom: 1rem; padding: .78rem; border: 1px solid rgba(23,57,76,.24); background: transparent; color: #17394c; font: 700 .68rem Inter,sans-serif; cursor: pointer; }
  .location-secondary.compact { margin: .55rem 0 1rem; padding: .65rem; }
  .target-icon { font-size: 1rem; }
  .coordinate-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; }
  .location-instruction { display: flex; gap: .7rem; align-items: center; padding: .8rem; margin: .25rem 0 1rem; background: #ece9df; }
  .location-instruction > span { font: 300 1.4rem Inter,sans-serif; }
  .location-instruction p { margin: 0; font: 400 .64rem/1.45 Inter,sans-serif; color: rgba(23,57,76,.66); }
  .location-primary { width: 100%; padding: .9rem; }
  .confirmed-location { display: grid; gap: .25rem; margin-top: 1rem; padding: .9rem; background: #dfe9df; font-family: Inter,sans-serif; }
  .confirmed-location span { font-size: .6rem; letter-spacing: .12em; text-transform: uppercase; color: #497150; }
  .confirmed-location strong { font-size: .72rem; line-height: 1.35; }
  .confirmed-location small { font-size: .62rem; color: rgba(23,57,76,.62); }
  .placement-controls { margin-top: 1.2rem; padding-top: 1.2rem; border-top: 1px solid rgba(23,57,76,.15); }
  .small-step { margin-bottom: 1rem; }
  .small-step > span { width: 28px; height: 28px; flex-basis: 28px; background: #c5a66a; color: #17394c; }
  .rotation-control input { width: 100%; accent-color: #17394c; }
  .rotation-control > span { display: flex; justify-content: space-between; }
  .provider-note { margin-top: 1.3rem; padding-top: 1rem; border-top: 1px solid rgba(23,57,76,.13); }
  .provider-note strong, .provider-note p { font-family: Inter,sans-serif; }
  .provider-note strong { font-size: .66rem; }
  .provider-note p { margin: .35rem 0 0; font-size: .6rem; line-height: 1.5; color: rgba(23,57,76,.55); }
  .map-workspace { display: grid; grid-template-rows: auto 1fr auto; min-width: 0; }
  .map-toolbar { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem .9rem; border-bottom: 1px solid rgba(23,57,76,.16); background: #f7f5ef; }
