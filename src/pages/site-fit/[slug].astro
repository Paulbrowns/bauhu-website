ite-fit-steps form>button,.secondary-control{width:100%;border:0;background:#17394c;color:#fff;padding:.9rem;font:700 .75rem Inter,sans-serif}.secondary-control{background:transparent!important;color:#17394c!important;border:1px solid rgba(23,57,76,.24)!important}.site-fit-upload{display:grid;gap:.45rem;margin-top:1.5rem;padding:1rem;border:1px dashed rgba(23,57,76,.3);font:400 .72rem/1.4 Inter,sans-serif}.placement-controls{margin-top:1.5rem;padding-top:1.3rem;border-top:1px solid rgba(23,57,76,.15)}.placement-controls input[type=range]{width:100%;accent-color:#17394c}.site-fit-workspace{display:grid;grid-template-rows:auto 1fr;min-width:0}.site-fit-toolbar{display:flex;justify-content:space-between;gap:1rem;padding:.7rem 1rem;border-bottom:1px solid rgba(23,57,76,.16);background:#f7f4ed}.site-fit-toolbar div{display:flex;gap:.35rem;flex-wrap:wrap}.site-fit-toolbar button{border:1px solid rgba(23,57,76,.18);background:#fff;padding:.55rem .75rem;color:#17394c;font:700 .7rem Inter,sans-serif}.site-fit-toolbar button.is-active{background:#17394c;color:#fff}.site-fit-toolbar>span{align-self:center;font:700 .65rem Inter,sans-serif;color:#9a7a48}.site-fit-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:3rem;background:linear-gradient(rgba(23,57,76,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(23,57,76,.05) 1px,transparent 1px),#dde4df;background-size:24px 24px}.site-fit-marker{display:grid;place-items:center;width:64px;height:64px;border:1px solid rgba(23,57,76,.28);border-radius:50%;font:300 2rem Inter,sans-serif}.site-fit-empty h2{margin:1.2rem 0 .5rem;font:400 2.4rem 'Cormorant Garamond',serif}.site-fit-empty p{max-width:520px;margin:0;font:300 .9rem/1.7 Inter,sans-serif;color:rgba(23,57,76,.68)}.active-workspace{height:100%}.workspace-view{display:none;height:100%}.workspace-view.is-active{display:block}.site-canvas{position:relative;height:calc(100% - 92px);min-height:560px;overflow:hidden;backgroun