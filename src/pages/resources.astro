---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const resourceAreas = [
  ['Buyer questions', 'Clear answers for clients comparing custom residences, model residences, developments and the Bauhu construction route.'],
  ['Technical confidence', 'Plain English explanations of the steel frame system, hurricane resistance, remote site logistics and long term resilience.'],
  ['Project preparation', 'What we need from you at the start, what can be decided later, and how a serious first conversation should be prepared.'],
];

const downloads = [
  ['Assembly guidance', 'Example assembly guide material showing how the Bauhu package is interpreted on site.'],
  ['Foundation examples', 'Typical elevated and on-grade foundation information used to coordinate local works.'],
  ['Drawing samples', 'Example architectural, structural and construction drawing extracts for project review.'],
  ['Engineering information', 'Structural calculation examples and technical notes available as part of serious project discussions.'],
  ['Specification guidance', 'Indicative finishes, decor selections and scope notes for understanding what can be included.'],
  ['Brochure material', 'Brand, system and project overview material for buyers, advisers and development teams.'],
];

const clientNotes = [
  ['St Thomas, USVI', 'Bauhu has been great to work with, and extremely responsive.'],
  ['Eleuthera, The Bahamas', 'I am so impressed. It is absolutely beautiful.'],
  ['Guana Cay, The Bahamas', 'You and your team are nothing shy of amazing.'],
];

const faqGroups = [
  {
    title: 'Choosing the right Bauhu route',
    questions: [
      ['What is the difference between Custom Design and Home Models?', 'Custom Design is a fully tailored architectural commission developed around your brief and site. Home Models are architect-designed starting points that can be adapted around your land, budget, bedroom requirement and way of living.'],
      ['Is Bauhu a modular home company?', 'No. Bauhu uses a patented steel frame construction system, but the offer is architectural and project-led. The aim is not to sell generic modules, but to deliver resilient contemporary buildings with a more controlled route to construction.'],
      ['Can a model residence be changed?', 'Yes. A model is a starting point. Layouts, terraces, openings, shading, finishes and site response can be refined before the project is engineered and delivered.'],
      ['When should I choose a fully bespoke residence?', 'Choose the Custom Design route when the home needs to be entirely shaped around a unique brief, a particular lifestyle, a difficult site, or a money-no-object architectural ambition.'],
    ],
  },
  {
    title: 'Sites, climate and construction',
    questions: [
      ['Can Bauhu work on remote Caribbean sites?', 'Yes. Bauhu is especially relevant where remote access, limited labour, coastal exposure, shipping, sequencing and conventional construction risk need to be planned carefully from the beginning.'],
      ['What does hurricane resistant mean?', 'It means the structure is designed with severe wind exposure in mind. The exact engineering response depends on the site, local code, exposure category and final building design. Bauhu does not treat “hurricane proof” as an absolute promise.'],
      ['Can Bauhu build on sloping or difficult land?', 'Often, yes. Sloping land, coastal exposure and constrained access are exactly the kinds of issues that should be reviewed early so the right structural, foundation and delivery strategy can be chosen.'],
      ['Does Bauhu handle foundations and local works?', 'The scope depends on the project and location. Bauhu can help define what is supplied through its system and what needs to be delivered locally, including foundations, services, approvals and site works.'],
      ['How are codes and approvals handled?', 'Bauhu projects are engineered to the applicable project code, jurisdiction, exposure and final building geometry. The code basis, wind design criteria and approval route are confirmed project by project with the appointed engineer and relevant local professionals.'],
    ],
  },
  {
    title: 'Scope, finishes and commercial basics',
    questions: [
      ['What does a guide price include?', 'Guide prices are useful for early fit, but the confirmed supply scope is project-specific. Pricing depends on the final design, engineering, specification, location, shipping strategy and agreed Bauhu package.'],
      ['What is usually excluded?', 'Local foundations, approvals, services, ground works, site labour, local contractor costs, import duties, taxes, shipping and final completion works may sit outside the Bauhu supply unless specifically included in the agreed scope.'],
      ['How are payments structured?', 'A project normally starts with an initial deposit, with progress payments linked to design, engineering, procurement or fabrication milestones. Exact payment terms are confirmed in the project agreement.'],
      ['Does Bauhu provide finance?', 'No. If finance is required, it should be arranged separately by the buyer.'],
      ['Can finishes and decor be included?', 'Yes. Bauhu can coordinate kitchen, bathroom, internal finish, external finish and decor selections as part of the project specification. Alternative finishes, tile selections, cabinetry, sanitaryware and furniture packages can be discussed, with the final scope confirmed before supply.'],
      ['Can I choose alternative decor and finishes?', 'Yes. Finishes can usually be refined to suit the buyer, project style and local conditions, subject to cost, availability, technical suitability and the agreed project programme.'],
    ],
  },
  {
    title: 'Specification, performance and sustainability',
    questions: [
      ['Is Bauhu sustainable?', 'Bauhu’s sustainability case is based on material efficiency, reduced waste, precision manufacture, durable components, thermal performance and long-life resilience. Exact performance depends on the final project specification, climate and building envelope.'],
      ['Are the homes energy efficient?', 'The building envelope can be designed for high levels of insulation, reduced heat gain, efficient cooling and long-term comfort. Thermal performance is project-specific and should be assessed against the chosen wall, roof, glazing and shading specification.'],
      ['What documentation supports the building package?', 'Project documentation can include architectural drawings, structural assembly information, component layouts, connection details, schedules, foundation interface information, door and window schedules and project-specific supply scope.'],
      ['How does Bauhu reduce site waste?', 'More decisions are resolved before dispatch, and components are prepared against approved project information. That reduces improvised site cutting, duplicate ordering, unnecessary deliveries and avoidable waste.'],
    ],
  },
  {
    title: 'Developments and larger projects',
    questions: [
      ['Can Bauhu be used for apartments or condominiums?', 'Yes. Bauhu can be applied to multi-family buildings, condominium projects and residential clusters where repeated structural logic and architectural consistency are valuable.'],
      ['Can Bauhu support resort or multi building developments?', 'Yes. Bauhu can help with resort accommodation, villa clusters, guest residences, private estates, staff buildings and phased multi building development strategies.'],
      ['Do all buildings in a development need to be the same?', 'No. A development can use a consistent system and architectural language while varying unit types, orientation, scale, privacy, views and specification.'],
    ],
  },
  {
    title: 'Starting a conversation',
    questions: [
      ['What should I send Bauhu first?', 'Send the location, site photographs, survey or plot information if available, desired number of bedrooms, intended use, target scale, planning status and any inspiration images or architectural references.'],
      ['Do I need a full design brief before contacting Bauhu?', 'No. A clear ambition is enough to start. The brief can be developed with you once the site, budget level, lifestyle requirements and likely route are understood.'],
      ['Does Bauhu provide price guidance?', 'Yes. Model residences include guide-price filtering to help establish fit. Custom homes and developments need a project review before meaningful pricing can be given because site, scope, engineering and specification materially affect the cost.'],
      ['What happens after I submit a project?', 'Bauhu reviews the site, project type, timing, budget, planning position and any documents you provide. The first objective is to identify feasibility, the right project route and the next information or decision needed.'],
      ['What does Bauhu actually supply?', 'The exact scope is agreed project by project. Bauhu can coordinate architecture, engineering, the manufactured building system, procurement package and delivery information, while local foundations, approvals, services, finishing and site works are defined clearly for the location.'],
      ['Who assembles the building?', 'The assembly strategy depends on the project and location. Bauhu designs the system and documentation to reduce dependence on scarce specialist trades, with appropriate supervision and a clearly defined split between the supplied system and local works.'],
      ['Can Bauhu work with my local architect, engineer or contractor?', 'In many cases, yes. Local professionals can be important for approvals, code compliance, site works, services and final delivery depending on the jurisdiction.'],
    ],
  },
];
---
<BaseLayout title="Resources | Bauhu" description="Buyer questions, technical notes and project preparation guidance for Bauhu residences, model homes and developments.">
  <SiteHeader />
  <main class="resources-page">
    <section class="resources-hero">
      <div class="resources-hero-inner">
        <p class="resources-kicker">Resources</p>
        <h1>Questions clients ask before building with Bauhu.</h1>
        <p>Clear answers for serious buyers, developers and landowners considering a Bauhu residence, model home or multi-building development.</p>
      </div>
    </section>

    <section class="resources-intro">
      <div class="resources-two-col">
        <div>
          <p class="resources-kicker">Before Enquiry</p>
          <h2>Useful information should lead to a better first conversation.</h2>
        </div>
        <div class="resources-copy">
          <p>This page is here to answer the practical questions that come before a serious project review. What Bauhu is, what it is not, how models differ from custom residences, and what needs to be understood about the site before meaningful decisions can be made.</p>
          <p>Price guides are useful for early fit, but the confirmed scope is always project-specific. Site, engineering, specification, shipping, local works and approvals materially affect the final route.</p>
        </div>
      </div>
    </section>

    <section class="resources-areas-section">
      <div class="resources-areas-inner">
        <p class="resources-kicker">Resource Areas</p>
        <h2>Guidance for choosing, planning and understanding the Bauhu route.</h2>
        <div class="resources-areas-grid">
          {resourceAreas.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="resources-downloads-section">
      <div class="resources-areas-inner">
        <p class="resources-kicker">Downloads & Sample Documents</p>
        <h2>Example material available for serious project review.</h2>
        <p class="resources-section-lead">Bauhu can share sample documentation to help buyers, advisers and contractors understand the building package, project scope and coordination process. Exact documents vary by project.</p>
        <div class="resources-downloads-grid">
          {downloads.map(([title, text]) => (
            <article>
              <span>Available on request</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="resources-proof-section">
      <div class="resources-areas-inner">
        <p class="resources-kicker">Client Notes</p>
        <h2>Proof from real island projects.</h2>
        <div class="resources-proof-grid">
          {clientNotes.map(([location, quote]) => (
            <figure>
              <blockquote>“{quote}”</blockquote>
              <figcaption>{location}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="resources-faq-section">
      <div class="resources-faq-inner">
        <p class="resources-kicker">Buyer Questions</p>
        <h2>Frequently asked questions.</h2>
        <div class="faq-groups">
          {faqGroups.map((group) => (
            <section class="faq-group">
              <h3>{group.title}</h3>
              <div class="faq-list">
                {group.questions.map(([question, answer]) => (
                  <details>
                    <summary>{question}</summary>
                    <p>{answer}</p>
                  </details>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="resources-cta-section">
      <h2>Ready to discuss a real site?</h2>
      <p>Send your location, land information, broad brief and intended route. We can help decide whether a model residence, custom residence or development strategy is the right starting point.</p>
      <a class="resources-button" href="/site-fit">Start Your Project</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  :global(html), :global(body) { overflow-x:hidden !important; }
  .resources-page { background:#050505; color:#f8f6f0; overflow:hidden; font-family:Inter, system-ui, sans-serif; font-weight:300; font-synthesis:none; }
  .resources-page * { box-sizing:border-box; }
  .resources-hero { min-height:80vh; display:flex; align-items:flex-end; padding:120px 7vw 100px; background:linear-gradient(180deg,rgba(5,5,5,.18),rgba(5,5,5,.84)),url('/images/developments/bauhu-resources-hero.webp') center/cover no-repeat; }
  .resources-hero-inner, .resources-two-col, .resources-areas-inner, .resources-faq-inner { max-width:1500px; margin:0 auto; width:100%; }
  .resources-kicker { color:#c8a96a; text-transform:uppercase; letter-spacing:.22em; font-size:12px; margin:0 0 22px; font-weight:500; }
  .resources-hero h1, .resources-intro h2, .resources-areas-section h2, .resources-downloads-section h2, .resources-proof-section h2, .resources-faq-section h2, .resources-cta-section h2 { font-family:"Cormorant Garamond", Georgia, serif; font-weight:400; color:#f8f6f0; letter-spacing:-.055em; }
  .resources-hero h1 { max-width:1120px; font-size:clamp(46px,7.4vw,112px); line-height:.9; margin:0 0 28px; }
  .resources-hero p { max-width:820px; font-size:clamp(19px,2vw,28px); line-height:1.35; color:rgba(248,246,240,.76); margin:0; }
  .resources-intro { padding:110px 7vw; background:#050505; }
  .resources-two-col { display:grid; grid-template-columns:1.1fr .9fr; gap:64px; align-items:center; }
  .resources-intro h2, .resources-areas-section h2, .resources-downloads-section h2, .resources-proof-section h2, .resources-faq-section h2, .resources-cta-section h2 { font-size:clamp(44px,7vw,104px); line-height:.92; margin:0; }
  .resources-copy p { font-size:17px; line-height:1.75; color:rgba(248,246,240,.66); margin:0 0 22px; }
  .resources-section-lead { max-width:820px; margin:28px 0 0; color:rgba(248,246,240,.66); font-size:18px; line-height:1.7; }
  .resources-areas-section { padding:95px 7vw 110px; background:#0a0a0a; }
  .resources-areas-section h2, .resources-downloads-section h2, .resources-proof-section h2 { max-width:1050px; }
  .resources-areas-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:22px; margin-top:54px; }
  .resources-areas-grid article, .resources-downloads-grid article { border:1px solid rgba(255,255,255,.16); min-height:290px; padding:38px; background:linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.01)); }
  .resources-areas-grid h3, .resources-downloads-grid h3, .faq-group h3 { font-family:"Cormorant Garamond", Georgia, serif; font-size:clamp(28px,2.6vw,42px); line-height:1.05; font-weight:400; letter-spacing:-.035em; margin:0 0 22px; color:#f8f6f0; }
  .resources-areas-grid p, .resources-downloads-grid p { color:rgba(248,246,240,.62); line-height:1.65; margin:0; }
  .resources-downloads-section { padding:105px 7vw 115px; background:#050505; }
  .resources-downloads-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:22px; margin-top:54px; }
  .resources-downloads-grid span { display:block; margin-bottom:24px; color:#c8a96a; font-size:11px; letter-spacing:.18em; text-transform:uppercase; }
  .resources-proof-section { padding:105px 7vw 115px; background:#0a0a0a; }
  .resources-proof-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; margin-top:54px; }
  .resources-proof-grid figure { margin:0; padding:38px; border:1px solid rgba(255,255,255,.16); background:#050505; }
  .resources-proof-grid blockquote { margin:0; font-family:"Cormorant Garamond", Georgia, serif; font-size:clamp(30px,2.8vw,46px); line-height:1.05; letter-spacing:-.035em; color:#f8f6f0; }
  .resources-proof-grid figcaption { margin-top:28px; color:#c8a96a; font-size:12px; letter-spacing:.16em; text-transform:uppercase; }
  .resources-faq-section { padding:110px 7vw 130px; background:#050505; }
  .resources-faq-section h2 { max-width:980px; }
  .faq-groups { margin-top:64px; display:grid; gap:54px; }
  .faq-group { display:grid; grid-template-columns:.42fr .58fr; gap:54px; border-top:1px solid rgba(255,255,255,.16); padding-top:34px; }
  .faq-list { border-top:1px solid rgba(255,255,255,.12); }
  .faq-list details { border-bottom:1px solid rgba(255,255,255,.12); padding:22px 0; }
  .faq-list summary { cursor:pointer; list-style:none; font-family:"Cormorant Garamond", Georgia, serif; font-size:28px; line-height:1.12; letter-spacing:-.03em; color:#f8f6f0; }
  .faq-list summary::-webkit-details-marker { display:none; }
  .faq-list summary::after { content:'+'; float:right; color:#c8a96a; padding-left:24px; }
  .faq-list details[open] summary::after { content:'–'; }
  .faq-list p { color:rgba(248,246,240,.64); line-height:1.7; margin:18px 0 0; max-width:820px; }
  .resources-cta-section { padding:135px 7vw; text-align:center; background:radial-gradient(circle at 70% 30%, rgba(200,169,106,.20), transparent 36%), linear-gradient(135deg,#050505,#15120e); }
  .resources-cta-section h2 { max-width:1000px; margin:0 auto 26px; }
  .resources-cta-section p { max-width:760px; margin:0 auto; color:rgba(248,246,240,.66); font-size:18px; line-height:1.65; }
  .resources-button { display:inline-block; margin-top:34px; padding:15px 24px; border:1px solid #c8a96a; color:#f8f6f0; text-decoration:none; text-transform:uppercase; letter-spacing:.16em; font-size:12px; transition:all .3s ease; }
  .resources-button:hover { background:#c8a96a; color:#050505; }
  @media screen and (max-width:900px) {
    .resources-hero { min-height:78vh; padding:96px 22px 74px; }
    .resources-hero h1, .resources-intro h2, .resources-areas-section h2, .resources-downloads-section h2, .resources-proof-section h2, .resources-faq-section h2, .resources-cta-section h2 { font-size:clamp(36px,10.5vw,62px); line-height:.96; letter-spacing:-.045em; }
    .resources-hero p { max-width:100%; }
    .resources-intro, .resources-areas-section, .resources-downloads-section, .resources-proof-section, .resources-faq-section, .resources-cta-section { padding-left:22px; padding-right:22px; }
    .resources-two-col, .resources-areas-grid, .resources-downloads-grid, .resources-proof-grid, .faq-group { grid-template-columns:1fr; gap:34px; }
    .resources-areas-grid article, .resources-downloads-grid article { min-height:auto; }
    .faq-list summary { font-size:24px; }
  }
</style>
