---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { bauhuModels } from '../data/models';
---
<BaseLayout title="Choose Your Bauhu Route | Bauhu" description="Choose a Bauhu model, a private residence route or continue without deciding yet.">
  <SiteHeader />
  <main class="journey-page">
    <header class="journey-header">
      <div><p class="kicker">START YOUR PROJECT</p><h1>Choose or confirm the home.</h1><p>You do not need to make a final design decision now. Choose a model if you have one in mind, select a bespoke route, or continue undecided.</p></div>
      <aside><span>PROJECT JOURNEY</span><strong>3 of 4 · Home</strong><small>Next: your contact details.</small></aside>
    </header>

    <section class="home-shell">
      <form id="home-form" class="home-card">
        <label class="choice"><input type="radio" name="homeChoice" value="model" /><span><strong>Model residence</strong><small>Choose an existing Bauhu design as the starting point.</small></span></label>
        <div id="model-picker" class="model-picker" hidden>
          <label><span>Choose a model</span><select name="modelSlug"><option value="">Select a model</option>{bauhuModels.map((model) => <option value={model.slug.replace(/^bauhu-/, '')}>{model.name} · {model.bedroomsLabel} bed · {model.guidePriceLabel}</option>)}</select></label>
          <p id="model-help">You can review and change the model later.</p>
        </div>
        <label class="choice"><input type="radio" name="homeChoice" value="private" /><span><strong>Private residence</strong><small>A fully bespoke architectural commission.</small></span></label>
        <label class="choice"><input type="radio" name="homeChoice" value="development" /><span><strong>Development / multiple buildings</strong><small>Hospitality, residential clusters or larger projects.</small></span></label>
        <label class="choice"><input type="radio" name="homeChoice" value="unsure" /><span><strong>Not sure yet</strong><small>Let Bauhu recommend the right route from your brief.</small></span></label>


        <div class="form-actions"><a href="/project-details">← Back to project</a><button type="submit">Continue to contact details</button></div>
      </form>
    </section>
  </main>
  <SiteFooter />

  <script is:inline>
    (() => {
      const form = document.getElementById('home-form');
      const picker = document.getElementById('model-picker');
      const select = form.elements.modelSlug;
      let details = {}, previous = {};
      try { details = JSON.parse(localStorage.getItem('bauhuProjectDetails') || '{}'); } catch {}
      try { previous = JSON.parse(localStorage.getItem('bauhuProjectHome') || '{}'); } catch {}

      const initialChoice = previous.homeChoice || (details.route === 'model' ? 'model' : details.route === 'private' ? 'private' : details.route === 'development' ? 'development' : 'unsure');
      const radio = form.querySelector(`input[name="homeChoice"][value="${initialChoice}"]`);
      if (radio) radio.checked = true;
      if (previous.modelSlug) select.value = previous.modelSlug;

      const refresh = () => {
        const choice = form.querySelector('input[name="homeChoice"]:checked')?.value || '';
        picker.hidden = choice !== 'model';
      };
      form.addEventListener('change', refresh);
      select.addEventListener('change', refresh);


      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const choice = form.querySelector('input[name="homeChoice"]:checked')?.value;
        if (!choice) return;
        if (choice === 'model' && !select.value) { select.focus(); return; }
        const chosen = select.value ? select.options[select.selectedIndex] : null;
        const home = { homeChoice: choice, modelSlug: choice === 'model' ? select.value : '', modelName: choice === 'model' ? chosen.textContent.split(' · ')[0] : '' };
        try { localStorage.setItem('bauhuProjectHome', JSON.stringify(home)); } catch {}
        location.assign('/project-contact');
      });
      refresh();
    })();
  </script>
</BaseLayout>

<style>
.journey-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}.journey-header{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:4rem;padding:3.4rem 4vw 2.4rem;border-bottom:1px solid rgba(23,57,76,.18)}.kicker,.journey-header aside>span{margin:0 0 .8rem;font:700 .68rem/1 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#9b7b49}.journey-header h1{margin:0 0 1rem;font:400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif}.journey-header>div>p:last-child{max-width:760px;font:300 1rem/1.7 Inter,sans-serif;color:rgba(23,57,76,.7)}.journey-header aside{display:flex;flex-direction:column;justify-content:flex-end;gap:.45rem;padding-left:2rem;border-left:1px solid rgba(23,57,76,.18);font-family:Inter,sans-serif}.journey-header aside strong{font:400 1.8rem 'Cormorant Garamond',serif}.home-shell{max-width:880px;margin:0 auto;padding:2rem 4vw 4rem}.home-card{display:grid;gap:.8rem}.choice{display:flex;gap:1rem;align-items:flex-start;padding:1.15rem;background:#f7f5ef;border:1px solid rgba(23,57,76,.15);cursor:pointer}.choice input{margin-top:.2rem}.choice strong,.choice small{display:block;font-family:Inter,sans-serif}.choice strong{font-size:.82rem}.choice small{margin-top:.3rem;color:rgba(23,57,76,.62);line-height:1.45}.model-picker{padding:1rem 1.15rem;background:#f7f5ef;border:1px solid rgba(23,57,76,.15)}.model-picker label>span{display:block;margin-bottom:.45rem;font:700 .66rem Inter,sans-serif}.model-picker select{width:100%;padding:.88rem;border:1px solid rgba(23,57,76,.2);background:#fff;color:#17394c}.model-picker p{margin:.5rem 0 0;font:400 .64rem/1.5 Inter,sans-serif;color:rgba(23,57,76,.58)}.form-actions{display:flex;justify-content:space-between;align-items:center;margin-top:.8rem}.form-actions a{color:#17394c;font:700 .68rem Inter,sans-serif}.form-actions button{padding:.95rem 1.2rem;border:0;background:#17394c;color:#fff;font:700 .7rem Inter,sans-serif}@media(max-width:820px){.journey-header{grid-template-columns:1fr;gap:2rem}.journey-header aside{padding:1.3rem 0 0;border-left:0;border-top:1px solid rgba(23,57,76,.18)}}@media(max-width:620px){.form-actions{align-items:stretch;flex-direction:column-reverse;gap:.8rem}.form-actions button{width:100%}}
</style>