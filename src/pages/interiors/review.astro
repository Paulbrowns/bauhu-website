---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
const stages=[
  {number:'01',title:'Your selections',detail:'Your own design preferences, saved locally in this browser.'},
  {number:'02',title:'Bauhu design review',detail:'Our team confirms manufacturer references, room applications and technical compatibility.'},
  {number:'03',title:'Client approval',detail:'A versioned finishes schedule is issued for approval before procurement.'},
];
---
<BaseLayout title="Your Design Review | Bauhu Interiors" description="Review your personal Bauhu Interiors selections and prepare them for a Bauhu design consultation.">
  <SiteHeader />
  <main class="bg-paper">
    <section class="bg-ink px-5 pb-20 pt-40 text-paper lg:px-10">
      <div class="mx-auto max-w-site">
        <a href="/interiors/studio" class="text-xs uppercase tracking-widest text-paper/60">← Return to Design Studio</a>
        <p class="eyebrow mt-12 text-stone">Bauhu Interiors / Personal design review</p>
        <h1 class="mt-5 max-w-5xl font-display text-6xl leading-tight md:text-8xl">Your home, considered.</h1>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-paper/75">A clear overview of your architectural finishes and fitted components, ready to discuss with the Bauhu design team.</p>
      </div>
    </section>
    <section class="section-pad bg-paper">
      <div class="mx-auto max-w-site">
        <div id="review-empty" class="hidden bg-mist p-8 md:p-14">
          <p class="eyebrow text-clay">Nothing to review yet</p>
          <h2 class="mt-5 font-display text-5xl">Begin with your design.</h2>
          <p class="mt-5 max-w-xl text-ink/65">Your working draft is saved in the browser where you created it. If you're using another device, import the previously downloaded draft through the Design Studio first.</p>
          <a href="/interiors/studio" class="mt-8 inline-flex rounded-full bg-ink px-7 py-4 text-xs uppercase tracking-widest text-paper">Open Design Studio →</a>
        </div>
        <div id="review-coastal" class="hidden">
          <div class="mb-12 grid gap-7 lg:grid-cols-[0.7fr_1.3fr] lg:items-end">
            <div>
              <p class="eyebrow text-clay">Your curated mood board</p>
              <h2 id="review-coastal-title" class="mt-4 font-display text-5xl"></h2>
              <p class="mt-4 text-sm leading-7 text-ink/65">Your complete Bauhu Coastal starting scheme, including any personal refinements. A visual design draft, not an approved order.</p>
              <a href="/interiors/coastal" class="mt-6 inline-flex border-b border-ink/40 pb-2 text-xs uppercase tracking-widest">Refine Coastal →</a>
            </div>
            <div id="review-coastal-palette" class="grid h-16 grid-cols-4"></div>
          </div>
          <div class="grid gap-3 bg-mist p-3 lg:grid-cols-[1.15fr_0.85fr]">
            <div class="relative min-h-80 bg-stone">
              <img id="review-coastal-hero" class="absolute inset-0 h-full w-full object-cover" alt="Architectural mood board inspiration"/>
              <span id="review-coastal-hero-label" class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-ink/70 to-transparent p-6 font-display text-4xl text-paper"></span>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div class="relative col-span-2 min-h-48 bg-[#DDD2BC]">
                <img id="review-coastal-kitchen" alt="Nobilia manufacturer kitchen reference" class="h-52 w-full object-cover" loading="lazy"/>
                <span id="review-coastal-kitchen-name" class="absolute bottom-0 left-0 bg-paper/95 p-3 text-xs uppercase tracking-widest"></span>
              </div>
              <div id="review-coastal-floor" class="flex min-h-36 items-end bg-[#CFC3AD] p-3 text-xs">Ceramics</div>
              <div id="review-coastal-paint" class="flex min-h-36 items-end bg-[#EFE9DE] p-3 text-xs">Paint</div>
            </div>
          </div>
          <div id="review-coastal-spec" class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
          <div class="mt-8 flex flex-wrap gap-3">
            <button id="review-coastal-print" type="button" class="rounded-full bg-ink px-7 py-4 text-xs uppercase tracking-widest text-paper">Print my mood board</button>
            <button id="review-coastal-copy" type="button" class="rounded-full border border-ink/30 px-7 py-4 text-xs uppercase tracking-widest">Copy finish selections</button>
          </div>
          <p id="review-coastal-status" class="mt-3 text-sm text-ink/60" role="status"></p>
          <p class="mt-6 text-xs leading-6 text-ink/55">Real products and quantities will be confirmed by Bauhu before approval. Mood-board colours are digital approximations. This page does not place an order.</p>
        </div>
        <div id="review-content" class="hidden">
          <div class="grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-end">
            <div>
              <p class="eyebrow text-clay">Personal selection portfolio</p>
              <h2 id="review-home" class="mt-5 font-display text-5xl leading-tight md:text-6xl"></h2>
              <p id="review-collection" class="mt-4 text-lg text-ink/60"></p>
            </div>
            <div class="bg-mist p-7">
              <p class="text-xs uppercase tracking-widest text-ink/55">Your design progress</p>
              <p id="review-progress" class="mt-4 font-display text-4xl"></p>
              <div class="mt-5 h-2 overflow-hidden bg-ink/10"><div id="review-bar" class="h-full bg-ink transition-all" style="width:0%"></div></div>
              <p class="mt-4 text-xs leading-6 text-ink/60">Progress measures your own selections only. It is not client approval, a quotation or a procurement instruction.</p>
            </div>
          </div>
          <div id="review-sections" class="mt-14 grid gap-6 md:grid-cols-2"></div>
          <div class="mt-14 border-t border-ink/20 pt-10">
            <h3 class="font-display text-4xl">What happens next.</h3>
            <div class="mt-8 grid gap-5 md:grid-cols-3">
              {stages.map(stage=><article class="bg-mist p-7"><p class="text-xs tracking-widest text-clay">{stage.number}</p><h4 class="mt-5 font-display text-3xl">{stage.title}</h4><p class="mt-4 text-sm leading-7 text-ink/65">{stage.detail}</p></article>)}
            </div>
          </div>
          <div class="mt-12 flex flex-wrap gap-4">
            <a href="/interiors/studio" class="inline-flex rounded-full bg-ink px-7 py-4 text-xs uppercase tracking-widest text-paper">Continue personalising →</a>
            <button id="review-copy" type="button" class="rounded-full border border-ink/30 px-7 py-4 text-xs uppercase tracking-widest">Copy for consultation</button>
            <button id="review-print" type="button" class="rounded-full border border-ink/30 px-7 py-4 text-xs uppercase tracking-widest">Print review</button>
          </div>
          <p id="review-status" role="status" aria-live="polite" class="mt-5 text-sm text-ink/60"></p>
          <p class="mt-8 max-w-3xl text-sm leading-7 text-ink/60">This is a personal, non-binding draft stored on your device. Bauhu will validate supplier references, inclusion, availability, technical compatibility and quantities separately. Furniture, decorative lighting, curtains, rugs, artwork and loose accessories are not part of the Bauhu Interiors supply.</p>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  const escapeText=(value)=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const catalogue=[
    {key:'exterior',name:'Façades & openings',fields:[['render','Render colour direction'],['grain','Render grain'],['frames','Aluminium frame finish']]},
    {key:'kitchen',name:'Fitted kitchen',fields:[['cabinet','Cabinet front direction'],['worktop','Worktop direction'],['handles','Cabinet handles'],['sink','Sink and mixer direction']]},
    {key:'bathroom',name:'Bathrooms',fields:[['vanity','Vanity direction'],['basin','Basin and sanitary ware'],['faucet','Faucets']]},
    {key:'ceramics',name:'Ceramic finishes',fields:[['floor','Interior floor'],['wall','Wall ceramics']]},
    {key:'doors',name:'Interior joinery',fields:[['profile','Door profile'],['finish','Door finish'],['hardware','Door hardware']]},
    {key:'paint',name:'Interior paint',fields:[['walls','Wall palette'],['ceiling','Ceiling palette'],['reference','Colour reference']]}
  ];
  const kitchenLabels={upper:'Upper cabinet fronts',lower:'Lower / island fronts',carcase:'Carcass finish',worktop:'Worktop',handles:'Handles',sink:'Sink',mixer:'Mixer',splashback:'Splashback tiles'};
  const safeValue=value=>typeof value==='string'&&value.trim() ? value.trim().slice(0,200) : 'Not selected';
  const empty=document.getElementById('review-empty');
  const wrapper=document.getElementById('review-content');
  let draft;
  try{draft=JSON.parse(localStorage.getItem('bauhu-interiors-draft-v1')||'null')}catch{}
  // Curated Coastal schemes have their own local draft and should be reviewable without opening the legacy form.
  const coastalDefaults={
    natural:{name:'Coastal Natural',hero:'/images/models/bauhu-bahama-beach/2.webp',palette:['#F2EFE8','#DCD1BD','#BBB19F','#77746A'],finishes:{exterior:'Soft white',frames:'Pure white',kitchen:'Ivory supermatt',bath:'White & chrome',floor:'Warm limestone look',doors:'Matt white',paint:'Warm off-white'}},
    ocean:{name:'Coastal Ocean',hero:'/images/models/bauhu-barbados-blue/2.webp',palette:['#F0F1ED','#C9D7D8','#879FAA','#5A7887'],finishes:{exterior:'Soft white',frames:'Pure white',kitchen:'Ivory matt',bath:'White & chrome',floor:'Pale grey stone look',doors:'Matt white',paint:'Cool off-white'}},
    refined:{name:'Coastal Refined',hero:'/images/models/bauhu-cap-dantibes/2.webp',palette:['#E8E0D5','#C1AE97','#827060','#433D38'],finishes:{exterior:'Warm white',frames:'Anthracite',kitchen:'Soft sand',bath:'Walnut & chrome',floor:'Warm limestone look',doors:'Timber-look',paint:'Soft taupe'}}
  };
  const photos={'Ivory supermatt':'https://www.nobilia.de/fileadmin/_processed_/5/d/csm_336_touch_g2_40ce6e6ab7.webp','Ivory matt':'https://www.nobilia.de/fileadmin/_processed_/4/c/csm_418_laser_g1_c7ec336585.webp','Graphite ultra matt':'https://www.nobilia.de/fileadmin/_processed_/b/d/csm_961_easytouch_g1_36a0209cc2.webp'};
  let coastal;
  try {coastal=JSON.parse(localStorage.getItem('bauhu-interiors-coastal-v1')||'null')}catch{}
  if(coastal && Object.hasOwn(coastalDefaults,coastal.scheme)){
    const board=coastalDefaults[coastal.scheme];
    const labels={exterior:'Exterior render',frames:'Cortizo frame colour',kitchen:'Nobilia kitchen front',bath:'Bathroom scheme',floor:'Dominó floor direction',doors:'Compincar doors',paint:'CIN paint direction'};
    const validAlternatives={exterior:['Soft white','Warm white','Light grey'],frames:['Pure white','Anthracite'],kitchen:['Ivory supermatt','Ivory matt','Soft sand','Graphite ultra matt'],bath:['White & chrome','Walnut & chrome','Light wood & chrome'],floor:['Warm limestone look','Pale grey stone look','Light sand look'],doors:['Matt white','Timber-look','Soft grey'],paint:['Warm off-white','Cool off-white','Soft taupe']};
    const selected=key=>validAlternatives[key].includes(coastal.changes?.[key])?coastal.changes[key]:board.finishes[key];
    const panel=document.getElementById('review-coastal');panel.classList.remove('hidden');
    document.getElementById('review-coastal-title').textContent=board.name;
    document.getElementById('review-coastal-hero').src=board.hero;
    document.getElementById('review-coastal-hero-label').textContent=board.name;
    document.getElementById('review-coastal-palette').innerHTML=board.palette.map(tone=>'<span style="background:'+tone+'"></span>').join('');
    document.getElementById('review-coastal-kitchen-name').textContent='Kitchen · '+selected('kitchen');
    const kitchenPhoto=document.getElementById('review-coastal-kitchen');
    if(photos[selected('kitchen')])kitchenPhoto.src=photos[selected('kitchen')];else kitchenPhoto.hidden=true;
    const tileColours={'Warm limestone look':'#CFC3AD','Pale grey stone look':'#B9C0BE','Light sand look':'#E5D8BF'};
    const paintColours={'Warm off-white':'#EFE9DE','Cool off-white':'#ECEDEA','Soft taupe':'#BBAF9E'};
    document.getElementById('review-coastal-floor').style.backgroundColor=tileColours[selected('floor')];
    document.getElementById('review-coastal-floor').textContent='Ceramics · '+selected('floor');
    document.getElementById('review-coastal-paint').style.backgroundColor=paintColours[selected('paint')];
    document.getElementById('review-coastal-paint').textContent='Paint · '+selected('paint');
    document.getElementById('review-coastal-spec').innerHTML=Object.keys(labels).map(key=>'<div class="border-t border-ink/20 py-3"><p class="text-xs uppercase tracking-widest text-ink/55">'+escapeText(labels[key])+'</p><p class="mt-2 text-lg">'+escapeText(selected(key))+'</p></div>').join('');
    const lines=['BAUHU INTERIORS — '+board.name,'Unapproved client design preferences',''].concat(Object.keys(labels).map(key=>labels[key]+': '+selected(key)));
    document.getElementById('review-coastal-print').addEventListener('click',()=>window.print());
    document.getElementById('review-coastal-copy').addEventListener('click',async()=>{
      try{await navigator.clipboard.writeText(lines.join('\\n'));document.getElementById('review-coastal-status').textContent='Copied for consultation.'}
      catch{document.getElementById('review-coastal-status').textContent='Copy unavailable. Please use Print.'}
    });
  }
  if(!draft||draft.version!==1||!draft.selections||typeof draft.selections!=='object'||Array.isArray(draft.selections)){
    if(!coastal) empty.classList.remove('hidden');
  }else{
    wrapper.classList.remove('hidden');
    const collectionTitles={coastal:'Coastal',contemporary:'Contemporary',signature:'Signature',tropical:'Tropical'};
    document.getElementById('review-home').textContent=safeValue(draft.home)==='Not selected'?'My Bauhu home':safeValue(draft.home);
    document.getElementById('review-collection').textContent=(collectionTitles[draft.collection]||'Individual design')+' · Preliminary selections';
    const sections=document.getElementById('review-sections');
    let chosen=0;let possible=0;
    const plain=['BAUHU INTERIORS — PERSONAL DESIGN REVIEW','NOT APPROVED FOR PROCUREMENT','Project: '+safeValue(draft.home),'Collection: '+(collectionTitles[draft.collection]||'Individual design')];
    const renderLine=(label,value)=>{
      const current=safeValue(value);
      possible++;if(current!=='Not selected')chosen++;
      plain.push(label+': '+current);
      return '<div class="flex items-start justify-between gap-5 border-t border-ink/10 py-3 text-sm"><span class="text-ink/60">'+escapeText(label)+'</span><strong class="max-w-[60%] text-right font-medium">'+escapeText(current)+'</strong></div>';
    };
    const cards=catalogue.map(category=>{
      plain.push('',category.name.toUpperCase());
      let lines=category.fields.map(([key,label])=>renderLine(label,draft.selections[category.key+'.'+key])).join('');
      if(category.key==='kitchen'){
        plain.push('Kitchen component details');
        for(const [key,label] of Object.entries(kitchenLabels)) {
          const value=draft.kitchenDetails?.[key];
          lines+=renderLine(label,value);
        }
      }
      if(category.key==='bathroom'){
        const roomCount=Number(draft.rooms?.bathroomCount);
        const count=Number.isInteger(roomCount)?Math.max(0,Math.min(8,roomCount)):0;
        for(let i=1;i<=count;i++){
          const room=draft.rooms?.bathrooms?.[String(i)]||{};
          const roomName=safeValue(room.name)==='Not selected'?'Bathroom '+i:safeValue(room.name);
          plain.push('Room: '+roomName);
          lines+='<div class="mt-5 border-t border-ink/20 pt-3 font-display text-xl">'+escapeText(roomName)+'</div>';
          for(const [key,label] of [['vanity','Vanity'],['tiles','Wall tile direction'],['mixer','Mixer finish']])lines+=renderLine(label,room[key]);
          if(typeof room.notes==='string'&&room.notes.trim()){plain.push('Notes: '+room.notes.slice(0,500));lines+='<p class="mt-3 whitespace-pre-wrap text-sm text-ink/60">'+escapeText(room.notes.slice(0,500))+'</p>';}
        }
      }
      if(typeof draft.notes?.[category.key]==='string'&&draft.notes[category.key].trim()) {
        const note=draft.notes[category.key].slice(0,1000);
        plain.push('Notes: '+note);
        lines+='<p class="mt-3 whitespace-pre-wrap text-sm text-ink/60">'+escapeText(note)+'</p>';
      }
      const reviewed=draft.reviewed?.[category.key]===true;
      return '<article class="bg-mist p-7 md:p-9"><div class="flex items-start justify-between gap-3"><h3 class="font-display text-3xl">'+escapeText(category.name)+'</h3><span class="text-xs uppercase tracking-wide text-ink/50">'+(reviewed?'Reviewed':'In progress')+'</span></div><div class="mt-6">'+lines+'</div><a href="/interiors/studio#studio-tabs" class="mt-6 inline-block border-b border-ink/60 pb-2 text-xs uppercase tracking-widest">Edit in Studio →</a></article>';
    });
    sections.innerHTML=cards.join('');
    document.getElementById('review-progress').textContent=chosen+' of '+possible+' preferences recorded';
    document.getElementById('review-bar').style.width=(possible?Math.round(chosen/possible*100):0)+'%';
    plain.push('','All preferences are unapproved. Bauhu must review supplier references, contract scope and any price adjustments.');
    document.getElementById('review-copy').addEventListener('click',async()=>{
      try{await navigator.clipboard.writeText(plain.join('\n'));document.getElementById('review-status').textContent='Review copied. Paste it into your Bauhu consultation email.';}
      catch{document.getElementById('review-status').textContent='Unable to copy. Try printing the review instead.';}
    });
    document.getElementById('review-print').addEventListener('click',()=>window.print());
  }
</script>
<style>
  @media print {
    header,footer,#review-copy,#review-print,#review-coastal-copy,#review-coastal-print {display:none!important}
    #review-content {display:block!important}
    article {break-inside:avoid}
  }
</style>