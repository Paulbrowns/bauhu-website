---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const areas = [
  ['kitchen','Kitchen','Cabinetry, worktop, sink, mixer and fitted details.'],
  ['bathrooms','Bathrooms','Vanity furniture, sanitaryware, tapware and bathroom finishes.'],
  ['flooring','Flooring & wall tiles','Interior floor and bathroom wall ceramic direction.'],
  ['doors','Interior doors','Door profile, finish and associated hardware.'],
  ['paint','Interior paint','Wall and ceiling colour direction.'],
  ['frames','Windows & exterior doors','Aluminium frame colour and finish.'],
  ['render','Exterior render','Façade colour and render finish.'],
];

const designs = [
  ['coastal-natural','Coastal Natural'],['coastal-ocean','Coastal Ocean'],['coastal-refined','Coastal Refined'],
  ['contemporary-pure','Contemporary Pure'],['contemporary-graphite','Contemporary Graphite'],['contemporary-mineral','Contemporary Mineral'],
  ['signature-atelier','Signature Atelier'],['signature-gallery','Signature Gallery'],['signature-noir','Signature Noir'],
  ['tropical-canopy','Tropical Canopy'],['tropical-lagoon','Tropical Lagoon'],['tropical-terracotta','Tropical Terracotta'],
];
---
<BaseLayout title="Personalise Your Interior | Bauhu Interiors" description="Review your chosen Bauhu interior and tell us which elements you would like to keep or change.">
  <SiteHeader />
  <main class="bg-paper">
    <section class="bg-ink px-5 pb-16 pt-36 text-paper lg:px-10">
      <div class="mx-auto max-w-site">
        <a href="/interiors/#collections" class="text-xs uppercase tracking-widest text-paper/65">← All interior designs</a>
        <p class="eyebrow mt-12 text-stone">Bauhu Interiors / Personalisation</p>
        <div class="mt-5 grid gap-8 lg:grid-cols-[1.15fr_.85fr] lg:items-end">
          <div>
            <h1 class="font-display text-6xl leading-tight md:text-8xl">Start with a complete design.<br/>Change only what you want.</h1>
          </div>
          <p class="max-w-lg text-lg leading-8 text-paper/75">Your chosen Bauhu interior is the starting specification. Keep it exactly as designed, or flag the areas you would like us to reconsider.</p>
        </div>
      </div>
    </section>

    <section class="section-pad bg-paper" data-personalise>
      <div class="mx-auto max-w-site">
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr]">
          <aside class="self-start bg-mist p-6 md:p-8 lg:sticky lg:top-28">
            <p class="eyebrow text-clay">Your starting design</p>
            <label for="design-choice" class="mt-5 block text-sm font-medium">Selected Bauhu interior</label>
            <select id="design-choice" class="mt-3 w-full border border-ink/20 bg-paper px-4 py-3 text-sm text-ink">
              <option value="">Choose a design</option>
              {designs.map(([value,label]) => <option value={value}>{label}</option>)}
            </select>
            <p id="design-note" class="mt-5 text-sm leading-7 text-ink/65">Choose one of the 12 Bauhu interiors first. It becomes the coordinated base specification for your home.</p>

            <div class="mt-8 border-t border-ink/15 pt-7">
              <p class="text-xs uppercase tracking-widest text-clay">Prefer to browse yourself?</p>
              <p class="mt-3 text-sm leading-7 text-ink/65">You are welcome to explore our supplier library and their websites, then tell us what you like. We will check suitability, availability and how it fits your chosen scheme.</p>
              <a href="/interiors/materials" class="mt-5 inline-flex border-b border-ink/50 pb-2 text-xs uppercase tracking-widest">Explore materials & suppliers →</a>
            </div>

            <div class="mt-8 border-t border-ink/15 pt-7 text-xs leading-6 text-ink/55">
              Supplier websites are reference libraries, not Bauhu shopping catalogues. Products shown there are not automatically included, approved or available for a particular project.
            </div>
          </aside>

          <div>
            <div class="border border-ink/15 bg-mist p-7 md:p-9">
              <p class="eyebrow text-clay">How it works</p>
              <h2 class="mt-4 font-display text-4xl md:text-5xl">Keep the collection — or ask us to refine it.</h2>
              <p class="mt-5 max-w-3xl leading-8 text-ink/65">For each area, simply tell us whether you are happy with the collection selection. If not, describe the change you have in mind. Bauhu can then propose a small number of suitable alternatives from our supplier network.</p>
            </div>

            <div class="mt-8 space-y-4">
              {areas.map(([id,title,description],index) => (
                <section class="border border-ink/15 bg-paper p-6 md:p-8" data-area={id}>
                  <div class="flex flex-wrap items-start justify-between gap-5">
                    <div>
                      <p class="text-xs uppercase tracking-widest text-clay">{String(index+1).padStart(2,'0')}</p>
                      <h3 class="mt-2 font-display text-3xl">{title}</h3>
                      <p class="mt-2 text-sm leading-6 text-ink/60">{description}</p>
                    </div>
                    <div class="flex gap-2">
                      <label class="cursor-pointer border border-ink/20 px-4 py-3 text-xs uppercase tracking-wide has-[:checked]:bg-ink has-[:checked]:text-paper">
                        <input type="radio" name={id} value="keep" checked class="sr-only" />Keep as designed
                      </label>
                      <label class="cursor-pointer border border-ink/20 px-4 py-3 text-xs uppercase tracking-wide has-[:checked]:bg-ink has-[:checked]:text-paper">
                        <input type="radio" name={id} value="change" class="sr-only" />I'd like a change
                      </label>
                    </div>
                  </div>
                  <div class="mt-6 hidden" data-change-panel={id}>
                    <label class="block text-sm font-medium" for={'note-'+id}>What would you like to change?</label>
                    <textarea id={'note-'+id} rows="3" class="mt-3 w-full border border-ink/20 bg-mist px-4 py-3 text-sm" placeholder="For example: a darker kitchen, timber vanity, warmer floor tile..."></textarea>
                    <div class="mt-4 flex flex-wrap gap-3">
                      <a href="/interiors/materials" class="inline-flex border-b border-ink/50 pb-2 text-xs uppercase tracking-widest">I’ll browse the supplier library →</a>
                      <span class="text-xs leading-6 text-ink/50">or describe what you want above and Bauhu will recommend alternatives.</span>
                    </div>
                  </div>
                </section>
              ))}
            </div>

            <section class="mt-8 bg-ink p-7 text-paper md:p-9">
              <p class="eyebrow text-stone">Next step</p>
              <h2 class="mt-4 font-display text-4xl">Tell us about your project.</h2>
              <p class="mt-4 max-w-2xl leading-7 text-paper/70">Your interior direction is useful context, but the site, location, home and project requirements come first. We’ll keep these preferences as part of your working brief while you continue through the project journey.</p>
              <div class="mt-7 flex flex-wrap gap-3">
                <button id="send-preferences" type="button" class="rounded-full bg-paper px-7 py-4 text-xs uppercase tracking-widest text-ink">Continue to site & project details →</button>
                <a href="/interiors/#collections" class="rounded-full border border-paper/35 px-7 py-4 text-xs uppercase tracking-widest text-paper">Choose another design</a>
              </div>
              <p id="studio-status" class="mt-4 text-sm text-paper/60" aria-live="polite"></p>
            </section>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const requested = params.get('design') || '';
  const mode = params.get('mode') || '';
  const select = document.getElementById('design-choice');
  if (select && requested && [...select.options].some(o => o.value === requested)) select.value = requested;

  if (mode === 'approve') {
    const note = document.getElementById('design-note');
    if (note) note.textContent = 'Great — keep the collection as designed, or use the options on this page only if there is something you would like us to change.';
  }

  document.querySelectorAll('[data-area]').forEach(area => {
    const id = area.getAttribute('data-area');
    const panel = document.querySelector('[data-change-panel="'+id+'"]');
    area.querySelectorAll('input[type="radio"]').forEach(input => {
      input.addEventListener('change', () => {
        if (panel) panel.classList.toggle('hidden', input.value !== 'change' || !input.checked);
      });
    });
  });

  document.getElementById('send-preferences')?.addEventListener('click', () => {
    const chosen = select?.value || '';
    if (!chosen) {
      document.getElementById('studio-status').textContent = 'Please choose your Bauhu interior first.';
      select?.focus();
      return;
    }
    const label = select.options[select.selectedIndex]?.text || chosen;
    const lines = ['Selected Bauhu interior: '+label, ''];
    document.querySelectorAll('[data-area]').forEach(area => {
      const title = area.querySelector('h3')?.textContent?.trim() || '';
      const checked = area.querySelector('input[type="radio"]:checked');
      const value = checked?.value || 'keep';
      if (value === 'keep') {
        lines.push(title+': Keep as designed');
      } else {
        const id = area.getAttribute('data-area');
        const note = document.getElementById('note-'+id)?.value?.trim();
        lines.push(title+': CHANGE'+(note ? ' — '+note : ' — please recommend alternatives'));
      }
    });
    const preferences = {
      design: chosen,
      designLabel: label,
      areas: [...document.querySelectorAll('[data-area]')].map(area => {
        const id = area.getAttribute('data-area');
        const title = area.querySelector('h3')?.textContent?.trim() || '';
        const value = area.querySelector('input[type="radio"]:checked')?.value || 'keep';
        const note = value === 'change' ? (document.getElementById('note-'+id)?.value?.trim() || '') : '';
        return { id, title, status: value, note };
      }),
      savedAt: new Date().toISOString()
    };
    try { localStorage.setItem('bauhuInteriorPreferences', JSON.stringify(preferences)); } catch {}
    window.location.href = '/site-fit';
  });
</script>
