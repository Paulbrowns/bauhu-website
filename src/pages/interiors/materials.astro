---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const suppliers = [
  { group:'01', category:'Façades & openings', partners:[{name:'Sto',link:'https://www.stocorp.com/sto-color-800/',note:'Façade colour system; exact shade and render grain to be agreed.'},{name:'Cortizo',link:'https://www.cortizo.com/en/paginas/carta_standard',note:'Architectural aluminium colour chart; project-approved coatings only.'}]},
  { group:'02', category:'Fitted kitchens', partners:[{name:'Nobilia',link:'https://www.nobilia.de/en/products/kitchens/',note:'Factory kitchen fronts, carcasses, worktops and handles. Bauhu approval required for combinations.'}]},
  { group:'03', category:'Bathrooms', partners:[{name:'Kitbanho',link:'https://www.kitbanho.com/en/products/bathroom-furniture',note:'Wall-hung bathroom furniture and integrated basin directions.'},{name:'Sanindusa',link:'https://sanindusa.com/en/products/toilets',note:'White ceramic sanitary ware; specific model subject to specification.'},{name:'Bruma',link:'https://bruma.pt/en/bruma',note:'Water-conserving kitchen and bathroom fittings.'}]},
  { group:'04', category:'Ceramics', partners:[{name:'Dominó',link:'https://www.domino.pt/en/products',note:'Portuguese interior wall and floor ceramic collections.'}]},
  { group:'05', category:'Interior joinery', partners:[{name:'Compincar',link:'https://compincar.com/doors/?lang=en',note:'Interior door styles, lacquer/veneer direction and hardware.'}]},
  { group:'06', category:'Interior paint', partners:[{name:'CIN',link:'https://cin.com/en',note:'Interior coatings; RAL/Pantone specification subject to accurate physical matching.'}]},
];

const candidates = [
  { category:'Kitchen fronts', manufacturer:'Nobilia', name:'TOUCH 336 — Ivory supermatt', code:'Front 336', url:'https://www.nobilia.de/en/products/kitchens/modern-kitchens/touch-336/', note:'Verified manufacturer front reference. Not yet Bauhu-approved for the project.' },
  { category:'Kitchen fronts', manufacturer:'Nobilia', name:'LASER 418 — Ivory matt', code:'Front 418', url:'https://www.nobilia.de/en/products/kitchens/modern-kitchens/laser-418/', note:'Verified manufacturer reference; supply and pricing unconfirmed.' },
  { category:'Kitchen fronts', manufacturer:'Nobilia', name:'EASYTOUCH 961 — Graphite black ultra matt', code:'Front 961', url:'https://www.nobilia.de/en/products/kitchens/designer-kitchens/easytouch-961/', note:'Verified manufacturer reference; supply and pricing unconfirmed.' },
  { category:'Ceramic floor ranges', manufacturer:'Dominó', name:'Ecoliving', code:'Collection / exact tile TBD', url:'https://www.domino.pt/en/products', note:'Manufacturer collection name only. Specific tile, size and finish not yet selected.' },
  { category:'Ceramic floor ranges', manufacturer:'Dominó', name:'Jura', code:'Collection / exact tile TBD', url:'https://www.domino.pt/en/products', note:'Manufacturer collection name only. Specific tile, size and finish not yet selected.' },
  { category:'Ceramic wall ranges', manufacturer:'Dominó', name:'Mood', code:'Collection / exact tile TBD', url:'https://www.domino.pt/en/products', note:'Manufacturer collection name only. Specific tile, size and finish not yet selected.' },
  { category:'Ceramic wall ranges', manufacturer:'Dominó', name:'Tokyo', code:'Collection / exact tile TBD', url:'https://www.domino.pt/en/products', note:'Manufacturer collection name only. Specific tile, size and finish not yet selected.' },
];
---
<BaseLayout title="Materials & Suppliers | Bauhu Interiors" description="A curated overview of Bauhu architectural finish suppliers and manufacturer references under review.">
  <SiteHeader />
  <main class="bg-paper">
    <section class="bg-ink px-5 pb-20 pt-40 text-paper lg:px-10">
      <div class="mx-auto max-w-site">
        <a class="text-xs uppercase tracking-widest text-paper/60" href="/interiors">← Bauhu Interiors</a>
        <p class="eyebrow mt-12 text-stone">Bauhu Interiors / Materials library</p>
        <h1 class="mt-6 max-w-5xl font-display text-6xl leading-tight md:text-8xl">Beautiful materials.<br/>Thoughtfully selected.</h1>
        <p class="mt-8 max-w-3xl text-lg leading-8 text-paper/70">A considered view of the specialist manufacturers behind Bauhu's fixed architectural finishes. Explore design possibilities without the burden of navigating an unrestricted retail catalogue.</p>
      </div>
    </section>
    <section class="section-pad bg-paper">
      <div class="mx-auto max-w-site">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
          <div><p class="eyebrow text-clay">Supplier partners</p><h2 class="mt-5 font-display text-5xl leading-tight">Quality begins with the details.</h2></div>
          <p class="text-lg leading-8 text-ink/70">The following manufacturers are listed in Bauhu's existing décor brochure. We are curating approved options for the Design Studio. A manufacturer's full catalogue should not be interpreted as an automatic Bauhu inclusion.</p>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-2">
          {suppliers.map((group) => (
            <article class="bg-mist p-8 md:p-10">
              <p class="text-xs uppercase tracking-widest text-clay">{group.group} / Architectural selection</p>
              <h3 class="mt-4 font-display text-4xl">{group.category}</h3>
              <div class="mt-7 space-y-6">
                {group.partners.map((partner) => (
                  <div class="border-t border-ink/15 pt-5">
                    <div class="flex items-center justify-between gap-3"><h4 class="text-lg font-medium">{partner.name}</h4><a href={partner.link} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-widest underline underline-offset-4">Manufacturer ↗</a></div>
                    <p class="mt-3 text-sm leading-7 text-ink/65">{partner.note}</p>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section-pad bg-mist">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-clay">Manufacturer references</p>
        <h2 class="mt-5 max-w-4xl font-display text-5xl leading-tight md:text-6xl">A first shortlist, not a shopping catalogue.</h2>
        <p class="mt-5 max-w-3xl leading-8 text-ink/65">These ranges and references have been identified from manufacturers' catalogues. They are candidates for selection, not yet confirmed Bauhu-stocked, included or suitable for a particular home.</p>
        <figure class="mt-12 grid overflow-hidden bg-paper lg:grid-cols-[1.2fr_0.8fr]">
          <div class="min-h-64 bg-stone"><img src="https://www.nobilia.de/fileadmin/_processed_/5/d/csm_336_touch_g2_40ce6e6ab7.webp" alt="Nobilia TOUCH 336 ivory supermatt kitchen with a light wood-effect countertop" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover" /></div>
          <figcaption class="flex flex-col justify-center p-8 md:p-12">
            <p class="eyebrow text-clay">From the manufacturer / Nobilia</p>
            <h3 class="mt-4 font-display text-4xl">Touch 336</h3>
            <p class="mt-4 leading-7 text-ink/70">Ivory supermatt front, shown in a manufacturer kitchen setting. A genuine product reference to explore — not yet an approved Bauhu specification.</p>
            <a href="https://www.nobilia.de/en/products/kitchens/modern-kitchens/touch-336/" target="_blank" rel="noopener noreferrer" class="mt-7 self-start border-b border-ink/50 pb-2 text-xs uppercase tracking-widest">View Nobilia specification ↗</a>
          </figcaption>
        </figure>
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {candidates.map((candidate) => (
            <article class="bg-paper p-7">
              <p class="text-xs uppercase tracking-widest text-clay">{candidate.category}</p>
              <h3 class="mt-5 font-display text-3xl">{candidate.name}</h3>
              <p class="mt-3 text-sm text-ink/60">{candidate.manufacturer} / {candidate.code}</p>
              <p class="mt-5 text-sm leading-7 text-ink/65">{candidate.note}</p>
              <a href={candidate.url} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex border-b border-ink/50 pb-2 text-xs uppercase tracking-widest">View manufacturer reference ↗</a>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section-pad bg-ink text-paper">
      <div class="mx-auto grid max-w-site gap-10 lg:grid-cols-2 lg:items-center">
        <div><p class="eyebrow text-stone">Explore your choices</p><h2 class="mt-5 font-display text-5xl leading-tight">From inspiration to a personal draft.</h2></div>
        <div><p class="text-lg leading-8 text-paper/70">Our Design Studio lets you record preferred directions across the six categories and download a personal draft. Actual supplier product approval and cost variations are resolved with Bauhu against the agreed home scope.</p><a href="/interiors/studio" class="mt-8 inline-flex rounded-full bg-paper px-7 py-4 text-xs uppercase tracking-widest text-ink">Open Design Studio →</a></div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>