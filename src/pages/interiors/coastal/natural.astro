---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import {coastalNatural} from '../../../data/interiors-coastal-natural';
const palette=['#F1ECE2','#DCD0BC','#B3A58E','#7F8179'];
const imageFallback={
 finishes:'/images/residences/casa-lavanda.webp',
 kitchens:'/images/residences/luxuma-living-area.webp',
 bathrooms:'/images/models/bauhu-bahama-beach/4.webp'
};
---
<BaseLayout title="Coastal Natural | Bauhu Interiors" description="A curated Coastal Natural interior design with three mood boards and a traceable Bauhu product schedule.">
 <SiteHeader/>
 <main class="bg-paper px-5 pb-20 pt-32 lg:px-10">
  <div class="mx-auto max-w-site">
   <a href="/interiors/coastal/" class="text-xs uppercase tracking-widest text-ink/60">← Coastal collection</a>
   <div class="relative mt-7 overflow-hidden rounded-2xl">
     <img src={coastalNatural.hero} alt="Coastal Natural architectural interior mood and palette" class="h-[48vh] min-h-80 w-full object-cover lg:h-[60vh]"/>
     <div class="absolute inset-0 bg-gradient-to-t from-ink/65 via-transparent to-transparent"></div>
     <div class="absolute bottom-9 left-8 text-paper md:bottom-12 md:left-12">
       <p class="text-xs uppercase tracking-[.25em]">Bauhu Interiors · Coastal 01</p>
       <h1 class="mt-3 font-display text-6xl md:text-8xl">Coastal Natural.</h1>
       <p class="mt-4 text-sm text-paper/85">Sand, pale stone and soft white. Beautifully coordinated.</p>
     </div>
   </div>
   <div class="mt-12 grid gap-8 md:grid-cols-[.9fr_1.1fr] md:items-end">
     <div><p class="eyebrow text-clay">One look / Three boards</p><h2 class="mt-4 font-display text-5xl">Everything at a glance.</h2></div>
     <p class="text-lg leading-8 text-ink/65">A complete first-pass scheme organised exactly as a designer would present it: architectural finishes, kitchen and bathroom. Every item below has a Bauhu ID and a traceable supplier shortlist.</p>
   </div>
   <div class="mt-10 grid gap-6 lg:grid-cols-3">
     {coastalNatural.boards.map(board=><section class="overflow-hidden rounded-xl bg-mist">
       <div class="relative">
         <img src={imageFallback[board.id]} alt={'Editorial inspiration for '+board.title+' — not a supplier product photograph'} class="h-52 w-full object-cover" loading="lazy"/>
         <div class="absolute inset-0 bg-gradient-to-t from-ink/50 to-transparent"></div>
         <h3 class="absolute bottom-4 left-6 font-display text-4xl text-paper">{board.title}</h3>
       </div>
       <div class="p-5">
         <p class="min-h-12 text-sm leading-6 text-ink/65">{board.subtitle}</p>
         <div class="mt-4 grid grid-cols-2 gap-2">
           {board.items.slice(0,6).map((item,i)=><div class="relative flex min-h-28 flex-col justify-end overflow-hidden rounded-md bg-paper p-3">
             {item.image?<img src={item.image} alt={item.supplier+' '+item.range} loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-80"/>:<span class="absolute inset-0" style={'background:'+palette[i%palette.length]}></span>}
             <div class="relative bg-paper/90 p-2"><p class="text-[10px] uppercase tracking-wider text-ink/60">{item.label}</p><p class="mt-1 text-xs font-medium">{item.range}</p></div>
           </div>)}
         </div>
         <p class="mt-5 text-xs text-ink/50">Curated design direction. Exact variants still under selection.</p>
       </div>
     </section>)}
   </div>
   <div class="mt-16 grid gap-6 border-t border-ink/15 pt-10 md:grid-cols-[1fr_.9fr] md:items-end">
     <div><p class="eyebrow text-clay">The product behind the picture</p><h2 class="mt-4 font-display text-5xl">Every item has an identity.</h2></div>
     <p class="text-sm leading-7 text-ink/65">The photographic mood boards are the customer experience. The Bauhu reference list below is for detailed review and future architectural scheduling, not an order.</p>
   </div>
   <div class="mt-8 flex flex-wrap gap-3">
    <button id="natural-download" type="button" class="rounded-full bg-ink px-7 py-4 text-xs uppercase tracking-widest text-paper">Download Bauhu ID list</button>
    <button id="natural-print" type="button" class="rounded-full border border-ink/25 px-7 py-4 text-xs uppercase tracking-widest">Print mood boards</button>
   </div>
   <div class="mt-8 overflow-x-auto">
    <table class="w-full min-w-[650px] text-left text-sm">
     <thead><tr class="border-y border-ink/20 text-xs uppercase tracking-wider text-ink/55"><th class="py-4">Bauhu ID</th><th>Component</th><th>Supplier / collection</th><th>Reference</th><th>Review</th></tr></thead>
     <tbody>{coastalNatural.boards.flatMap(board=>board.items.map(item=><tr class="border-b border-ink/10"><td class="py-4 font-mono text-xs">{item.bauhuId}</td><td>{item.label}</td><td>{item.supplier} · {item.range}</td><td>{item.model||'Pending'}</td><td class="text-xs text-ink/60">{item.status==='confirmed-rule'?'Bauhu range confirmed':item.status==='manufacturer-reference'?'Manufacturer reference':'Variant to confirm'}</td></tr>))}</tbody>
    </table>
   </div>
   <p id="natural-status" class="mt-4 text-sm text-ink/60" role="status"></p>
   <p class="mt-8 max-w-4xl text-xs leading-6 text-ink/60">This is the first curated Coastal Natural proposal, not an approved supplier schedule. Manufacturer photographs are only used where a source image is identified. Other visual samples are illustrative and must be replaced with the matching supplier products before final approval. All bathrooms must use coordinated Bruma tap ranges and finishes. Sto Stolit K fine grain RAL 9003 is fixed across collections.</p>
  </div>
 </main>
 <SiteFooter/>
</BaseLayout>
<script define:vars={{coastalNatural}}>
 const rows=coastalNatural.boards.flatMap(board=>board.items.map(item=>[board.title,item.label,item.bauhuId,item.supplier,item.range,item.model||'',item.finish||'',item.status,item.image||'']));
 document.getElementById('natural-print').addEventListener('click',()=>window.print());
 document.getElementById('natural-download').addEventListener('click',()=>{
  const escapeCSV=v=>{let s=String(v??'');if(/^\s*[=+\-@]/.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"'};
  const csv='\uFEFF'+[['Board','Component','Bauhu ID','Supplier','Collection','Model','Finish','Status','Product image'],...rows].map(row=>row.map(escapeCSV).join(',')).join('\r\n');
  const url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='bauhu-coastal-natural-draft.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
  document.getElementById('natural-status').textContent='Draft schedule saved locally. Not submitted to Bauhu.';
 });
</script>
<style>@media print{header,footer,button{display:none!important}section{break-inside:avoid}}</style>