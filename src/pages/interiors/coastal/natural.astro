---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import InteriorsDesignPresentation from '../../../components/InteriorsDesignPresentation.astro';
import {coastalNatural} from '../../../data/interiors-coastal-natural';
const supplierSlot = (slot:string) => {
  if (['front','cabinet-fronts'].includes(slot)) return 'Kitchen front';
  if (['handles','cabinet-handles'].includes(slot)) return 'Kitchen handles';
  if (['countertop','worktop'].includes(slot)) return 'Countertop';
  if (['sink','kitchen-sink'].includes(slot)) return 'Kitchen sink';
  if (['faucet','kitchen-faucet','kitchen-tap'].includes(slot)) return 'Kitchen faucet';
  if (['floor-tile'].includes(slot)) return 'Floor tile';
  if (['wall-tile'].includes(slot)) return 'Wall tile';
  if (['render','exterior-render'].includes(slot)) return 'Exterior render';
    if (['frames','window-frames'].includes(slot)) return 'Window and exterior door frames';
  if (['interior-door','interior-doors'].includes(slot)) return 'Interior doors';
  if (slot.includes('basin')&&slot.includes('tap')) return 'Basin faucet';
  if (slot.includes('shower')&&slot.includes('tap')) return 'Shower faucet';
  return slot;
};
const boards = [
 {id:'finishes',title:'Finishes',summary:'Floor and wall tile · paint · render · frames · doors',image:'/images/interiors/coastal-natural-finishes.webp', fallback:'/images/interiors/coastal-natural-finishes-moodboard.svg'},
 {id:'kitchens',title:'Kitchens',summary:'Cabinet front · handles · countertop · sink · faucet',image:'/images/interiors/coastal-natural-kitchens.webp', fallback:'/images/interiors/coastal-natural-kitchens-moodboard.svg'},
 {id:'bathrooms',title:'Bathrooms',summary:'Vanity · basin · matching tapware · wall tile',image:'/images/interiors/coastal-natural-bathrooms.webp', fallback:'/images/interiors/coastal-natural-bathrooms-moodboard.svg'}
];
---
<BaseLayout title="Coastal Natural | Bauhu Interiors" description="A curated Coastal Natural interior design with three mood boards and a traceable Bauhu product schedule.">
 <SiteHeader/>
 <main class="bg-paper px-5 pb-20 pt-32 lg:px-10">
  <div class="mx-auto max-w-site">
   <a href="/interiors/#collections" class="text-xs uppercase tracking-widest text-ink/60">← All interior designs</a>
   <div class="mt-7">
    <InteriorsDesignPresentation
      title="Coastal Natural"
      description="Sand, pale stone and soft white. Beautifully coordinated."
      palette={["#F2EFE8","#DDD1BE","#B9AE9C","#77776E"]}
      hero="/images/interiors/coastal-natural-hero.webp"
      overall="/images/interiors/coastal-natural-overall.webp"
      singleMoodboard="/images/interiors/coastal-natural-curated-moodboard.webp"
      moodboardFallback="/images/interiors/coastal-natural-overall.webp"
      schemeKey="coastal/natural"
      useImageEmbeddedLabels={true}
      boards={boards.map(board=>({title:board.title,subtitle:board.summary,image:board.image,items:coastalNatural.boards.find(b=>b.id===board.id)?.items.map(item=>({slot:supplierSlot(item.slot),supplier:item.supplier,range:item.range,finish:item.finish||''}))||[]}))}
    />
   </div>
   <section class="mt-14 border-y border-ink/15 bg-mist px-6 py-8 md:px-9">
    <p class="eyebrow text-clay">Choose your starting point</p>
    <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <h2 class="font-display text-4xl">Use this design for your Bauhu interior.</h2>
        <p class="mt-3 max-w-3xl text-sm leading-7 text-ink/65">Keep the complete collection as designed, or personalise only the areas you want to change. Browse our supplier library if you already know what you like, or tell Bauhu what you want changed and we will recommend suitable alternatives.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/interiors/studio?design=coastal-natural&mode=approve" class="rounded-full bg-ink px-6 py-4 text-xs uppercase tracking-widest text-paper">Choose this design</a>
        <a href="/interiors/studio?design=coastal-natural&mode=change" class="rounded-full border border-ink/25 px-6 py-4 text-xs uppercase tracking-widest">Personalise this design</a>
      </div>
    </div>
   </section>
   <div class="mt-16 grid gap-6 border-t border-ink/15 pt-10 md:grid-cols-[1fr_.9fr] md:items-end">
     <div><p class="eyebrow text-clay">The product behind the picture</p><h2 class="mt-4 font-display text-5xl">Every item has an identity.</h2></div>
     <p class="text-sm leading-7 text-ink/65">The mood boards capture the look. The separate Bauhu ID list maps the selected components to supplier ranges and, later, actual product photographs and confirmed manufacturer references.</p>
   </div>
   <div class="mt-8 flex flex-wrap gap-3">
    <button id="natural-print" type="button" class="rounded-full border border-ink/25 px-7 py-4 text-xs uppercase tracking-widest">Print mood boards</button>
   </div>
   <div class="mt-8 overflow-x-auto">
    <table class="w-full min-w-[650px] text-left text-sm">
     <thead><tr class="border-y border-ink/20 text-xs uppercase tracking-wider text-ink/55"><th class="py-4">Bauhu ID</th><th>Component</th><th>Supplier / collection</th><th>Reference</th><th>Review</th></tr></thead>
     <tbody>{coastalNatural.boards.flatMap(board=>board.items.map(item=><tr class="border-b border-ink/10"><td class="py-4 font-mono text-xs">{item.bauhuId}</td><td>{item.label}</td><td>{item.supplier} · {item.range}</td><td>{item.model||'Pending'}</td><td class="text-xs text-ink/60">{item.status==='confirmed-rule'?'Bauhu range confirmed':item.status==='manufacturer-reference'?'Manufacturer reference':'Variant to confirm'}</td></tr>))}</tbody>
    </table>
   </div>
   <p id="natural-status" class="mt-4 text-sm text-ink/60" role="status"></p>
   <p class="mt-8 max-w-4xl text-xs leading-6 text-ink/60">This is the first curated Coastal Natural proposal, not an approved supplier schedule. Mood-board artwork represents the intended look rather than the specific products. Actual supplier images and exact variants belong in the technical ID list and must be verified before approval. All bathrooms must use coordinated Bruma tap ranges and finishes. Sto Stolit K fine grain RAL 9003 is fixed across collections.</p>
  </div>
 </main>
 <SiteFooter/>
</BaseLayout>
<script define:vars={{coastalNatural}}>
 const rows=coastalNatural.boards.flatMap(board=>board.items.map(item=>[board.title,item.label,item.bauhuId,item.supplier,item.range,item.model||'',item.finish||'',item.status,item.image||'']));
 document.getElementById('natural-print').addEventListener('click',()=>window.print());
</script>
<style>@media print{header,footer,button{display:none!important}section{break-inside:avoid}}</style>