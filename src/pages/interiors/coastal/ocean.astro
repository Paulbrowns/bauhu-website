---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import {coastalOcean} from '../../../data/interiors-coastal-ocean';
const boards = [
 {id:'finishes',title:'Finishes',summary:'Floor and wall tile · paint · render · frames · doors',image:'/images/interiors/coastal-ocean-finishes.webp', fallback:'/images/interiors/coastal-natural-finishes-moodboard.svg'},
 {id:'kitchens',title:'Kitchens',summary:'Cabinet front · handles · countertop · sink · faucet',image:'/images/interiors/coastal-ocean-kitchens.webp', fallback:'/images/interiors/coastal-natural-kitchens-moodboard.svg'},
 {id:'bathrooms',title:'Bathrooms',summary:'Vanity · basin · matching tapware · wall tile',image:'/images/interiors/coastal-ocean-bathrooms.webp', fallback:'/images/interiors/coastal-natural-bathrooms-moodboard.svg'}
];
---
<BaseLayout title="Coastal Ocean | Bauhu Interiors" description="A curated Coastal Ocean interior design with three mood boards and a traceable Bauhu product schedule.">
 <SiteHeader/>
 <main class="bg-paper px-5 pb-20 pt-32 lg:px-10">
  <div class="mx-auto max-w-site">
   <a href="/interiors/coastal/" class="text-xs uppercase tracking-widest text-ink/60">← Coastal collection</a>
   <div class="relative mt-7 overflow-hidden rounded-2xl">
     <img src="/images/interiors/coastal-ocean-hero.webp" data-fallback="/images/models/bauhu-barbados-blue/2.webp" onerror="this.onerror=null;this.src=this.dataset.fallback" alt="Coastal Ocean architectural interior mood and palette" class="h-[48vh] min-h-80 w-full object-cover lg:h-[60vh]"/>
     <div class="absolute inset-0 bg-gradient-to-t from-ink/65 via-transparent to-transparent"></div>
     <div class="absolute bottom-9 left-8 text-paper md:bottom-12 md:left-12">
       <p class="text-xs uppercase tracking-[.25em]">Bauhu Interiors · Coastal 02</p>
       <h1 class="mt-3 font-display text-6xl md:text-8xl">Coastal Ocean.</h1>
       <p class="mt-4 text-sm text-paper/85">Sea mist, pale minerals and soft coastal blues. Beautifully coordinated.</p>
     </div>
   </div>
   <div class="mt-12 grid gap-8 md:grid-cols-[.9fr_1.1fr] md:items-end">
     <div><p class="eyebrow text-clay">One look / Three boards</p><h2 class="mt-4 font-display text-5xl">Everything at a glance.</h2></div>
     <p class="text-lg leading-8 text-ink/65">Three coordinated editorial mood boards covering the finishes, kitchen and bathrooms. The supplier specification lives separately below the presentation.</p>
   </div>
   <div class="mt-10 grid gap-7 lg:grid-cols-3">
    {boards.map(board=><figure class="min-w-0">
      <div class="overflow-hidden rounded-2xl bg-mist shadow-sm">
        <img src={board.image} data-fallback={board.fallback} onerror="this.onerror=null;this.src=this.dataset.fallback" class="block aspect-[4/5] w-full object-cover" alt={'Coastal Ocean '+board.title+' editorial material mood board composition'} loading="lazy"/>
      </div>
      <figcaption class="mt-5">
        <h3 class="font-display text-4xl">{board.title}</h3>
        <p class="mt-2 text-sm leading-6 text-ink/60">{board.summary}</p>
      </figcaption>
    </figure>)}
   </div>
   <p class="mt-8 text-xs leading-6 text-ink/55">These are illustrative design mood boards, expressing the intended colours, textures and material combinations. They are not photographs of the exact specified products.</p>
   <div class="mt-16 grid gap-6 border-t border-ink/15 pt-10 md:grid-cols-[1fr_.9fr] md:items-end">
     <div><p class="eyebrow text-clay">The product behind the picture</p><h2 class="mt-4 font-display text-5xl">Every item has an identity.</h2></div>
     <p class="text-sm leading-7 text-ink/65">The mood boards capture the look. The separate Bauhu ID list maps the selected components to supplier ranges and, later, actual product photographs and confirmed manufacturer references.</p>
   </div>
   <div class="mt-8 flex flex-wrap gap-3">
    <button id="natural-download" type="button" class="rounded-full bg-ink px-7 py-4 text-xs uppercase tracking-widest text-paper">Download Bauhu ID list</button>
    <button id="natural-print" type="button" class="rounded-full border border-ink/25 px-7 py-4 text-xs uppercase tracking-widest">Print mood boards</button>
   </div>
   <div class="mt-8 overflow-x-auto">
    <table class="w-full min-w-[650px] text-left text-sm">
     <thead><tr class="border-y border-ink/20 text-xs uppercase tracking-wider text-ink/55"><th class="py-4">Bauhu ID</th><th>Component</th><th>Supplier / collection</th><th>Reference</th><th>Review</th></tr></thead>
     <tbody>{coastalOcean.boards.flatMap(board=>board.items.map(item=><tr class="border-b border-ink/10"><td class="py-4 font-mono text-xs">{item.bauhuId}</td><td>{item.label}</td><td>{item.supplier} · {item.range}</td><td>{item.model||'Pending'}</td><td class="text-xs text-ink/60">{item.status==='confirmed-rule'?'Bauhu range confirmed':item.status==='manufacturer-reference'?'Manufacturer reference':'Variant to confirm'}</td></tr>))}</tbody>
    </table>
   </div>
   <p id="natural-status" class="mt-4 text-sm text-ink/60" role="status"></p>
   <p class="mt-8 max-w-4xl text-xs leading-6 text-ink/60">This is the first curated Coastal Ocean proposal, not an approved supplier schedule. Mood-board artwork represents the intended look rather than the specific products. Actual supplier images and exact variants belong in the technical ID list and must be verified before approval. All bathrooms must use coordinated Bruma tap ranges and finishes. Sto Stolit K fine grain RAL 9003 is fixed across collections.</p>
  </div>
 </main>
 <SiteFooter/>
</BaseLayout>
<script define:vars={{coastalOcean}}>
 const rows=coastalOcean.boards.flatMap(board=>board.items.map(item=>[board.title,item.label,item.bauhuId,item.supplier,item.range,item.model||'',item.finish||'',item.status,item.image||'']));
 document.getElementById('natural-print').addEventListener('click',()=>window.print());
 document.getElementById('natural-download').addEventListener('click',()=>{
  const escapeCSV=v=>{let s=String(v??'');if(/^\s*[=+\-@]/.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"'};
  const csv='\uFEFF'+[['Board','Component','Bauhu ID','Supplier','Collection','Model','Finish','Status','Product image'],...rows].map(row=>row.map(escapeCSV).join(',')).join('\r\n');
  const url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='bauhu-coastal-ocean-draft.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
  document.getElementById('natural-status').textContent='Draft schedule saved locally. Not submitted to Bauhu.';
 });
</script>
<style>@media print{header,footer,button{display:none!important}section{break-inside:avoid}}</style>