---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
const items = [
  {
    "number": "01",
    "name": "Façade & openings",
    "direction": "Warm natural-toned render with complementary dark aluminium openings."
  },
  {
    "number": "02",
    "name": "Kitchen",
    "direction": "Calm earthy-toned kitchen cabinetry, pale composite countertop and restrained hardware."
  },
  {
    "number": "03",
    "name": "Bathrooms",
    "direction": "Understated wall-hung vanity, white ceramics and water-conserving chrome faucets."
  },
  {
    "number": "04",
    "name": "Ceramics",
    "direction": "Warm stone-effect floor ceramics and gently contrasting shower wall tiles."
  },
  {
    "number": "05",
    "name": "Interior doors",
    "direction": "Natural veneer or muted lacquer door finish with simple architectural profiles."
  },
  {
    "number": "06",
    "name": "Paint",
    "direction": "Soft off-whites with selected earthy or botanical-inspired accent tones."
  }
];
const tones = ["#E6DDC8","#B9B59B","#77806A","#454C3D"];
---
<BaseLayout title="Tropical Collection | Bauhu Interiors" description="Explore the Bauhu Tropical collection: a curated architectural finish direction for your home.">
  <SiteHeader />
  <main class="bg-paper">
    <section class="relative min-h-[78vh] overflow-hidden bg-ink text-paper">
      <img src="/images/residences/luxuma-pool-terrace.webp" alt="Bauhu architectural inspiration for the Tropical collection" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-ink/90 via-ink/55 to-ink/15"></div>
      <div class="relative mx-auto flex min-h-[78vh] max-w-site flex-col justify-end px-5 pb-20 pt-40 lg:px-10">
        <a class="text-xs uppercase tracking-widest text-paper/70" href="/interiors#collections">← All collections</a>
        <p class="eyebrow mt-12 text-stone">Bauhu Interiors / Collection 04</p>
        <h1 class="mt-5 font-display text-7xl leading-none md:text-9xl">Tropical.</h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-paper/85">A relaxed, nature-inspired material palette suited to sunlit island living.</p>
      </div>
    </section>
    <section class="section-pad bg-paper">
      <div class="mx-auto grid max-w-site gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div><p class="eyebrow text-clay">The palette</p><h2 class="mt-5 font-display text-5xl leading-tight">Grounded in nature. Made for light.</h2></div>
        <div>
          <p class="text-lg leading-8 text-ink/70">This collection is an inspirational starting point, not a prescribed product package. Your Bauhu home can be personalised using the architectural finishes and fixed fittings available for your particular project.</p>
          <div class="mt-8 grid h-20 grid-cols-4" aria-label="Tropical inspiration colour palette">
            {tones.map((tone) => <div style={`background-color: ${tone}`}></div>)}
          </div>
          <p class="mt-3 text-xs leading-6 text-ink/55">Indicative colour direction, not manufacturer swatches. Exact product codes and available options are confirmed during specification.</p>
        </div>
      </div>
    </section>
    <section class="section-pad bg-mist">
      <div class="mx-auto max-w-site">
        <p class="eyebrow text-clay">The architectural scheme</p>
        <h2 class="mt-5 max-w-4xl font-display text-5xl leading-tight md:text-6xl">Six carefully coordinated choices.</h2>
        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {items.map((item) => (
            <article class="bg-paper p-8 md:p-10">
              <p class="text-xs tracking-widest text-clay">{item.number} / Design direction</p>
              <h3 class="mt-5 font-display text-4xl">{item.name}</h3>
              <p class="mt-5 text-lg leading-8 text-ink/75">{item.direction}</p>
              <p class="mt-7 border-t border-ink/15 pt-5 text-sm leading-7 text-ink/55">Exact supplier range, product references and any price variations to be confirmed for the project.</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section-pad bg-paper">
      <div class="mx-auto grid max-w-site gap-10 lg:grid-cols-2">
        <div><p class="eyebrow text-clay">Make it yours</p><h2 class="mt-5 font-display text-5xl leading-tight">Your architecture. Your choices.</h2></div>
        <div class="space-y-6">
          <p class="text-lg leading-8 text-ink/70">Most standard finish selections are included in the Bauhu home package. Optional professional guidance is available for clients who want coordinated schemes, consultation or visualisations.</p>
          <p class="text-sm leading-7 text-ink/60">This is an architectural finishes service. Furniture, rugs, curtains, decorative lighting, accessories and artwork are not supplied. Final inclusions and any supplementary charges are determined by the contract specification.</p>
          <a href="/interiors/studio?collection=tropical" class="inline-flex rounded-full border border-ink/30 px-7 py-4 text-xs uppercase tracking-widest text-ink">Explore finishes in Design Studio →</a>
          <a href="mailto:contact@bauhu.com?subject=Bauhu%20Tropical%20Interiors" class="inline-flex rounded-full bg-ink px-7 py-4 text-xs uppercase tracking-widest text-paper">Discuss this collection →</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>