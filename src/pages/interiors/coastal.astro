---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const designs=[
 {number:'01',name:'Natural',palette:'Soft ivory · Sandstone · Warm white',description:'Sun-washed stone, ivory cabinetry and naturally relaxed details.',image:'/images/interiors/coastal-natural-hero.webp',href:'/interiors/coastal/natural/',ready:true},
 {number:'02',name:'Ocean',palette:'Sea mist · Chalk · Soft grey',description:'Cool mineral tones, discreet silver finishes and an airy coastal feel.',image:'/images/models/bauhu-barbados-blue/2.webp',href:null,ready:false},
 {number:'03',name:'Refined',palette:'Taupe · Walnut · Anthracite',description:'Layered neutral stone, deeper natural joinery and architectural contrast.',image:'/images/models/bauhu-cap-dantibes/2.webp',href:null,ready:false}
];
---
<BaseLayout title="Coastal Designs | Bauhu Interiors" description="Explore three curated design stories within Bauhu Interiors Coastal.">
 <SiteHeader/>
 <main class="bg-paper px-5 pb-24 pt-36 lg:px-10">
  <div class="mx-auto max-w-site">
   <a href="/interiors/" class="text-xs uppercase tracking-[.2em] text-ink/60">← Bauhu Interiors</a>
   <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_.75fr] lg:items-end">
    <div><p class="eyebrow text-clay">Bauhu / Curated interiors</p><h1 class="mt-4 font-display text-7xl md:text-8xl">Coastal.</h1>
    <p class="mt-5 max-w-2xl text-xl leading-8 text-ink/65">One collection, three individual looks. Thoughtfully selected finishes, fitted kitchens and bathrooms, presented as three beautiful material mood boards for each home.</p></div>
    <div class="border-t border-ink/20 pt-6 text-sm leading-7 text-ink/60">Choose a complete Bauhu design. You can keep the curated scheme as it is, or later request a small number of complementary alternatives. Exact product codes and imagery are maintained separately in the Bauhu specification.</div>
   </div>
   <div class="mt-14 grid gap-7 lg:grid-cols-3">
     {designs.map(d=><article class="overflow-hidden rounded-2xl bg-mist">
       <div class="relative h-80 overflow-hidden">
         <img src={d.image} alt={'Architectural inspiration for Coastal '+d.name} loading="lazy" class="h-full w-full object-cover"/>
         <span class="absolute left-5 top-5 rounded-full bg-paper px-4 py-2 text-xs uppercase tracking-widest text-ink">Coastal {d.number}</span>
       </div>
       <div class="p-7">
         <h2 class="font-display text-4xl">{d.name}</h2>
         <p class="mt-2 text-sm text-clay">{d.palette}</p>
         <p class="mt-5 min-h-16 text-sm leading-7 text-ink/65">{d.description}</p>
         {d.ready?<a class="mt-6 inline-flex border-b border-ink/60 pb-2 text-xs uppercase tracking-widest" href={d.href}>Explore mood boards →</a>:<p class="mt-6 text-xs uppercase tracking-widest text-ink/40">Mood boards in preparation</p>}
       </div>
     </article>)}
   </div>
   <p class="mt-9 max-w-3xl text-xs leading-6 text-ink/55">Coastal Natural is the approved presentation template. Ocean and Refined are curated working schemes; their photographs will be added before those designs are offered to customers. All product selections remain subject to final Bauhu supplier and contract-scope confirmation.</p>
 </div>
 </main>
 <SiteFooter/>
</BaseLayout>