---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Send Your Project | Bauhu" description="Send Bauhu your project brief and contact details.">
  <SiteHeader />
  <main class="journey-page">
    <header class="journey-header">
      <div><p class="kicker">START YOUR PROJECT</p><h1>Tell us how to contact you.</h1><p>Your site and project choices are attached automatically. Add your contact details and any final note.</p></div>
      <aside><span>PROJECT JOURNEY</span><strong>3 of 3 · Contact</strong><small>Final review before sending to Bauhu.</small></aside>
    </header>

    <section class="contact-shell">
      <form id="contact-form" class="contact-form">
        <div class="field-grid">
          <label><span>Full name</span><input name="name" autocomplete="name" required /></label>
          <label><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
          <label><span>Phone</span><input name="phone" type="tel" autocomplete="tel" /></label>
          <label><span>Preferred contact</span><select name="contactPreference"><option>Email</option><option>Phone</option><option>WhatsApp</option></select></label>
        </div>
        <label><span>Final note <em>Optional</em></span><textarea name="message" rows="5" placeholder="Anything else you want us to know?"></textarea></label>
        <label class="consent"><input name="consent" type="checkbox" required /><span>I agree that Bauhu may contact me about this project and use my enquiry information in line with the <a href="/privacy" target="_blank" rel="noopener">Privacy Notice</a>.</span></label>
        <div class="project-privacy-note">
          <strong>Your project. Your privacy.</strong>
          <p>We understand the importance of discretion. Your site details, project information and personal enquiry are handled confidentially and used to assess and develop your Bauhu project, in accordance with our <a href="/privacy" target="_blank" rel="noopener">Privacy Notice</a>.</p>
        </div>
        <div class="turnstile-container"><div class="cf-turnstile" data-sitekey="0x4AAAAAAFbeuRxlXR015Fra"></div></div>
        <input id="project-payload" type="hidden" name="projectPayload" />
        <div class="form-actions"><a href="/project-details">← Back to project details</a><button type="submit" id="send-enquiry-button"><span class="send-button-label">Send enquiry</span><span class="send-button-icon" aria-hidden="true"></span></button></div>
        <p id="submission-note" class="submission-note">Your project details and any supporting documents will be sent securely to Bauhu.</p>
        <div class="bauhu-launch" id="bauhu-launch" aria-hidden="true">
          <div class="bauhu-launch-grid"></div>
          <div class="bauhu-launch-ring"></div>
          <div class="bauhu-launch-ticket">
            <div class="bauhu-ticket-top"><span>BAUHU / ENQUIRY</span><span>CONFIRMED</span></div>
            <div class="bauhu-ticket-center"><span>YOUR<br>PROJECT.</span><b>↗</b></div>
            <div class="bauhu-ticket-bottom"><span>SUCCESSFULLY SENT</span><span>✳</span></div>
          </div>
          <div class="bauhu-launch-trail"></div>
          <p class="bauhu-launch-caption">YOUR PROJECT IS ON ITS WAY.</p>
        </div>
      </form>

      <aside class="recap">
        <p class="kicker">PROJECT SUMMARY</p>
        <h2 id="recap-home">Route not selected</h2>
        <dl>
          <div><dt>Location</dt><dd id="recap-location">Not supplied</dd></div>
          <div><dt>Land</dt><dd id="recap-land">—</dd></div>
          <div><dt>Planning</dt><dd id="recap-planning">—</dd></div>
          <div><dt>Budget</dt><dd id="recap-budget">—</dd></div>
          <div><dt>Target start</dt><dd id="recap-timing">—</dd></div>
          <div><dt>Documents</dt><dd id="recap-documents">None supplied</dd></div>
          <div><dt>Interior direction</dt><dd id="recap-interiors">Not selected</dd></div>
        </dl>
      </aside>
    </section>
  </main>
  <SiteFooter />

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline>
    (() => {
      const read = (key) => { try { return JSON.parse(localStorage.getItem(key) || '{}'); } catch { return {}; } };
      const site = read('bauhuProjectSite');
      const details = read('bauhuProjectDetails');
      const storedDocuments = (() => { try { return JSON.parse(localStorage.getItem('bauhuProjectDocuments') || '[]'); } catch { return []; } })();
      const interiors = (() => { try { return JSON.parse(localStorage.getItem('bauhuInteriorPreferences') || '{}'); } catch { return {}; } })();
      const routeLabels = { private:'Custom design', custom:'Custom design', development:'Development / multiple buildings', unsure:'Not sure yet', model:'Predesigned model' };
      const effectiveRoute = details.route === 'private' ? 'custom' : details.route;
      document.getElementById('recap-home').textContent = effectiveRoute === 'model' ? (details.modelName || 'Predesigned model') : (routeLabels[effectiveRoute] || 'Route not selected');
      document.getElementById('recap-location').textContent = site.place || details.buildLocation || 'Not supplied';
      document.getElementById('recap-land').textContent = details.landStatus || '—';
      document.getElementById('recap-planning').textContent = details.planningStatus || '—';
      document.getElementById('recap-budget').textContent = details.budget || '—';
      document.getElementById('recap-timing').textContent = details.targetStart || '—';
      document.getElementById('recap-documents').textContent = storedDocuments.length ? `${storedDocuments.length} file${storedDocuments.length === 1 ? '' : 's'} selected` : 'None supplied';
      document.getElementById('recap-interiors').textContent = interiors?.designLabel || interiors?.design || 'Not selected';

      if (details.route === 'private') details.route = 'custom';
      const home = {
        homeChoice: details.route || 'unsure',
        modelSlug: details.route === 'model' ? (details.modelSlug || '') : '',
        modelName: details.route === 'model' ? (details.modelName || '') : ''
      };

      const buildAttribution = () => {
        const shared = window.bauhuAttribution?.asPayload?.();
        if (shared) return shared;
        try { return JSON.parse(localStorage.getItem('bauhu_attribution_v1') || '{}'); } catch { return {}; }
      };

      const buildPayload = (extra = {}) => ({
        site,
        project: details,
        home,
        documents: storedDocuments,
        interiors: interiors?.design ? interiors : null,
        attribution: buildAttribution(),
        sourceUrl: location.href,
        ...extra
      });

      document.getElementById('project-payload').value = JSON.stringify(buildPayload());

      async function normaliseStoredBlob(record) {
        const source = record?.blob;
        if (!(source instanceof Blob) || source.size <= 0) return null;
        const type = record?.type || source.type || 'application/octet-stream';
        const buffer = await source.arrayBuffer();
        return new Blob([buffer], { type });
      }

      async function appendSafeFiles(body) {
        const warnings = [];
        const selectedFiles = [];

        if (!window.BauhuEnquiryFiles) return { warnings, selectedFiles };

        let records = [];
        try {
          records = await window.BauhuEnquiryFiles.list();
        } catch (error) {
          warnings.push(`Files were selected but this browser could not read them: ${error?.message || 'file read failed'}.`);
          return { warnings, selectedFiles };
        }

        for (const record of records) {
          const fileInfo = {
            name: record?.name || 'document',
            size: Number(record?.size || record?.blob?.size || 0),
            type: record?.type || record?.blob?.type || '',
            lastModified: record?.lastModified || null
          };
          selectedFiles.push(fileInfo);

          try {
            if (fileInfo.size > 30 * 1024 * 1024) {
              warnings.push(`${fileInfo.name} was larger than 30 MB and was not uploaded.`);
              continue;
            }
            const uploadBlob = await normaliseStoredBlob(record);
            if (!uploadBlob) {
              warnings.push(`${fileInfo.name} could not be attached because the browser did not provide a readable file.`);
              continue;
            }
            body.append('files', uploadBlob, fileInfo.name);
          } catch (error) {
            warnings.push(`${fileInfo.name} could not be attached: ${error?.message || 'attachment failed'}.`);
          }
        }

        return { warnings, selectedFiles };
      }

      document.getElementById('contact-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        if (!form.reportValidity()) return;

        const button = form.querySelector('button[type="submit"]');
        const note = document.getElementById('submission-note');
        const launch = document.getElementById('bauhu-launch');
        const setSendingState = (state) => {
          button.classList.toggle('is-sending', state === 'sending');
          button.classList.toggle('is-sent', state === 'sent');
          button.querySelector('.send-button-label').textContent = state === 'sending' ? 'Sending…' : state === 'sent' ? 'Sent' : 'Send enquiry';
        };
        button.disabled = true;
        setSendingState('sending');
        note.textContent = 'Sending your project information securely to Bauhu.';
        note.classList.remove('ready');

        const contact = Object.fromEntries(new FormData(form).entries());
        const body = new FormData();

        try {
          const { warnings, selectedFiles } = await appendSafeFiles(body);
          const complete = buildPayload({
            contact,
            submittedAt: new Date().toISOString(),
            selectedFiles,
            attachmentWarnings: warnings
          });
          const turnstileToken = window.turnstile?.getResponse?.() || '';
          if (!turnstileToken) throw new Error('Please complete the security check before sending your enquiry.');
          body.append('cf-turnstile-response', turnstileToken);
          body.append('payload', JSON.stringify(complete));

          const response = await fetch('/api/enquiries', { method: 'POST', body });
          const text = await response.text();
          let result = {};
          try { result = text ? JSON.parse(text) : {}; } catch {}
          if (!response.ok) {
            const detail = result.detail ? ` ${result.detail}` : '';
            throw new Error(result.error || `The enquiry could not be sent. HTTP ${response.status}.${detail}`);
          }

          try {
            ['bauhuProjectSite','bauhuProjectDetails','bauhuProjectHome','bauhuProjectDocuments','bauhuInteriorPreferences'].forEach((key) => localStorage.removeItem(key));
            if (window.BauhuEnquiryFiles) await window.BauhuEnquiryFiles.clear();
          } catch {}

          setSendingState('sent');
          note.textContent = 'Successfully sent. Opening your confirmation…';
          note.classList.add('ready');
          const confirmationUrl = `/project-sent?ref=${encodeURIComponent(result.reference || '')}`;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            location.assign(confirmationUrl);
          } else {
            launch.classList.add('is-launching');
            launch.setAttribute('aria-hidden', 'false');
            window.setTimeout(() => location.assign(confirmationUrl), 2950);
          }
        } catch (error) {
          const message = error?.message || 'The enquiry could not be sent. Please try again.';
          setSendingState('error');
          note.textContent = message;
          note.classList.remove('ready');
          button.disabled = false;
          window.turnstile?.reset?.();
        }
      });
    })();
  </script>
</BaseLayout>

<style>
.turnstile-container{margin:1rem 0 1.25rem;min-height:65px}
.project-privacy-note{margin:1rem 0 1.4rem;padding:1.1rem 1.25rem;background:#eeeae0;border-left:2px solid #b89a62;color:#17394c}.project-privacy-note strong{font:600 .85rem Inter,sans-serif}.project-privacy-note p{margin:.4rem 0 0;font:400 .79rem/1.65 Inter,sans-serif}.project-privacy-note a{color:inherit;text-decoration:underline}
.journey-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}.journey-header{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:4rem;padding:3.4rem 4vw 2.4rem;border-bottom:1px solid rgba(23,57,76,.18)}.kicker,.journey-header aside>span{margin:0 0 .8rem;font:700 .68rem/1 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#9b7b49}.journey-header h1{margin:0 0 1rem;font:400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif}.journey-header>div>p:last-child{max-width:760px;font:300 1rem/1.7 Inter,sans-serif;color:rgba(23,57,76,.7)}.journey-header aside{display:flex;flex-direction:column;justify-content:flex-end;gap:.45rem;padding-left:2rem;border-left:1px solid rgba(23,57,76,.18);font-family:Inter,sans-serif}.journey-header aside strong{font:400 1.8rem 'Cormorant Garamond',serif}.contact-shell{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:1rem;padding:2rem 4vw 4rem}.contact-form,.recap{padding:1.5rem;background:#f7f5ef;border:1px solid rgba(23,57,76,.14)}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.contact-form label{display:block;margin-bottom:1rem}.contact-form label>span{display:block;margin-bottom:.45rem;font:700 .66rem Inter,sans-serif}.contact-form label em{font-style:normal;font-weight:400;color:rgba(23,57,76,.55)}.contact-form input,.contact-form select,.contact-form textarea{width:100%;box-sizing:border-box;padding:.88rem;border:1px solid rgba(23,57,76,.2);background:#fff;color:#17394c;font:400 .78rem Inter,sans-serif}.consent{display:flex!important;align-items:flex-start;gap:.65rem}.consent input{width:auto;margin-top:.18rem}.consent span{font-weight:400!important;line-height:1.5}.consent a{color:#17394c;font-weight:700}.form-actions{display:flex;justify-content:space-between;align-items:center}.form-actions a{color:#17394c;font:700 .68rem Inter,sans-serif}.form-actions button{padding:.95rem 1.2rem;border:0;background:#17394c;color:#fff;font:700 .7rem Inter,sans-serif}.submission-note{margin:1rem 0 0;padding:1rem;background:#eee4cf;font:400 .64rem/1.55 Inter,sans-serif}.submission-note.ready{background:#dde8df}.recap h2{margin:.2rem 0 1rem;font:400 2rem 'Cormorant Garamond',serif}.recap dl{margin:0}.recap dl div{display:flex;justify-content:space-between;gap:1rem;padding:.68rem 0;border-top:1px solid rgba(23,57,76,.12);font:400 .66rem/1.4 Inter,sans-serif}.recap dd{margin:0;text-align:right;font-weight:700}@media(max-width:820px){.journey-header{grid-template-columns:1fr;gap:2rem}.journey-header aside{padding:1.3rem 0 0;border-left:0;border-top:1px solid rgba(23,57,76,.18)}.contact-shell{grid-template-columns:1fr}.recap{grid-row:1}}@media(max-width:620px){.field-grid{grid-template-columns:1fr}.form-actions{align-items:stretch;flex-direction:column-reverse;gap:.8rem}.form-actions button{width:100%}}

/* Loopi-inspired post-submit launch. Only starts once the enquiry API accepts the form. */
.contact-form{position:relative;isolation:isolate}
.form-actions button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-width:160px}
.form-actions button:disabled{cursor:progress;opacity:.9}
.form-actions button.is-sent{background:#315f55}
.form-actions button.is-sending .send-button-icon{width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:bauhu-send-spin .7s linear infinite}
.form-actions button.is-sent .send-button-icon{width:8px;height:13px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg);margin:-3px 3px 3px}
.bauhu-launch{position:absolute;inset:0;z-index:10;overflow:hidden;pointer-events:none;visibility:hidden;opacity:0;background:#17394c;color:#f5f2e8;display:grid;place-items:center}
.bauhu-launch.is-launching{visibility:visible;opacity:1}
.bauhu-launch-grid{position:absolute;inset:-40%;opacity:.13;background:repeating-linear-gradient(0deg,transparent 0,transparent 42px,#aed2db 43px,#aed2db 44px),repeating-linear-gradient(90deg,transparent 0,transparent 42px,#aed2db 43px,#aed2db 44px);transform:rotate(-8deg)}
.bauhu-launch-ring{position:absolute;width:550px;height:550px;border:1px solid #a4d3dc;border-radius:50%;opacity:0;transform:scale(.4)}
.bauhu-launch-ticket{position:relative;z-index:2;width:min(76%,350px);background:#d8e5df;color:#17394c;padding:20px;border:2px solid #17394c;box-shadow:17px 17px 0 #0e2431;transform:translateY(120%) rotate(16deg) scale(.72);opacity:0}
.bauhu-ticket-top,.bauhu-ticket-bottom{display:flex;justify-content:space-between;gap:10px;font:800 10px Inter,Arial,sans-serif;letter-spacing:.1em}
.bauhu-ticket-top{padding-bottom:13px;border-bottom:1px solid #7ba6a5}
.bauhu-ticket-bottom{padding-top:14px;border-top:1px solid #7ba6a5}
.bauhu-ticket-center{min-height:200px;display:flex;align-items:flex-end;justify-content:space-between;gap:12px}
.bauhu-ticket-center span{font:700 clamp(39px,5vw,70px)/.9 Inter,Arial,sans-serif;letter-spacing:-.07em}
.bauhu-ticket-center b{font:700 65px/1 Inter,Arial,sans-serif}
.bauhu-launch-trail{position:absolute;z-index:3;width:180%;height:5px;background:#c8a96a;transform:translate(-120%,250px) rotate(-27deg);opacity:0}
.bauhu-launch-caption{position:absolute;bottom:24px;left:20px;right:20px;border-top:1px solid #7d9eab;padding-top:14px;text-align:center;font:700 clamp(11px,1.5vw,15px)/1.3 Inter,Arial,sans-serif;letter-spacing:.1em;opacity:0}
.bauhu-launch.is-launching .bauhu-launch-ticket{animation:bauhu-ticket-launch 2.8s cubic-bezier(.2,.7,.3,1) both}
.bauhu-launch.is-launching .bauhu-launch-ring{animation:bauhu-ring-enter 1.2s ease-out forwards}
.bauhu-launch.is-launching .bauhu-launch-trail{animation:bauhu-trail-sweep .95s ease-in 1.75s forwards}
.bauhu-launch.is-launching .bauhu-launch-caption{animation:bauhu-caption .7s ease-out 1.3s forwards}
@keyframes bauhu-send-spin{to{transform:rotate(360deg)}}
@keyframes bauhu-ticket-launch{0%{transform:translateY(120%) rotate(16deg) scale(.72);opacity:0}24%{transform:translateY(0) rotate(-7deg) scale(1.06);opacity:1}45%{transform:translateY(0) rotate(3deg) scale(.98);opacity:1}65%{transform:translateY(0) rotate(-2deg) scale(1);opacity:1}78%{transform:translateY(-25px) rotate(-8deg) scale(1.06);opacity:1}100%{transform:translate(155%,-170%) rotate(35deg) scale(.18);opacity:0}}
@keyframes bauhu-ring-enter{to{transform:scale(1);opacity:.8}}
@keyframes bauhu-trail-sweep{0%{transform:translate(-120%,250px) rotate(-27deg);opacity:1}75%{opacity:1}100%{transform:translate(120%,-300px) rotate(-27deg);opacity:0}}
@keyframes bauhu-caption{to{opacity:1}}
@media(max-width:620px){.bauhu-launch-ticket{width:min(83%,310px)}.bauhu-ticket-center{min-height:170px}.bauhu-ticket-center span{font-size:clamp(37px,9vw,55px)}}
@media(prefers-reduced-motion:reduce){.bauhu-launch.is-launching *{animation:none!important}.form-actions button.is-sending .send-button-icon{animation:none}}
</style>
