---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Send Your Project | Bauhu" description="Send Bauhu your project brief and contact details.">
  <SiteHeader />
  <main class="journey-page">
    <header class="journey-header">
      <div><p class="kicker">START YOUR PROJECT</p><h1>Tell us how to contact you.</h1><p>Your site, project and home choices are attached automatically. Add your contact details and any final note.</p></div>
      <aside><span>PROJECT JOURNEY</span><strong>4 of 4 · Contact</strong><small>Final review before sending to Bauhu.</small></aside>
    </header>

    <section class="contact-shell">
      <form id="contact-form" class="contact-form">
        <div class="field-grid">
          <label><span>Full name</span><input name="name" autocomplete="name" required /></label>
          <label><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
          <label><span>Phone</span><input name="phone" type="tel" autocomplete="tel" /></label>
          <label><span>Preferred contact</span><select name="contactPreference"><option>Email</option><option>Phone</option><option>WhatsApp</option></select></label>
        </div>
        <label><span>Final note <em>Optional</em></span><textarea name="message" rows="5" placeholder="Anything else you want us to know?"></textarea></label>
        <label class="consent"><input name="consent" type="checkbox" required /><span>I agree that Bauhu may contact me about this project.</span></label>
        <input id="project-payload" type="hidden" name="projectPayload" />
        <div class="form-actions"><a href="/project-home">← Back to home choice</a><button type="submit">Prepare enquiry</button></div>
        <p id="submission-note" class="submission-note">The journey is complete. The final server-side delivery connection will be added before launch so this button sends the enquiry directly to Bauhu.</p>
      </form>

      <aside class="recap">
        <p class="kicker">PROJECT SUMMARY</p>
        <h2 id="recap-home">Route not selected</h2>
        <dl>
          <div><dt>Location</dt><dd id="recap-location">Not supplied</dd></div>
          <div><dt>Land</dt><dd id="recap-land">—</dd></div>
          <div><dt>Planning</dt><dd id="recap-planning">—</dd></div>
          <div><dt>Budget</dt><dd id="recap-budget">—</dd></div>
          <div><dt>Target start</dt><dd id="recap-timing">—</dd></div>
          <div><dt>Placement</dt><dd id="recap-placement">Optional / not used</dd></div><div><dt>Documents</dt><dd id="recap-documents">None supplied</dd></div>
        </dl>
      </aside>
    </section>
  </main>
  <SiteFooter />

  <script is:inline>
    (() => {
      const read = (key) => { try { return JSON.parse(localStorage.getItem(key) || '{}'); } catch { return {}; } };
      const site = read('bauhuProjectSite');
      const details = read('bauhuProjectDetails');
      const home = read('bauhuProjectHome');
      const params = new URLSearchParams(location.search);
      const attribution = read('bauhuAttribution');
      const documents = (() => { try { return JSON.parse(localStorage.getItem('bauhuProjectDocuments') || '[]'); } catch { return []; } })();
      const placement = params.get('placement') === 'confirmed' ? {
        confirmed: true,
        lat: params.get('lat') || '',
        lng: params.get('lng') || '',
        rotation: Number(params.get('rotation') || 0),
        parcel: params.get('parcel') || site.parcel || '',
        area: params.get('area') || site.area || ''
      } : { confirmed: false };

      const routeLabels = { private:'Private residence', development:'Development / multiple buildings', unsure:'Not sure yet', model:'Model residence' };
      document.getElementById('recap-home').textContent = home.homeChoice === 'model' ? (home.modelName || 'Model residence') : (routeLabels[home.homeChoice] || routeLabels[details.route] || 'Route not selected');
      document.getElementById('recap-location').textContent = site.place || details.buildLocation || 'Not supplied';
      document.getElementById('recap-land').textContent = details.landStatus || '—';
      document.getElementById('recap-planning').textContent = details.planningStatus || '—';
      document.getElementById('recap-budget').textContent = details.budget || '—';
      document.getElementById('recap-timing').textContent = details.targetStart || '—';
      document.getElementById('recap-placement').textContent = placement.confirmed ? `Confirmed · ${placement.rotation}°` : 'Optional / not used';
      document.getElementById('recap-documents').textContent = documents.length ? `${documents.length} file${documents.length === 1 ? '' : 's'} selected` : 'None supplied';

      const payload = { site, project: details, home, placement, documents, attribution, sourceUrl: location.href };
      document.getElementById('project-payload').value = JSON.stringify(payload);

      document.getElementById('contact-form').addEventListener('submit', (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        if (!form.reportValidity()) return;
        const contact = Object.fromEntries(new FormData(form).entries());
        const complete = { ...payload, contact, preparedAt: new Date().toISOString() };
        try { sessionStorage.setItem('bauhuProjectEnquiryDraft', JSON.stringify(complete)); } catch {}
        const note = document.getElementById('submission-note');
        note.textContent = 'Enquiry prepared successfully. Server-side delivery is the remaining launch connection; no information has been sent yet.';
        note.classList.add('ready');
        form.querySelector('button[type="submit"]').textContent = 'Enquiry prepared';
      });
    })();
  </script>
</BaseLayout>

<style>
.journey-page{min-height:100vh;padding-top:5.5rem;background:#ebe9e2;color:#17394c}.journey-header{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:4rem;padding:3.4rem 4vw 2.4rem;border-bottom:1px solid rgba(23,57,76,.18)}.kicker,.journey-header aside>span{margin:0 0 .8rem;font:700 .68rem/1 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#9b7b49}.journey-header h1{margin:0 0 1rem;font:400 clamp(2.8rem,5.6vw,5.8rem)/.94 'Cormorant Garamond',serif}.journey-header>div>p:last-child{max-width:760px;font:300 1rem/1.7 Inter,sans-serif;color:rgba(23,57,76,.7)}.journey-header aside{display:flex;flex-direction:column;justify-content:flex-end;gap:.45rem;padding-left:2rem;border-left:1px solid rgba(23,57,76,.18);font-family:Inter,sans-serif}.journey-header aside strong{font:400 1.8rem 'Cormorant Garamond',serif}.contact-shell{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:1rem;padding:2rem 4vw 4rem}.contact-form,.recap{padding:1.5rem;background:#f7f5ef;border:1px solid rgba(23,57,76,.14)}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.contact-form label{display:block;margin-bottom:1rem}.contact-form label>span{display:block;margin-bottom:.45rem;font:700 .66rem Inter,sans-serif}.contact-form label em{font-style:normal;font-weight:400;color:rgba(23,57,76,.55)}.contact-form input,.contact-form select,.contact-form textarea{width:100%;box-sizing:border-box;padding:.88rem;border:1px solid rgba(23,57,76,.2);background:#fff;color:#17394c;font:400 .78rem Inter,sans-serif}.consent{display:flex!important;align-items:flex-start;gap:.65rem}.consent input{width:auto;margin-top:.18rem}.consent span{font-weight:400!important;line-height:1.5}.form-actions{display:flex;justify-content:space-between;align-items:center}.form-actions a{color:#17394c;font:700 .68rem Inter,sans-serif}.form-actions button{padding:.95rem 1.2rem;border:0;background:#17394c;color:#fff;font:700 .7rem Inter,sans-serif}.submission-note{margin:1rem 0 0;padding:1rem;background:#eee4cf;font:400 .64rem/1.55 Inter,sans-serif}.submission-note.ready{background:#dde8df}.recap h2{margin:.2rem 0 1rem;font:400 2rem 'Cormorant Garamond',serif}.recap dl{margin:0}.recap dl div{display:flex;justify-content:space-between;gap:1rem;padding:.68rem 0;border-top:1px solid rgba(23,57,76,.12);font:400 .66rem/1.4 Inter,sans-serif}.recap dd{margin:0;text-align:right;font-weight:700}@media(max-width:820px){.journey-header{grid-template-columns:1fr;gap:2rem}.journey-header aside{padding:1.3rem 0 0;border-left:0;border-top:1px solid rgba(23,57,76,.18)}.contact-shell{grid-template-columns:1fr}.recap{grid-row:1}}@media(max-width:620px){.field-grid{grid-template-columns:1fr}.form-actions{align-items:stretch;flex-direction:column-reverse;gap:.8rem}.form-actions button{width:100%}}
</style>