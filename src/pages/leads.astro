---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Bauhu Leads" description="Internal Bauhu enquiry dashboard." noindex={true}>
  <main class="leads-page">
    <header class="leads-header">
      <div><p>BAUHU</p><h1>Leads</h1><span>Website enquiries and qualification</span></div>
      <div class="header-actions"><button id="refresh" type="button">Refresh</button><button id="logout" type="button">Lock</button></div>
    </header>

    <section id="login-panel" class="login-panel">
      <form id="login-form">
        <h2>Open leads dashboard</h2>
        <p>Enter the private dashboard token configured in Cloudflare.</p>
        <input id="token" type="password" autocomplete="current-password" placeholder="Dashboard token" required />
        <button type="submit">Open dashboard</button>
        <small id="login-error"></small>
      </form>
    </section>

    <section id="dashboard" class="dashboard" hidden>
      <div class="metrics">
        <article><span>New</span><strong id="metric-new">0</strong></article>
        <article><span>Qualified</span><strong id="metric-qualified">0</strong></article>
        <article><span>Proposal</span><strong id="metric-proposal">0</strong></article>
        <article><span>Won</span><strong id="metric-won">0</strong></article>
      </div>

      <div class="filters">
        <input id="search" type="search" placeholder="Search reference, name, email, location or model" />
        <select id="status-filter">
          <option>All</option><option>New</option><option>Reviewed</option><option>Qualified</option><option>Contacted</option><option>Meeting</option><option>Proposal</option><option>Won</option><option>Lost</option><option>Nurture</option>
        </select>
      </div>

      <div class="table-shell">
        <table>
          <thead><tr><th>Ref</th><th>Date</th><th>Name</th><th>Location</th><th>Route</th><th>Budget</th><th>Timing</th><th>Source</th><th>Status</th></tr></thead>
          <tbody id="lead-rows"></tbody>
        </table>
      </div>
      <p id="empty" class="empty" hidden>No enquiries found.</p>
    </section>

    <div id="drawer-backdrop" class="drawer-backdrop" hidden></div>
    <aside id="lead-drawer" class="drawer" hidden>
      <div class="drawer-head"><div><span id="drawer-ref">Lead</span><h2 id="drawer-name">Enquiry</h2></div><button id="close-drawer" type="button" aria-label="Close enquiry">×</button></div>
      <div id="drawer-body"></div>
    </aside>
  </main>

  <script is:inline>
    (() => {
      const tokenKey = 'bauhuLeadsToken';
      const loginPanel = document.getElementById('login-panel');
      const dashboard = document.getElementById('dashboard');
      const loginForm = document.getElementById('login-form');
      const tokenInput = document.getElementById('token');
      const rows = document.getElementById('lead-rows');
      const empty = document.getElementById('empty');
      const search = document.getElementById('search');
      const statusFilter = document.getElementById('status-filter');
      const drawer = document.getElementById('lead-drawer');
      const backdrop = document.getElementById('drawer-backdrop');
      const body = document.getElementById('drawer-body');
      let leads = [];

      const token = () => sessionStorage.getItem(tokenKey) || '';
      const auth = () => ({ authorization: `Bearer ${token()}` });
      const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (m) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));

      async function api(url, options = {}) {
        const headers = { ...(options.headers || {}), ...auth() };
        const response = await fetch(url, { ...options, headers });
        if (response.status === 401) throw new Error('Unauthorised');
        if (!response.ok) throw new Error('Request failed');
        return response.json();
      }

      function metrics() {
        document.getElementById('metric-new').textContent = leads.filter(x => x.status === 'New').length;
        document.getElementById('metric-qualified').textContent = leads.filter(x => x.status === 'Qualified').length;
        document.getElementById('metric-proposal').textContent = leads.filter(x => x.status === 'Proposal').length;
        document.getElementById('metric-won').textContent = leads.filter(x => x.status === 'Won').length;
      }

      function filtered() {
        const q = search.value.trim().toLowerCase();
        const status = statusFilter.value;
        return leads.filter((lead) => {
          if (status !== 'All' && lead.status !== status) return false;
          if (!q) return true;
          return [lead.reference, lead.contact_name, lead.contact_email, lead.site_location, lead.model_name, lead.project_route]
            .some(v => String(v || '').toLowerCase().includes(q));
        });
      }

      function render() {
        const data = filtered();
        rows.innerHTML = data.map((lead) => `
          <tr data-id="${esc(lead.id)}">
            <td><button class="ref-button" type="button">${esc(lead.reference)}</button></td>
            <td>${esc(new Date(lead.created_at).toLocaleDateString())}</td>
            <td><strong>${esc(lead.contact_name)}</strong><small>${esc(lead.contact_email)}</small></td>
            <td>${esc(lead.site_location || '—')}</td>
            <td>${esc(lead.model_name || lead.project_route || lead.home_choice || '—')}</td>
            <td>${esc(lead.budget || '—')}</td>
            <td>${esc(lead.target_start || '—')}</td>
            <td>${esc(lead.attribution_source || 'Direct / unknown')}</td>
            <td><span class="status status-${esc((lead.status || '').toLowerCase())}">${esc(lead.status)}</span></td>
          </tr>
        `).join('');
        empty.hidden = data.length > 0;
        metrics();
      }

      async function load() {
        const data = await api('/api/enquiries?limit=250');
        leads = data.enquiries || [];
        loginPanel.hidden = true;
        dashboard.hidden = false;
        render();
      }

      async function openLead(id) {
        const data = await api(`/api/enquiries/${encodeURIComponent(id)}`);
        const e = data.enquiry;
        document.getElementById('drawer-ref').textContent = e.reference;
        document.getElementById('drawer-name').textContent = e.contact_name;
        const hasPlot = Number.isFinite(Number(e.site_lat)) && Number.isFinite(Number(e.site_lng));
        const lat = hasPlot ? Number(e.site_lat) : null;
        const lng = hasPlot ? Number(e.site_lng) : null;
        const mapHref = hasPlot ? `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=18/${lat}/${lng}` : '';
        const mapEmbed = hasPlot ? `https://www.openstreetmap.org/export/embed.html?bbox=${lng-0.004}%2C${lat-0.003}%2C${lng+0.004}%2C${lat+0.003}&layer=mapnik&marker=${lat}%2C${lng}` : '';
        const files = data.files || [];

        body.innerHTML = `
          <div class="lead-topbar">
            <div>
              <span class="classification">${esc(e.classification || 'Unreviewed')}</span>
              <span class="received">Received ${esc(new Date(e.created_at).toLocaleString())}</span>
            </div>
            <div class="lead-workflow">
              <label><span>Status</span><select id="drawer-status">${['New','Reviewed','Qualified','Contacted','Meeting','Proposal','Won','Lost','Nurture'].map(s => `<option ${s===e.status?'selected':''}>${s}</option>`).join('')}</select></label>
              <label><span>Owner</span><input id="drawer-owner" value="${esc(e.owner || '')}" placeholder="Team member" /></label>
            </div>
          </div>

          <div class="lead-layout">
            <div class="lead-main">
              <section class="panel site-panel">
                <div class="panel-heading"><div><span class="panel-kicker">SITE</span><h3>${esc(e.site_location || 'Site not supplied')}</h3></div></div>
                <div class="detail-table site-details">
                  <div class="detail-row"><span>Land status</span><strong>${esc(e.land_status || '—')}</strong></div>
                  <div class="detail-row"><span>Planning</span><strong>${esc(e.planning_status || '—')}</strong></div>
                  <div class="detail-row"><span>Coordinates</span><strong>${hasPlot ? `${lat.toFixed(6)}, ${lng.toFixed(6)}` : 'Not supplied'}</strong></div>
                </div>
                ${hasPlot ? `<div class="plot-map"><iframe title="Plot location" src="${mapEmbed}" loading="lazy"></iframe></div><a class="plot-link" href="${mapHref}" target="_blank" rel="noopener">Open full map ↗</a>` : '<p class="muted-note">No map coordinates were supplied with this enquiry.</p>'}
              </section>

              <section class="panel project-panel">
                <div class="panel-heading"><div><span class="panel-kicker">PROJECT</span><h3>${esc(e.model_name || e.home_choice || e.project_route || 'Project details')}</h3></div></div>
                <div class="detail-table project-details">
                  <div class="detail-row"><span>Route</span><strong>${esc(e.project_route || '—')}</strong></div>
                  <div class="detail-row"><span>Intended use</span><strong>${esc(e.intended_use || '—')}</strong></div>
                  <div class="detail-row"><span>Bedrooms / scale</span><strong>${esc(e.bedrooms_scale || '—')}</strong></div>
                  <div class="detail-row"><span>Budget</span><strong>${esc(e.budget || '—')}</strong></div>
                  <div class="detail-row"><span>Target start</span><strong>${esc(e.target_start || '—')}</strong></div>
                  <div class="detail-row"><span>Decision role</span><strong>${esc(e.decision_role || '—')}</strong></div>
                </div>
              </section>

              <section class="panel notes-panel">
                <div class="panel-heading"><div><span class="panel-kicker">CUSTOMER NOTES</span><h3>Brief</h3></div></div>
                <p>${esc(e.project_notes || e.message || 'No notes supplied.')}</p>
              </section>
            </div>

            <div class="lead-side">
              <section class="panel contact-panel">
                <div class="panel-heading"><div><span class="panel-kicker">CONTACT</span><h3>${esc(e.contact_name)}</h3></div></div>
                <div class="detail-table compact-details">
                  <div class="detail-row"><span>Email</span><strong><a href="mailto:${esc(e.contact_email)}">${esc(e.contact_email)}</a></strong></div>
                  <div class="detail-row"><span>Phone</span><strong>${esc(e.contact_phone || 'No phone supplied')}</strong></div>
                  <div class="detail-row"><span>Preferred</span><strong>${esc(e.preferred_contact || '—')}</strong></div>
                </div>
              </section>

              <section class="panel documents-panel">
                <div class="panel-heading"><div><span class="panel-kicker">DOCUMENTS</span><h3>Supporting files</h3></div><span class="file-count">${files.length}</span></div>
                <div id="drawer-files" class="file-list">${files.length ? files.map(f => `
                  <div class="file-row">
                    <div class="file-icon">DOC</div>
                    <div class="file-copy"><strong>${esc(f.filename)}</strong><small>${esc(f.content_type || 'Document')} · ${Math.max(1, Math.round(Number(f.size || 0)/1024))} KB</small></div>
                    <button class="file-button" data-file-id="${esc(f.id)}" type="button">View</button>
                  </div>`).join('') : '<p class="muted-note">No supporting documents were supplied.</p>'}</div>
              </section>

              <section class="panel source-panel">
                <div class="panel-heading"><div><span class="panel-kicker">SOURCE</span><h3>Marketing attribution</h3></div></div>
                <div class="detail-table compact-details">
                  <div class="detail-row"><span>Source</span><strong>${esc(e.attribution_source || 'Direct / unknown')}</strong></div>
                  <div class="detail-row"><span>Medium</span><strong>${esc(e.attribution_medium || '—')}</strong></div>
                  <div class="detail-row"><span>Campaign</span><strong>${esc(e.attribution_campaign || '—')}</strong></div>
                  <div class="detail-row"><span>Landing page</span><strong>${esc(e.landing_page || '—')}</strong></div>
                </div>
              </section>

              <section class="panel internal-panel">
                <div class="panel-heading"><div><span class="panel-kicker">INTERNAL</span><h3>Sales notes</h3></div></div>
                <textarea id="drawer-notes" rows="6" placeholder="Add sales notes, follow-up details or next actions…">${esc(e.internal_notes || '')}</textarea>
                <button id="save-lead" class="save-lead" type="button">Save changes</button>
              </section>
            </div>
          </div>
        `;
        backdrop.hidden = false;
        drawer.hidden = false;
        document.body.classList.add('drawer-open');

        document.getElementById('save-lead').onclick = async () => {
          await api(`/api/enquiries/${encodeURIComponent(id)}`, {
            method: 'PATCH',
            headers: { 'content-type':'application/json' },
            body: JSON.stringify({
              status: document.getElementById('drawer-status').value,
              owner: document.getElementById('drawer-owner').value,
              internal_notes: document.getElementById('drawer-notes').value
            })
          });
          await load();
          await openLead(id);
        };

        body.querySelectorAll('.file-button').forEach((button) => {
          button.onclick = async () => {
            const response = await fetch(`/api/enquiries/${encodeURIComponent(id)}/files/${encodeURIComponent(button.dataset.fileId)}`, { headers: auth() });
            if (!response.ok) return;
            const blob = await response.blob();
            window.open(URL.createObjectURL(blob), '_blank', 'noopener');
          };
        });
      }

      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        sessionStorage.setItem(tokenKey, tokenInput.value);
        try { await load(); document.getElementById('login-error').textContent = ''; }
        catch { sessionStorage.removeItem(tokenKey); document.getElementById('login-error').textContent = 'That token was not accepted.'; }
      });

      rows.addEventListener('click', (event) => {
        const row = event.target.closest('tr[data-id]');
        if (row) openLead(row.dataset.id);
      });
      search.addEventListener('input', render);
      statusFilter.addEventListener('change', render);
      document.getElementById('refresh').onclick = () => load().catch(() => {});
      const closeDrawer = () => {
        drawer.hidden = true;
        backdrop.hidden = true;
        document.body.classList.remove('drawer-open');
      };
      document.getElementById('close-drawer').onclick = closeDrawer;
      backdrop.onclick = closeDrawer;
      document.getElementById('logout').onclick = () => { sessionStorage.removeItem(tokenKey); location.reload(); };

      if (token()) load().catch(() => sessionStorage.removeItem(tokenKey));
    })();
  </script>
</BaseLayout>

<style>
.leads-page{min-height:100vh;background:#ebe9e2;color:#17394c;font-family:Inter,sans-serif}
.leads-header{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;padding:2rem 3vw;background:#101b21;color:#f5f1e8}
.leads-header p{margin:0 0 .35rem;font-size:.62rem;letter-spacing:.22em;color:#c5a66a}
.leads-header h1{margin:0;font:400 3rem/1 'Cormorant Garamond',serif}
.leads-header span{display:block;margin-top:.4rem;font-size:.68rem;color:rgba(245,241,232,.62)}
.header-actions{display:flex;gap:.5rem}
.header-actions button{padding:.65rem .8rem;border:1px solid rgba(255,255,255,.2);background:transparent;color:#fff;cursor:pointer}

.login-panel{display:grid;place-items:center;min-height:70vh}
.login-panel form{width:min(420px,90vw);padding:2rem;background:#f7f5ef;border:1px solid rgba(23,57,76,.15)}
.login-panel h2{margin:0 0 .5rem;font:400 2rem 'Cormorant Garamond',serif}
.login-panel p{font-size:.72rem;line-height:1.6;color:rgba(23,57,76,.65)}
.login-panel input,.login-panel button{width:100%;box-sizing:border-box;padding:.9rem;margin-top:.7rem}
.login-panel input{border:1px solid rgba(23,57,76,.2)}
.login-panel button{border:0;background:#17394c;color:#fff;font-weight:700;cursor:pointer}
.login-panel small{display:block;margin-top:.6rem;color:#8a3d33}

.dashboard{padding:1.5rem 3vw 4rem}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem}
.metrics article{padding:1rem;background:#f7f5ef;border:1px solid rgba(23,57,76,.12)}
.metrics span{display:block;font-size:.58rem;text-transform:uppercase;letter-spacing:.1em;color:rgba(23,57,76,.55)}
.metrics strong{display:block;margin-top:.3rem;font:400 2rem 'Cormorant Garamond',serif}
.filters{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:.7rem;margin:1rem 0}
.filters input,.filters select{padding:.8rem;border:1px solid rgba(23,57,76,.16);background:#fff;color:#17394c}
.table-shell{overflow:auto;background:#f7f5ef;border:1px solid rgba(23,57,76,.12)}
table{width:100%;border-collapse:collapse;min-width:1050px}
th,td{padding:.75rem;text-align:left;border-bottom:1px solid rgba(23,57,76,.1);font-size:.65rem}
th{font-size:.56rem;text-transform:uppercase;letter-spacing:.08em;color:rgba(23,57,76,.52)}
td strong,td small{display:block}
td small{margin-top:.18rem;color:rgba(23,57,76,.5)}
.ref-button{border:0;background:none;padding:0;color:#17394c;text-decoration:underline;font-weight:700;cursor:pointer}
.status{display:inline-block;padding:.35rem .5rem;background:#ece9df;font-weight:700}
.status-qualified,.status-won{background:#dfe9df}
.status-lost{background:#eadbd7}
.empty{padding:2rem;text-align:center}

.drawer-backdrop{position:fixed;z-index:90;inset:0;background:rgba(9,18,23,.48);backdrop-filter:blur(2px)}
body.drawer-open{overflow:hidden}
.drawer{position:fixed;z-index:100;top:2vh;right:2vw;width:min(1120px,96vw);height:96vh;overflow:auto;background:#ebe9e2;box-shadow:-24px 0 60px rgba(23,57,76,.28);border:1px solid rgba(255,255,255,.08)}
.drawer-head{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;align-items:flex-start;padding:1.35rem 1.6rem;background:#101b21;color:#fff;border-bottom:1px solid rgba(255,255,255,.08)}
.drawer-head span{font-size:.58rem;letter-spacing:.14em;color:#c5a66a}
.drawer-head h2{margin:.3rem 0 0;font:400 2.4rem 'Cormorant Garamond',serif}
.drawer-head button{display:grid;place-items:center;width:38px;height:38px;border:1px solid rgba(255,255,255,.18);border-radius:50%;background:transparent;color:#fff;font-size:1.5rem;cursor:pointer}
.drawer-body{padding:1.3rem 1.6rem 2rem}

.lead-topbar{display:flex;justify-content:space-between;gap:1rem;align-items:flex-end;margin-bottom:1rem;padding:1rem 1.1rem;background:#f7f5ef;border:1px solid rgba(23,57,76,.12)}
.lead-topbar>div:first-child{display:flex;gap:.65rem;align-items:center;flex-wrap:wrap}
.classification{padding:.38rem .58rem;background:#e9e1cf;font-size:.58rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}
.received{font-size:.6rem;color:rgba(23,57,76,.52)}
.lead-workflow{display:grid;grid-template-columns:160px 180px;gap:.6rem}
.lead-workflow label span{display:block;margin-bottom:.3rem;font-size:.55rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:rgba(23,57,76,.55)}
.lead-workflow select,.lead-workflow input,.drawer textarea{width:100%;box-sizing:border-box;padding:.7rem;border:1px solid rgba(23,57,76,.18);background:#fff;color:#17394c}

.lead-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(320px,.75fr);gap:1rem}
.lead-main,.lead-side{display:grid;align-content:start;gap:1rem}
.panel{margin:0;padding:1.05rem 1.1rem;background:#f7f5ef;border:1px solid rgba(23,57,76,.12)}
.panel-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:.85rem}
.panel-kicker{display:block;margin-bottom:.22rem;font-size:.53rem;font-weight:700;letter-spacing:.14em;color:#9b7b49}
.panel-heading h3{margin:0;font:400 1.65rem/1.05 'Cormorant Garamond',serif;color:#17394c}
.file-count{display:inline-grid;place-items:center;min-width:28px;padding:.35rem .5rem;background:#e9e1cf;border-radius:999px;font-size:.56rem;font-weight:700;color:#17394c}

.detail-table{display:grid;border:1px solid rgba(23,57,76,.12);background:#fff}
.detail-row{display:grid;grid-template-columns:165px minmax(0,1fr);min-height:42px;border-top:1px solid rgba(23,57,76,.1)}
.detail-row:first-child{border-top:0}
.detail-row>span{display:flex;align-items:center;padding:.68rem .75rem;background:#e9e5dc;border-right:1px solid rgba(23,57,76,.1);font-size:.55rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:rgba(23,57,76,.56)}
.detail-row>strong{display:flex;align-items:center;padding:.68rem .8rem;background:#fff;font-size:.68rem;line-height:1.35;color:#17394c;overflow-wrap:anywhere}
.detail-row>strong a{color:#17394c;text-decoration:underline;text-underline-offset:2px}
.site-details{margin-bottom:.8rem}
.project-details{grid-template-columns:1fr 1fr}
.project-details .detail-row{grid-template-columns:140px minmax(0,1fr)}
.project-details .detail-row:nth-child(odd){border-right:1px solid rgba(23,57,76,.1)}
.project-details .detail-row:nth-child(1),.project-details .detail-row:nth-child(2){border-top:0}
.compact-details .detail-row{grid-template-columns:105px minmax(0,1fr)}

.plot-map{overflow:hidden;height:220px;border:1px solid rgba(23,57,76,.12);background:#d9dfdc}
.plot-map iframe{width:100%;height:100%;border:0}
.plot-link{display:inline-block;margin-top:.7rem;color:#17394c;font-size:.64rem;font-weight:700}
.muted-note{margin:.2rem 0;font-size:.64rem;color:rgba(23,57,76,.52)}

.file-list{display:grid;gap:.5rem}
.file-row{display:grid;grid-template-columns:34px minmax(0,1fr) auto;gap:.65rem;align-items:center;padding:.75rem;background:#ece9df}
.file-icon{display:grid;place-items:center;width:34px;height:34px;background:#17394c;color:#fff;font-size:.48rem;font-weight:700;letter-spacing:.08em}
.file-copy{min-width:0}
.file-copy strong,.file-copy small{display:block}
.file-copy strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.65rem}
.file-copy small{margin-top:.18rem;font-size:.56rem;color:rgba(23,57,76,.5)}
.file-button{padding:.55rem .8rem;border:1px solid #17394c;background:#fff;color:#17394c;font-size:.6rem;font-weight:700;cursor:pointer}

.notes-panel p{margin:0;font-size:.72rem;line-height:1.65;color:rgba(23,57,76,.7)}
.internal-panel textarea{min-height:120px}
.save-lead{width:100%;margin-top:1rem;padding:1rem;border:0;background:#17394c;color:#fff;font-weight:700;cursor:pointer}

@media(max-width:900px){
  .drawer{top:0;right:0;width:100vw;height:100vh;border:0}
  .lead-layout{grid-template-columns:1fr}
  .lead-topbar{align-items:stretch;flex-direction:column}
  .lead-workflow{grid-template-columns:1fr 1fr}
}
@media(max-width:760px){
  .metrics{grid-template-columns:1fr 1fr}
  .filters{grid-template-columns:1fr}
  .leads-header{align-items:flex-start;flex-direction:column}
  .drawer-body{padding:1rem}
  .lead-workflow,.project-details{grid-template-columns:1fr}
  .project-details .detail-row{border-right:0!important}
  .detail-row,.project-details .detail-row,.compact-details .detail-row{grid-template-columns:112px minmax(0,1fr)}
  .plot-map{height:190px}
}
</style>