---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const rawPathname = Astro.url.pathname;
const canonicalPathname = rawPathname === '/' || rawPathname.endsWith('/') || rawPathname.split('/').pop()?.includes('.')
  ? rawPathname
  : `${rawPathname}/`;
const canonical = new URL(canonicalPathname, Astro.site ?? 'https://bauhu.com').toString();
const ogImage = new URL('/images/developments/bauhu-projects-hero.webp', Astro.site ?? 'https://bauhu.com').toString();
const siteUrl = (Astro.site ?? 'https://bauhu.com').toString().replace(/\/$/, '');
const organizationSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Bauhu',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  email: 'contact@bauhu.com',
  telephone: '+44 7949 345 478',
  description:
    'Bauhu designs architect-led homes and precision-engineered building systems for remote, coastal and hurricane-exposed sites across the Caribbean, The Bahamas and other island locations.',
  areaServed: [
    'The Bahamas',
    'Turks and Caicos',
    'US Virgin Islands',
    'British Virgin Islands',
    'Cayman Islands',
    'Antigua and Barbuda',
    'Anguilla',
    'St Barthélemy',
    'St Martin / Sint Maarten',
    'Barbados',
    'Jamaica',
    'Puerto Rico',
    'Dominican Republic',
    'St Lucia',
    'Grenada',
    'St Vincent and the Grenadines',
    'Trinidad and Tobago',
    'Bermuda',
    'Florida',
  ],
  knowsAbout: [
    'Architect-designed homes',
    'Remote island construction',
    'Hurricane-exposed coastal sites',
    'Steel frame building systems',
    'Caribbean homes',
    'Prefab and modular home delivery',
    'Resort and residential developments',
  ],
  sameAs: [
    'https://www.instagram.com/bauhuhomes/',
    'https://www.facebook.com/bauhu.co.uk/',
    'https://www.linkedin.com/company/bauhu',
  ],
});
const webSiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Bauhu',
  url: siteUrl,
  description:
    'Architect-designed homes and precision-engineered building systems for remote, coastal and hurricane-exposed sites.',
  publisher: {
    '@type': 'Organization',
    name: 'Bauhu',
    url: siteUrl,
  },
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bauhu" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#243A32" />
    <meta name="facebook-domain-verification" content="iticng9m7v8xbubpf69c08sbu6ycyv" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/site-intelligence.css" />
    <link rel="stylesheet" href="/related-models.css" />
    <script type="application/ld+json" set:html={organizationSchema} />
    <script type="application/ld+json" set:html={webSiteSchema} />
    <script is:inline>
      var _paq = window._paq = window._paq || [];
      _paq.push(['setCookieDomain', '*.bauhu.com']);
      _paq.push(['trackPageView']);
      _paq.push(['enableLinkTracking']);
      (function() {
        var u = 'https://bauhu.matomo.cloud/';
        _paq.push(['setTrackerUrl', u + 'matomo.php']);
        _paq.push(['setSiteId', '1']);
        var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
        g.async = true;
        g.src = 'https://cdn.matomo.cloud/bauhu.matomo.cloud/matomo.js';
        s.parentNode.insertBefore(g, s);
      })();
    </script>
    <script is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window, document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '684657639337711');
      fbq('track', 'PageView');
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <noscript><img alt="fb-pixel" height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=684657639337711&ev=PageView&noscript=1" /></noscript>
    <script src="/lead-attribution.js" defer></script>
    <script src="/project-start-route.js" defer></script>
    <script src="/enquiry-files.js" defer></script>
    <script src="/site-fit-survey.js" defer></script>
    <script src="/site-intelligence.js" defer></script>
    <script src="/site-fit-reset.js" defer></script>
    <script src="/site-fit-summary.js" defer></script>
    <script src="/site-fit-location-flow.js" defer></script>
    <script src="/site-fit-simple-journey.js" defer></script>
    <script src="/site-fit-placement-cleanup.js" defer></script>
    <script src="/site-placement-visibility.js" defer></script>
    <script src="/site-placement-footprint.js" defer></script>
    <script src="/site-placement-value-tools.js" defer></script>
    <script src="/site-placement-next.js" defer></script>
    <script src="/model-viewer-gltf.js" defer></script>
    <script src="/model-viewer-gallery.js" defer></script>
    <script src="/model-copy.js" defer></script>
    <script src="/floorplan-cleanup.js" defer></script>
    <script src="/related-models.js" defer></script>
  </body>
</html>